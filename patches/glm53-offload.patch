+    const int64_t i_s  = i / (n_kv*32);
+    const int64_t i_kv = (i / 32) % n_kv;
+    const int     i4   = i % 32;
+    const void * k_base = (const void *) (K + i_kv*nbk2 + i_s*nbk3);
+    constexpr dequantize_V_t dequantize_k = get_dequantize_V<TYPE_K, half, 4>();
+    __align__(8) half tmp[4];
+    dequantize_k(k_base, tmp, i4*4);
+    *(int2 *) (dst + (i_s*n_kv + i_kv)*128 + i4*4) = *(const int2 *) tmp;
