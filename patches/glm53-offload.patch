+void llama_moe_cache::td_flush() {
+    for (size_t id = 0; id < pimpl->rb_td_all.size(); ++id) {
+        if (pimpl->rb_td_all[id] != nullptr && pimpl->rb_td_dirty[id]) {
+            ggml_backend_tensor_set(pimpl->rb_td_all[id], pimpl->rb_td_host[id].data(), 0, ggml_nbytes(pimpl->rb_td_all[id]));
+            pimpl->rb_td_dirty[id] = false;
+        }
+    }
+}
