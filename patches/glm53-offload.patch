+// GGML_CUDA_OP_TIMING=1: device time per op (op, tensor name without its layer suffix, the weight type of a matmul), the top entries
+// printed every 65536 ops; GGML_CUDA_DISABLE_GRAPHS=1 is needed with it, ops inside a captured CUDA graph cannot be timed
+struct ggml_cuda_op_timing {
+    static constexpr int N = 8192;
+    cudaEvent_t start[N] = {};
+    cudaEvent_t end[N]   = {};
+    int         key[N]   = {};
+    int         head = 0;
+    int         tail = 0;
+    std::unordered_map<std::string, int> ids;
+    std::vector<std::string> names;
+    std::vector<double>      ms;
+    std::vector<int64_t>     n;
+    int64_t n_done = 0;
+};
+
+static ggml_cuda_op_timing g_cuda_op_timing[GGML_CUDA_MAX_DEVICES];
+
+static bool ggml_cuda_op_timing_enabled(void) {
+    static const bool enabled = getenv("GGML_CUDA_OP_TIMING") != nullptr && atoi(getenv("GGML_CUDA_OP_TIMING")) > 0;
+    return enabled;
+}
+
+static bool ggml_cuda_graphs_disabled_by_env(void) {
+    static const bool disabled = getenv("GGML_CUDA_DISABLE_GRAPHS") != nullptr && atoi(getenv("GGML_CUDA_DISABLE_GRAPHS")) > 0;
+    return disabled;
+}
