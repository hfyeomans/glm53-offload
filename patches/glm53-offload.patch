+// LLAMA_MTP_HEAD_IDS=<file> (0155): copy the head rows of the listed token ids (one a line) into a buffer of the head's own type
+void llama_model_base::load_tensors_mtp_head() {
+    const char * path = getenv("LLAMA_MTP_HEAD_IDS");
+    if (path == nullptr || *path == '\0' || output == nullptr || output->buffer == nullptr || !ggml_is_contiguous(output)) {
+        return;
+    }
+    std::vector<int64_t> ids;
+    if (FILE * f = fopen(path, "r")) {
+        long long v = 0;
+        while (fscanf(f, "%lld", &v) == 1) {
+            if (v >= 0 && v < output->ne[1]) {
+                ids.push_back((int64_t) v);
+            }
+        }
+        fclose(f);
+    }
+    std::sort(ids.begin(), ids.end());
+    ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+    if (ids.empty() || (int64_t) ids.size() >= output->ne[1]) {
+        LLAMA_LOG_WARN("%s: LLAMA_MTP_HEAD_IDS=%s: %zu usable ids, not used\n", __func__, path, ids.size());
+        return;
+    }
+    const int64_t K = (int64_t) ids.size();
+    ggml_init_params params = { ggml_tensor_overhead()*3, NULL, true };
+    ggml_context_ptr ctx { ggml_init(params) };
+    ggml_tensor * sub = ggml_new_tensor_2d(ctx.get(), output->type, output->ne[0], K);
+    ggml_set_name(sub, "mtp_head_sub");
+    ggml_tensor * idt = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I64, K);
+    ggml_set_name(idt, "mtp_head_ids");
+    ggml_backend_buffer_ptr buf { ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), ggml_backend_buffer_get_type(output->buffer)) };
+    if (!buf) {
+        LLAMA_LOG_WARN("%s: LLAMA_MTP_HEAD_IDS: could not allocate %lld rows beside the head, not used\n", __func__, (long long) K);
+        return;
+    }
+    ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    const size_t rs = output->nb[1];
+    std::vector<uint8_t> all(ggml_nbytes(output));
+    ggml_backend_tensor_get(output, all.data(), 0, all.size());
+    std::vector<uint8_t> rows((size_t) K * rs);
+    for (int64_t k = 0; k < K; ++k) {
+        memcpy(rows.data() + (size_t) k * rs, all.data() + (size_t) ids[k] * rs, rs);
+    }
+    ggml_backend_tensor_set(sub, rows.data(), 0, rows.size());
+    ggml_backend_tensor_set(idt, ids.data(), 0, (size_t) K * sizeof(int64_t));
+    mtp_head_sub = sub;
+    mtp_head_ids = idt;
+    LLAMA_LOG_INFO("%s: LLAMA_MTP_HEAD_IDS: the draft head scores %lld of %lld tokens (%.1f MiB beside the head, %s)\n", __func__,
+        (long long) K, (long long) output->ne[1], ggml_nbytes(sub)/1024.0/1024.0, ggml_backend_buffer_name(buf.get()));
+    std::vector<ggml_backend_buffer_ptr> buffers;
+    buffers.emplace_back(std::move(buf));
+    pimpl->ctxs_bufs.emplace_back(std::move(ctx), std::move(buffers));
+}
+
+// LLAMA_HEAD_SPLIT=1 (0174): the first half of the vocabulary head's rows on the other card of a two-card layer split
+void llama_model_base::load_tensors_head_split() {
+    const char * env = getenv("LLAMA_HEAD_SPLIT");
+    if (env == nullptr || atoi(env) == 0 || output == nullptr || output->buffer == nullptr || ggml_backend_buffer_is_host(output->buffer) ||
+            !ggml_is_contiguous(output) || output->ne[1] % 2 != 0 || output_s != nullptr) {
+        return;
+    }
+    std::vector<ggml_backend_dev_t> devs;
+    for (int il = 0; il < (int) hparams.n_layer(); ++il) {
+        ggml_backend_dev_t d = dev_layer(il);
+        if (ggml_backend_dev_type(d) == GGML_BACKEND_DEVICE_TYPE_GPU && std::find(devs.begin(), devs.end(), d) == devs.end()) {
+            devs.push_back(d);
+        }
+    }
+    ggml_backend_dev_t d_out = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(output->buffer));
+    if (devs.size() != 2 || (devs[0] != d_out && devs[1] != d_out)) {
+        LLAMA_LOG_WARN("%s: LLAMA_HEAD_SPLIT needs the layers on two GPUs, one of them the head's, not used\n", __func__);
+        return;
+    }
+    ggml_backend_dev_t d_x = devs[0] == d_out ? devs[1] : devs[0];
+    ggml_init_params params = { ggml_tensor_overhead()*2, NULL, true };
+    ggml_context_ptr ctx { ggml_init(params) };
+    ggml_tensor * t = ggml_new_tensor_2d(ctx.get(), output->type, output->ne[0], output->ne[1]/2);
+    ggml_set_name(t, "output.head_half");
+    ggml_backend_buffer_ptr buf { ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), ggml_backend_dev_buffer_type(d_x)) };
+    if (!buf) {
+        LLAMA_LOG_WARN("%s: LLAMA_HEAD_SPLIT: could not allocate %.1f MiB on %s, not used\n", __func__, ggml_nbytes(t)/1024.0/1024.0,
+            ggml_backend_dev_name(d_x));
+        return;
+    }
+    ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    std::vector<uint8_t> rows(ggml_nbytes(t));
+    ggml_backend_tensor_get(output, rows.data(), 0, rows.size());
+    ggml_backend_tensor_set(t, rows.data(), 0, rows.size());
+    head_half = t;
+    head_half_dev = d_x;
+    LLAMA_LOG_INFO("%s: LLAMA_HEAD_SPLIT: the head's first %lld of %lld rows on %s (%.1f MiB)\n", __func__, (long long) t->ne[1],
+        (long long) output->ne[1], ggml_backend_dev_name(d_x), ggml_nbytes(t)/1024.0/1024.0);
+    std::vector<ggml_backend_buffer_ptr> buffers;
+    buffers.emplace_back(std::move(buf));
+    pimpl->ctxs_bufs.emplace_back(std::move(ctx), std::move(buffers));
+}
+
+// LLAMA_MTP_HEAD_TYPE=<type> (0191): a requantized copy of the vocabulary head for the MTP draft graph only (fewer bytes a draft; the verify
+// keeps the model's head), on the head's card, and with 0174's split head its first half also on the other card
+void llama_model_base::load_tensors_mtp_head_q() {
+    const char * env = getenv("LLAMA_MTP_HEAD_TYPE");
+    if (env == nullptr || *env == 0 || hparams.n_layer_nextn == 0 || output == nullptr || output->buffer == nullptr ||
+            ggml_backend_buffer_is_host(output->buffer) || !ggml_is_contiguous(output) || output_s != nullptr) {
+        return;
+    }
+    ggml_type qt = GGML_TYPE_COUNT;
+    for (int t = 0; t < GGML_TYPE_COUNT; ++t) {
+        const char * name = ggml_type_name((ggml_type) t);
+        if (name != nullptr && strcmp(name, env) == 0 && ggml_blck_size((ggml_type) t) > 0) {
+            qt = (ggml_type) t;
+            break;
+        }
+    }
+    const auto * tr_src = ggml_get_type_traits(output->type);
+    const int64_t n_per_row = output->ne[0];
+    const int64_t nrows = output->ne[1];
+    if (qt == GGML_TYPE_COUNT || qt == output->type || ggml_quantize_requires_imatrix(qt) || tr_src->to_float == nullptr ||
+            n_per_row % ggml_blck_size(qt) != 0) {
+        LLAMA_LOG_WARN("%s: LLAMA_MTP_HEAD_TYPE=%s: not a type the head (%s) can be requantized to without an imatrix, not used\n", __func__,
+            env, ggml_type_name(output->type));
+        return;
+    }
+    const int64_t t0 = ggml_time_us();
+    std::vector<uint8_t> src(ggml_nbytes(output));
+    ggml_backend_tensor_get(output, src.data(), 0, src.size());
+    const size_t row_q = ggml_row_size(qt, n_per_row);
+    std::vector<uint8_t> dst(row_q * nrows);
+    const int n_thr = std::max(1, std::min(64, (int) std::thread::hardware_concurrency() / 2));
+    std::vector<std::thread> workers;
+    for (int w = 0; w < n_thr; ++w) {
+        workers.emplace_back([&, w]() {
+            const int64_t r0 = nrows * w / n_thr;
+            const int64_t r1 = nrows * (w + 1) / n_thr;
+            std::vector<float> f(n_per_row * 64);
+            for (int64_t r = r0; r < r1; r += 64) {
+                const int64_t nr = std::min<int64_t>(64, r1 - r);
+                for (int64_t k = 0; k < nr; ++k) {
+                    tr_src->to_float(src.data() + (r + k) * output->nb[1], f.data() + k * n_per_row, n_per_row);
+                }
+                ggml_quantize_chunk(qt, f.data(), dst.data() + r * row_q, 0, nr, n_per_row, nullptr);
+            }
+        });
+    }
+    for (auto & w : workers) {
+        w.join();
+    }
+    ggml_backend_dev_t d_out = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(output->buffer));
+    auto place = [&](ggml_backend_dev_t dev, int64_t n, const char * name) -> ggml_tensor * {
+        ggml_init_params params = { ggml_tensor_overhead()*2, NULL, true };
+        ggml_context_ptr ctx { ggml_init(params) };
+        ggml_tensor * t = ggml_new_tensor_2d(ctx.get(), qt, n_per_row, n);
+        ggml_set_name(t, name);
+        ggml_backend_buffer_ptr buf { ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), ggml_backend_dev_buffer_type(dev)) };
+        if (!buf) {
+            LLAMA_LOG_WARN("%s: LLAMA_MTP_HEAD_TYPE: could not allocate %.1f MiB on %s\n", __func__, ggml_nbytes(t)/1024.0/1024.0,
+                ggml_backend_dev_name(dev));
+            return nullptr;
+        }
+        ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        ggml_backend_tensor_set(t, dst.data(), 0, ggml_nbytes(t)); // the first n rows
+        std::vector<ggml_backend_buffer_ptr> buffers;
+        buffers.emplace_back(std::move(buf));
+        pimpl->ctxs_bufs.emplace_back(std::move(ctx), std::move(buffers));
+        return t;
+    };
+    ggml_tensor * full = place(d_out, nrows, "output.mtp_head_q");
+    if (full == nullptr) {
+        return;
+    }
+    ggml_tensor * half = nullptr;
+    if (head_half != nullptr) {
+        half = place(head_half_dev, head_half->ne[1], "output.mtp_head_q_half");
+        if (half == nullptr) {
+            return;
+        }
+    }
+    mtp_head_q = full;
+    mtp_head_q_half = half;
+    LLAMA_LOG_INFO("%s: LLAMA_MTP_HEAD_TYPE: the draft head as %s, %.1f MiB on %s%s%s (requantized from %s in %.1f s on %d threads)\n",
+        __func__, ggml_type_name(qt), ggml_nbytes(full)/1024.0/1024.0, ggml_backend_dev_name(d_out), half ? ", its first half on " : "",
+        half ? ggml_backend_dev_name(head_half_dev) : "", ggml_type_name(output->type), (ggml_time_us() - t0)/1e6, n_thr);
+}
+
+// LLAMA_TP_DECODE=1 (0165): the two-card head-split decode's weights on each layer's non-home card (docs/20261107-two-card-tp-decode-design.md)
+void llama_model_base::load_tensors_td() {
+    const char * env = getenv("LLAMA_TP_DECODE");
+    if (env == nullptr || atoi(env) == 0) {
+        return;
+    }
+    if (tp_devs.empty()) {
+        std::vector<ggml_backend_dev_t> devs;
+        for (int il = 0; il < (int) hparams.n_layer(); ++il) {
+            ggml_backend_dev_t d = dev_layer(il);
+            if (ggml_backend_dev_type(d) == GGML_BACKEND_DEVICE_TYPE_GPU && std::find(devs.begin(), devs.end(), d) == devs.end()) {
+                devs.push_back(d);
+            }
+        }
+        if (devs.size() == 2) {
+            tp_devs = devs;
+        }
+    }
+    if (tp_devs.size() != 2) {
+        LLAMA_LOG_WARN("%s: LLAMA_TP_DECODE needs the layers on exactly two GPUs, not used\n", __func__);
+        return;
+    }
+    struct item { ggml_tensor * w; int kind; int c; }; // kind -1: a full copy; 0 rows, 1 heads, 2 columns: the half of card c
+    std::vector<item> items;
+    bool ok = true;
+    for (int il = 0; il < (int) hparams.n_layer() && ok; ++il) {
+        const int o = 1 - tp_home(il);
+        const auto & L = layers[il];
+        auto add = [&](ggml_tensor * w, int kind) {
+            if (w == nullptr) {
+                return;
+            }
+            if (w->buffer == nullptr || ggml_backend_buffer_is_host(w->buffer) || !ggml_is_contiguous(w)) {
+                LLAMA_LOG_WARN("%s: LLAMA_TP_DECODE: %s is not a contiguous GPU weight, not used\n", __func__, ggml_get_name(w));
+                ok = false;
+                return;
+            }
+            const bool fits = kind < 0 || (kind == 0 && w->ne[1] % 2 == 0 && w->ne[2] == 1 && w->ne[3] == 1) ||
+                (kind == 1 && w->ne[2] % 2 == 0 && w->ne[3] == 1) ||
+                (kind == 2 && (w->ne[0]/2) % ggml_blck_size(w->type) == 0 && w->ne[0] % 2 == 0 && w->ne[2] == 1 && w->ne[3] == 1);
+            if (!fits) {
+                LLAMA_LOG_WARN("%s: LLAMA_TP_DECODE: %s does not split in halves, not used\n", __func__, ggml_get_name(w));
+                ok = false;
+                return;
+            }
+            items.push_back({ w, kind, o });
+        };
+        for (ggml_tensor * w : { L.attn_norm, L.wq_a, L.attn_q_a_norm, L.wkv_a_mqa, L.attn_kv_a_norm, L.ffn_norm, L.ffn_gate_inp, L.ffn_exp_probs_b }) {
+            add(w, -1);
+        }
+        // 0179 LLAMA_TD_LID_REP=1: a full-indexer layer's indexer weights on the other card too
+        static const bool td_lid_rep = getenv("LLAMA_TD_LID_REP") != nullptr && atoi(getenv("LLAMA_TD_LID_REP")) != 0;
+        if (td_lid_rep && hparams.is_indexer_full(il)) {
+            for (ggml_tensor * w : { L.indexer_attn_q_b, L.indexer_attn_k, L.indexer_k_norm, L.indexer_k_norm_b, L.indexer_proj }) {
+                add(w, -1);
+            }
+        }
+        add(L.wq_b, 0);
+        add(L.wk_b, 1);
+        add(L.wv_b, 1);
+        add(L.wo,   2);
+        if ((uint32_t) il < hparams.n_layer_dense_lead) {
+            add(L.ffn_gate, 0);
+            add(L.ffn_up,   0);
+            add(L.ffn_down, 2);
+        }
+    }
+    if (!ok || items.empty()) {
+        return;
+    }
+    ggml_context_ptr ctx[2];
+    size_t bytes[2] = { 0, 0 };
+    for (int c = 0; c < 2; ++c) {
+        ggml_init_params params = { ggml_tensor_overhead()*(items.size() + 1), NULL, true };
+        ctx[c].reset(ggml_init(params));
+        if (!ctx[c]) {
+            throw std::runtime_error("LLAMA_TP_DECODE: failed to create the context of the weight copies");
+        }
+    }
+    std::vector<ggml_tensor *> copies(items.size());
+    for (size_t i = 0; i < items.size(); ++i) {
+        const item & it = items[i];
+        int64_t ne[4] = { it.w->ne[0], it.w->ne[1], it.w->ne[2], it.w->ne[3] };
+        if (it.kind >= 0) {
+            ne[it.kind == 0 ? 1 : it.kind == 1 ? 2 : 0] /= 2;
+        }
+        copies[i] = ggml_new_tensor(ctx[it.c].get(), it.w->type, GGML_MAX_DIMS, ne);
+        ggml_format_name(copies[i], "%s.%s", it.kind < 0 ? "td" : "tdh", ggml_get_name(it.w));
+        bytes[it.c] += ggml_nbytes(copies[i]);
+    }
+    std::vector<ggml_backend_buffer_ptr> bufs(2);
+    for (int c = 0; c < 2; ++c) {
+        if (bytes[c] == 0) {
+            continue;
+        }
+        bufs[c].reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx[c].get(), ggml_backend_dev_buffer_type(tp_devs[c])));
+        if (!bufs[c]) {
+            throw std::runtime_error(format("LLAMA_TP_DECODE: unable to allocate %.1f MiB of weight copies on %s",
+                bytes[c]/1024.0/1024.0, ggml_backend_dev_name(tp_devs[c])));
+        }
+        ggml_backend_buffer_set_usage(bufs[c].get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    }
+    std::vector<uint8_t> src;
+    std::vector<uint8_t> dst;
+    for (size_t i = 0; i < items.size(); ++i) {
+        const item & it = items[i];
+        ggml_tensor * w = it.w;
+        ggml_tensor * t = copies[i];
+        src.resize(ggml_nbytes(w));
+        ggml_backend_tensor_get(w, src.data(), 0, src.size());
+        const uint8_t * p = src.data();
+        if (it.kind < 0) {
+            ggml_backend_tensor_set(t, p, 0, ggml_nbytes(t));
+            td_rep[w] = t;
+            continue;
+        }
+        if (it.kind == 0) {
+            p += (size_t) it.c*(w->ne[1]/2)*w->nb[1];
+            ggml_backend_tensor_set(t, p, 0, ggml_nbytes(t));
+        } else if (it.kind == 1) {
+            p += (size_t) it.c*(w->ne[2]/2)*w->nb[2];
+            ggml_backend_tensor_set(t, p, 0, ggml_nbytes(t));
+        } else {
+            const size_t rs = ggml_row_size(w->type, w->ne[0]/2);
+            dst.resize(rs*w->ne[1]);
+            for (int64_t r = 0; r < w->ne[1]; ++r) {
+                memcpy(dst.data() + r*rs, p + r*w->nb[1] + it.c*rs, rs);
+            }
+            ggml_backend_tensor_set(t, dst.data(), 0, dst.size());
+        }
+        td_half[w] = t;
+    }
+    for (int c = 0; c < 2; ++c) {
+        if (!bufs[c]) {
+            continue;
+        }
+        LLAMA_LOG_INFO("%s: LLAMA_TP_DECODE: %.1f MiB of weight copies on %s\n", __func__, bytes[c]/1024.0/1024.0, ggml_backend_dev_name(tp_devs[c]));
+        std::vector<ggml_backend_buffer_ptr> buffers;
+        buffers.emplace_back(std::move(bufs[c]));
+        pimpl->ctxs_bufs.emplace_back(std::move(ctx[c]), std::move(buffers));
+    }
+    td_ready = true;
+}
+
+ggml_tensor * llama_model::tp_w(ggml_tensor * w, int c) const {
+    if (w == nullptr || tp_devs.size() != 2 || w->buffer == nullptr || ggml_backend_buffer_is_host(w->buffer)) {
+        return w;
+    }
+    if (ggml_backend_buft_get_device(ggml_backend_buffer_get_type(w->buffer)) == tp_devs[c]) {
+        return w;
+    }
+    auto it = tp_shadow.find(w);
+    GGML_ASSERT(it != tp_shadow.end() && "LLAMA_TP_PROMPT: a GPU weight without a copy on the other card");
+    return it->second;
+}
+
+int llama_model::tp_home(int il) const {
+    if (tp_devs.size() != 2) {
+        return -1;
+    }
+    return dev_layer(il) == tp_devs[0] ? 0 : 1;
+}
+
+ggml_tensor * llama_model::td_w(ggml_tensor * w, int c) const {
+    if (w == nullptr || ggml_backend_buft_get_device(ggml_backend_buffer_get_type(w->buffer)) == tp_devs[c]) {
+        return w;
+    }
+    auto it = td_rep.find(w);
+    GGML_ASSERT(it != td_rep.end() && "LLAMA_TP_DECODE: a replicated weight without a copy on the other card");
+    return it->second;
+}
+
+ggml_tensor * llama_model::td_h(ggml_context * ctx, ggml_tensor * w, int c, int kind) const {
+    if (w == nullptr) {
+        return nullptr;
+    }
+    if (ggml_backend_buft_get_device(ggml_backend_buffer_get_type(w->buffer)) != tp_devs[c]) {
+        auto it = td_half.find(w);
+        GGML_ASSERT(it != td_half.end() && "LLAMA_TP_DECODE: a split weight without its half on the other card");
+        return it->second;
+    }
+    switch (kind) {
+        case 0:  return ggml_view_2d(ctx, w, w->ne[0], w->ne[1]/2, w->nb[1], (size_t) c*(w->ne[1]/2)*w->nb[1]);
+        case 1:  return ggml_view_3d(ctx, w, w->ne[0], w->ne[1], w->ne[2]/2, w->nb[1], w->nb[2], (size_t) c*(w->ne[2]/2)*w->nb[2]);
+        default: return ggml_view_2d(ctx, w, w->ne[0]/2, w->ne[1], w->nb[1], (size_t) c*ggml_row_size(w->type, w->ne[0]/2));
+    }
+}
