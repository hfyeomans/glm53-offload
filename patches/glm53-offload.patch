+                o = build_lora_mm(L.wo, o, L.wo_s);
+                outs.push_back(o);
+                ggml_build_forward_expand(gf, o);
+            }
+            ggml_tensor * attn = concat_rows(outs);
+            if (il == n_layer - 1 && crop_before_nextn(out_ids)) {
+                attn = ggml_get_rows(ctx0, attn, out_ids);
+                x_sa = ggml_get_rows(ctx0, x_sa, out_ids);
+            }
+            ggml_tensor * ffn_inp = ggml_add(ctx0, attn, x_sa);
+            ggml_tensor * h = build_norm(ffn_inp, L.ffn_norm, NULL, LLM_NORM_RMS, il);
