+ggml_backend_buffer_type_t ggml_backend_cuda_arena_buffer_type(ggml_backend_t backend) {
+    ggml_cuda_arena & a = g_cuda_arena[((ggml_backend_cuda_context *) backend->context)->device];
+    return a.va != 0 ? &a.buft : nullptr;
