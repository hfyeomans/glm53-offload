+        if (l.fill_ev_pending) {
+            // LLAMA_MOE_ASYNC_FILL_TOKENS: the hits of this layer read the slots filled at its last lookup
+            ggml_backend_event_wait(backend, l.fill_ev);
+            l.fill_ev_pending = false;
+        }
+
+        if (trace != nullptr) {
+            write_trace(il, it_cpu != cpu_parts.end() ? it_cpu->second.n_used : n_expert_used);
+        }
+
+        // part of the misses is computed on the CPU once the cache is full, the carry keeps the share right on average
+        const uint32_t share_q = has_cpu && g.slru.n_filled == g.slru.n_active ? cpu_share_q : 0;
+        auto n_cpu = [&](size_t n_miss) {
+            const uint64_t acc = (uint64_t) n_miss*share_q + l.cpu_acc;
+            l.cpu_acc = acc & 0xffff;
+            return (size_t) (acc >> 16);
+        };
+        size_t n_hit = 0;
+        if (!g.slru.plan(il, ids.data(), ids.size(), has_cpu ? it_cpu->second.n_used : 1, n_zero, n_cpu, rng, fills, cpu, n_hit)) {
+            GGML_ABORT("the MoE cache is too small for the experts selected in layer %d", il);
+        }
+        for (const auto * fs : { &fills, &cpu }) {
+            for (const auto & f : *fs) {
+                GGML_ASSERT(f.expert < l.n_host); // a miss is read from host memory
+            }
+        }
+        if (has_cpu) {
+            int32_t * cpu_map = (int32_t *) l.cpu_map->data;
+            for (int32_t e : l.cpu_experts) {
+                cpu_map[e] = -1;
+            }
+            l.cpu_experts.clear();
+            for (const auto & f : cpu) {
+                cpu_map[f.expert] = f.expert;
+                l.cpu_experts.push_back(f.expert);
+            }
+        }
+
+        // LLAMA_MOE_ASYNC_FILL (one token, a CPU part): the misses that enter the cache are computed on the CPU this token, their device
+        // slot reads zeros, and their uploads go on the side stream; the slots are published at the next lookup of the layer
+        bool async_fill = false;
+#ifdef GGML_USE_CUDA
+        {
+            // one token, or with LLAMA_MOE_ASYNC_FILL_TOKENS up to that many (the MTP verify)
+            const size_t n_tok_af = has_cpu ? ids.size() / (size_t) it_cpu->second.n_used : 0;
+            async_fill = async_fill_enabled() && has_cpu && !fills.empty() && ggml_backend_is_cuda(backend) &&
+                (ids.size() == (size_t) n_expert_used || (async_fill_tokens() > 0 && n_tok_af <= (size_t) async_fill_tokens()));
+        }
+        if (async_fill_enabled() && !async_fill && !fills.empty() && ggml_backend_is_cuda(backend)) {
+            // a main-stream fill must not race an older side upload into the same slot
+            ggml_backend_cuda_side_upload_wait(backend);
+        }
+#endif
+        // a fill computed on the CPU reads a zero slot that no token of the batch uses twice (the planner's rule for its CPU misses);
+        // one that finds none left is uploaded on the main stream and computed on the device
+        fill_async.assign(fills.size(), 0);
+        size_t n_async = 0;
+        if (async_fill) {
+            int32_t * cpu_map = (int32_t *) l.cpu_map->data;
+            int32_t * slots_af = g.slru.slot_map[il];
+            const int32_t n_used_af = it_cpu->second.n_used;
+            const size_t  n_tok_af  = ids.size() / (size_t) n_used_af;
+            std::vector<uint64_t> & tz = g.slru.token_zero;
+            if (cpu.empty() || tz.size() != n_tok_af) {
+                tz.assign(n_tok_af, 0); // left from an earlier batch: the planner sets them only for its CPU misses
+            }
+            for (size_t i = 0; i < fills.size(); ++i) {
+                const int32_t e = fills[i].expert;
+                uint64_t used = 0;
+                for (size_t it = 0; it < n_tok_af; ++it) {
+                    for (int32_t k = 0; k < n_used_af; ++k) {
+                        if (ids[it*n_used_af + k] == e) {
+                            used |= tz[it];
+                        }
+                    }
+                }
+                int32_t z = 0;
+                while (z < n_zero && (used >> z & 1)) {
+                    z++;
+                }
+                if (z >= n_zero) {
+                    continue;
+                }
+                for (size_t it = 0; it < n_tok_af; ++it) {
+                    for (int32_t k = 0; k < n_used_af; ++k) {
+                        if (ids[it*n_used_af + k] == e) {
+                            tz[it] |= 1ull << z;
+                        }
+                    }
+                }
+                fill_async[i] = 1;
+                n_async++;
+                slots_af[e] = g.slru.n_slots + z;
+                cpu_map[e] = e;
+                l.cpu_experts.push_back(e);
+                l.pending_fills.push_back({ e, fills[i].slot });
+            }
+            win_async += n_async;
+#ifdef GGML_USE_CUDA
+            if (n_async < fills.size()) {
+                // a main-stream fill must not race an older side upload into the same slot
+                ggml_backend_cuda_side_upload_wait(backend);
+            }
+#endif
+        }
+
+        // upload the missing experts, consecutive experts going to consecutive slots are uploaded together
+        size_t bytes = 0;
+        for (size_t ip = 0; ip < l.experts.size(); ++ip) {
+            const ggml_tensor * w    = l.experts[ip];
+            ggml_tensor       * bank = g.banks[ip];
+            const size_t expert_size = w->nb[2];
+            for (size_t i = 0; i < fills.size();) {
+                size_t n = 1;
+                while (i + n < fills.size() && fill_async[i + n] == fill_async[i] && fills[i + n].expert == fills[i].expert + (int32_t) n && fills[i + n].slot == fills[i].slot + (int32_t) n) {
+                    n++;
+                }
+#ifdef GGML_USE_CUDA
+                if (fill_async[i]) {
+                    ggml_backend_cuda_side_upload_async(backend, (uint8_t *) bank->data + fills[i].slot*expert_size,
+                        (const uint8_t *) w->data + fills[i].expert*expert_size, n*expert_size);
+                } else
+#endif
+                {
+                    ggml_backend_tensor_set_async(backend, bank, (const uint8_t *) w->data + fills[i].expert*expert_size, fills[i].slot*expert_size, n*expert_size);
+                }
+                bytes += n*expert_size;
+                i += n;
+            }
+        }
+
+#ifdef GGML_USE_CUDA
+        if (n_async > 0 && async_fill_tokens() > 0) {
+            if (l.fill_ev == nullptr) {
+                l.fill_ev = ggml_backend_event_new(ggml_backend_get_device(backend));
+                GGML_ASSERT(l.fill_ev != nullptr);
+            }
+            ggml_backend_cuda_side_upload_record(backend, l.fill_ev);
+            l.fill_ev_pending = true;
+        }
+#endif
+
+        // LLAMA_MOE_ROUTE_BIAS: the selection bias of this layer for the next token, d for the cached experts (the pending fills included)
+        if (l.route_bias != nullptr) {
+            const float d = route_bias_value();
+            const int32_t * slots_rb = g.slru.slot_map[il];
+            for (int32_t e = 0; e < g.slru.n_expert; ++e) {
+                l.route_bias_host[e] = (l.route_epb.empty() ? 0.0f : l.route_epb[e]) + (slots_rb[e] < g.slru.n_slots ? d : 0.0f);
+            }
+            for (const auto & pf : l.pending_fills) {
+                l.route_bias_host[pf.first] = (l.route_epb.empty() ? 0.0f : l.route_epb[pf.first]) + d;
+            }
+            if (l.route_bias_host != l.route_bias_last) {
+                stage_set(backend, l.route_bias, l.route_bias_host.data(), ggml_nbytes(l.route_bias)); // 0148
+                if (l.route_bias_td != nullptr) {
+                    // 0170: into the mirror; td_flush uploads it before the next graph (an upload to the other card here could wait for it
+                    // while its pair all-reduce waits for this card)
+                    const int32_t id_td = groups[l.ig_xd].id;
+                    std::copy(l.route_bias_host.begin(), l.route_bias_host.end(), rb_td_host[id_td].begin() + (size_t) l.td_row*l.route_bias_host.size());
+                    rb_td_dirty[id_td] = true;
+                }
+                l.route_bias_last = l.route_bias_host;
+            }
+        }
+
+        if (pred_pending && ids.size() == (size_t) n_expert_used) {
+            prefetch(il + 1, backend);
+        }
+        pred_pending = false;
+        stats & st = ids.size() <= (size_t) 8*n_expert_used ? stats_small : stats_large;
+        st.hits   += n_hit;
+        st.misses += fills.size() + cpu.size();
+        st.cpu    += cpu.size() + n_async;
+        st.bytes  += bytes;
+
+        if (log_every > 0 && ids.size() <= (size_t) 8*n_expert_used) {
+            win.hits   += n_hit;
+            win.misses += fills.size() + cpu.size();
+            win.cpu    += cpu.size() + n_async;
+            win.bytes  += bytes;
+            if (il_first < 0 || il < il_first) {
+                il_first = il;
+            }
+            if (il == il_first && ++win_tokens >= (size_t) log_every) {
+                win_total += win_tokens;
+                const size_t n = win.hits + win.misses;
+                LLAMA_LOG_INFO("llama_moe_cache: window: tokens %zu-%zu: hit rate = %.2f%% (%zu hits, %zu misses, %zu on the CPU), uploaded = %.1f MiB, prefetched = %zu (%.1f MiB)\n",
+                    win_total - win_tokens, win_total, n > 0 ? 100.0*win.hits/n : 0.0, win.hits, win.misses, win.cpu, win.bytes/1024.0/1024.0,
+                    win_pf_n, win_pf_bytes/1024.0/1024.0);
+                win_tokens = 0;
+                win = stats();
+                win_pf_n = 0;
+                win_pf_bytes = 0;
+            }
+        }
+
+#ifdef GGML_USE_CUDA
+        // the hits of this layer wait for the side uploads issued for it (the prefetch of the previous layer, the asynchronous fills of
+        // the last token published above)
+        if ((prefetch_enabled() || (async_fill_enabled() && async_fill_tokens() == 0)) && ggml_backend_is_cuda(backend)) {
+            ggml_backend_cuda_side_upload_wait(backend);
+        }
+#endif
+        // the next copy synchronizes the backend before it changes the slot map again
+        ggml_backend_tensor_set_async(backend, dst, src->data, 0, ggml_nbytes(src));
+
+        return true;
+    }
+
+    int32_t layer_of_weight(const ggml_tensor * w) const {
+        const auto it = bindings.find(w);
+        return it != bindings.end() ? it->second.il : -1;
+    }
+
+    void count_ids(layer & l, const int32_t * data, int64_t ne0, int64_t ne1, size_t nb0, size_t nb1) {
+        const int32_t n_expert = groups[l.ig].ref[0]->ne[2];
+        if (l.hist.empty()) {
+            l.hist.assign(n_expert, 0);
+        }
+        for (int64_t i1 = 0; i1 < ne1; ++i1) {
+            for (int64_t i0 = 0; i0 < ne0; ++i0) {
+                const int32_t id = data[i1*nb1/sizeof(int32_t) + i0*nb0/sizeof(int32_t)];
+                if (id >= 0 && id < n_expert) {
+                    l.hist[id]++;
+                }
+            }
+        }
+    }
+
+    void note_prompt_ids(int32_t il, const int32_t * data, int64_t ne0, int64_t ne1, size_t nb0, size_t nb1) {
+        if (admit_k <= 0 || il < 0 || il >= (int32_t) layers.size() || layers[il].ig < 0) {
+            return;
+        }
+        count_ids(layers[il], data, ne0, ne1, nb0, nb1);
+        prompt_pending = true;
+    }
+
+    // count the ids read asynchronously, after the devices are done with the graphs that produced them
+    void flush_pending() {
+        if (pending.empty()) {
+            return;
+        }
+        for (device & d : devices) {
+            if (d.buf) {
+                ggml_backend_synchronize(d.backend);
+            }
+        }
+        for (const pending_ids & p : pending) {
+            ggml_backend_synchronize(p.backend);
+        }
+        const int32_t * base = (const int32_t *) ggml_backend_buffer_get_base(pending_buf.get());
+        for (const pending_ids & p : pending) {
+            count_ids(layers[p.il], base + p.pos, p.ne0, p.ne1, p.nb0, p.nb1);
+        }
+        pending.clear();
+        pending_pos = 0;
+    }
+
+    void note_prompt_ids_async(ggml_backend_t backend, int32_t il, const ggml_tensor * ids) {
+        if (admit_k <= 0 || il < 0 || il >= (int32_t) layers.size() || layers[il].ig < 0) {
+            return;
+        }
+        const size_t n = (ggml_nbytes(ids) + sizeof(int32_t) - 1)/sizeof(int32_t);
+        if (!pending_buf) {
+            pending_cap = (size_t) 256*1024*1024/sizeof(int32_t);
+            ggml_backend_buffer_type_t buft = ggml_backend_dev_host_buffer_type(ggml_backend_get_device(backend));
+            pending_buf.reset(ggml_backend_buft_alloc_buffer(buft ? buft : ggml_backend_cpu_buffer_type(), pending_cap*sizeof(int32_t)));
+            GGML_ASSERT(pending_buf);
+        }
+        if (n > pending_cap) {
+            return;
+        }
+        if (pending_pos + n > pending_cap) {
+            flush_pending(); // the ring wraps: synchronize and count what is in it
+        }
+        int32_t * base = (int32_t *) ggml_backend_buffer_get_base(pending_buf.get());
+        ggml_backend_tensor_get_async(backend, ids, base + pending_pos, 0, ggml_nbytes(ids));
+        pending.push_back({ il, backend, pending_pos, ids->ne[0], ids->ne[1], ids->nb[0], ids->nb[1] });
+        pending_pos += GGML_PAD(n, 16);
+        prompt_pending = true;
+    }
+
+    // the first small batch after a prompt: load the top experts of each layer selected during the prompt
+    void admit() {
+        prompt_pending = false;
+        flush_pending();
+        // 0084 LLAMA_MOE_ROUTE_HIST: the prompt's selections per expert and layer, "c" for a cached expert
+        if (const char * path = getenv("LLAMA_MOE_ROUTE_HIST"); path != nullptr && *path != '\0') {
+            if (FILE * f = fopen(path, "a")) {
+                for (size_t il = 0; il < layers.size(); ++il) {
+                    const layer & l = layers[il];
+                    if (l.ig < 0 || l.hist.empty()) {
+                        continue;
+                    }
+                    const group & g = groups[l.ig];
+                    fprintf(f, "%zu", il);
+                    for (size_t e = 0; e < l.hist.size(); ++e) {
+                        fprintf(f, " %u%s", l.hist[e], g.slru.slot_map[il][e] < g.slru.n_slots ? "c" : "");
+                    }
+                    fprintf(f, "\n");
+                }
+                fprintf(f, "end\n");
+                fclose(f);
+            }
+        }
+        const int64_t t0 = ggml_time_us();
+        size_t n_layers = 0;
+        size_t n_up     = 0;
+        size_t bytes    = 0;
+        std::vector<int32_t> top;
+        for (size_t il = 0; il < layers.size(); ++il) {
+            layer & l = layers[il];
+            if (l.ig < 0 || l.hist.empty()) {
+                continue;
+            }
+            group & g = groups[l.ig];
+            top.clear();
+            for (int32_t e = 0; e < (int32_t) l.hist.size(); ++e) {
+                if (l.hist[e] > 0) {
+                    top.push_back(e);
+                }
+            }
+            const size_t k = std::min<size_t>(std::min<size_t>((size_t) admit_k, top.size()), (size_t) g.n_slots);
+            std::partial_sort(top.begin(), top.begin() + k, top.end(), [&](int32_t a, int32_t b) { return l.hist[a] > l.hist[b]; });
+            top.resize(k);
+            std::fill(l.hist.begin(), l.hist.end(), 0);
+            if (k == 0) {
+                continue;
+            }
+            size_t n_hit = 0;
+            if (!g.slru.plan(il, top.data(), top.size(), 1, 0, [](size_t) { return (size_t) 0; }, rng, fills, cpu, n_hit)) {
+                continue;
+            }
+            ggml_backend_t backend = devices[g.id].backend;
+            for (size_t ip = 0; ip < l.experts.size(); ++ip) {
+                const ggml_tensor * w    = l.experts[ip];
+                ggml_tensor       * bank = g.banks[ip];
+                const size_t expert_size = w->nb[2];
+                for (size_t i = 0; i < fills.size();) {
+                    size_t n = 1;
+                    while (i + n < fills.size() && fills[i + n].expert == fills[i].expert + (int32_t) n && fills[i + n].slot == fills[i].slot + (int32_t) n) {
+                        n++;
+                    }
+                    ggml_backend_tensor_set_async(backend, bank, (const uint8_t *) w->data + fills[i].expert*expert_size, fills[i].slot*expert_size, n*expert_size);
+                    bytes += n*expert_size;
+                    i += n;
+                }
+            }
+            n_layers++;
+            n_up += fills.size();
+        }
+        for (device & d : devices) {
+            if (d.buf) {
+                ggml_backend_synchronize(d.backend);
+            }
+        }
+        const double ms = (ggml_time_us() - t0)/1000.0;
+        stats_admit.prompts++;
+        stats_admit.layers   += n_layers;
+        stats_admit.uploaded += n_up;
+        stats_admit.bytes    += bytes;
+        stats_admit.ms       += ms;
+        LLAMA_LOG_INFO("llama_moe_cache: admitted the prompt's top %d experts of %zu layers: %zu uploaded, %.1f MiB, %.1f ms\n",
+            admit_k, n_layers, n_up, bytes/1024.0/1024.0, ms);
+    }
+
+    void log_stats() const {
+        auto log = [](const char * name, const stats & st) {
+            const size_t n = st.hits + st.misses;
+            if (n == 0) {
+                return;
+            }
+            LLAMA_LOG_INFO("llama_moe_cache: %s: hits = %zu, misses = %zu (%zu on the CPU), hit rate = %.2f%%, uploaded = %.2f MiB\n",
+                name, st.hits, st.misses, st.cpu, 100.0*st.hits/n, st.bytes/1024.0/1024.0);
+        };
+        log("ubatch <= 8", stats_small);
+        log("ubatch  > 8", stats_large);
+        if (stats_copy.hits > 0) {
+            LLAMA_LOG_INFO("llama_moe_cache: large batches: %zu experts copied from the cache, %.2f MiB\n", stats_copy.hits, stats_copy.bytes/1024.0/1024.0);
+        }
+        if (stats_admit.prompts > 0) {
+            LLAMA_LOG_INFO("llama_moe_cache: admission: %zu prompts, %zu layers, %zu experts uploaded, %.2f MiB, %.1f ms\n",
+                stats_admit.prompts, stats_admit.layers, stats_admit.uploaded, stats_admit.bytes/1024.0/1024.0, stats_admit.ms);
+        }
+    }
+};
