+    // account the completed splits
+    while (t.tail != t.head) {
+        if (cudaEventQuery(t.end[t.tail]) != cudaSuccess) {
+            (void) cudaGetLastError();
+            break;
+        }
+        float ms = 0.0f;
+        CUDA_CHECK(cudaEventElapsedTime(&ms, t.start[t.tail], t.end[t.tail]));
+        t.busy_ms += ms;
+        t.busy_k_ms[t.kind[t.tail]] += ms;
+        t.n_k[t.kind[t.tail]] += 1;
+        if (t.prev >= 0) {
+            CUDA_CHECK(cudaEventElapsedTime(&ms, t.end[t.prev], t.start[t.tail]));
+            t.gap_ms += ms;
+            t.gap_k_ms[t.kind[t.tail]] += ms;
