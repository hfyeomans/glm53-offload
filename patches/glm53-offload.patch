+bool ggml_backend_cuda_upload_ring_prefetch(ggml_backend_t backend, void * const * dsts, const void * const * srcs, const size_t * sizes, size_t n) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(cuda_ctx->device);
+    ggml_cuda_upload_ring & r = g_cuda_upload_ring[cuda_ctx->device];
+    if (r.stream == nullptr || r.k < 0) {
+        return false;
+    }
+    if (n == 0) {
+        return true;
+    }
+#if CUDART_VERSION >= 12080
+    cudaMemcpyAttributes attr = {};
+    attr.srcAccessOrder = cudaMemcpySrcAccessOrderStream;
+    size_t attr_idx = 0;
