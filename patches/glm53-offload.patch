+ggml_backend_buffer_type_t llama_moe_cache::borrow_buft(ggml_backend_t backend) const {
+#ifdef GGML_USE_CUDA
+    for (const auto & d : pimpl->devices) {
+        if (d.backend == backend && d.borrow_bytes > 0) {
+            return ggml_backend_cuda_arena_buffer_type(backend);
+        }
+    }
+#endif
+    GGML_UNUSED(backend);
+    return nullptr;
+}
+
+void llama_moe_cache::borrow_update(ggml_backend_sched_t sched, int64_t n_tokens) {
+#ifdef GGML_USE_CUDA
+    impl & p = *pimpl;
+    // 0141: lent chunks whose pages the KV cache has given back return to the banks, the most recently lent first
+    for (auto & g : p.groups) {
+        auto & d = p.devices[g.id];
+        while (g.n_lent > 0) {
+            const int32_t j = g.n_lend - g.n_lent;
+            if (!ggml_backend_cuda_lend_take(d.backend, j)) {
+                break;
+            }
+            g.n_lent--;
+            g.n_top = g.lend_s0 + (j + 1)*g.lend_c;
+            if (d.borrow_bytes == 0 || d.borrow_on) {
+                g.slru.n_active = g.n_top;
+            }
+            if (d.lend_n++ < 4 || d.lend_n % 64 == 0) {
+                LLAMA_LOG_INFO("llama_moe_cache: 0141 %s: chunk %d back in the cache (%d of %d lent)\n", ggml_backend_name(d.backend), j, g.n_lent, g.n_lend);
+            }
+        }
+    }
+    for (size_t id = 0; id < p.devices.size(); ++id) {
+        auto & d = p.devices[id];
+        if (d.borrow_bytes == 0) {
+            continue;
+        }
+        // LLAMA_MOE_CACHE_BORROW_RING=1: the ring (any graph of more than max_batch tokens) uses the arena too
+        static const bool ring = getenv("LLAMA_MOE_CACHE_BORROW_RING") != nullptr && atoi(getenv("LLAMA_MOE_CACHE_BORROW_RING")) != 0;
+        const size_t peak = ggml_backend_sched_get_peak(sched, d.backend);
+        const bool   want = (!ring || n_tokens <= impl::max_batch) && peak <= d.borrow_head;
+        if (peak != SIZE_MAX && peak > d.borrow_peak && d.borrow_logs < 8) {
+            d.borrow_peak = peak;
+            d.borrow_logs++;
+            LLAMA_LOG_INFO("llama_moe_cache: 0139 %s: new largest graph peak %.1f MiB (%lld tokens, head %.0f MiB)\n", ggml_backend_name(d.backend),
+                peak/1024.0/1024.0, (long long) n_tokens, d.borrow_head/1024.0/1024.0);
+        }
+        // 0202: the peak of a short graph grows with the context
+        if (peak != SIZE_MAX && n_tokens <= impl::max_batch) {
+            if (peak > d.short_peak + 64*1024*1024) {
+                d.short_peak = peak;
+                LLAMA_LOG_INFO("llama_moe_cache: 0202 %s: largest short graph so far %.1f MiB (%lld tokens, head %.0f MiB)\n", ggml_backend_name(d.backend),
+                    peak/1024.0/1024.0, (long long) n_tokens, d.borrow_head/1024.0/1024.0);
+            }
+            if (!want && !d.head_warned) {
+                d.head_warned = true;
+                LLAMA_LOG_WARN("llama_moe_cache: 0202 %s: a graph of %lld tokens needs %.1f MiB, past the head of %.0f MiB: the cache falls to its own slots while such graphs run; raise LLAMA_MOE_CACHE_BORROW_HEAD_MIB\n",
+                    ggml_backend_name(d.backend), (long long) n_tokens, peak/1024.0/1024.0, d.borrow_head/1024.0/1024.0);
+            }
+        }
+        if (want == d.borrow_on) {
+            continue;
+        }
+        // nothing may still read or write the borrowed slots (the hits, the side fills) or the memory the graph puts there (the ring)
+        ggml_backend_cuda_synchronize_device(d.backend);
+        int32_t n_given = 0;
+        for (auto & g : p.groups) {
+            if (g.id != (int32_t) id || g.n_base == g.n_slots) {
+                continue;
+            }
+            if (want) {
+                g.slru.n_active = g.n_top;
+            } else {
+                n_given += g.slru.give_up(g.n_base);
+            }
+        }
+        d.borrow_on = want;
+        if (d.borrow_n++ < 4 || d.borrow_n % 64 == 0) {
+            size_t head, compute, ring_lo, ring_hi, mapped;
+            ggml_backend_cuda_arena_info(d.backend, &head, &compute, &ring_lo, &ring_hi, &mapped);
+            LLAMA_LOG_INFO("llama_moe_cache: 0138 %s: borrowed slots %s (transition %u): %lld tokens, graph peak %.1f MiB, head %.0f, compute %.1f, "
+                "ring %.1f-%.1f, mapped %.1f MiB, %d experts emptied\n", ggml_backend_name(d.backend), want ? "back in use" : "given up", d.borrow_n,
+                (long long) n_tokens, peak == SIZE_MAX ? -1.0 : peak/1024.0/1024.0, head/1024.0/1024.0, compute/1024.0/1024.0,
+                ring_lo/1024.0/1024.0, ring_hi/1024.0/1024.0, mapped/1024.0/1024.0, n_given);
+        }
+    }
+#else
+    GGML_UNUSED(sched);
+    GGML_UNUSED(n_tokens);
+#endif
+}
