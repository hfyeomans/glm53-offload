+    if (p.p2p) {
+        pair_ar_kernel_p2p<<<PAIR_AR_BLOCKS, PAIR_AR_THREADS, 0, ctx.stream()>>>(
+            (const float *) src->data, (float *) dst->data, p.recv[1 - rank], p.recv[rank], (int) n,
+            p.tok[1 - rank], p.tok[rank], p.ctr[rank], p.slot_elems, vec, p.err_dev, p.timeout_ns, res);
+        CUDA_CHECK(cudaGetLastError());
+        return;
+    }
+    pair_ar_kernel<<<PAIR_AR_BLOCKS, PAIR_AR_THREADS, 0, ctx.stream()>>>(
+        (const float *) src->data, (float *) dst->data, p.host[rank], p.host[1 - rank], (int) n,
+        p.arr[rank], p.arr[1 - rank], p.ctr[rank], p.slot_elems, vec, p.err_dev, p.timeout_ns, res);
+    CUDA_CHECK(cudaGetLastError());
+}
