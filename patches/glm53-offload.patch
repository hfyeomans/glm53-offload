+            for (const ggml_tensor * w : self->layers[self->pq_il].experts) {
+                const int64_t nr = w->ne[1];
+                const int64_t dr = (nr + nth - 1)/nth;
+                const int64_t r0 = std::min<int64_t>(dr*ith, nr), r1 = std::min<int64_t>(r0 + dr, nr);
+                for (const int32_t e : self->pq_pf) {
