@@ -0,0 +1,296 @@
+#include "pair-allreduce.cuh"
+
+#include <cstring>
+#include <mutex>
+
+// 0164 GGML_OP_PAIR_ALLREDUCE, adapted from allreduce.cu's chunked kernel (upstream's two-GPU tensor-parallel reduction over PCIe): each
+// device writes its partial into its own pinned host buffer, raises a token per block, waits for the peer's token and adds the peer's
+// partial: dst = mine + peer's, the same bits on both devices (one add, which commutes).  The call number lives in device memory (each
+// device counts its own calls, a call is one kernel whose last block advances the count), so the op is an ordinary graph node and its CUDA
+// graph replays.  The two devices run their calls in the same order, one kernel at a time on a stream, and a call is a barrier: when a
+// device starts call N, its peer has finished call N-2, so PAIR_AR_POOL >= 2 slots are never overwritten while read.
+
+#define PAIR_AR_BLOCKS  8
+#define PAIR_AR_THREADS 256
+#define PAIR_AR_POOL    4
+#define PAIR_AR_STRIDE  16 // ints between two blocks' tokens (64 bytes, one line each)
+
+struct ggml_cuda_pair_ar {
+    bool    ready = false;
+    int     dev[2] = { -1, -1 };
+    size_t  slot_elems = 0;                          // floats a slot
+    float * host[2] = { nullptr, nullptr };          // rank r's staging: PAIR_AR_POOL slots (mapped pinned host memory)
+    int   * arr[2]  = { nullptr, nullptr };          // rank r's tokens: [PAIR_AR_POOL][PAIR_AR_BLOCKS][PAIR_AR_STRIDE]
+    int   * ctr[2]  = { nullptr, nullptr };          // on device r: { calls, blocks done in the current call }
+    int   * err_host = nullptr;                      // 0170: set by a kernel that gave up waiting (mapped host memory)
+    bool    p2p = false;                             // 0175 GGML_CUDA_PAIR_AR_P2P=1: the exchange through the peer's memory
+    float * recv[2] = { nullptr, nullptr };          // 0175: on device r, the slots the peer writes its partial into
+    int   * tok[2]  = { nullptr, nullptr };          // 0175: on device r, the peer's tokens [PAIR_AR_POOL][PAIR_AR_BLOCKS][PAIR_AR_STRIDE]
+    int   * err_dev  = nullptr;
+    uint64_t timeout_ns = 0;
+};
+
+static ggml_cuda_pair_ar g_pair_ar;
+static std::mutex        g_pair_ar_mutex;
+
+bool ggml_cuda_pair_ar_init(int dev0, int dev1, size_t max_bytes) {
+    std::lock_guard<std::mutex> lock(g_pair_ar_mutex);
+    ggml_cuda_pair_ar & p = g_pair_ar;
+    if (p.ready) {
+        return p.dev[0] == dev0 && p.dev[1] == dev1 && p.slot_elems*sizeof(float) >= max_bytes;
+    }
+    if (dev0 == dev1) {
+        return false;
+    }
+    p.dev[0] = dev0;
+    p.dev[1] = dev1;
+    p.slot_elems = (max_bytes + 15)/16*4;
+    const size_t host_bytes = (size_t) PAIR_AR_POOL*p.slot_elems*sizeof(float);
+    const size_t arr_bytes  = (size_t) PAIR_AR_POOL*PAIR_AR_BLOCKS*PAIR_AR_STRIDE*sizeof(int);
+    for (int r = 0; r < 2; ++r) {
+        ggml_cuda_set_device(p.dev[r]);
+        void * h = nullptr;
+        void * a = nullptr;
+        CUDA_CHECK(cudaHostAlloc(&h, host_bytes, cudaHostAllocPortable | cudaHostAllocMapped));
+        CUDA_CHECK(cudaHostAlloc(&a, arr_bytes,  cudaHostAllocPortable | cudaHostAllocMapped));
+        memset(h, 0, host_bytes);
+        memset(a, 0, arr_bytes);
+        CUDA_CHECK(cudaHostGetDevicePointer((void **) &p.host[r], h, 0));
+        CUDA_CHECK(cudaHostGetDevicePointer((void **) &p.arr[r],  a, 0));
+        CUDA_CHECK(cudaMalloc((void **) &p.ctr[r], 2*sizeof(int)));
+        CUDA_CHECK(cudaMemset(p.ctr[r], 0, 2*sizeof(int)));
+        CUDA_CHECK(cudaDeviceSynchronize());
+    }
+    {
+        void * e = nullptr;
+        ggml_cuda_set_device(p.dev[0]);
+        CUDA_CHECK(cudaHostAlloc(&e, 64, cudaHostAllocPortable | cudaHostAllocMapped));
+        memset(e, 0, 64);
+        p.err_host = (int *) e;
+        CUDA_CHECK(cudaHostGetDevicePointer((void **) &p.err_dev, e, 0));
+        const char * t = getenv("GGML_CUDA_PAIR_AR_TIMEOUT_MS");
+        p.timeout_ns = (uint64_t) (t != nullptr ? atoll(t) : 10000)*1000000ull;
+    }
+    // 0175 GGML_CUDA_PAIR_AR_P2P=1: receive slots and tokens in each device's own memory, written by the peer
+    if (getenv("GGML_CUDA_PAIR_AR_P2P") != nullptr && atoi(getenv("GGML_CUDA_PAIR_AR_P2P")) != 0) {
+        int a01 = 0;
+        int a10 = 0;
+        CUDA_CHECK(cudaDeviceCanAccessPeer(&a01, p.dev[0], p.dev[1]));
+        CUDA_CHECK(cudaDeviceCanAccessPeer(&a10, p.dev[1], p.dev[0]));
+        if (a01 && a10) {
+            const size_t tok_bytes = (size_t) PAIR_AR_POOL*PAIR_AR_BLOCKS*PAIR_AR_STRIDE*sizeof(int);
+            for (int r = 0; r < 2; ++r) {
+                ggml_cuda_set_device(p.dev[r]);
+                const cudaError_t e = cudaDeviceEnablePeerAccess(p.dev[1 - r], 0);
+                if (e != cudaSuccess && e != cudaErrorPeerAccessAlreadyEnabled) {
+                    CUDA_CHECK(e);
+                }
+                (void) cudaGetLastError();
+                CUDA_CHECK(cudaMalloc((void **) &p.recv[r], (size_t) PAIR_AR_POOL*p.slot_elems*sizeof(float)));
+                CUDA_CHECK(cudaMalloc((void **) &p.tok[r], tok_bytes));
+                CUDA_CHECK(cudaMemset(p.tok[r], 0, tok_bytes));
+                CUDA_CHECK(cudaDeviceSynchronize());
+            }
+            p.p2p = true;
+        } else {
+            GGML_LOG_WARN("%s: 0175: no peer access between CUDA%d and CUDA%d, the exchange stays in host memory\n", __func__, dev0, dev1);
+        }
+    }
+    p.ready = true;
+    GGML_LOG_INFO("%s: 0164: pair all-reduce between CUDA%d and CUDA%d%s, up to %zu KiB a call, gives up after %llu ms\n", __func__, dev0, dev1,
+        p.p2p ? " (0175: through the peer's memory)" : "",
+        p.slot_elems*sizeof(float)/1024, (unsigned long long) (p.timeout_ns/1000000ull));
+    return true;
+}
+
+static __global__ void pair_ar_kernel(
+        const float * __restrict__ src, float * __restrict__ dst, float * __restrict__ host_mine, const float * __restrict__ host_other,
+        const int n, int * arr_mine, const int * arr_other, int * ctr, const size_t slot_elems, const bool vec,
+        int * err, const uint64_t timeout_ns, const float * __restrict__ res) {
+    __shared__ int s_call;
+    if (threadIdx.x == 0) {
+        s_call = *(volatile int *) ctr;
+    }
+    __syncthreads();
+    const int call  = s_call;
+    const int slot  = call % PAIR_AR_POOL;
+    const int token = call + 1;
+
+    float       * hm = host_mine  + (size_t) slot*slot_elems;
+    const float * ho = host_other + (size_t) slot*slot_elems;
+
+    const int gt = blockIdx.x*blockDim.x + threadIdx.x;
+    const int gn = gridDim.x*blockDim.x;
+    const int n4 = vec ? n/4 : 0;
+
+    // this block's stripe of my partial to host memory (the peer's same block reads it)
+    for (int i = gt; i < n4; i += gn) {
+        ((float4 *) hm)[i] = ((const float4 *) src)[i];
+    }
+    for (int i = 4*n4 + gt; i < n; i += gn) {
+        hm[i] = src[i];
+    }
+    __threadfence_system();
+    __syncthreads();
+
+    if (threadIdx.x == 0) {
+        volatile int       * am = arr_mine  + (slot*PAIR_AR_BLOCKS + blockIdx.x)*PAIR_AR_STRIDE;
+        const volatile int * ao = arr_other + (slot*PAIR_AR_BLOCKS + blockIdx.x)*PAIR_AR_STRIDE;
+        *am = token;
+        __threadfence_system();
+        uint64_t t0;
+        asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t0));
+        while (*ao != token) {
+#if __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
+            __nanosleep(32);
+#endif // __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
+            uint64_t t1;
+            asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t1));
+            if (timeout_ns > 0 && t1 - t0 > timeout_ns) {
+                *(volatile int *) err = 1; // 0170: give up; the host aborts at the next pair all-reduce
+                __threadfence_system();
+                break;
+            }
+        }
+    }
+    __syncthreads();
+    __threadfence_system();
+
+    // mine + the peer's, the peer's read past the caches
+    for (int i = gt; i < n4; i += gn) {
+        const float4 a = ((const float4 *) src)[i];
+        const float4 b = __ldcv((const float4 *) ho + i);
+        float4 s = make_float4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
+        if (res != nullptr) { // 0182: + the residual, after the pair's sum (the same order on both devices)
+            const float4 r = ((const float4 *) res)[i];
+            s = make_float4(s.x + r.x, s.y + r.y, s.z + r.z, s.w + r.w);
+        }
+        ((float4 *) dst)[i] = s;
+    }
+    for (int i = 4*n4 + gt; i < n; i += gn) {
+        const float s = src[i] + __ldcv(ho + i);
+        dst[i] = res != nullptr ? s + res[i] : s;
+    }
+
+    // the last block of the call advances the count (the next call on this stream starts after this kernel)
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        __threadfence();
+        if (atomicAdd(ctr + 1, 1) == (int) gridDim.x - 1) {
+            ctr[1] = 0;
+            *(volatile int *) ctr = call + 1;
+            __threadfence();
+        }
+    }
+}
+
+// 0175: the exchange through the peer's memory: my partial and then my token into the peer's slot, the peer's token polled in my memory
+static __global__ void pair_ar_kernel_p2p(
+        const float * __restrict__ src, float * __restrict__ dst, float * __restrict__ peer_recv, const float * __restrict__ my_recv,
+        const int n, int * peer_tok, const int * my_tok, int * ctr, const size_t slot_elems, const bool vec,
+        int * err, const uint64_t timeout_ns, const float * __restrict__ res) {
+    __shared__ int s_call;
+    if (threadIdx.x == 0) {
+        s_call = *(volatile int *) ctr;
+    }
+    __syncthreads();
+    const int call  = s_call;
+    const int slot  = call % PAIR_AR_POOL;
+    const int token = call + 1;
+
+    float       * pr = peer_recv + (size_t) slot*slot_elems;
+    const float * mr = my_recv   + (size_t) slot*slot_elems;
+
+    const int gt = blockIdx.x*blockDim.x + threadIdx.x;
+    const int gn = gridDim.x*blockDim.x;
+    const int n4 = vec ? n/4 : 0;
+
+    for (int i = gt; i < n4; i += gn) {
+        ((float4 *) pr)[i] = ((const float4 *) src)[i];
+    }
+    for (int i = 4*n4 + gt; i < n; i += gn) {
+        pr[i] = src[i];
+    }
+    __threadfence_system();
+    __syncthreads();
+
+    if (threadIdx.x == 0) {
+        volatile int       * pt = peer_tok + (slot*PAIR_AR_BLOCKS + blockIdx.x)*PAIR_AR_STRIDE;
+        const volatile int * mt = my_tok   + (slot*PAIR_AR_BLOCKS + blockIdx.x)*PAIR_AR_STRIDE;
+        *pt = token;
+        __threadfence_system();
+        uint64_t t0;
+        asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t0));
+        while (*mt != token) {
+            uint64_t t1;
+            asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t1));
+            if (timeout_ns > 0 && t1 - t0 > timeout_ns) {
+                *(volatile int *) err = 1;
+                __threadfence_system();
+                break;
+            }
+        }
+    }
+    __syncthreads();
+    __threadfence();
+
+    for (int i = gt; i < n4; i += gn) {
+        const float4 a = ((const float4 *) src)[i];
+        const float4 b = __ldcv((const float4 *) mr + i);
+        float4 s = make_float4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
+        if (res != nullptr) { // 0182
+            const float4 r = ((const float4 *) res)[i];
+            s = make_float4(s.x + r.x, s.y + r.y, s.z + r.z, s.w + r.w);
+        }
+        ((float4 *) dst)[i] = s;
+    }
+    for (int i = 4*n4 + gt; i < n; i += gn) {
+        const float s = src[i] + __ldcv(mr + i);
+        dst[i] = res != nullptr ? s + res[i] : s;
+    }
+
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        __threadfence();
+        if (atomicAdd(ctr + 1, 1) == (int) gridDim.x - 1) {
+            ctr[1] = 0;
+            *(volatile int *) ctr = call + 1;
+            __threadfence();
+        }
+    }
+}
+
+void ggml_cuda_op_pair_allreduce(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src = dst->src[0];
+    const int rank = ggml_get_op_params_i32(dst, 0);
+    ggml_cuda_pair_ar & p = g_pair_ar;
+
+    GGML_ASSERT(p.ready && "ggml_pair_allreduce: the pair was not set up (ggml_backend_cuda_pair_ar_init)");
+    GGML_ASSERT(rank == 0 || rank == 1);
+    GGML_ASSERT(p.dev[rank] == ctx.device);
+    GGML_ASSERT(src->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(src) && ggml_is_contiguous(dst));
+
+    const int64_t n = ggml_nelements(src);
+    GGML_ASSERT(n > 0 && (size_t) n <= p.slot_elems);
+    if (*(volatile int *) p.err_host != 0) {
+        GGML_ABORT("pair all-reduce: a call waited longer than GGML_CUDA_PAIR_AR_TIMEOUT_MS for its peer (the two devices' graphs disagree or the host blocked on one)");
+    }
+
+    // 0182: the residual (src[1]), when the add is folded in
+    const ggml_tensor * res_t = dst->src[1];
+    GGML_ASSERT(res_t == nullptr || (res_t->type == GGML_TYPE_F32 && ggml_is_contiguous(res_t) && ggml_nelements(res_t) == n));
