+// LLAMA_TP_PROMPT=1 (0059): copy every layer weight that lives on one of the two GPUs to the other one
+void llama_model_base::load_tensors_tp_shadow() {
+    const char * env = getenv("LLAMA_TP_PROMPT");
+    if (env == nullptr || atoi(env) == 0) {
+        return;
+    }
+    tp_devs.clear();
+    for (int il = 0; il < (int) hparams.n_layer(); ++il) {
+        ggml_backend_dev_t d = dev_layer(il);
+        if (ggml_backend_dev_type(d) == GGML_BACKEND_DEVICE_TYPE_GPU && std::find(tp_devs.begin(), tp_devs.end(), d) == tp_devs.end()) {
+            tp_devs.push_back(d);
+        }
+    }
+    if (tp_devs.size() != 2) {
+        LLAMA_LOG_WARN("%s: LLAMA_TP_PROMPT needs the layers on exactly two GPUs (found %zu), not used\n", __func__, tp_devs.size());
+        tp_devs.clear();
+        return;
+    }
+    struct target {
+        ggml_context_ptr ctx;
+        std::vector<std::pair<ggml_tensor *, ggml_tensor *>> pairs;
+        size_t bytes = 0;
+    } tg[2];
+    for (auto & t : tg) {
+        ggml_init_params params = {
+            /*.mem_size   =*/ ggml_tensor_overhead()*(tensors_by_name.size() + 1),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        t.ctx.reset(ggml_init(params));
+        if (!t.ctx) {
+            throw std::runtime_error("LLAMA_TP_PROMPT: failed to create the context of the weight copies");
+        }
+    }
+    for (const auto & [name, w] : tensors_by_name) {
+        int il = -1;
+        if (sscanf(name.c_str(), "blk.%d.", &il) != 1 || il < 0 || il >= (int) hparams.n_layer() ||
+                w->buffer == nullptr || ggml_backend_buffer_is_host(w->buffer)) {
+            continue;
+        }
+        ggml_backend_dev_t home = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(w->buffer));
+        const int c_home = home == tp_devs[0] ? 0 : home == tp_devs[1] ? 1 : -1;
+        if (c_home < 0) {
+            continue;
+        }
+        auto & t = tg[1 - c_home];
+        ggml_tensor * s = ggml_dup_tensor(t.ctx.get(), w);
+        ggml_format_name(s, "tp.%s", name.c_str());
+        t.pairs.emplace_back(w, s);
+        t.bytes += ggml_nbytes(w);
+    }
+    for (int c = 0; c < 2; ++c) {
+        auto & t = tg[c];
+        if (t.pairs.empty()) {
+            continue;
+        }
+        // 0064 LLAMA_TP_SHADOW_HOST=1: the copies in pinned host memory, uploaded with each prompt graph, so the MoE cache keeps the GPU memory
+        static const bool shadow_host = getenv("LLAMA_TP_SHADOW_HOST") != nullptr && atoi(getenv("LLAMA_TP_SHADOW_HOST")) != 0;
+        ggml_backend_buffer_type_t buft = ggml_backend_dev_buffer_type(tp_devs[c]);
+        if (shadow_host) {
+            buft = ggml_backend_dev_host_buffer_type(tp_devs[c]);
+            if (buft == nullptr) {
+                buft = ggml_backend_cpu_buffer_type();
+            }
+        }
+        ggml_backend_buffer_ptr buf { ggml_backend_alloc_ctx_tensors_from_buft(t.ctx.get(), buft) };
+        if (!buf) {
+            throw std::runtime_error(format("LLAMA_TP_PROMPT: unable to allocate %.1f MiB of weight copies on %s",
+                t.bytes/1024.0/1024.0, ggml_backend_dev_name(tp_devs[c])));
+        }
+        ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        const bool in_host = ggml_backend_buffer_is_host(buf.get());
+        std::map<int, size_t> layer_bytes;
+        for (auto & [w, s] : t.pairs) {
+            ggml_backend_tensor_copy(w, s);
+            tp_shadow[w] = s;
+            // 0078: the layer of a host-memory copy (the weight ring uploads a card's copies a layer at a time)
+            int sil = -1;
+            if (in_host && sscanf(ggml_get_name(s), "tp.blk.%d.", &sil) == 1) {
+                tp_shadow_il[s] = sil;
+                layer_bytes[sil] += GGML_PAD(ggml_nbytes(s), 256);
+            }
+        }
+        for (const auto & [sil, b] : layer_bytes) {
+            tp_shadow_slot = std::max(tp_shadow_slot, b);
+        }
+        LLAMA_LOG_INFO("%s: LLAMA_TP_PROMPT: %zu layer weights (%.1f MiB) copied for %s (%s)\n", __func__, t.pairs.size(),
+            t.bytes/1024.0/1024.0, ggml_backend_dev_name(tp_devs[c]), ggml_backend_buft_name(buft));
+        std::vector<ggml_backend_buffer_ptr> buffers;
+        buffers.emplace_back(std::move(buf));
+        pimpl->ctxs_bufs.emplace_back(std::move(t.ctx), std::move(buffers));
+    }
+}
+
+ggml_tensor * llama_model::tp_w(ggml_tensor * w, int c) const {
+    if (w == nullptr || tp_devs.size() != 2 || w->buffer == nullptr || ggml_backend_buffer_is_host(w->buffer)) {
+        return w;
+    }
+    if (ggml_backend_buft_get_device(ggml_backend_buffer_get_type(w->buffer)) == tp_devs[c]) {
+        return w;
+    }
+    auto it = tp_shadow.find(w);
+    GGML_ASSERT(it != tp_shadow.end() && "LLAMA_TP_PROMPT: a GPU weight without a copy on the other card");
+    return it->second;
+}
+
+int llama_model::tp_home(int il) const {
+    if (tp_devs.size() != 2) {
+        return -1;
+    }
+    return dev_layer(il) == tp_devs[0] ? 0 : 1;
+}
