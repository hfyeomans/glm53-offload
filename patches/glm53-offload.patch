+// 0165 LLAMA_TP_DECODE=1: the K replica of each trunk layer on the layer's other card
+void llama_kv_cache::td_rep_alloc(bool rot) {
+    if (!model.td_ready || model.tp_devs.size() != 2 || n_stream != 1) {
+        return;
+    }
+    std::map<ggml_backend_buffer_type_t, ggml_context_ptr> ctxs;
+    for (auto & l : layers) {
+        if (l.il >= hparams.n_layer() || l.k == nullptr || l.k->buffer == nullptr || ggml_backend_buffer_is_host(l.k->buffer)) {
+            continue;
+        }
+        const int home = model.tp_home((int) l.il);
+        if (home < 0) {
+            continue;
+        }
+        ggml_backend_buffer_type_t buft = ggml_backend_dev_buffer_type(model.tp_devs[1 - home]);
+        auto & ctx = ctxs[buft];
+        if (!ctx) {
+            ggml_init_params params = { ggml_tensor_overhead()*(layers.size() + 1), nullptr, true };
+            ctx.reset(ggml_init(params));
+        }
+        l.k_rep = ggml_dup_tensor(ctx.get(), l.k);
+        ggml_format_name(l.k_rep, "cache_k_rep_l%d", (int) l.il);
+    }
+    for (auto & [buft, ctx] : ctxs) {
+        ggml_backend_buffer_t buf = nullptr;
+#ifdef GGML_USE_CUDA
+        // 0178 LLAMA_KV_LAZY=1: mapped as the cells are used, with the home KV (llama_kv_lazy_commit maps every lazy buffer)
+        static const bool kv_lazy = getenv("LLAMA_KV_LAZY") != nullptr && atoi(getenv("LLAMA_KV_LAZY")) != 0;
+        if (kv_lazy && !lazy_bufs.empty()) {
+            std::vector<ggml_tensor *> ts;
+            std::vector<size_t> lens;
+            for (ggml_tensor * t = ggml_get_first_tensor(ctx.get()); t != nullptr; t = ggml_get_next_tensor(ctx.get(), t)) {
+                if (t->view_src == nullptr) {
+                    ts.push_back(t);
+                    lens.push_back(ggml_backend_buft_get_alloc_size(buft, t));
+                }
+            }
+            std::vector<size_t> offs(ts.size());
+            buf = ts.empty() ? nullptr : ggml_backend_cuda_alloc_lazy(buft, (int) ts.size(), lens.data(), offs.data());
+            if (buf != nullptr) {
+                char * base = (char *) ggml_backend_buffer_get_base(buf);
+                llama_kv_lazy_buf lb = { buf, {}, {} };
+                for (size_t i = 0; i < ts.size(); ++i) {
+                    GGML_ASSERT(ggml_backend_tensor_alloc(buf, ts[i], base + offs[i]) == GGML_STATUS_SUCCESS);
+                    lb.row.push_back(ts[i]->nb[1]);
+                    lb.len.push_back(lens[i]);
+                }
+                lazy_bufs.push_back(lb);
+                td_rep_bufs.bufs.emplace_back(std::move(ctx), ggml_backend_buffer_ptr(buf));
+                // the cells mapped so far for the home KV, for the replica too
+                std::vector<size_t> w(lb.row.size());
+                for (size_t i = 0; i < w.size(); ++i) {
+                    w[i] = std::min(lb.len[i], (size_t) lazy_cells*lb.row[i]);
+                }
+                if (lazy_cells > 0 && !ggml_backend_cuda_lazy_commit(buf, w.data(), (int) w.size())) {
+                    throw std::runtime_error("LLAMA_TP_DECODE: could not map the lazy K replica");
+                }
+                LLAMA_LOG_INFO("%s: LLAMA_TP_DECODE: lazy K replica on %s (%.1f MiB when every cell is mapped)\n", __func__,
+                    ggml_backend_buft_name(buft), ggml_backend_buffer_get_size(buf)/1024.0/1024.0);
+                continue;
+            }
+        }
+#endif
+        buf = td_rep_bufs.emplace(std::move(ctx), buft, "K replica");
+        if (buf == nullptr) {
+            throw std::runtime_error("LLAMA_TP_DECODE: failed to allocate the K replica");
+        }
+        LLAMA_LOG_INFO("%s: LLAMA_TP_DECODE: K replica on %s, %.1f MiB\n", __func__, ggml_backend_buft_name(buft),
+            ggml_backend_buffer_get_size(buf)/1024.0/1024.0);
+    }
+    // 0179: the rotation matrices of the replicated layers on the other card too (their own buffer: the replica's pages may be unmapped)
+    std::map<ggml_backend_buffer_type_t, ggml_context_ptr> rctxs;
+    for (auto & l : layers) {
+        if (!rot || l.k_rep == nullptr || l.k_rot == nullptr) {
+            continue;
+        }
+        ggml_backend_buffer_type_t buft = ggml_backend_dev_buffer_type(model.tp_devs[1 - model.tp_home((int) l.il)]);
+        auto & ctx = rctxs[buft];
+        if (!ctx) {
+            ggml_init_params params = { ggml_tensor_overhead()*(layers.size() + 1), nullptr, true };
+            ctx.reset(ggml_init(params));
+        }
+        l.k_rot_rep = ggml_dup_tensor(ctx.get(), l.k_rot);
+        ggml_format_name(l.k_rot_rep, "cache_k_rot_rep_l%d", (int) l.il);
+    }
+    for (auto & [buft, ctx] : rctxs) {
+        ggml_backend_buffer_t buf = td_rep_bufs.emplace(std::move(ctx), buft, "rotation replica");
+        if (buf == nullptr) {
+            throw std::runtime_error("LLAMA_TP_DECODE: failed to allocate the rotation replica");
+        }
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    }
+    for (auto & l : layers) {
+        if (l.k_rot_rep != nullptr) {
+            ggml_backend_tensor_set(l.k_rot_rep, attn_rot_hadamard.at(l.k_rot->ne[0]).data(), 0, ggml_nbytes(l.k_rot_rep));
+        }
+    }
+}
