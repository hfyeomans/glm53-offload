+static void * ggml_cuda_host_malloc_thp(size_t size) {
+    const size_t align = 2ull << 20;
+    const size_t sz    = (size + align - 1) & ~(align - 1);
+    const size_t msz   = sz + align;
+    void * base = mmap(nullptr, msz, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (base == MAP_FAILED) {
+        GGML_LOG_WARN("%s: mmap of %.2f MiB failed\n", __func__, msz / 1024.0 / 1024.0);
+        return nullptr;
+    }
+    void * ptr = (void *) (((uintptr_t) base + align - 1) & ~(uintptr_t) (align - 1));
+    if (madvise(ptr, sz, MADV_HUGEPAGE) != 0) {
+        GGML_LOG_WARN("%s: madvise(MADV_HUGEPAGE) failed, the buffer stays on small pages\n", __func__);
+    }
+    cudaError_t err = cudaHostRegister(ptr, sz, cudaHostRegisterPortable | cudaHostRegisterMapped);
+    if (err != cudaSuccess) {
+        (void) cudaGetLastError();
+        GGML_LOG_WARN("%s: cudaHostRegister of %.2f MiB failed: %s\n", __func__, sz / 1024.0 / 1024.0, cudaGetErrorString(err));
+        munmap(base, msz);
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(ggml_cuda_host_thp_mutex);
+    ggml_cuda_host_thp_allocs[ptr] = { base, msz };
+    return ptr;
+}
+
+static bool ggml_cuda_host_free_thp(void * ptr) {
+    std::pair<void *, size_t> m;
