+// the arena mapped up to `end` bytes, with pages of its own past what is mapped
+static bool ggml_cuda_arena_grow(int device, size_t end) {
+    ggml_cuda_arena & a = g_cuda_arena[device];
+    end = GGML_PAD(end, ggml_cuda_info().devices[device].vmm_granularity);
+    if (end <= a.mapped) {
+        return true;
+    }
+    if (end > a.va_size) {
+        return false;
+    }
+    ggml_cuda_set_device(device);
+    ggml_cuda_vmm_map_new(device, (CUdeviceptr) (a.va + a.mapped), end - a.mapped);
+    a.mapped = end;
+    return true;
+}
