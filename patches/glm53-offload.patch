+// 0150: the side uploads issued from now on wait for `event` (recorded on a stream of the same device)
+void ggml_backend_cuda_side_upload_wait_event(ggml_backend_t backend, ggml_backend_event_t event) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(cuda_ctx->device);
+    ggml_cuda_upload_ring & r = g_cuda_upload_ring[cuda_ctx->device];
+    ggml_cuda_upload_ring_init(r);
+    CUDA_CHECK(cudaStreamWaitEvent(r.stream, (cudaEvent_t) event->context, 0));
+}
