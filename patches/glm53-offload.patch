+}
+
+void ggml_backend_cuda_synchronize_device(ggml_backend_t backend) {
+    ggml_cuda_set_device(((ggml_backend_cuda_context *) backend->context)->device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+}
+
+// 0141 LLAMA_KV_LAZY / LLAMA_MOE_CACHE_LEND_MIB: pages that move between the MoE cache and the KV cache.  The cache's lendable chunks
+// (whole pages of its banks, one handle each) are mapped into the banks while the cache has them; a lazy buffer (the KV cache) reserves
+// its virtual range and maps pages as its cells are used: from the chunks the cache has given up, the oldest first, else after asking the
+// cache for more (ggml_backend_cuda_lend_set_need), else pages of its own.  A chunk goes back into the banks once all of its pages are free
+// again, the most recently given first (ggml_backend_cuda_lend_take).
+struct ggml_cuda_lend_chunk {
+#if defined(GGML_USE_VMM)
+    std::vector<CUmemGenericAllocationHandle> h; // 0147: one handle a page (cuMemMap maps a handle from its start only)
+#endif
+    size_t bytes = 0;
+    std::vector<uintptr_t> va; // its pieces in the banks: address, length, offset in the chunk
+    std::vector<size_t>    len;
+    std::vector<size_t>    off;
+    bool in_bank = true;
+    std::vector<uint8_t> out;  // per page: mapped by a lazy buffer
+    size_t n_out = 0;
+};
+struct ggml_cuda_lend {
+    std::vector<ggml_cuda_lend_chunk> chunks;
+    std::vector<int> given;    // the chunks the cache has given up, in order
+    bool (*need)(void * ud, size_t bytes) = nullptr;
+    void * need_ud = nullptr;
+};
+static ggml_cuda_lend g_cuda_lend[GGML_CUDA_MAX_DEVICES];
+
+// a lazy buffer's mapping: [va, va + len) from page `page` of chunk `chunk` (-1: one page of its own, handle h)
+struct ggml_cuda_lazy_map {
+    uintptr_t va;
+    size_t    len;
+    int       chunk;
+    size_t    page;
+#if defined(GGML_USE_VMM)
+    CUmemGenericAllocationHandle h;
+#endif
+};
+struct ggml_cuda_lazy {
+    int       device = 0;
+    uintptr_t va     = 0;
+    size_t    size   = 0;
+    std::vector<size_t> t_off;    // per tensor: its start (a page), its length, the bytes mapped from its start
+    std::vector<size_t> t_len;
+    std::vector<size_t> t_mapped;
+    std::vector<std::vector<ggml_cuda_lazy_map>> t_maps;
+};
+
+static void ggml_cuda_lazy_clear(void * p, uint8_t value) {
+    ggml_cuda_lazy * z = (ggml_cuda_lazy *) p;
+    ggml_cuda_set_device(z->device);
+    for (size_t i = 0; i < z->t_off.size(); ++i) {
+        if (z->t_mapped[i] > 0) {
+            CUDA_CHECK(cudaMemsetAsync((void *) (z->va + z->t_off[i]), value, z->t_mapped[i], cudaStreamPerThread));
+        }
+    }
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+}
+
+bool ggml_backend_buffer_is_cuda_lazy(ggml_backend_buffer_t buf) {
+    return buf != nullptr && ggml_backend_buffer_is_cuda(buf) && ((ggml_backend_cuda_buffer_context *) buf->context)->lazy != nullptr;
+}
+
+ggml_backend_buffer_t ggml_backend_cuda_alloc_lazy(ggml_backend_buffer_type_t buft, int n, const size_t * len, size_t * off) {
+#if defined(GGML_USE_VMM)
+    if (!ggml_backend_buft_is_cuda(buft) || n <= 0) {
+        return nullptr;
+    }
+    const int device = ((ggml_backend_cuda_buffer_type_context *) buft->context)->device;
+    const auto & info = ggml_cuda_info().devices[device];
+    if (!info.vmm) {
+        return nullptr;
+    }
+    const size_t gran = info.vmm_granularity;
+    ggml_cuda_lazy * z = new ggml_cuda_lazy();
+    z->device = device;
+    size_t pos = 0;
+    for (int i = 0; i < n; ++i) {
+        off[i] = pos;
+        z->t_off.push_back(pos);
+        z->t_len.push_back(len[i]);
+        z->t_mapped.push_back(0);
+        z->t_maps.emplace_back();
+        pos = GGML_PAD(pos + len[i], gran);
+    }
+    z->size = std::max(pos, gran);
+    ggml_cuda_set_device(device);
+    CUdeviceptr va = 0;
+    CU_CHECK(cuMemAddressReserve(&va, z->size, 0, 0, 0));
+    z->va = (uintptr_t) va;
+    ggml_backend_cuda_buffer_context * ctx = new ggml_backend_cuda_buffer_context(device, (void *) va);
+    ctx->external   = true; // its pages live for the process (an unmap returns them earlier)
+    ctx->lazy       = z;
+    ctx->lazy_clear = ggml_cuda_lazy_clear;
+    GGML_LOG_INFO("%s: device %d: %d tensors, %.1f MiB reserved, mapped as the cells are used\n", __func__, device, n, z->size/1024.0/1024.0);
+    return ggml_backend_buffer_init(buft, ggml_backend_cuda_buffer_interface, ctx, z->size);
+#else
+    GGML_UNUSED(buft); GGML_UNUSED(n); GGML_UNUSED(len); GGML_UNUSED(off);
+    return nullptr;
+#endif // defined(GGML_USE_VMM)
+}
+
+#if defined(GGML_USE_VMM)
+// a run of up to `want` free pages of the oldest given chunk that has one
+static bool ggml_cuda_lend_pages(int device, size_t want, int & chunk, size_t & page, size_t & n) {
+    ggml_cuda_lend & L = g_cuda_lend[device];
+    for (int k : L.given) {
+        const ggml_cuda_lend_chunk & c = L.chunks[k];
+        if (c.n_out == c.out.size()) {
+            continue;
+        }
+        for (size_t p = 0; p < c.out.size(); ++p) {
+            if (!c.out[p]) {
+                size_t q = p;
+                while (q < c.out.size() && !c.out[q] && q - p < want) {
+                    q++;
+                }
+                chunk = k;
+                page  = p;
+                n     = q - p;
+                return true;
+            }
+        }
+    }
+    return false;
+}
+#endif // defined(GGML_USE_VMM)
+
+bool ggml_backend_cuda_lazy_commit(ggml_backend_buffer_t buf, const size_t * want, int n) {
+#if defined(GGML_USE_VMM)
+    ggml_cuda_lazy * z = (ggml_cuda_lazy *) ((ggml_backend_cuda_buffer_context *) buf->context)->lazy;
+    if (z == nullptr) {
+        return false;
+    }
+    const int device = z->device;
+    const size_t gran = ggml_cuda_info().devices[device].vmm_granularity;
+    ggml_cuda_lend & L = g_cuda_lend[device];
+    size_t total = 0;
+    for (int i = 0; i < n && i < (int) z->t_off.size(); ++i) {
+        const size_t need = std::min(GGML_PAD(want[i], gran), GGML_PAD(z->t_len[i], gran));
+        total += need > z->t_mapped[i] ? need - z->t_mapped[i] : 0;
+    }
+    if (total == 0) {
+        return true;
+    }
+    bool asked = false;
+    for (int i = 0; i < n && i < (int) z->t_off.size(); ++i) {
+        const size_t need = std::min(GGML_PAD(want[i], gran), GGML_PAD(z->t_len[i], gran));
+        while (z->t_mapped[i] < need) {
+            const size_t pages = (need - z->t_mapped[i])/gran;
+            int    k = -1;
+            size_t p = 0;
+            size_t r = 0;
+            bool got = ggml_cuda_lend_pages(device, pages, k, p, r);
+            if (!got && !asked && L.need != nullptr) {
+                asked = true; // once a commit: the cache gives all it can for the whole commit
+                if (L.need(L.need_ud, total)) {
+                    got = ggml_cuda_lend_pages(device, pages, k, p, r);
+                }
+            }
+            ggml_cuda_set_device(device);
+            const CUdeviceptr at = (CUdeviceptr) (z->va + z->t_off[i] + z->t_mapped[i]);
+            ggml_cuda_lazy_map m = {};
+            if (got) {
+                ggml_cuda_lend_chunk & c = L.chunks[k];
+                for (size_t q = 0; q < r; ++q) {
+                    CU_CHECK(cuMemMap(at + q*gran, gran, 0, c.h[p + q], 0));
+                }
+                for (size_t q = p; q < p + r; ++q) {
+                    c.out[q] = 1;
+                }
+                c.n_out += r;
+                m = { (uintptr_t) at, r*gran, k, p, 0 };
+            } else {
+                r = 1;
+                CUmemGenericAllocationHandle h = ggml_cuda_vmm_create(device, gran);
+                CU_CHECK(cuMemMap(at, gran, 0, h, 0));
+                m = { (uintptr_t) at, gran, -1, 0, h };
+            }
+            ggml_cuda_vmm_access(device, at, r*gran);
+            CUDA_CHECK(cudaMemsetAsync((void *) at, 0, r*gran, cudaStreamPerThread));
+            z->t_maps[i].push_back(m);
+            z->t_mapped[i] += r*gran;
+        }
+    }
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+    return true;
+#else
+    GGML_UNUSED(buf); GGML_UNUSED(want); GGML_UNUSED(n);
+    return false;
+#endif // defined(GGML_USE_VMM)
+}
+
+void ggml_backend_cuda_lazy_decommit(ggml_backend_buffer_t buf, const size_t * keep, int n) {
+#if defined(GGML_USE_VMM)
+    ggml_cuda_lazy * z = (ggml_cuda_lazy *) ((ggml_backend_cuda_buffer_context *) buf->context)->lazy;
+    if (z == nullptr) {
+        return;
+    }
+    const int device = z->device;
+    const size_t gran = ggml_cuda_info().devices[device].vmm_granularity;
+    ggml_cuda_lend & L = g_cuda_lend[device];
+    ggml_cuda_set_device(device);
+    CUDA_CHECK(cudaDeviceSynchronize()); // no graph may still read the cells given up
+    for (int i = 0; i < n && i < (int) z->t_off.size(); ++i) {
+        const size_t k_bytes = std::min(GGML_PAD(keep[i], gran), GGML_PAD(z->t_len[i], gran));
+        while (z->t_mapped[i] > k_bytes && !z->t_maps[i].empty()) {
+            ggml_cuda_lazy_map & m = z->t_maps[i].back();
+            const size_t m_lo = z->t_mapped[i] - m.len;     // the mapping's start, from the tensor's
+            const size_t cut  = std::max(k_bytes, m_lo);    // unmapped: [cut, t_mapped)
+            const size_t ulen = z->t_mapped[i] - cut;
+            CU_CHECK(cuMemUnmap((CUdeviceptr) (m.va + (cut - m_lo)), ulen));
+            if (m.chunk >= 0) {
+                ggml_cuda_lend_chunk & c = L.chunks[m.chunk];
+                const size_t p0 = m.page + (cut - m_lo)/gran;
+                for (size_t q = p0; q < p0 + ulen/gran; ++q) {
+                    c.out[q] = 0;
+                }
+                c.n_out -= ulen/gran;
+            } else {
+                CU_CHECK(cuMemRelease(m.h)); // one page, unmapped whole
+            }
+            m.len -= ulen;
+            z->t_mapped[i] = cut;
+            if (m.len == 0) {
+                z->t_maps[i].pop_back();
+            }
+        }
+    }
+#else
+    GGML_UNUSED(buf); GGML_UNUSED(keep); GGML_UNUSED(n);
+#endif // defined(GGML_USE_VMM)
+}
+
+ggml_backend_buffer_t ggml_backend_cuda_alloc_banks(ggml_backend_t backend, size_t size, const struct ggml_cuda_bank_seg * segs, int n, size_t head) {
+#if defined(GGML_USE_VMM)
+    const int device = ((ggml_backend_cuda_context *) backend->context)->device;
+    const auto & info = ggml_cuda_info().devices[device];
+    ggml_cuda_arena & a = g_cuda_arena[device];
+    ggml_cuda_lend  & L = g_cuda_lend[device];
+    if (!info.vmm || a.va != 0 || !L.chunks.empty()) {
+        return nullptr;
+    }
+    const size_t gran = info.vmm_granularity;
+    size = GGML_PAD(size, gran);
+    head = GGML_PAD(head, gran);
+    size_t shared = 0;
+    int n_chunks = 0;
+    for (int i = 0; i < n; ++i) {
+        GGML_ASSERT(segs[i].off % gran == 0 && segs[i].len % gran == 0 && segs[i].off + segs[i].len <= size);
+        GGML_ASSERT(segs[i].off == (i == 0 ? 0 : segs[i - 1].off + segs[i - 1].len));
+        shared  += segs[i].kind == 1 ? segs[i].len : 0;
+        n_chunks = segs[i].kind == 2 ? std::max(n_chunks, segs[i].chunk + 1) : n_chunks;
+    }
+    ggml_cuda_set_device(device);
+    L.chunks.resize(n_chunks);
+    for (int i = 0; i < n; ++i) {
+        if (segs[i].kind == 2) {
+            ggml_cuda_lend_chunk & c = L.chunks[segs[i].chunk];
+            c.bytes = std::max(c.bytes, segs[i].chunk_off + segs[i].len);
+        }
+    }
+    for (ggml_cuda_lend_chunk & c : L.chunks) {
+        GGML_ASSERT(c.bytes > 0 && c.bytes % gran == 0);
+        // kept: its pages move between the banks and the lazy buffers
+        c.h.resize(c.bytes/gran);
+        for (CUmemGenericAllocationHandle & hp : c.h) {
+            hp = ggml_cuda_vmm_create(device, gran);
+        }
+        c.out.assign(c.bytes/gran, 0);
+    }
+    CUdeviceptr bank = 0;
+    CU_CHECK(cuMemAddressReserve(&bank, size, 0, 0, 0));
+    CUdeviceptr va = 0;
+    if (shared > 0) {
+        a.va_size = head + shared + ((size_t) 512 << 30);
+        CU_CHECK(cuMemAddressReserve(&va, a.va_size, 0, 0, 0));
+        a.va = (uintptr_t) va;
+        ggml_cuda_vmm_map_new(device, va, head);
+    }
+    size_t pos  = 0;
+    size_t apos = head;
+    for (int i = 0; i < n; ++i) {
+        const CUdeviceptr at = bank + segs[i].off;
+        if (segs[i].kind == 0) {
+            ggml_cuda_vmm_map_new(device, at, segs[i].len);
+        } else if (segs[i].kind == 1) {
+            CUmemGenericAllocationHandle handle = ggml_cuda_vmm_create(device, segs[i].len);
+            CU_CHECK(cuMemMap(at, segs[i].len, 0, handle, 0));
+            CU_CHECK(cuMemMap(va + apos, segs[i].len, 0, handle, 0));
+            CU_CHECK(cuMemRelease(handle));
+            ggml_cuda_vmm_access(device, at, segs[i].len);
+            ggml_cuda_vmm_access(device, va + apos, segs[i].len);
+            apos += segs[i].len;
+        } else {
+            ggml_cuda_lend_chunk & c = L.chunks[segs[i].chunk];
+            for (size_t q = 0; q < segs[i].len/gran; ++q) {
+                CU_CHECK(cuMemMap(at + q*gran, gran, 0, c.h[segs[i].chunk_off/gran + q], 0));
+            }
+            ggml_cuda_vmm_access(device, at, segs[i].len);
+            c.va.push_back((uintptr_t) at);
+            c.len.push_back(segs[i].len);
+            c.off.push_back(segs[i].chunk_off);
+        }
+        pos = segs[i].off + segs[i].len;
+    }
+    ggml_cuda_vmm_map_new(device, bank + pos, size - pos);
+    if (shared > 0) {
+        a.mapped = apos;
+        a.head   = head;
+        a.shared = shared;
+        a.buft   = {
+            /* .iface   = */ ggml_backend_cuda_buffer_type_interface,
+            /* .device  = */ ggml_backend_reg_dev_get(ggml_backend_cuda_reg(), device),
+            /* .context = */ new ggml_backend_cuda_buffer_type_context{device, GGML_CUDA_NAME + std::to_string(device)},
+        };
+        a.buft.iface.alloc_buffer = ggml_backend_cuda_arena_alloc_buffer;
+    }
+    size_t lend = 0;
+    for (const ggml_cuda_lend_chunk & c : L.chunks) {
+        lend += c.bytes;
+    }
+    GGML_LOG_INFO("%s: device %d: a %.1f MiB bank buffer: %.1f MiB shared with the arena (head %.1f MiB), %d lendable chunks of %.1f MiB in all\n",
+        __func__, device, size/1024.0/1024.0, shared/1024.0/1024.0, head/1024.0/1024.0, n_chunks, lend/1024.0/1024.0);
+    ggml_backend_cuda_buffer_context * ctx = new ggml_backend_cuda_buffer_context(device, (void *) bank);
+    ctx->external = true;
+    return ggml_backend_buffer_init(ggml_backend_cuda_buffer_type(device), ggml_backend_cuda_buffer_interface, ctx, size);
+#else
+    GGML_UNUSED(backend); GGML_UNUSED(size); GGML_UNUSED(segs); GGML_UNUSED(n); GGML_UNUSED(head);
+    return nullptr;
+#endif // defined(GGML_USE_VMM)
+}
+
+void ggml_backend_cuda_lend_set_need(ggml_backend_t backend, bool (*need)(void * ud, size_t bytes), void * ud) {
+    ggml_cuda_lend & L = g_cuda_lend[((ggml_backend_cuda_context *) backend->context)->device];
+    L.need    = need;
+    L.need_ud = ud;
+}
+
+void ggml_backend_cuda_lend_give(ggml_backend_t backend, int k) {
+#if defined(GGML_USE_VMM)
+    const int device = ((ggml_backend_cuda_context *) backend->context)->device;
+    ggml_cuda_lend & L = g_cuda_lend[device];
+    ggml_cuda_lend_chunk & c = L.chunks[k];
+    GGML_ASSERT(c.in_bank);
+    ggml_cuda_set_device(device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+    for (size_t i = 0; i < c.va.size(); ++i) {
+        CU_CHECK(cuMemUnmap((CUdeviceptr) c.va[i], c.len[i]));
+    }
+    c.in_bank = false;
+    std::fill(c.out.begin(), c.out.end(), 0);
+    c.n_out = 0;
+    L.given.push_back(k);
+#else
+    GGML_UNUSED(backend); GGML_UNUSED(k);
+#endif // defined(GGML_USE_VMM)
+}
+
+bool ggml_backend_cuda_lend_take(ggml_backend_t backend, int k) {
+#if defined(GGML_USE_VMM)
+    const int device = ((ggml_backend_cuda_context *) backend->context)->device;
+    ggml_cuda_lend & L = g_cuda_lend[device];
+    if (k < 0 || k >= (int) L.chunks.size() || L.given.empty() || L.given.back() != k) {
+        return false;
+    }
+    ggml_cuda_lend_chunk & c = L.chunks[k];
+    if (c.in_bank || c.n_out > 0) {
+        return false;
+    }
+    ggml_cuda_set_device(device);
+    const size_t gran = ggml_cuda_info().devices[device].vmm_granularity;
+    for (size_t i = 0; i < c.va.size(); ++i) {
+        for (size_t q = 0; q < c.len[i]/gran; ++q) {
+            CU_CHECK(cuMemMap((CUdeviceptr) c.va[i] + q*gran, gran, 0, c.h[c.off[i]/gran + q], 0));
+        }
+        ggml_cuda_vmm_access(device, (CUdeviceptr) c.va[i], c.len[i]);
+    }
+    c.in_bank = true;
+    L.given.pop_back();
+    return true;
+#else
+    GGML_UNUSED(backend); GGML_UNUSED(k);
+    return false;
+#endif // defined(GGML_USE_VMM)
+}
+
+// expert upload ring (see ggml-cuda.h): two slots per device, an upload stream, and the events that order it against the main stream
+struct ggml_cuda_upload_ring {
+    cudaStream_t stream     = nullptr;
+    cudaEvent_t  ev_main[4] = {};                   // the main stream's progress, recorded at the start of split k into [k%N]
+    cudaEvent_t  ev_upload  = nullptr;              // the last gather on the upload stream
+    void *       slot[4]    = {};
+    size_t       slot_bytes = 0;
+    size_t       used       = 0;  // bump pointer in the current slot
+    int64_t      k          = -1; // split counter
+    bool         side_pending = false; // side uploads issued since the last wait
+};
+
+// 0106 GGML_CUDA_RING_SLOTS=N (2-4, default 2): the upload of split k may start once split k-N is done (N-1 splits of lookahead)
+static int ggml_cuda_ring_slots(void) {
+    static int n = -1;
+    if (n < 0) {
+        const char * e = getenv("GGML_CUDA_RING_SLOTS");
+        n = e != nullptr ? atoi(e) : 2;
+        n = n < 2 ? 2 : (n > 4 ? 4 : n);
+    }
+    return n;
+}
+
+static ggml_cuda_upload_ring g_cuda_upload_ring[GGML_CUDA_MAX_DEVICES];
+static ggml_cuda_upload_ring g_cuda_weight_ring[GGML_CUDA_MAX_DEVICES]; // 0078: host-memory weights (LLAMA_TP_SHADOW_HOST)
+
+// 0134 LLAMA_MOE_UPLOAD_AHEAD: the upload ring's slots filled a layer ahead, see ggml_backend_cuda_upload_ring_ahead_gather
+struct ggml_cuda_ring_ahead {
+    bool        init        = false;
+    bool        dirty       = false;  // ahead gathers issued since the old path's last slot: its reuse event does not cover them
+    cudaEvent_t ev_free[4]  = {};     // the main stream when the slot's last reader had been issued
+    cudaEvent_t ev_t[4][4]  = {};     // the gather of tensor idx of the slot
+    cudaEvent_t ev_switch   = nullptr;
+    size_t      used[4]     = {};     // bump pointer per slot
+};
+static ggml_cuda_ring_ahead g_cuda_ring_ahead[GGML_CUDA_MAX_DEVICES];
+
+static void * ggml_cuda_ring_gather_impl(ggml_cuda_upload_ring * rings, ggml_backend_t backend, bool first_of_split, const void * const * srcs, int64_t n, size_t size, size_t split_bytes, const void * host_all, const void * host_hi = nullptr) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    const int dev = cuda_ctx->device;
+    ggml_cuda_set_device(dev);
+    ggml_cuda_upload_ring & r = rings[dev];
+    if (r.stream == nullptr) {
+        CUDA_CHECK(cudaStreamCreateWithFlags(&r.stream, cudaStreamNonBlocking));
+        for (int i = 0; i < 4; ++i) {
+            CUDA_CHECK(cudaEventCreateWithFlags(&r.ev_main[i], cudaEventDisableTiming));
+        }
+        CUDA_CHECK(cudaEventCreateWithFlags(&r.ev_upload, cudaEventDisableTiming));
+    }
+    cudaStream_t main_stream = cuda_ctx->stream();
+    if (first_of_split) {
+        // 0134: after ahead gathers, the slots' last readers are not in ev_main: the upload waits for the main stream's progress now
+        if (rings == g_cuda_upload_ring && g_cuda_ring_ahead[dev].dirty) {
+            CUDA_CHECK(cudaEventRecord(g_cuda_ring_ahead[dev].ev_switch, main_stream));
+            CUDA_CHECK(cudaStreamWaitEvent(r.stream, g_cuda_ring_ahead[dev].ev_switch, 0));
+            g_cuda_ring_ahead[dev].dirty = false;
+        }
+        r.k += 1;
+        r.used = 0;
+        const int s = (int) (r.k % ggml_cuda_ring_slots());
+        // the main stream's progress now: every split issued so far, the previous MoE split's GEMMs included
+        CUDA_CHECK(cudaEventRecord(r.ev_main[s], main_stream));
+        // slot s was last read by split k-2, which was done when the previous call recorded ev_main[(k-1)%2]
+        if (r.k >= ggml_cuda_ring_slots() - 1) {
+            CUDA_CHECK(cudaStreamWaitEvent(r.stream, r.ev_main[(r.k - ggml_cuda_ring_slots() + 1) % ggml_cuda_ring_slots()], 0));
+        }
+    }
+    if (r.k < 0) {
+        return nullptr;
+    }
+    const int    s     = (int) (r.k % ggml_cuda_ring_slots());
+    const size_t bytes = (size_t) n*size;
+    if (r.used + bytes > r.slot_bytes) {
+        // the slots are sized on the first split (the sizes do not change afterwards); a later growth synchronizes the device
+        const size_t need = std::max(r.used + bytes, split_bytes);
+        CUDA_CHECK(cudaDeviceSynchronize());
+        for (int i = 0; i < 4; ++i) {
+            if (r.slot[i] != nullptr) {
+                ggml_cuda_ring_free(r.slot[i], dev);
+                r.slot[i] = nullptr;
+            }
+        }
+        for (int i = 0; i < ggml_cuda_ring_slots(); ++i) {
+            ggml_cuda_ring_malloc(&r.slot[i], need, dev, &r == &g_cuda_upload_ring[dev]);
+        }
+        r.slot_bytes = need;
+        GGML_LOG_INFO("%s: device %d: %d upload slots of %.1f MiB\n", __func__, dev, ggml_cuda_ring_slots(), need/1024.0/1024.0);
+    }
+    char * dst = (char *) r.slot[s] + r.used;
+    r.used += GGML_PAD(bytes, 256);
+
+    // 0107: a table entry inside [host_all, host_hi) is pinned host memory (by default the n experts from host_all, where the callers put
+    // expert e at host_all + e*size)
+    const char * h_lo = (const char *) host_all;
+    const char * h_hi = host_hi != nullptr ? (const char *) host_hi : h_lo != nullptr ? h_lo + (size_t) n*size : nullptr;
+    auto is_host = [&](const void * p) { return p != nullptr && h_lo != nullptr && (const char *) p >= h_lo && (const char *) p < h_hi; };
+
+    // 0082 GGML_CUDA_RING_MIXED=1: given both the table and the host tensor, the copy engine copies a run of host entries in one
+    // host-to-device transfer and a cached expert (an entry elsewhere, a device bank) device-to-device, so the cache saves PCIe bytes
+    static const bool ring_mixed = getenv("GGML_CUDA_RING_MIXED") != nullptr && atoi(getenv("GGML_CUDA_RING_MIXED")) != 0;
+#if CUDART_VERSION >= 12080
+    // 0083: in two calls -- the host runs in one batched copy, the cached experts by one gather kernel (one call per copy filled the
+    // copy queue and blocked the host)
+    if (host_all != nullptr && srcs != nullptr && ring_mixed && n <= GGML_CUDA_GATHER_MAX) {
+        void       * run_dst[GGML_CUDA_GATHER_MAX]; // 0107: the runs of host entries by is_host
+        const void * run_src[GGML_CUDA_GATHER_MAX];
+        size_t       run_len[GGML_CUDA_GATHER_MAX];
+        size_t       n_runs  = 0;
+        ggml_cuda_gather_table table;
+        bool any_dev = false;
+        for (int64_t e = 0; e < GGML_CUDA_GATHER_MAX; ++e) {
+            table.src[e] = nullptr;
+        }
+        for (int64_t e = 0; e < n; ) {
+            if (is_host(srcs[e])) {
+                int64_t e1 = e + 1;
+                while (e1 < n && is_host(srcs[e1]) && srcs[e1] == (const char *) srcs[e1 - 1] + size) {
+                    e1++;
+                }
+                run_dst[n_runs] = dst + (size_t) e*size;
+                run_src[n_runs] = srcs[e];
+                run_len[n_runs] = (size_t) (e1 - e)*size;
+                n_runs++;
+                e = e1;
+            } else {
+                table.src[e] = srcs[e];
+                any_dev = true;
+                e++;
+            }
+        }
+        if (n_runs > 0) {
+            cudaMemcpyAttributes attr = {};
+            attr.srcAccessOrder = cudaMemcpySrcAccessOrderStream;
+            size_t attr_idx = 0;
+            CUDA_CHECK(cudaMemcpyBatchAsync(run_dst, run_src, run_len, n_runs, &attr, &attr_idx, 1, r.stream));
+        }
+        if (any_dev) {
+            const size_t chunk = 1024*1024;
+            const dim3 grid((unsigned) ((size + chunk - 1)/chunk), (unsigned) n);
+            ggml_cuda_gather_copy_kernel<<<grid, 256, 0, r.stream>>>(table, dst, size, chunk);
+            CUDA_CHECK(cudaGetLastError());
+        }
+        CUDA_CHECK(cudaEventRecord(r.ev_upload, r.stream));
+        CUDA_CHECK(cudaStreamWaitEvent(main_stream, r.ev_upload, 0));
+        return dst;
+    }
+#endif // CUDART_VERSION >= 12080
+    if (host_all != nullptr && srcs != nullptr && ring_mixed) {
+        int64_t e = 0;
+        while (e < n) {
+            if (is_host(srcs[e])) {
+                int64_t e1 = e + 1;
+                while (e1 < n && is_host(srcs[e1]) && srcs[e1] == (const char *) srcs[e1 - 1] + size) {
+                    e1++;
+                }
+                CUDA_CHECK(cudaMemcpyAsync(dst + (size_t) e*size, srcs[e], (size_t) (e1 - e)*size, cudaMemcpyHostToDevice, r.stream));
+                e = e1;
+            } else if (srcs[e] == nullptr) {
+                e++; // 0085: an expert the batch does not upload
+            } else {
+                CUDA_CHECK(cudaMemcpyAsync(dst + (size_t) e*size, srcs[e], size, cudaMemcpyDeviceToDevice, r.stream));
+                e++;
+            }
+        }
+        CUDA_CHECK(cudaEventRecord(r.ev_upload, r.stream));
+        CUDA_CHECK(cudaStreamWaitEvent(main_stream, r.ev_upload, 0));
+        return dst;
+    }
+
+    if (host_all != nullptr) {
+        // the whole tensor from the pinned host weights in one DMA transfer
+        CUDA_CHECK(cudaMemcpyAsync(dst, host_all, bytes, cudaMemcpyHostToDevice, r.stream));
+        CUDA_CHECK(cudaEventRecord(r.ev_upload, r.stream));
+        CUDA_CHECK(cudaStreamWaitEvent(main_stream, r.ev_upload, 0));
+        return dst;
+    }
+
+    const size_t chunk = 1024*1024;
+    const unsigned n_chunks = (unsigned) ((size + chunk - 1)/chunk);
+    for (int64_t first = 0; first < n; first += GGML_CUDA_GATHER_MAX) {
+        const int cnt = (int) std::min<int64_t>(GGML_CUDA_GATHER_MAX, n - first);
+        ggml_cuda_gather_table table;
+        for (int i = 0; i < cnt; ++i) {
+            table.src[i] = srcs[first + i];
+        }
+        for (int i = cnt; i < GGML_CUDA_GATHER_MAX; ++i) {
+            table.src[i] = nullptr;
+        }
+        const dim3 grid(n_chunks, cnt);
+        ggml_cuda_gather_copy_kernel<<<grid, 256, 0, r.stream>>>(table, dst + (size_t) first*size, size, chunk);
+        CUDA_CHECK(cudaGetLastError());
+    }
+    // the split's compute on the main stream waits for this upload
+    CUDA_CHECK(cudaEventRecord(r.ev_upload, r.stream));
+    CUDA_CHECK(cudaStreamWaitEvent(main_stream, r.ev_upload, 0));
+    return dst;
+}
+
+// 0134 LLAMA_MOE_UPLOAD_AHEAD
+int ggml_backend_cuda_upload_ring_slots(void) {
+    return ggml_cuda_ring_slots();
+}
+
+static void ggml_cuda_ring_ahead_init(int dev, ggml_cuda_upload_ring & r, ggml_cuda_ring_ahead & a, cudaStream_t main_stream) {
+    if (r.stream == nullptr) {
+        CUDA_CHECK(cudaStreamCreateWithFlags(&r.stream, cudaStreamNonBlocking));
+        for (int i = 0; i < 4; ++i) {
+            CUDA_CHECK(cudaEventCreateWithFlags(&r.ev_main[i], cudaEventDisableTiming));
+        }
+        CUDA_CHECK(cudaEventCreateWithFlags(&r.ev_upload, cudaEventDisableTiming));
+    }
+    if (!a.init) {
+        for (int i = 0; i < 4; ++i) {
+            CUDA_CHECK(cudaEventCreateWithFlags(&a.ev_free[i], cudaEventDisableTiming));
+            CUDA_CHECK(cudaEventRecord(a.ev_free[i], main_stream));
+            for (int j = 0; j < 4; ++j) {
+                CUDA_CHECK(cudaEventCreateWithFlags(&a.ev_t[i][j], cudaEventDisableTiming));
+            }
+        }
+        CUDA_CHECK(cudaEventCreateWithFlags(&a.ev_switch, cudaEventDisableTiming));
+        a.init = true;
+        GGML_LOG_INFO("%s: device %d: LLAMA_MOE_UPLOAD_AHEAD, %d slots\n", __func__, dev, ggml_cuda_ring_slots());
+    }
+}
+
+void ggml_backend_cuda_upload_ring_ahead_free(ggml_backend_t backend, int slot) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    const int dev = cuda_ctx->device;
+    ggml_cuda_set_device(dev);
+    ggml_cuda_upload_ring & r = g_cuda_upload_ring[dev];
+    ggml_cuda_ring_ahead  & a = g_cuda_ring_ahead[dev];
+    ggml_cuda_ring_ahead_init(dev, r, a, cuda_ctx->stream());
+    for (int i = 0; i < ggml_cuda_ring_slots(); ++i) {
+        if (slot < 0 || i == slot) {
+            CUDA_CHECK(cudaEventRecord(a.ev_free[i], cuda_ctx->stream()));
+        }
+    }
+}
+
+void * ggml_backend_cuda_upload_ring_ahead_gather(ggml_backend_t backend, int slot, int idx, const void * const * srcs, int64_t n, size_t size, size_t slot_bytes, const void * host_lo, const void * host_hi) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    const int dev = cuda_ctx->device;
+    ggml_cuda_set_device(dev);
+    ggml_cuda_upload_ring & r = g_cuda_upload_ring[dev];
+    ggml_cuda_ring_ahead  & a = g_cuda_ring_ahead[dev];
+    GGML_ASSERT(slot >= 0 && slot < ggml_cuda_ring_slots() && idx >= 0 && idx < 4 && n <= GGML_CUDA_GATHER_MAX);
+    ggml_cuda_ring_ahead_init(dev, r, a, cuda_ctx->stream());
+    if (r.slot_bytes < slot_bytes) {
+        // the slots are sized once (a layer of experts); a growth synchronizes the device
+        CUDA_CHECK(cudaDeviceSynchronize());
+        for (int i = 0; i < 4; ++i) {
+            if (r.slot[i] != nullptr) {
+                ggml_cuda_ring_free(r.slot[i], dev);
+                r.slot[i] = nullptr;
+            }
+        }
+        for (int i = 0; i < ggml_cuda_ring_slots(); ++i) {
+            ggml_cuda_ring_malloc(&r.slot[i], slot_bytes, dev, &r == &g_cuda_upload_ring[dev]);
+        }
+        r.slot_bytes = slot_bytes;
+        GGML_LOG_INFO("%s: device %d: %d upload slots of %.1f MiB\n", __func__, dev, ggml_cuda_ring_slots(), slot_bytes/1024.0/1024.0);
+    }
+    if (idx == 0) {
+        a.used[slot] = 0;
+        CUDA_CHECK(cudaStreamWaitEvent(r.stream, a.ev_free[slot], 0));
+    }
+    const size_t bytes = (size_t) n*size;
+    GGML_ASSERT(a.used[slot] + bytes <= r.slot_bytes);
+    char * dst = (char *) r.slot[slot] + a.used[slot];
+    a.used[slot] += GGML_PAD(bytes, 256);
+
+    // as the ring's mixed copy (0082 / 0083 / 0107): the host runs in one batched copy, the experts elsewhere (device banks) by the gather kernel
+    const char * h_lo = (const char *) host_lo;
+    const char * h_hi = (const char *) host_hi;
+    auto is_host = [&](const void * p) { return p != nullptr && (const char *) p >= h_lo && (const char *) p < h_hi; };
+    ggml_cuda_gather_table table;
+    bool any_dev = false;
+    for (int64_t e = 0; e < GGML_CUDA_GATHER_MAX; ++e) {
+        table.src[e] = nullptr;
+    }
+#if CUDART_VERSION >= 12080
+    void       * run_dst[GGML_CUDA_GATHER_MAX];
+    const void * run_src[GGML_CUDA_GATHER_MAX];
+    size_t       run_len[GGML_CUDA_GATHER_MAX];
+    size_t       n_runs = 0;
+#endif
+    for (int64_t e = 0; e < n; ) {
+        if (is_host(srcs[e])) {
+            int64_t e1 = e + 1;
+            while (e1 < n && is_host(srcs[e1]) && srcs[e1] == (const char *) srcs[e1 - 1] + size) {
+                e1++;
+            }
+#if CUDART_VERSION >= 12080
+            run_dst[n_runs] = dst + (size_t) e*size;
+            run_src[n_runs] = srcs[e];
+            run_len[n_runs] = (size_t) (e1 - e)*size;
+            n_runs++;
+#else
+            CUDA_CHECK(cudaMemcpyAsync(dst + (size_t) e*size, srcs[e], (size_t) (e1 - e)*size, cudaMemcpyHostToDevice, r.stream));
+#endif
+            e = e1;
+        } else {
+            table.src[e] = srcs[e];
+            any_dev = any_dev || srcs[e] != nullptr;
+            e++;
+        }
+    }
+#if CUDART_VERSION >= 12080
+    if (n_runs > 0) {
+        cudaMemcpyAttributes attr = {};
+        attr.srcAccessOrder = cudaMemcpySrcAccessOrderStream;
+        size_t attr_idx = 0;
+        CUDA_CHECK(cudaMemcpyBatchAsync(run_dst, run_src, run_len, n_runs, &attr, &attr_idx, 1, r.stream));
+    }
+#endif
+    if (any_dev) {
+        const size_t chunk = 1024*1024;
+        const dim3 grid((unsigned) ((size + chunk - 1)/chunk), (unsigned) n);
+        ggml_cuda_gather_copy_kernel<<<grid, 256, 0, r.stream>>>(table, dst, size, chunk);
+        CUDA_CHECK(cudaGetLastError());
+    }
+    CUDA_CHECK(cudaEventRecord(a.ev_t[slot][idx], r.stream));
+    a.dirty = true;
+    return dst;
+}
+
+void ggml_backend_cuda_upload_ring_ahead_wait(ggml_backend_t backend, int slot, int idx) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    const int dev = cuda_ctx->device;
+    ggml_cuda_set_device(dev);
+    ggml_cuda_ring_ahead & a = g_cuda_ring_ahead[dev];
+    GGML_ASSERT(a.init && slot >= 0 && slot < 4 && idx >= 0 && idx < 4);
+    CUDA_CHECK(cudaStreamWaitEvent(cuda_ctx->stream(), a.ev_t[slot][idx], 0));
+}
