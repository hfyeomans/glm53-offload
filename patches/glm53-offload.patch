+void llama_moe_cache::prompt_scatter(struct ggml_tensor * dst, int ith, int nth, void * userdata) {
+    const auto * cs = (const llama_moe_prompt_csr *) userdata;
+    const ggml_tensor * y = dst->src[0];
+    const int64_t n_embd = dst->ne[0];
+    const int64_t n_tok  = dst->ne[1];
+    GGML_ASSERT(cs->n_tok == n_tok && y->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 && y->ne[0] == n_embd);
+    const int64_t t0 = n_tok*ith/nth;
+    const int64_t t1 = n_tok*(ith + 1)/nth;
+    for (int64_t t = t0; t < t1; ++t) {
+        float * d = (float *) ((char *) dst->data + t*dst->nb[1]);
+        std::fill(d, d + n_embd, 0.0f);
+        for (int32_t p = cs->start[t]; p < cs->start[t + 1]; ++p) {
+            const float * s = (const float *) ((const char *) y->data + (size_t) p*y->nb[2]);
+            for (int64_t i = 0; i < n_embd; ++i) {
+                d[i] += s[i];
+            }
+        }
+    }
+}
