+        GGML_LOG_INFO("cuda split timing: device %d:   MoE splits %d: busy %.1f ms, gaps before them %.1f ms; other %d: busy %.1f ms, gaps %.1f ms\n",
+            cuda_ctx->device, t.n_k[1], t.busy_k_ms[1], t.gap_k_ms[1], t.n_k[0], t.busy_k_ms[0], t.gap_k_ms[0]);
+        t.n = 0;
+        t.busy_ms = 0.0;
+        t.gap_ms  = 0.0;
+        for (int k = 0; k < 2; ++k) {
+            t.n_k[k] = 0;
+            t.busy_k_ms[k] = 0.0;
+            t.gap_k_ms[k]  = 0.0;
+        }
