+void * ggml_backend_cuda_upload_ring_gather(ggml_backend_t backend, bool first_of_split, const void * const * srcs, int64_t n, size_t size, size_t split_bytes, const void * host_all) {
+    return ggml_cuda_ring_gather_impl(g_cuda_upload_ring, backend, first_of_split, srcs, n, size, split_bytes, host_all);
+}
