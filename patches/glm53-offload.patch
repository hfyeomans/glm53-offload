+void * ggml_backend_cuda_upload_ring_gather_span(ggml_backend_t backend, bool first_of_split, const void * const * srcs, int64_t n, size_t size, size_t split_bytes, const void * host_lo, const void * host_hi) {
+    GGML_ASSERT(srcs != nullptr && host_lo != nullptr && host_hi != nullptr);
