+
+#include "common.cuh"
+
+// 0137 GGML_CUDA_FA_MLA_SPARSE=1|2: GLM-5.3's sparse prompt attention (64 query heads on one KV head, DKQ 576, V a view of K's first 512
+// dims) in a dedicated kernel, one CTA a query.  The caller has decided that the sparse gather applies.
+bool ggml_cuda_flash_attn_ext_mla_sparse_use(const ggml_tensor * dst);
