+        t.names.push_back(key);
+        t.ms.push_back(0.0);
+        t.n.push_back(0);
+    }
+    t.key[slot] = it->second;
+    CUDA_CHECK(cudaEventRecord(t.end[slot], cuda_ctx->stream()));
+}
