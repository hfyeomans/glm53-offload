+            // path's 8 rows); a layer's experts are one copy for all of them
+            const int64_t nh  = h->ne[1];
+            // 0110 / 0112: the reserve's FFN block count, some blocks of 0 rows on a short ubatch or the cropped last layer
+            const int64_t nbm = std::max<int64_t>(1, ((int64_t) cparams.n_ubatch + lm_moe_rows - 1)/lm_moe_rows);
+            std::vector<ggml_tensor *> fouts;
+            for (int64_t m = 0, m0 = 0; m < nbm; ++m) {
+                const int64_t nm = nh/nbm + (m < nh % nbm ? 1 : 0);
+                ggml_tensor * hm = rows(h, m0, nm);
+                m0 += nm;
+                ggml_tensor * f = nullptr;
+                if ((uint32_t) il < hparams.n_layer_dense_lead) {
+                    f = build_ffn(hm,
+                        L.ffn_up, NULL, L.ffn_up_s,
+                        L.ffn_gate, NULL, L.ffn_gate_s,
+                        L.ffn_down, NULL, L.ffn_down_s,
+                        NULL, LLM_FFN_SILU, LLM_FFN_PAR, il);
+                } else {
+                    ggml_tensor * moe = build_moe_ffn(hm,
+                        L.ffn_gate_inp,
+                        L.ffn_up_exps,
+                        L.ffn_gate_exps,
+                        L.ffn_down_exps,
+                        L.ffn_exp_probs_b,
+                        n_expert, n_expert_used,
+                        LLM_FFN_SILU, hparams.expert_weights_norm,
+                        hparams.expert_weights_scale,
+                        (llama_expert_gating_func_type) hparams.expert_gating_func,
+                        il,
+                        nullptr,
+                        L.ffn_gate_up_exps,
+                        L.ffn_up_exps_s,
+                        L.ffn_gate_exps_s,
+                        L.ffn_down_exps_s);
+                    ggml_tensor * sh = build_ffn(hm,
+                        L.ffn_up_shexp, NULL, L.ffn_up_shexp_s,
+                        L.ffn_gate_shexp, NULL, L.ffn_gate_shexp_s,
