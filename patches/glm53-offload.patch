+// 0158 GGML_CUDA_SPARSE_CHUNKED=1: the top-k-only mask with a block a chunk of a row (fill, then the picks inside the chunk)
+#define CUDA_TOP_K_MASK_CHUNK 4096
+template <typename T>
+static __global__ void top_k_mask_chunked_kernel(
+        const T * mask, const int32_t * top_k, T * dst,
+        const int64_t n_kv, const int64_t ne1, const int64_t ne2,
+        const int64_t m1, const int64_t m2, const int64_t m3, const int64_t n_top,
+        const int64_t sm1, const int64_t sm2, const int64_t sm3,
+        const int64_t sd1, const int64_t sd2, const int64_t sd3,
+        const int64_t sk0, const int64_t sk1, const int64_t sk2, const int64_t sk3) {
+    ggml_cuda_pdl_lc();
+
+    const int64_t ir = blockIdx.x;
+    const int64_t i1 = ir % ne1;
+    const int64_t i2 = (ir / ne1) % ne2;
+    const int64_t i3 = ir / (ne1*ne2);
+    const int64_t c0 = int64_t(blockIdx.y)*CUDA_TOP_K_MASK_CHUNK;
+    const int64_t c1 = min(n_kv, c0 + CUDA_TOP_K_MASK_CHUNK);
+
+    const T       * mask_row  = mask  + (i1 % m1)*sm1 + (i2 % m2)*sm2 + (i3 % m3)*sm3;
+    T             * dst_row   = dst   + i1*sd1 + i2*sd2 + i3*sd3;
+    const int32_t * top_k_row = top_k + i1*sk1 + i2*sk2 + i3*sk3;
+
+    ggml_cuda_pdl_sync();
+
+    const T ninf = ggml_cuda_cast<T>(-INFINITY);
+    for (int64_t i = c0 + threadIdx.x; i < c1; i += blockDim.x) {
+        dst_row[i] = ninf;
+    }
+    __syncthreads();
+    for (int64_t i = threadIdx.x; i < n_top; i += blockDim.x) {
+        const int32_t p = top_k_row[i*sk0];
+        if (p >= c0 && p < c1) {
+            dst_row[p] = mask_row[p];
+        }
+    }
+}
