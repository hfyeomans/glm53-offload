+static void ggml_cuda_op_timing_flush(int device, ggml_cuda_op_timing & t) {
+    while (t.tail != t.head) {
+        if (cudaEventQuery(t.end[t.tail]) != cudaSuccess) {
+            (void) cudaGetLastError();
+            break;
+        }
+        float ms = 0.0f;
+        CUDA_CHECK(cudaEventElapsedTime(&ms, t.start[t.tail], t.end[t.tail]));
+        t.ms[t.key[t.tail]] += ms;
+        t.n[t.key[t.tail]]  += 1;
+        t.tail = (t.tail + 1) % ggml_cuda_op_timing::N;
+        t.n_done += 1;
+    }
+    static const int64_t every_ops = getenv("GGML_CUDA_OP_TIMING_EVERY") != nullptr ? std::max(1LL, atoll(getenv("GGML_CUDA_OP_TIMING_EVERY"))) : 65536;
+    if (t.n_done >= every_ops) {
+        double total = 0.0;
+        std::vector<int> order;
+        for (size_t k = 0; k < t.names.size(); ++k) {
+            total += t.ms[k];
+            order.push_back((int) k);
+        }
+        std::sort(order.begin(), order.end(), [&](int a, int b) { return t.ms[a] > t.ms[b]; });
+        GGML_LOG_INFO("cuda op timing: device %d: %lld ops, %.1f ms\n", device, (long long) t.n_done, total);
+        for (size_t r = 0; r < order.size() && r < 40; ++r) {
+            const int k = order[r];
+            GGML_LOG_INFO("cuda op timing:   %8.1f ms %5.1f %% %8lld %7.1f us  %s\n", t.ms[k], 100.0*t.ms[k]/total, (long long) t.n[k], 1000.0*t.ms[k]/t.n[k], t.names[k].c_str());
+        }
+        std::fill(t.ms.begin(), t.ms.end(), 0.0);
+        std::fill(t.n.begin(), t.n.end(), 0);
+        t.n_done = 0;
