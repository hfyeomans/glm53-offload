+    }
+    CUmemGenericAllocationHandle handle = ggml_cuda_vmm_create(device, size);
+    CU_CHECK(cuMemMap(ptr, size, 0, handle, 0));
+    CU_CHECK(cuMemRelease(handle));
+    ggml_cuda_vmm_access(device, ptr, size);
+}
