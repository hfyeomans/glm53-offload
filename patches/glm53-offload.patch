+        static const double T[][2] = { { 0, 0 }, { 1.57, 0.080 }, { 2.30, 0.109 }, { 4.07, 0.251 }, { 10, 0.287 }, { 20, 0.346 }, { 40, 0.516 }, { 100, 0.956 } };
+        const int n = (int) (sizeof(T)/sizeof(T[0]));
+        for (int i = 1; i < n; ++i) {
+            if (t <= T[i][0]) {
+                return T[i - 1][1] + (T[i][1] - T[i - 1][1])*(t - T[i - 1][0])/(T[i][0] - T[i - 1][0]);
+            }
+        }
+        return T[n - 1][1] + (t - T[n - 1][0])*(T[n - 1][1] - T[n - 2][1])/(T[n - 1][0] - T[n - 2][0]);
+    }
+
+    ggml_context_ptr        p_ctx;
+    ggml_backend_buffer_ptr p_buf;
+    std::unordered_map<const ggml_tensor *, int32_t> layer_of_pmap; // prompt map -> layer
+    int64_t p_alloc = 0;   // pairs allocated per layer
+    double  p_cap   = 0.15;
+    int32_t p_last  = -1;  // the last layer with a prompt map: the ubatch's log line
+    uint64_t p_cur  = 1;   // 0088: the graph compute in progress, advanced by begin()
+    std::vector<int32_t> p_cnt;
+    std::vector<int32_t> p_order;
+    std::vector<int32_t> p_pred_ids;
+    std::vector<int32_t> p_rank;
+    // 0090: the staging areas of each device (two, by layer parity), one tensor per expert tensor of a layer
+    struct prompt_stage {
+        ggml_context_ptr        ctx;
+        ggml_backend_buffer_ptr buf;
+        ggml_tensor *           t[2][4] = { { nullptr } };
+    };
+    std::vector<prompt_stage> p_stage;
+    std::unordered_map<const ggml_tensor *, int32_t> layer_of_pout; // 0091: CPU part result -> layer
+    int32_t p_pf_n   = 0;
+    int32_t p_pf_min = 4;
+    std::vector<void *>       pf_dst;
+    std::vector<const void *> pf_src;
+    std::vector<size_t>       pf_len;
+    static constexpr int P_NB = 4;
+    static constexpr int P_B[P_NB] = { 25, 50, 75, 100 };
+    struct prompt_stats {
+        int64_t n_layers = 0, n_tok = 0, n_cpu = 0, n_zero = 0, n_up = 0, n_cached = 0, n_pairs = 0, n_sel = 0;
+        int64_t n_pred = 0, pred_up[P_NB] = {}, pred_cpu[P_NB] = {}, pred_zero[P_NB] = {}, pred_den[P_NB] = {}, pred_upall = 0;
+        int64_t pf_used = 0, pf_unused = 0;
+        double  link_ms = 0, cpu_ms = 0;
+        int64_t t_us = 0, t_wait_us = 0;
+    } p_st;
+
+    int64_t prompt_n_pairs(int64_t n_tokens) const {
+        return std::max<int64_t>(1, (int64_t) std::ceil(p_cap*n_expert_used*n_tokens));
+    }
+
+    void init_prompt_cpu(int64_t n_ubatch) {
+        if (!prompt_cpu_enabled() || p_ctx || n_ubatch <= max_batch) {
+            return;
+        }
+        p_cap   = std::min(1.0, std::max(0.01, prompt_env("LLAMA_MOE_PROMPT_CPU_CAP", 0.15)));
+        p_alloc = prompt_n_pairs(n_ubatch);
+        size_t n_t = 0;
+        for (const layer & l : layers) {
+            n_t += l.ig >= 0 ? 4 : 0;
+        }
+        if (n_t == 0) {
+            return;
+        }
+        ggml_init_params params = { n_t*ggml_tensor_overhead(), nullptr, true };
+        p_ctx.reset(ggml_init(params));
+        for (size_t il = 0; il < layers.size(); ++il) {
+            layer & l = layers[il];
+            if (l.ig < 0) {
+                continue;
+            }
+            const int64_t n_expert = groups[l.ig].ref[0]->ne[2];
+            l.p_map = ggml_new_tensor_2d(p_ctx.get(), GGML_TYPE_I32, 1, n_expert);
+            ggml_format_name(l.p_map, "moe_cache.prompt_map-%zu", il);
+            l.p_tok = ggml_new_tensor_1d(p_ctx.get(), GGML_TYPE_I32, p_alloc);
+            ggml_format_name(l.p_tok, "moe_cache.prompt_tok-%zu", il);
+            l.p_ids = ggml_new_tensor_2d(p_ctx.get(), GGML_TYPE_I32, 1, p_alloc);
+            ggml_format_name(l.p_ids, "moe_cache.prompt_ids-%zu", il);
+            l.p_w   = ggml_new_tensor_3d(p_ctx.get(), GGML_TYPE_F32, 1, 1, p_alloc);
+            ggml_format_name(l.p_w, "moe_cache.prompt_w-%zu", il);
+            l.p_skip.assign(n_expert, 0);
+            layer_of_pmap[l.p_map] = (int32_t) il;
+            p_last = (int32_t) il;
+        }
+        p_buf = llama_memory_bufs::alloc_buf(p_ctx.get(), ggml_backend_cpu_buffer_type(), false, "MoE prompt CPU split");
+        GGML_ASSERT(p_buf);
+        // as weights: the CPU part reads them in place, the device's lookup copies the map with the copy callback
+        ggml_backend_buffer_set_usage(p_buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        for (layer & l : layers) {
+            if (l.p_map == nullptr) {
+                continue;
+            }
+            int32_t * m = (int32_t *) l.p_map->data;
+            for (int64_t e = 0; e < l.p_map->ne[1]; ++e) {
+                m[e] = (int32_t) e;
+            }
+            std::fill((int32_t *) l.p_tok->data, (int32_t *) l.p_tok->data + p_alloc, 0);
+            std::fill((int32_t *) l.p_ids->data, (int32_t *) l.p_ids->data + p_alloc, -1);
+            std::fill((float *) l.p_w->data, (float *) l.p_w->data + p_alloc, 0.0f);
+        }
+        LLAMA_LOG_INFO("%s: LLAMA_MOE_PROMPT_CPU: batches over %lld tokens plan their experts per layer, up to %lld CPU pairs a layer (cap %.2f)\n",
+            __func__, (long long) max_batch, (long long) p_alloc, p_cap);
+
+        // 0090: the staging areas
+        p_pf_n   = (int32_t) prompt_env("LLAMA_MOE_PROMPT_PREFETCH", 0);
+        p_pf_min = (int32_t) prompt_env("LLAMA_MOE_PROMPT_PREFETCH_MIN", 4);
+        if (p_pf_n > 0) {
+            p_stage.resize(devices.size());
+            for (size_t id = 0; id < devices.size(); ++id) {
+                size_t es[4] = { 0, 0, 0, 0 };
+                size_t n_ip  = 0;
+                for (const layer & l : layers) {
+                    if (l.p_map == nullptr || groups[l.ig].id != (int32_t) id) {
+                        continue;
+                    }
+                    n_ip = std::max(n_ip, l.experts.size());
+                    for (size_t ip = 0; ip < l.experts.size() && ip < 4; ++ip) {
+                        es[ip] = std::max(es[ip], (size_t) l.experts[ip]->nb[2]);
+                    }
+                }
+                if (n_ip == 0) {
+                    continue;
+                }
+                prompt_stage & ps = p_stage[id];
+                ggml_init_params sp = { 8*ggml_tensor_overhead(), nullptr, true };
+                ps.ctx.reset(ggml_init(sp));
+                size_t total = 0;
+                for (int a = 0; a < 2; ++a) {
+                    for (size_t ip = 0; ip < n_ip && ip < 4; ++ip) {
+                        ps.t[a][ip] = ggml_new_tensor_1d(ps.ctx.get(), GGML_TYPE_I8, (int64_t) (es[ip]*p_pf_n));
+                        ggml_format_name(ps.t[a][ip], "moe_cache.prompt_stage-%d-%zu", a, ip);
+                        total += es[ip]*p_pf_n;
+                    }
+                }
+                ps.buf = llama_memory_bufs::alloc_buf(ps.ctx.get(), devices[id].buft, false, "MoE prompt prefetch");
+                GGML_ASSERT(ps.buf);
+                LLAMA_LOG_INFO("%s: LLAMA_MOE_PROMPT_PREFETCH: device %zu: %d experts a layer, two staging areas, %.1f MiB\n", __func__, id, p_pf_n,
+                    total/1024.0/1024.0);
+            }
+        }
+    }
+
+    ggml_tensor * get_prompt_map(int32_t il, int64_t n_tokens) const {
+        // 0087: a larger ubatch's next attention costs more than the plan saves (the upload no longer overlaps it)
+        static const int64_t max_tokens = (int64_t) prompt_env("LLAMA_MOE_PROMPT_CPU_MAX_TOKENS", 4096);
+        if (il < 0 || il >= (int32_t) layers.size() || layers[il].p_map == nullptr || n_tokens <= max_batch || n_tokens > max_tokens ||
+            prompt_n_pairs(n_tokens) > p_alloc) {
+            return nullptr;
+        }
+        return layers[il].p_map;
+    }
+
+    // 0091: expert e of layer l is in its staging area (its part went up in this graph compute)
+    bool prompt_is_staged(const layer & l, int64_t e) const {
+        if (l.p_stage_epoch != p_cur || e < 0 || e >= (int64_t) l.p_stage_pos.size() || l.p_stage_pos[e] < 0) {
+            return false;
+        }
+        return l.p_stage_pos[e] < l.p_pf_n1 ? l.p_pf_issued : l.p_pf_issued2;
+    }
+
+    // 0091: issue part one (behind the layer's uploads) or part two (behind its CPU part's result) of layer jl's prefetch
+    void prompt_prefetch_part(ggml_backend_t backend, int32_t jl, int part) {
+        layer & ln = layers[jl];
+        const size_t j0 = part == 1 ? 0 : (size_t) ln.p_pf_n1;
+        const size_t j1e = part == 1 ? (size_t) ln.p_pf_n1 : ln.p_pf.size();
+        bool ok = j0 >= j1e;
+        if (!ok) {
+            const prompt_stage & ps = p_stage[groups[ln.ig].id];
+            pf_dst.clear();
+            pf_src.clear();
+            pf_len.clear();
+            for (size_t ip = 0; ip < ln.experts.size() && ip < 4; ++ip) {
+                const ggml_tensor * t = ln.experts[ip];
+                char * base = (char *) ps.t[jl % 2][ip]->data;
+                const size_t es = t->nb[2];
+                for (size_t j = j0; j < j1e; ) {
+                    size_t j1 = j + 1;
+                    while (j1 < j1e && ln.p_pf[j1] == ln.p_pf[j1 - 1] + 1) {
+                        j1++;
+                    }
+                    pf_dst.push_back(base + j*es);
+                    pf_src.push_back((const char *) t->data + (size_t) ln.p_pf[j]*es);
+                    pf_len.push_back((j1 - j)*es);
+                    j = j1;
+                }
+            }
+#ifdef GGML_USE_CUDA
+            ok = ggml_backend_is_cuda(backend) &&
+                ggml_backend_cuda_upload_ring_prefetch(backend, pf_dst.data(), pf_src.data(), pf_len.data(), pf_dst.size());
+#else
+            GGML_UNUSED(backend);
+#endif
+        }
+        if (part == 1) {
+            ln.p_pf_issued = ok;
+        } else {
+            ln.p_pf_issued2 = ok;
+        }
+    }
+
+    void set_prompt_out(int32_t il, ggml_tensor * out) {
+        if (il < 0 || il >= (int32_t) layers.size()) {
+            return;
+        }
+        if (layers[il].p_out != nullptr) {
+            layer_of_pout.erase(layers[il].p_out);
+        }
+        layers[il].p_out = out;
+        if (out != nullptr) {
+            layer_of_pout[out] = il;
+        }
+    }
+
+    const void * prompt_staged(const ggml_tensor * w, int64_t e) const {
+        const auto it = bindings.find(w);
+        if (it == bindings.end()) {
+            return nullptr;
+        }
+        const layer & l = layers[it->second.il];
+        if (!prompt_is_staged(l, e)) {
+            return nullptr;
+        }
+        const int32_t ip = it->second.ip;
+        const ggml_tensor * st = p_stage[groups[l.ig].id].t[it->second.il % 2][ip];
+        return (const char *) st->data + (size_t) l.p_stage_pos[e]*w->nb[2];
+    }
+
+    void prompt_after_gather(ggml_backend_t backend, const ggml_tensor * w) {
+        if (p_pf_n <= 0) {
+            return;
+        }
+        const auto it = bindings.find(w);
+        if (it == bindings.end()) {
+            return;
+        }
+        const int32_t il = it->second.il;
+        layer & l = layers[il];
+        if (l.p_epoch != p_cur || ++l.p_gathers < (int32_t) l.experts.size() || il + 1 >= (int32_t) layers.size()) {
+            return;
+        }
+        layer & ln = layers[il + 1];
+        if (ln.p_stage_epoch != p_cur || ln.p_pf_issued || ln.p_map == nullptr) {
+            return;
+        }
+        prompt_prefetch_part(backend, il + 1, 1); // 0091: part one, behind this layer's uploads
+    }
+
+    void set_prompt_pred(int32_t il, ggml_tensor * sel) {
+        if (il >= 0 && il < (int32_t) layers.size()) {
+            layers[il].p_pred_t = sel;
+        }
+    }
+
+    bool prompt_skip(const ggml_tensor * w, int64_t e) const {
+        const auto it = bindings.find(w);
+        if (it == bindings.end()) {
+            return false;
+        }
+        const layer & l = layers[it->second.il];
+        return l.p_valid && l.p_epoch == p_cur && e >= 0 && e < (int64_t) l.p_skip.size() && l.p_skip[e] != 0;
+    }
+
+    // the copy of a prompt map: read the routing of the layer, plan it, write the map and the CPU's pairs
+    bool prompt_plan(ggml_backend_t backend, int32_t il, const ggml_tensor * src, ggml_tensor * dst, ggml_cgraph * graph) {
+        const int64_t t0 = ggml_time_us();
+        layer & l = layers[il];
+        group & g = groups[l.ig];
+        GGML_ASSERT(backend == devices[g.id].backend);
+        l.p_gathers = 0; // 0090
+
+        const int n_nodes = ggml_graph_n_nodes(graph);
+        const ggml_tensor * lookup = nullptr;
+        for (int i = 0; i < n_nodes && lookup == nullptr; ++i) {
+            const ggml_tensor * node = ggml_graph_node(graph, i);
+            if (node->op == GGML_OP_GET_ROWS && node->src[0] == dst) {
+                lookup = node;
+            }
+        }
+        GGML_ASSERT(lookup != nullptr);
+        const ggml_tensor * sel = lookup->src[1];
+        for (int i = 0; i < n_nodes; ++i) {
+            const ggml_tensor * node = ggml_graph_node(graph, i);
+            if (node == sel || node == sel->view_src) {
+                GGML_ABORT("the experts of layer %d are selected in the same split as their prompt plan", il);
+            }
+        }
+        GGML_ASSERT(ggml_is_contiguous(sel));
+        const auto it_cpu = cpu_parts.find(lookup);
+        GGML_ASSERT(it_cpu != cpu_parts.end() && it_cpu->second.inputs.size() == 2);
+        const ggml_tensor * x_t = it_cpu->second.inputs[0]; // the FFN input [n_embd, n_tokens]
+        const ggml_tensor * w_t = it_cpu->second.inputs[1]; // the router weights [1, n_used, n_tokens]
+
+        // the CPU part's input and the router weights are read with the selected experts, as for the slot lookup's CPU part
+        stash.clear();
+        size_t stash_size = 0;
+        for (const ggml_tensor * t : it_cpu->second.inputs) {
+            const ggml_tensor * base = base_of(t);
+            GGML_ASSERT(base->buffer != nullptr && !ggml_backend_buffer_is_host(base->buffer) && t->data != nullptr && ggml_is_contiguous(t));
+            const size_t offs = (const uint8_t *) t->data - (const uint8_t *) base->data;
+            stash.push_back({ base, offs, ggml_nbytes(t), stash_size });
+            stash_size += GGML_PAD(ggml_nbytes(t), 64);
+        }
+        if (!stash_buf || ggml_backend_buffer_get_size(stash_buf.get()) < stash_size) {
+            ggml_backend_buffer_type_t buft = ggml_backend_dev_host_buffer_type(ggml_backend_get_device(backend));
+            stash_buf.reset(ggml_backend_buft_alloc_buffer(buft ? buft : ggml_backend_cpu_buffer_type(), 2*stash_size));
+            GGML_ASSERT(stash_buf);
+        }
+        uint8_t * stash_data = (uint8_t *) ggml_backend_buffer_get_base(stash_buf.get());
+        for (const stash_entry & e : stash) {
+            ggml_backend_tensor_get_async(backend, e.base, stash_data + e.pos, e.offs, e.size);
+        }
+        ids.resize(ggml_nelements(sel));
+        ggml_backend_tensor_get_async(backend, sel, ids.data(), 0, ggml_nbytes(sel));
+        // 0089: the next layer's guess, computed with this layer's router
+        const ggml_tensor * pred_t = l.p_pred_t;
+        const bool has_pred = pred_t != nullptr && pred_t->data != nullptr && pred_t->buffer != nullptr && !ggml_backend_buffer_is_host(pred_t->buffer) &&
+            ggml_is_contiguous(pred_t) && il + 1 < (int32_t) layers.size() && layers[il + 1].p_map != nullptr;
+        if (has_pred) {
+            p_pred_ids.resize(ggml_nelements(pred_t));
+            ggml_backend_tensor_get_async(backend, pred_t, p_pred_ids.data(), 0, ggml_nbytes(pred_t));
+        }
+        ggml_backend_synchronize(backend);
+        const int64_t t1 = ggml_time_us();
+        if (has_pred) {
+            layer & ln = layers[il + 1];
+            ln.p_pred_cnt.assign(ln.p_map->ne[1], 0);
+            for (int32_t e : p_pred_ids) {
+                if (e >= 0 && e < (int32_t) ln.p_pred_cnt.size()) {
+                    ln.p_pred_cnt[e]++;
+                }
+            }
+            ln.p_pred_epoch = p_cur;
+            ln.p_pred_ntok  = pred_t->ne[1];
+        }
+
+        const int32_t n_used   = it_cpu->second.n_used;
+        const int64_t n_ids    = (int64_t) ids.size();
+        const int64_t n_tok    = n_ids/n_used;
+        const int64_t n_expert = l.p_map->ne[1];
+        const int64_t n_embd   = x_t->ne[0];
+        GGML_ASSERT(ggml_nelements(w_t) == n_ids && n_tok*n_used == n_ids);
+        const float * w = (const float *) (stash_data + stash[1].pos);
+
+        p_cnt.assign(n_expert, 0);
+        for (int32_t e : ids) {
+            if (e >= 0 && e < n_expert) {
+                p_cnt[e]++;
+            }
+        }
+        const int32_t * slots = g.slru.slot_map[il];
+        size_t ebytes = 0;
+        for (const ggml_tensor * t : l.experts) {
+            ebytes += t->nb[2];
+        }
+        static const double link_gbs = prompt_env("LLAMA_MOE_PROMPT_LINK_GBS", 55.0);
+        static const double cpu_scale = prompt_env("LLAMA_MOE_PROMPT_CPU_SCALE", 1.0);
+        static const double gpu_us    = prompt_env("LLAMA_MOE_PROMPT_GPU_US", 1.2);
+        static const double fixed_ms  = prompt_env("LLAMA_MOE_PROMPT_FIXED_MS", 2.0);
+        static const bool   do_log    = prompt_env("LLAMA_MOE_PROMPT_LOG", 1.0) != 0.0;
+        const double u_ms   = ebytes/(link_gbs*1e6);
+        const double gpu_ms = gpu_us*n_tok/1e3;
+        const double out_ms = 4.0*n_embd*n_tok/(link_gbs*1e6);
+
+        // the uncached experts some token selects, fewest selections first; the CPU takes them while that shortens the layer
+        p_order.clear();
+        double link = 0.0;
+        int64_t n_zero = 0, n_cached = 0;
+        for (int64_t e = 0; e < n_expert; ++e) {
+            const bool cached = slots != nullptr && slots[e] < g.n_slots;
+            const bool staged = prompt_is_staged(l, e); // 0090, 0091
+            if (p_cnt[e] == 0) {
+                n_zero += cached || staged ? 0 : 1;
+                p_st.pf_unused += staged ? 1 : 0;
+                continue;
+            }
+            if (cached) {
+                n_cached++;
+                continue;
+            }
+            if (staged) {
+                p_st.pf_used++; // 0090: on the card already, as a cached expert
+                continue;
+            }
+            p_order.push_back((int32_t) e);
+            link += u_ms;
+        }
+        std::sort(p_order.begin(), p_order.end(), [&](int32_t a, int32_t b) { return p_cnt[a] != p_cnt[b] ? p_cnt[a] < p_cnt[b] : a < b; });
+        // the best prefix: the CPU part's fixed cost and its result's upload are paid once, so a prefix is judged whole
+        const int64_t cap = prompt_n_pairs(n_tok);
+        double  cpu   = 0.0;
+        int64_t pairs = 0;
+        size_t  k     = 0;
+        {
+            double  best = link + gpu_ms;
+            double  c_j  = 0.0;
+            double  l_j  = link;
+            int64_t n_j  = 0;
+            for (size_t j = 0; j < p_order.size(); ++j) {
+                const int32_t e = p_order[j];
+                if (n_j + p_cnt[e] > cap) {
+                    break;
+                }
+                c_j += cpu_scale*prompt_cpu_ms(p_cnt[e]) + (j == 0 ? fixed_ms : 0.0);
+                l_j += (j == 0 ? out_ms : 0.0) - u_ms;
+                n_j += p_cnt[e];
+                const double t = std::max(l_j + gpu_ms, c_j);
+                if (t < best) {
+                    best  = t;
+                    k     = j + 1;
+                    cpu   = c_j;
+                    pairs = n_j;
+                }
+                if (c_j > l_j + gpu_ms) {
+                    break;
+                }
+            }
+            if (k > 0) {
+                link = link - k*u_ms + out_ms;
+            }
+        }
+        // 0091: the link time the CPU part leaves after this layer's uploads, for part one of the next layer's prefetch
+        l.p_pf_want1 = (int32_t) std::floor(std::max(0.0, cpu - (link - (k > 0 ? out_ms : 0.0)))/u_ms);
+
+        // the map and the skips: experts no token selects are not uploaded, nor the CPU's
+        int32_t * pm = (int32_t *) l.p_map->data;
+        for (int64_t e = 0; e < n_expert; ++e) {
+            pm[e] = (int32_t) e;
+            l.p_skip[e] = p_cnt[e] == 0;
+        }
+        for (size_t j = 0; j < k; ++j) {
+            pm[p_order[j]]       = -1;
+            l.p_skip[p_order[j]] = 1;
+        }
+
+        // the CPU's pairs, by token
+        int32_t * ptok = (int32_t *) l.p_tok->data;
+        int32_t * pids = (int32_t *) l.p_ids->data;
+        float   * pw   = (float   *) l.p_w->data;
+        l.p_csr.n_tok = n_tok;
+        l.p_csr.start.assign(n_tok + 1, 0);
+        int64_t np = 0;
+        for (int64_t t = 0; t < n_tok; ++t) {
+            l.p_csr.start[t] = (int32_t) np;
+            for (int32_t j = 0; j < n_used; ++j) {
+                const int32_t e = ids[t*n_used + j];
+                if (e >= 0 && e < n_expert && pm[e] < 0) {
+                    ptok[np] = (int32_t) t;
+                    pids[np] = e;
+                    pw[np]   = w[t*n_used + j];
+                    np++;
+                }
+            }
+        }
+        l.p_csr.start[n_tok] = (int32_t) np;
+        GGML_ASSERT(np == pairs && np <= cap);
+        for (int64_t p = np; p < cap; ++p) {
+            ptok[p] = 0;
+            pids[p] = -1;
+            pw[p]   = 0.0f;
+        }
+        l.p_valid = true;
+        l.p_epoch = p_cur;
+
+        // 0090: the next layer's prefetch, from its guess: the uncached experts it ranks first
+        if (p_pf_n > 0 && has_pred && il + 1 < (int32_t) layers.size() && layers[il + 1].p_map != nullptr) {
+            layer & ln = layers[il + 1];
+            group & gn = groups[ln.ig];
+            const int32_t * slots_n = gn.slru.slot_map[il + 1];
+            const int64_t n_exp_n = (int64_t) ln.p_pred_cnt.size();
+            std::vector<int32_t> & cand = ln.p_pf;
+            cand.clear();
+            for (int64_t e = 0; e < n_exp_n; ++e) {
+                const bool cached_n = slots_n != nullptr && slots_n[e] < gn.n_slots;
+                if (!cached_n && ln.p_pred_cnt[e] >= p_pf_min) {
+                    cand.push_back((int32_t) e);
+                }
+            }
+            std::sort(cand.begin(), cand.end(), [&](int32_t a, int32_t b) { return ln.p_pred_cnt[a] != ln.p_pred_cnt[b] ? ln.p_pred_cnt[a] > ln.p_pred_cnt[b] : a < b; });
+            if ((int64_t) cand.size() > p_pf_n) {
+                cand.resize(p_pf_n);
+            }
+            // 0091: part one (the guess's first, as many as the CPU window takes), then part two; each by expert, so consecutive experts
+            // are one copy
+            ln.p_pf_n1 = std::min<int32_t>((int32_t) cand.size(), l.p_pf_want1);
+            // 0093: part two no longer than the next layer's attention (the next plan's read-back queues behind it)
+            static const double post_us = prompt_env("LLAMA_MOE_PROMPT_POST_US", 7.0); // 0094: 5 -> 7, measured
+            const int32_t n2_max = (int32_t) std::floor(post_us*n_tok/1e3/u_ms);
+            if ((int32_t) cand.size() > ln.p_pf_n1 + n2_max) {
+                cand.resize(ln.p_pf_n1 + n2_max);
+            }
+            std::sort(cand.begin(), cand.begin() + ln.p_pf_n1);
+            std::sort(cand.begin() + ln.p_pf_n1, cand.end());
+            ln.p_pf_issued2 = false;
+            ln.p_stage_pos.assign(n_exp_n, -1);
+            for (size_t j = 0; j < cand.size(); ++j) {
+                ln.p_stage_pos[cand[j]] = (int32_t) j;
+            }
+            ln.p_stage_epoch = p_cur;
+            ln.p_pf_issued   = false;
+        }
+
+        // 0089: score the guess of this layer's experts read at the previous layer's plan
+        if (l.p_pred_epoch == p_cur && l.p_pred_ntok == n_tok && (int64_t) l.p_pred_cnt.size() == n_expert) {
+            p_rank.clear();
+            for (int64_t e = 0; e < n_expert; ++e) {
+                const bool cached = slots != nullptr && slots[e] < g.n_slots;
+                if (!cached && l.p_pred_cnt[e] > 0) {
+                    p_rank.push_back((int32_t) e);
+                }
+            }
+            std::sort(p_rank.begin(), p_rank.end(), [&](int32_t a, int32_t b) { return l.p_pred_cnt[a] != l.p_pred_cnt[b] ? l.p_pred_cnt[a] > l.p_pred_cnt[b] : a < b; });
+            int64_t n_upall = 0;
+            for (int64_t e = 0; e < n_expert; ++e) {
+                const bool cached = slots != nullptr && slots[e] < g.n_slots;
+                n_upall += !cached && p_cnt[e] > 0 && pm[e] >= 0 ? 1 : 0;
+            }
+            p_st.n_pred++;
+            p_st.pred_upall += n_upall;
+            for (int ib = 0; ib < P_NB; ++ib) {
+                const size_t nb = std::min<size_t>((size_t) P_B[ib], p_rank.size());
+                for (size_t j = 0; j < nb; ++j) {
+                    const int32_t e = p_rank[j];
+                    if (p_cnt[e] == 0) {
+                        p_st.pred_zero[ib]++;
+                    } else if (pm[e] < 0) {
+                        p_st.pred_cpu[ib]++;
+                    } else {
+                        p_st.pred_up[ib]++;
+                    }
+                }
+                p_st.pred_den[ib] += (int64_t) nb;
+            }
+        }
+
+        ggml_backend_tensor_set_async(backend, dst, src->data, 0, ggml_nbytes(src));
+
+        p_st.n_layers++;
+        p_st.n_tok     = n_tok;
+        p_st.n_cpu    += (int64_t) k;
+        p_st.n_zero   += n_zero;
+        p_st.n_up     += (int64_t) (p_order.size() - k);
+        p_st.n_cached += n_cached;
+        p_st.n_pairs  += np;
+        p_st.n_sel    += n_ids;
+        p_st.link_ms  += link + gpu_ms;
+        p_st.cpu_ms   += cpu;
+        p_st.t_us     += ggml_time_us() - t0;
+        p_st.t_wait_us += t1 - t0;
+        if (il == p_last) {
+            if (do_log && p_st.n_layers > 0) {
+                const double nl = (double) p_st.n_layers;
+                LLAMA_LOG_INFO("moe prompt cpu: %lld tokens x %lld layers: a layer %.1f experts on the CPU (%.1f%% of the selections), %.1f unused "
+                    "not uploaded, %.1f uploaded, %.1f cached; model link+gpu %.1f / cpu %.1f ms; plan %.2f ms (%.2f waiting)\n",
+                    (long long) p_st.n_tok, (long long) p_st.n_layers, p_st.n_cpu/nl, 100.0*p_st.n_pairs/std::max<int64_t>(1, p_st.n_sel),
+                    p_st.n_zero/nl, p_st.n_up/nl, p_st.n_cached/nl, p_st.link_ms/nl, p_st.cpu_ms/nl, p_st.t_us/nl/1e3, p_st.t_wait_us/nl/1e3);
+            }
+            if (do_log && p_st.n_pred > 0) {
+                char buf[512];
+                int  pos = 0;
+                for (int ib = 0; ib < P_NB; ++ib) {
+                    const double d = (double) std::max<int64_t>(1, p_st.pred_den[ib]);
+                    pos += snprintf(buf + pos, sizeof(buf) - pos, "; top %d: %.0f%% uploaded / %.0f%% CPU / %.0f%% unused, covers %.0f%%", P_B[ib],
+                        100.0*p_st.pred_up[ib]/d, 100.0*p_st.pred_cpu[ib]/d, 100.0*p_st.pred_zero[ib]/d,
+                        100.0*p_st.pred_up[ib]/std::max<int64_t>(1, p_st.pred_upall));
+                }
+                LLAMA_LOG_INFO("moe prompt pred: %lld layers scored, %.1f uploads a layer%s\n", (long long) p_st.n_pred,
+                    (double) p_st.pred_upall/p_st.n_pred, buf);
+            }
+            if (do_log && p_pf_n > 0 && p_st.n_layers > 0) {
+                LLAMA_LOG_INFO("moe prompt prefetch: a layer %.1f prefetched experts used, %.1f unused\n",
+                    (double) p_st.pf_used/p_st.n_layers, (double) p_st.pf_unused/p_st.n_layers);
+            }
+            p_st = {};
+        }
+        return true;
+    }
+
+    void begin() {
+        stash.clear();
+        p_cur++; // 0088
+    }
+
+    bool copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, ggml_cgraph * graph) {
+        // 0091: the CPU part's result goes up on the card's stream, then the next layer's prefetch part two behind it
+        if (!layer_of_pout.empty()) {
+            const auto io = layer_of_pout.find(src);
+            if (io != layer_of_pout.end() && dst->buffer != nullptr && !ggml_backend_buffer_is_host(dst->buffer)) {
+                ggml_backend_tensor_set_async(backend, dst, src->data, 0, ggml_nbytes(src));
+                const int32_t il = io->second;
+                if (p_pf_n > 0 && il + 1 < (int32_t) layers.size()) {
+                    layer & ln = layers[il + 1];
+                    if (ln.p_stage_epoch == p_cur && !ln.p_pf_issued2 && ln.p_map != nullptr) {
+                        prompt_prefetch_part(backend, il + 1, 2);
+                    }
+                }
+                return true;
+            }
+        }
+        if (!layer_of_pmap.empty()) {
+            const auto ip = layer_of_pmap.find(src);
+            if (ip != layer_of_pmap.end()) {
+                return prompt_plan(backend, ip->second, src, dst, graph);
+            }
+        }
+        const auto it = layer_of.find(src);
+        if (it == layer_of.end()) {
+            return copy_cpu_input(src, dst);
+        }
+        const int32_t il = it->second;
+        layer & l = layers[il];
+        group & g = groups[l.ig];
+
+        GGML_ASSERT(backend == devices[g.id].backend);
+
+        if (prompt_pending) {
+            admit();
+        }
+
+        // the get_rows that looks up the slots of the selected experts
+        const int n_nodes = ggml_graph_n_nodes(graph);
+        const ggml_tensor * lookup = nullptr;
+        for (int i = 0; i < n_nodes && lookup == nullptr; ++i) {
+            const ggml_tensor * node = ggml_graph_node(graph, i);
+            if (node->op == GGML_OP_GET_ROWS && node->src[0] == dst) {
+                lookup = node;
+            }
+        }
+        GGML_ASSERT(lookup != nullptr);
+
+        // the selected experts must be computed in an earlier split
+        // the scheduler starts a new split at the lookup because it reads a host weight, but only if the split already has inputs
+        const ggml_tensor * sel = lookup->src[1];
+        for (int i = 0; i < n_nodes; ++i) {
+            const ggml_tensor * node = ggml_graph_node(graph, i);
+            if (node == sel || node == sel->view_src) {
+                GGML_ABORT("the experts of layer %d are selected in the same split as their MoE cache lookup", il);
+            }
+        }
+        GGML_ASSERT(ggml_is_contiguous(sel));
+
+        // the device inputs of the CPU part are read with the selected experts, so the CPU part does not wait for the device
+        // the inputs computed in this split are left to the scheduler
+        // the graph has a CPU part for this layer if it registered its inputs
+        const auto it_cpu = cpu_parts.find(lookup);
+        const bool has_cpu = l.cpu_map != nullptr && it_cpu != cpu_parts.end() && !it_cpu->second.inputs.empty();
+
+        stash.clear();
+        size_t stash_size = 0;
+        if (has_cpu) {
+            ggml_backend_buffer_type_t buft_dev = ggml_backend_dev_buffer_type(ggml_backend_get_device(backend));
+            for (const ggml_tensor * t : it_cpu->second.inputs) {
+                const ggml_tensor * base = base_of(t);
+                if (base->buffer == nullptr || ggml_backend_buffer_is_host(base->buffer) || ggml_backend_buffer_get_type(base->buffer) != buft_dev || t->data == nullptr) {
+                    continue;
+                }
+                bool in_split = false;
+                for (int i = 0; i < n_nodes && !in_split; ++i) {
+                    in_split = ggml_graph_node(graph, i) == base;
+                }
+                if (in_split) {
+                    continue;
+                }
+                const size_t offs = (const uint8_t *) t->data - (const uint8_t *) base->data;
+                stash.push_back({ base, offs, ggml_nbytes(t), stash_size });
+                stash_size += GGML_PAD(ggml_nbytes(t), 64);
+            }
+            if (!stash_buf || ggml_backend_buffer_get_size(stash_buf.get()) < stash_size) {
+                ggml_backend_buffer_type_t buft = ggml_backend_dev_host_buffer_type(ggml_backend_get_device(backend));
+                stash_buf.reset(ggml_backend_buft_alloc_buffer(buft ? buft : ggml_backend_cpu_buffer_type(), 2*stash_size));
+                GGML_ASSERT(stash_buf);
+            }
+            uint8_t * stash_data = (uint8_t *) ggml_backend_buffer_get_base(stash_buf.get());
+            for (const stash_entry & e : stash) {
+                ggml_backend_tensor_get_async(backend, e.base, stash_data + e.pos, e.offs, e.size);
+            }
+        }
+
+        ids.resize(ggml_nelements(sel));
+        // 0052: a deferred plan reads into pinned memory (a read into pageable memory returns only once the router is done)
+        bool ids_in_pin = false;
+        if (deferred_plan() && has_cpu && l.cpu_ids != nullptr && ids.size() <= (size_t) defer_max_tokens*n_expert_used) {
+            if (!ids_pin_buf) {
+                ggml_backend_buffer_type_t buft_pin = ggml_backend_dev_host_buffer_type(ggml_backend_get_device(backend));
+                if (buft_pin != nullptr) {
+                    ids_pin_buf.reset(ggml_backend_buft_alloc_buffer(buft_pin, 64*1024));
+                    ids_pin = ids_pin_buf ? (int32_t *) ggml_backend_buffer_get_base(ids_pin_buf.get()) : nullptr;
+                }
+            }
+            ids_in_pin = ids_pin != nullptr && ggml_nbytes(sel) <= 64*1024;
+        }
+        ggml_backend_tensor_get_async(backend, sel, ids_in_pin ? (void *) ids_pin : (void *) ids.data(), 0, ggml_nbytes(sel));
+        pred_pending = false;
+        if (prefetch_enabled() && il + 1 < (int32_t) layers.size() && layers[il + 1].pred != nullptr && layers[il + 1].pred->data != nullptr &&
+            ids.size() == (size_t) n_expert_used) {
+            const ggml_tensor * pred = layers[il + 1].pred;
+            pred_ids.resize(ggml_nelements(pred));
+            ggml_backend_tensor_get_async(backend, pred, pred_ids.data(), 0, ggml_nbytes(pred));
+            pred_pending = true;
+        }
+        if (deferred_plan() && has_cpu && l.cpu_ids != nullptr && ids.size() <= (size_t) defer_max_tokens*n_expert_used) {
+            // the lookup runs on the map as it is: record the reads, upload the map, plan when the CPU part asks for its inputs
+            if (defer_st.il >= 0) {
+                GGML_ABORT("the deferred plan of layer %d never ran: its CPU part asked for no input", defer_st.il);
+            }
+            ggml_backend_event_t & ev = ev_ids[backend];
+            if (ev == nullptr) {
+                ev = ggml_backend_event_new(ggml_backend_get_device(backend));
+                GGML_ASSERT(ev != nullptr);
+            }
+            ggml_backend_event_record(ev, backend);
+            defer_st = { il, it_cpu->second.n_used, backend, ev };
+            defer_st.x_t = it_cpu->second.inputs.size() > 1 ? it_cpu->second.inputs[1] : nullptr;
+            defer_st.ids_pin = ids_in_pin;
+            if (l.fill_ev_pending) {
+                // 0046: the hits read the slots that the layer's last deferred plan filled on the side stream
+                ggml_backend_event_wait(backend, l.fill_ev);
+                l.fill_ev_pending = false;
+            }
+            ggml_backend_tensor_set_async(backend, dst, src->data, 0, ggml_nbytes(src));
+            return true;
+        }
+        ggml_backend_synchronize(backend);
+        l.last_ids.assign(ids.begin(), ids.end());
+
+        // LLAMA_MOE_ASYNC_FILL: the experts filled on the side stream at the last lookup of this layer are cached from now on, unless
+        // another layer's plan took their slot since (the main stream waits for the side uploads before the map upload below)
+        if (!l.pending_fills.empty()) {
+            int32_t * slots_pf = g.slru.slot_map[il];
+            for (const auto & pf : l.pending_fills) {
+                if (g.slru.key_of[pf.second] == il*g.slru.n_expert + pf.first) {
+                    slots_pf[pf.first] = pf.second;
+                }
+            }
+            l.pending_fills.clear();
+        }
+        if (l.fill_ev_pending) {
+            // LLAMA_MOE_ASYNC_FILL_TOKENS: the hits of this layer read the slots filled at its last lookup
+            ggml_backend_event_wait(backend, l.fill_ev);
+            l.fill_ev_pending = false;
+        }
+
+        if (trace != nullptr) {
+            write_trace(il, it_cpu != cpu_parts.end() ? it_cpu->second.n_used : n_expert_used);
+        }
+
+        // part of the misses is computed on the CPU once the cache is full, the carry keeps the share right on average
+        const uint32_t share_q = has_cpu && g.slru.n_filled == g.slru.n_slots ? cpu_share_q : 0;
+        auto n_cpu = [&](size_t n_miss) {
+            const uint64_t acc = (uint64_t) n_miss*share_q + l.cpu_acc;
+            l.cpu_acc = acc & 0xffff;
+            return (size_t) (acc >> 16);
+        };
+        size_t n_hit = 0;
+        if (!g.slru.plan(il, ids.data(), ids.size(), has_cpu ? it_cpu->second.n_used : 1, n_zero, n_cpu, rng, fills, cpu, n_hit)) {
+            GGML_ABORT("the MoE cache is too small for the experts selected in layer %d", il);
+        }
+        if (has_cpu) {
+            int32_t * cpu_map = (int32_t *) l.cpu_map->data;
+            for (int32_t e : l.cpu_experts) {
+                cpu_map[e] = -1;
+            }
+            l.cpu_experts.clear();
+            for (const auto & f : cpu) {
+                cpu_map[f.expert] = f.expert;
+                l.cpu_experts.push_back(f.expert);
+            }
+        }
+
+        // LLAMA_MOE_ASYNC_FILL (one token, a CPU part): the misses that enter the cache are computed on the CPU this token, their device
+        // slot reads zeros, and their uploads go on the side stream; the slots are published at the next lookup of the layer
+        bool async_fill = false;
+#ifdef GGML_USE_CUDA
+        {
+            // one token, or with LLAMA_MOE_ASYNC_FILL_TOKENS up to that many (the MTP verify)
+            const size_t n_tok_af = has_cpu ? ids.size() / (size_t) it_cpu->second.n_used : 0;
+            async_fill = async_fill_enabled() && has_cpu && !fills.empty() && ggml_backend_is_cuda(backend) &&
+                (ids.size() == (size_t) n_expert_used || (async_fill_tokens() > 0 && n_tok_af <= (size_t) async_fill_tokens()));
+        }
+        if (async_fill_enabled() && !async_fill && !fills.empty() && ggml_backend_is_cuda(backend)) {
+            // a main-stream fill must not race an older side upload into the same slot
+            ggml_backend_cuda_side_upload_wait(backend);
+        }
+#endif
+        // a fill computed on the CPU reads a zero slot that no token of the batch uses twice (the planner's rule for its CPU misses);
+        // one that finds none left is uploaded on the main stream and computed on the device
+        fill_async.assign(fills.size(), 0);
+        size_t n_async = 0;
+        if (async_fill) {
+            int32_t * cpu_map = (int32_t *) l.cpu_map->data;
+            int32_t * slots_af = g.slru.slot_map[il];
+            const int32_t n_used_af = it_cpu->second.n_used;
+            const size_t  n_tok_af  = ids.size() / (size_t) n_used_af;
+            std::vector<uint64_t> & tz = g.slru.token_zero;
+            if (cpu.empty() || tz.size() != n_tok_af) {
+                tz.assign(n_tok_af, 0); // left from an earlier batch: the planner sets them only for its CPU misses
+            }
+            for (size_t i = 0; i < fills.size(); ++i) {
+                const int32_t e = fills[i].expert;
+                uint64_t used = 0;
+                for (size_t it = 0; it < n_tok_af; ++it) {
+                    for (int32_t k = 0; k < n_used_af; ++k) {
+                        if (ids[it*n_used_af + k] == e) {
+                            used |= tz[it];
+                        }
+                    }
+                }
+                int32_t z = 0;
+                while (z < n_zero && (used >> z & 1)) {
+                    z++;
+                }
+                if (z >= n_zero) {
+                    continue;
+                }
+                for (size_t it = 0; it < n_tok_af; ++it) {
+                    for (int32_t k = 0; k < n_used_af; ++k) {
+                        if (ids[it*n_used_af + k] == e) {
+                            tz[it] |= 1ull << z;
+                        }
+                    }
+                }
+                fill_async[i] = 1;
+                n_async++;
+                slots_af[e] = g.slru.n_slots + z;
+                cpu_map[e] = e;
+                l.cpu_experts.push_back(e);
+                l.pending_fills.push_back({ e, fills[i].slot });
+            }
+            win_async += n_async;
+#ifdef GGML_USE_CUDA
+            if (n_async < fills.size()) {
+                // a main-stream fill must not race an older side upload into the same slot
+                ggml_backend_cuda_side_upload_wait(backend);
+            }
+#endif
+        }
+
+        // upload the missing experts, consecutive experts going to consecutive slots are uploaded together
+        size_t bytes = 0;
+        for (size_t ip = 0; ip < l.experts.size(); ++ip) {
+            const ggml_tensor * w    = l.experts[ip];
+            ggml_tensor       * bank = g.banks[ip];
+            const size_t expert_size = w->nb[2];
+            for (size_t i = 0; i < fills.size();) {
+                size_t n = 1;
+                while (i + n < fills.size() && fill_async[i + n] == fill_async[i] && fills[i + n].expert == fills[i].expert + (int32_t) n && fills[i + n].slot == fills[i].slot + (int32_t) n) {
+                    n++;
+                }
+#ifdef GGML_USE_CUDA
+                if (fill_async[i]) {
+                    ggml_backend_cuda_side_upload_async(backend, (uint8_t *) bank->data + fills[i].slot*expert_size,
+                        (const uint8_t *) w->data + fills[i].expert*expert_size, n*expert_size);
+                } else
+#endif
+                {
+                    ggml_backend_tensor_set_async(backend, bank, (const uint8_t *) w->data + fills[i].expert*expert_size, fills[i].slot*expert_size, n*expert_size);
+                }
+                bytes += n*expert_size;
+                i += n;
+            }
+        }
+
+#ifdef GGML_USE_CUDA
+        if (n_async > 0 && async_fill_tokens() > 0) {
+            if (l.fill_ev == nullptr) {
+                l.fill_ev = ggml_backend_event_new(ggml_backend_get_device(backend));
