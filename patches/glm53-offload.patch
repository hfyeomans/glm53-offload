+// GGML_CUDA_SPLIT_TIMING=1: device time of every split (one graph compute) and the idle gaps between consecutive splits, per device
+struct ggml_cuda_split_timing {
+    static constexpr int N = 2048;
+    cudaEvent_t start[N] = {};
+    cudaEvent_t end[N]   = {};
+    int    head = 0;      // next slot to record
+    int    tail = 0;      // oldest unprocessed slot
+    int    prev = -1;     // the last processed slot, for the gap to the next
+    int    n    = 0;      // processed splits since the last print
+    double busy_ms = 0.0;
+    double gap_ms  = 0.0;
+    // 0057: per kind of split (0 other, 1 MoE: the first node is MUL_MAT_ID), the gap charged to the split after it
+    int    kind[N] = {};
+    int    n_k[2]       = {};
+    double busy_k_ms[2] = {};
+    double gap_k_ms[2]  = {};
+};
+
+static ggml_cuda_split_timing g_cuda_split_timing[GGML_CUDA_MAX_DEVICES];
+
+static bool ggml_cuda_split_timing_enabled(void) {
+    static const bool enabled = getenv("GGML_CUDA_SPLIT_TIMING") != nullptr && atoi(getenv("GGML_CUDA_SPLIT_TIMING")) > 0;
+    return enabled;
+}
+
+static int ggml_cuda_split_timing_begin(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph) {
+    if (!ggml_cuda_split_timing_enabled()) {
+        return -1;
+    }
