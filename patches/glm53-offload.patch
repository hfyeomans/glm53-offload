+// 0108 LLAMA_LAYER_MAJOR
+bool llama_kv_cache::lm_cells_positional(uint32_t strm, llama_seq_id seq_id, llama_pos p_first) const {
+    if (strm >= v_cells.size()) {
+        return false;
+    }
+    const auto & cells = v_cells[strm];
+    if (p_first < 0 || (uint32_t) p_first > cells.size()) {
+        return false;
+    }
+    for (uint32_t i = 0; i < (uint32_t) p_first; ++i) {
+        if (cells.is_empty(i) || cells.pos_get(i) != (llama_pos) i || !cells.seq_has(i, seq_id)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool llama_kv_cache_context::lm_positional() const {
+    if (ubatches.empty() || sinfos.size() != ubatches.size()) {
+        return false;
+    }
+    const llama_seq_id seq = ubatches[0].seq_id[0][0];
+    llama_pos next = ubatches[0].pos[0];
+    for (size_t k = 0; k < ubatches.size(); ++k) {
+        const auto & ub = ubatches[k];
+        const auto & si = sinfos[k];
+        if (ub.n_seqs_unq != 1 || si.n_stream() != 1 || si.idxs[0].size() != ub.n_tokens) {
+            return false;
+        }
+        for (uint32_t i = 0; i < ub.n_tokens; ++i) {
+            if (ub.n_seq_id[i] != 1 || ub.seq_id[i][0] != seq || ub.pos[i] != next + (llama_pos) i || (llama_pos) si.idxs[0][i] != ub.pos[i]) {
+                return false;
+            }
+        }
+        next += (llama_pos) ub.n_tokens;
+    }
+    return kv->lm_cells_positional((uint32_t) sinfos[0].strm[0], seq, ubatches[0].pos[0]);
+}
