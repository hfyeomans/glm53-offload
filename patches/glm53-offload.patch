+// after the load: the tensors get their shape back, and the router of each layer the order of its experts
+static void llama_moe_hot_done(llama_model & model) {
+    const int32_t n_expert = (int32_t) model.hparams.n_expert;
+    std::vector<uint8_t> a;
+    std::vector<uint8_t> b;
+    for (auto & [il, h] : model.moe_hot) {
+        for (const auto & s : h.src) {
+            ggml_tensor * t = const_cast<ggml_tensor *>(s.t);
+            if (!llama_tensor_is_host_weight(t)) {
+                throw std::runtime_error(format("LLAMA_MOE_HOT_MAP: layer %d: %s is not in host memory", il, t->name));
+            }
+            t->ne[2] = n_expert;
+        }
+        const llama_layer & layer = model.layers[il];
+        for (ggml_tensor * t : { layer.ffn_gate_inp, layer.ffn_exp_probs_b }) {
+            if (t == nullptr) {
+                continue;
+            }
+            // one row per expert: ffn_gate_inp [n_embd, n_expert], ffn_exp_probs_b [n_expert]
+            const size_t row = ggml_nbytes(t)/n_expert;
+            GGML_ASSERT(ggml_nelements(t) % n_expert == 0 && row*n_expert == ggml_nbytes(t) && (ggml_n_dims(t) == 1 || t->nb[1] == row));
+            a.resize(ggml_nbytes(t));
+            b.resize(ggml_nbytes(t));
+            ggml_backend_tensor_get(t, a.data(), 0, a.size());
+            for (int32_t p = 0; p < n_expert; ++p) {
+                memcpy(b.data() + p*row, a.data() + h.order[p]*row, row);
+            }
+            ggml_backend_tensor_set(t, b.data(), 0, b.size());
+        }
+    }
+#ifndef _WIN32
+    // LLAMA_MOE_HOT_VERIFY=1: the host experts and the router rows against the model file, byte for byte
+    if (const char * s = getenv("LLAMA_MOE_HOT_VERIFY"); s != nullptr && atoi(s) != 0 && !model.moe_hot.empty()) {
+        const int64_t t0 = ggml_time_us();
+        auto same = [](int fd, size_t offs, const uint8_t * data, size_t size) {
+            std::vector<uint8_t> buf(std::min<size_t>(size, 8u*1024*1024));
+            for (size_t done = 0; done < size; ) {
+                const ssize_t r = pread(fd, buf.data(), std::min(buf.size(), size - done), (off_t) (offs + done));
+                if (r <= 0 || memcmp(buf.data(), data + done, (size_t) r) != 0) {
+                    return false;
+                }
+                done += (size_t) r;
+            }
+            return true;
+        };
+        std::vector<const llama_model::moe_hot_layer *> hs;
+        for (const auto & [il, h] : model.moe_hot) {
+            hs.push_back(&h);
+        }
+        std::atomic<size_t> next { 0 };
+        std::atomic<size_t> n_bad { 0 };
+        std::atomic<size_t> n_ok { 0 };
+        std::vector<std::thread> thr;
+        for (int i = 0; i < 8; ++i) {
+            thr.emplace_back([&]() {
+                for (size_t k = next++; k < hs.size(); k = next++) {
+                    const auto & h = *hs[k];
+                    for (const auto & s : h.src) {
+                        const size_t es = s.t->nb[2];
+                        for (int32_t p = 0; p < h.n_host; ++p) {
+                            (same(s.fd, s.offs + (size_t) h.order[p]*es, (const uint8_t *) s.t->data + (size_t) p*es, es) ? n_ok : n_bad)++;
+                        }
+                    }
+                }
+            });
+        }
+        for (auto & t : thr) {
+            t.join();
+        }
+        std::atomic<size_t> n_rows { 0 };
+        for (const auto & [il, h] : model.moe_hot) {
+            for (const auto & s : h.router) {
+                const size_t row = ggml_nbytes(s.t)/n_expert;
+                a.resize(ggml_nbytes(s.t));
+                ggml_backend_tensor_get(s.t, a.data(), 0, a.size());
+                for (int32_t p = 0; p < n_expert; ++p) {
+                    (same(s.fd, s.offs + (size_t) h.order[p]*row, a.data() + p*row, row) ? n_rows : n_bad)++;
+                }
+            }
+        }
+        LLAMA_LOG_INFO("%s: LLAMA_MOE_HOT_VERIFY: %zu host experts and %zu router rows match the model file, %zu differ (%.1f s)\n", __func__,
+            n_ok.load(), n_rows.load(), n_bad.load(), (ggml_time_us() - t0)/1e6);
+        if (n_bad > 0) {
+            throw std::runtime_error("LLAMA_MOE_HOT_VERIFY: the loaded experts differ from the model file");
+        }
+    }
+#endif
 }
 
