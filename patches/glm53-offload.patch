+                std::vector<ggml_tensor *> w;
+                for (size_t i = 0; i + 1 < v.size(); i += 2) {
+                    w.push_back(ggml_concat(ctx0, v[i], v[i + 1], 1));
+                }
+                if (v.size() % 2 == 1) {
+                    w.push_back(v.back());
+                }
+                v.swap(w);
+            }
+            return v[0];
+        };
+
+        if (getenv("GGML_GALLOCR_TRACE") != nullptr) { // 0115
+            LLAMA_LOG_INFO("lm graph: n_tokens %lld n_kv %lld lm_kv_end %u reserve %d blocks %zu, first block keys %lld\n", (long long) n_tokens,
+                (long long) n_kv, cparams.lm_kv_end, (int) cparams.lm_reserve, blocks.size(), (long long) blocks[0].n_kv);
+        }
+        std::vector<ggml_tensor *> top_k_prev(blocks.size(), nullptr);
+        for (int il = 0; il < n_layer; ++il) {
+            const auto & L = model.layers[il];
+            ggml_tensor * Z    = z_of(il);
+            ggml_tensor * x_sa = x;
+            res->t_layer_inp[il] = x; // 0109
+
+            ggml_tensor * cur = build_norm(x, L.attn_norm, NULL, LLM_NORM_RMS, il);
+            ggml_tensor * qr  = ggml_mul_mat(ctx0, L.wq_a, cur);
+            qr = build_norm(qr, L.attn_q_a_norm, nullptr, LLM_NORM_RMS, il);
+
+            // the indexer's queries and weights; its keys stored for the whole ubatch before any block reads them
+            ggml_tensor * iq = nullptr;
+            ggml_tensor * iw = nullptr;
+            ggml_tensor * ik_cache = nullptr;
+            if (hparams.is_indexer_full(il)) {
+                iq = ggml_mul_mat(ctx0, L.indexer_attn_q_b, qr);
+                iq = ggml_reshape_3d(ctx0, iq, n_embd_indexer_head, n_indexer_head, n_tokens);
+                iq = ggml_rope_ext(ctx0, iq, pos_all, nullptr, n_rot, LLAMA_ROPE_TYPE_NORM, n_ctx_orig, freq_base, freq_scale,
+                                   ext_factor, attn_factor, beta_fast, beta_slow);
+                ggml_tensor * ik = ggml_mul_mat(ctx0, L.indexer_attn_k, cur);
+                ik = build_norm(ik, L.indexer_k_norm, L.indexer_k_norm_b, LLM_NORM, il);
+                ik = ggml_reshape_3d(ctx0, ik, n_embd_indexer_head, 1, n_tokens);
+                ik = ggml_rope_ext(ctx0, ik, pos_all, nullptr, n_rot, LLAMA_ROPE_TYPE_NORM, n_ctx_orig, freq_base, freq_scale,
+                                   ext_factor, attn_factor, beta_fast, beta_slow);
+                iq = ggml_mul_mat(ctx0, inp->self_k_rot_lid[il], iq);
+                ik = ggml_mul_mat(ctx0, inp->self_k_rot_lid[il], ik);
+                ggml_build_forward_expand(gf, mctx_lid->cpy_k(ctx0, ik, inp->get_k_idxs_lid(), il));
+                ik_cache = mctx_lid->get_k(ctx0, il);
+                iw = ggml_mul_mat(ctx0, L.indexer_proj, cur);
+                iw = ggml_scale(ctx0, iw, 1.0f / sqrtf(float(n_embd_indexer_head * n_indexer_head)));
+            }
+
+            // the latent keys of the whole ubatch, stored likewise
+            ggml_tensor * kv_cmpr_pe = ggml_mul_mat(ctx0, L.wkv_a_mqa, cur);
+            ggml_tensor * kv_cmpr = ggml_view_2d(ctx0, kv_cmpr_pe, kv_lora_rank, n_tokens,
+                                                 ggml_row_size(kv_cmpr_pe->type, kv_lora_rank + n_embd_head_qk_rope), 0);
+            ggml_tensor * k_pe = ggml_view_3d(ctx0, kv_cmpr_pe, n_embd_head_qk_rope, 1, n_tokens,
+                                              ggml_row_size(kv_cmpr_pe->type, kv_lora_rank + n_embd_head_qk_rope),
+                                              ggml_row_size(kv_cmpr_pe->type, kv_lora_rank + n_embd_head_qk_rope),
+                                              ggml_row_size(kv_cmpr_pe->type, kv_lora_rank));
+            k_pe = ggml_rope_ext(ctx0, k_pe, pos_all, nullptr, n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+                                 ext_factor, attn_factor, beta_fast, beta_slow);
+            kv_cmpr = build_norm(kv_cmpr, L.attn_kv_a_norm, nullptr, LLM_NORM_RMS, il);
+            kv_cmpr = ggml_reshape_3d(ctx0, kv_cmpr, kv_lora_rank, 1, n_tokens);
+            ggml_build_forward_expand(gf, mctx_mla->cpy_k(ctx0, ggml_concat(ctx0, kv_cmpr, k_pe, 0), inp->get_k_idxs_mla(), il));
+            ggml_tensor * k_cache = mctx_mla->get_k(ctx0, il);
+
+            // the attention, a block of query rows at a time
+            std::vector<ggml_tensor *> outs;
+            for (size_t ib = 0; ib < blocks.size(); ++ib) {
+                const lm_block & b = blocks[ib];
+                ggml_tensor * mask  = z_view(Z, b);
+                ggml_tensor * top_k = nullptr;
+                if (iq != nullptr) {
+                    ggml_tensor * iq_b = ggml_view_3d(ctx0, iq, iq->ne[0], iq->ne[1], b.nr, iq->nb[1], iq->nb[2], b.r0*iq->nb[2]);
+                    ggml_tensor * ik_b = ggml_view_4d(ctx0, ik_cache, ik_cache->ne[0], ik_cache->ne[1], b.n_kv, ik_cache->ne[3],
+                                                      ik_cache->nb[1], ik_cache->nb[2], ik_cache->nb[3], 0);
+                    ggml_tensor * sc = ggml_lightning_indexer(ctx0, iq_b, ik_b, rows(iw, b.r0, b.nr), mask);
+                    res->add_fused_node({LLM_FUSED_OP_LIGHTNING_INDEXER, sc, il});
+                    const uint32_t n_top = sc->ne[0] < n_indexer_top_k ? sc->ne[0] : n_indexer_top_k;
+                    top_k = ggml_cont(ctx0, ggml_top_k(ctx0, sc, n_top));
+                    top_k_prev[ib] = top_k;
+                } else {
+                    GGML_ASSERT(top_k_prev[ib] != nullptr && "shared indexer layer must follow a previous full indexer layer");
+                    top_k = top_k_prev[ib];
+                }
+                ggml_tensor * kq_mask = build_fused_top_k_mask(mask, top_k, il);
+
+                ggml_tensor * pos_b = ggml_view_1d(ctx0, pos_all, b.nr, b.r0*ggml_element_size(pos_all));
+                ggml_tensor * q = ggml_mul_mat(ctx0, L.wq_b, rows(qr, b.r0, b.nr));
+                ggml_tensor * q_nope = ggml_view_3d(ctx0, q, n_embd_head_qk_nope, n_head, b.nr, ggml_row_size(q->type, n_embd_head_k),
+                                                    ggml_row_size(q->type, n_embd_head_k) * n_head, 0);
+                ggml_tensor * q_pe = ggml_view_3d(ctx0, q, n_embd_head_qk_rope, n_head, b.nr, ggml_row_size(q->type, n_embd_head_k),
+                                                  ggml_row_size(q->type, n_embd_head_k) * n_head, ggml_row_size(q->type, n_embd_head_qk_nope));
+                q_pe = ggml_rope_ext(ctx0, q_pe, pos_b, nullptr, n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+                                     ext_factor, attn_factor, beta_fast, beta_slow);
+                q_nope = ggml_permute(ctx0, q_nope, 0, 2, 1, 3);
+                ggml_tensor * q_abs = ggml_mul_mat(ctx0, L.wk_b, q_nope);
+                q_abs = ggml_permute(ctx0, q_abs, 0, 2, 1, 3);
+                ggml_tensor * Q = ggml_concat(ctx0, q_abs, q_pe, 0);
+
+                ggml_tensor * K = ggml_view_4d(ctx0, k_cache, k_cache->ne[0], k_cache->ne[1], b.n_kv, k_cache->ne[3],
+                                               k_cache->nb[1], k_cache->nb[2], k_cache->nb[3], 0);
+                ggml_tensor * V = ggml_view_4d(ctx0, K, kv_lora_rank, K->ne[1], K->ne[2], K->ne[3], K->nb[1], K->nb[2], K->nb[3], 0);
