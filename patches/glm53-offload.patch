+    t.head = next;
+    return slot;
+}
+
+static void ggml_cuda_split_timing_end(ggml_backend_cuda_context * cuda_ctx, int slot) {
+    if (slot < 0) {
+        return;
+    }
+    CUDA_CHECK(cudaEventRecord(g_cuda_split_timing[cuda_ctx->device].end[slot], cuda_ctx->stream()));
+}
