+template <ggml_type TYPE_K>
+static __global__ void lightning_indexer_k_to_f16(const char * __restrict__ K, half * __restrict__ dst,
+        const int64_t n_kv, const int64_t n_stream, const size_t nbk2, const size_t nbk3) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x; // a group of 4 values
+    const int64_t n4 = n_stream*n_kv*32;
+    if (i >= n4) {
