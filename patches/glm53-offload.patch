+                xa[c] = ggml_add(ctx0, o, x[c]);
+                ggml_build_forward_expand(gf, xa[c]);
+                pin_from(n0, c);
+            }
+
+            if ((uint32_t) il < hparams.n_layer_dense_lead) {
+                // a dense layer: each card its own tokens
+                for (int c = 0; c < 2; ++c) {
+                    const int n0 = ggml_graph_n_nodes(gf);
+                    ggml_tensor * h = build_norm(xa[c], W(L.ffn_norm, c), NULL, LLM_NORM_RMS, il);
+                    h = build_ffn(h,
+                        W(L.ffn_up, c), NULL, W(L.ffn_up_s, c),
+                        W(L.ffn_gate, c), NULL, W(L.ffn_gate_s, c),
+                        W(L.ffn_down, c), NULL, W(L.ffn_down_s, c),
+                        NULL, LLM_FFN_SILU, LLM_FFN_PAR, il);
+                    x[c] = ggml_add(ctx0, h, xa[c]);
+                    ggml_build_forward_expand(gf, x[c]);
+                    pin_from(n0, c);
+                }
+                continue;
+            }
+
+            // MoE: every token on both cards (all-gather), the router once on the home card, half of the experts on each card
+            ggml_tensor * hf[2];
+            ggml_tensor * xf[2];
+            for (int c = 0; c < 2; ++c) {
+                const int n0 = ggml_graph_n_nodes(gf);
+                xf[c] = ggml_concat(ctx0, xa[0], xa[1], 1); // 0068: both cards' concats before their norms
+                ggml_build_forward_expand(gf, xf[c]);
+                pin_from(n0, c);
+            }
+            for (int c = 0; c < 2; ++c) {
+                const int n0 = ggml_graph_n_nodes(gf);
+                hf[c] = build_norm(xf[c], W(L.ffn_norm, c), NULL, LLM_NORM_RMS, il);
+                ggml_build_forward_expand(gf, hf[c]);
+                pin_from(n0, c);
+            }
+            {
+                const int n0 = ggml_graph_n_nodes(gf);
+                moe_ep = true;
+                moe_ep_first = 1 - H; // 0068
+                for (int c = 0; c < 2; ++c) {
+                    moe_ep_in[c]      = hf[c];
+                    moe_ep_backend[c] = be[c];
+                    moe_ep_out[c]     = nullptr;
+                }
+                build_moe_ffn(hf[H],
+                    L.ffn_gate_inp,
+                    L.ffn_up_exps,
+                    L.ffn_gate_exps,
+                    L.ffn_down_exps,
+                    L.ffn_exp_probs_b,
+                    n_expert, n_expert_used,
+                    LLM_FFN_SILU, hparams.expert_weights_norm,
+                    hparams.expert_weights_scale,
+                    (llama_expert_gating_func_type) hparams.expert_gating_func,
+                    il,
+                    nullptr,
+                    L.ffn_gate_up_exps,
+                    L.ffn_up_exps_s,
+                    L.ffn_gate_exps_s,
+                    L.ffn_down_exps_s);
+                moe_ep = false;
+                for (int i = n0; i < moe_ep_route_end; ++i) {
+                    ggml_tensor * node = ggml_graph_node(gf, i);
+                    if (node->view_src == nullptr) {
+                        ggml_backend_sched_set_tensor_backend(sched, node, be[H]);
+                    }
+                }
+                GGML_ASSERT(moe_ep_out[0] != nullptr && moe_ep_out[1] != nullptr);
+            }
+            // reduce-scatter: this card's tokens of both partial sums (0068: both cards' adds before the shared experts)
+            ggml_tensor * mr[2];
+            for (int c = 0; c < 2; ++c) {
+                const int n0 = ggml_graph_n_nodes(gf);
+                mr[c] = ggml_add(ctx0, rows2(moe_ep_out[c], c), rows2(moe_ep_out[1 - c], c));
+                ggml_build_forward_expand(gf, mr[c]);
+                pin_from(n0, c);
+            }
+            for (int c = 0; c < 2; ++c) {
+                const int n0 = ggml_graph_n_nodes(gf);
+                ggml_tensor * m  = mr[c];
+                ggml_tensor * sh = build_ffn(rows2(hf[c], c),
+                    W(L.ffn_up_shexp, c), NULL, W(L.ffn_up_shexp_s, c),
+                    W(L.ffn_gate_shexp, c), NULL, W(L.ffn_gate_shexp_s, c),
+                    W(L.ffn_down_shexp, c), NULL, W(L.ffn_down_shexp_s, c),
+                    NULL, LLM_FFN_SILU, LLM_FFN_PAR, il);
+                x[c] = ggml_add(ctx0, ggml_add(ctx0, m, sh), xa[c]);
+                ggml_build_forward_expand(gf, x[c]);
+                pin_from(n0, c);
+            }
+        }
+
+        // the final norm, the MTP hidden state and the logits on the output's card
+        const int co = model.dev_output() == model.tp_devs[0] ? 0 : 1;
+        const int n0 = ggml_graph_n_nodes(gf);
+        ggml_tensor * cur = ggml_concat(ctx0, x[0], x[1], 1);
+        cur = build_norm(cur, model.output_norm, NULL, LLM_NORM_RMS, -1);
+        if (crop_before_nextn(inp_out_ids)) {
+            cur = ggml_get_rows(ctx0, cur, inp_out_ids);
+        }
+        cb(cur, "h_nextn", -1);
+        res->t_h_nextn = cur;
+        if (crop_after_nextn(inp_out_ids)) {
+            cur = ggml_get_rows(ctx0, cur, inp_out_ids);
+        }
+        cb(cur, "result_norm", -1);
+        res->t_embd = cur;
+        cur = ggml_mul_mat(ctx0, model.output, cur);
+        cb(cur, "result_output", -1);
+        res->t_logits = cur;
+        ggml_build_forward_expand(gf, cur);
+        pin_from(n0, co);
+        return;
+    }
+
+    // 0108 LLAMA_LAYER_MAJOR=R (llama_context::decode sets cparams.lm_rows for a batch whose tokens sit at the cells of their positions):
+    // each layer's attention in blocks of R query rows and its FFN in blocks of LLAMA_LM_MOE_ROWS rows, so a ubatch of up to n_ubatch
+    // tokens uploads each layer's experts once while the indexer's scores and masks stay [n_kv, R].  The masks are views of the device's
+    // causal staircase (llama_context::lm_z_init); a block's keys are the cache's first pad256(p0 + rows) cells, a reserve sizes every
+    // block for the whole cache.
+    if (cparams.lm_rows > 0 && lm_z != nullptr && !tp) {
+        GGML_ASSERT(cparams.fused_lid && cparams.fused_top_k_mask);
+        static const int64_t lm_moe_rows = getenv("LLAMA_LM_MOE_ROWS") != nullptr ? std::max(256, atoi(getenv("LLAMA_LM_MOE_ROWS"))) : 8192;
+        const int64_t R = cparams.lm_rows;
+
+        ggml_tensor * x       = build_inp_embd(model.tok_embd);
+        ggml_tensor * pos_all = build_inp_pos();
+        llm_graph_input_attn_k_dsa * inp = build_attn_inp_k_dsa();
+        ggml_tensor * out_ids = build_inp_out_ids();
+        res->add_input(std::make_unique<llm_graph_input_lm_once>());
+        if (moe_cache != nullptr) {
+            moe_cache->clear_preds();
+        }
+
+        const auto * mctx_mla = inp->mctx->get_mla();
+        const auto * mctx_lid = inp->mctx->get_lid();
+        const int64_t n_kv = mctx_mla->get_n_kv();
+
+        auto z_of = [&](int il) -> ggml_tensor * {
+            const ggml_backend_dev_t d = model.dev_layer(il);
+            for (const auto & e : *lm_z) {
+                if (e.first == d) {
+                    return e.second;
+                }
+            }
+            GGML_ABORT("LLAMA_LAYER_MAJOR: no causal staircase on the device of layer %d", il);
+        };
+        ggml_tensor * Z0 = lm_z->front().second;
+        const int64_t Rp = GGML_PAD(R, 8);
+        const int64_t S  = GGML_PAD((int64_t) cparams.n_ctx, 8); // 0118: the staircase is S + Rp + 512 wide again
+        GGML_ASSERT(S > 0 && S + Rp + 512 <= Z0->ne[0] && Z0->ne[1] >= Rp + 8);
+
+        // the attention blocks: rows [r0, r0 + nr), keys [0, n_kv), the staircase view at column c, row d
+        struct lm_block { int64_t r0, nr, n_kv, c, d; };
+        std::vector<lm_block> blocks;
+        // 0112: the reserve graph's structure for every ubatch -- ceil(n_ubatch / R) blocks sharing the rows evenly (fewer only for a
+        // ubatch with fewer rows), so every layer-major graph fits the one worst-case reserve and the allocator never re-plans (which
+        // synchronizes every backend: with blocks of R rows each ubatch after the first waited ~1.8 s for the one before it)
+        const int64_t n_blk = std::max<int64_t>(1, std::min<int64_t>(n_tokens, ((int64_t) cparams.n_ubatch + R - 1)/R));
+        for (int64_t ib = 0, r0 = 0; ib < n_blk; ++ib) {
+            lm_block b = { r0, n_tokens/n_blk + (ib < n_tokens % n_blk ? 1 : 0), n_kv, 0, 0 };
+            r0 += b.nr;
+            if (!cparams.lm_reserve) {
+                const int64_t p0   = ubatch.pos[b.r0];
+                const int64_t base = S - p0;
+                // 0118: the block's own keys -- the allocator's plan is the worst-case graph (process_ubatch reserves it before a run of
+                // layer-major ubatches), every block over the whole cache, so keys that grow with p0 never outgrow it
+                b.n_kv = std::min<int64_t>(n_kv, GGML_PAD(p0 + b.nr, 256));
