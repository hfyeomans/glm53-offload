+        dev_bytes[model.dev_layer(il)] += ggml_nbytes(t);
+        total += ggml_nbytes(t);
+    }
+    // no device holds more than 2/3 of them
+    for (const auto & [dev, bytes] : dev_bytes) {
+        if (3*bytes > 2*total) {
+            return false;
+        }
+    }
+    return true;
+}
