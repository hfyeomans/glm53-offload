From 6b78a06f251a5d54a7cd75217a13920892fa7f8c Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Mon, 2 Nov 2026 12:50:46 -0600
Subject: [PATCH 001/211] moe cache: prompt-informed admission
 (LLAMA_MOE_CACHE_ADMIT, default 32)

The experts selected during prompt processing (large batches, which only read the cache) are counted per layer in the
scheduler copy callback, asynchronously under pipeline parallelism; the first small batch after the prompt admits each
cached layer's top-K prompt experts through plan() and the upload path, so generation starts with the prompt's hot set
instead of warming the LRU over ~2,000 tokens.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/llama-context.cpp   |  17 ++++
 src/llama-context.h     |   2 +
 src/llama-moe-cache.cpp | 174 ++++++++++++++++++++++++++++++++++++++++
 src/llama-moe-cache.h   |   8 ++
 4 files changed, 201 insertions(+)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index df7802930..977defa02 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -2893,6 +2893,14 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
         const bool    full_batch = ids->ne[1] >= (int64_t) std::min(lctx->cparams.n_ctx, lctx->cparams.n_ubatch);
         st.upload_all = st.upload_all || (st.prev_in_flight ? n_ids >= 16*n_expert : full_batch && n_ids >= 64*n_expert);
         if (st.upload_all) {
+            // the ids are not read here (it would stall the graphs in flight); the MoE cache counts them asynchronously for admission
+            if (lctx->moe_cache && ids != st.ids_noted) {
+                const int32_t il = lctx->moe_cache->layer_of_weight(src);
+                if (il >= 0) {
+                    lctx->moe_cache->note_prompt_ids_async(backend, il, ids);
+                }
+                st.ids_noted = ids;
+            }
             return false;
         }
     }
@@ -2914,6 +2922,15 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
         st.ids = ids;
     }
 
+    // the experts of a large batch are counted for the admission into the MoE cache, once per layer
+    if (lctx->moe_cache && ids != st.ids_noted) {
+        const int32_t il = lctx->moe_cache->layer_of_weight(src);
+        if (il >= 0) {
+            lctx->moe_cache->note_prompt_ids(il, st.ids_data.data(), ids->ne[0], ids->ne[1], ids->nb[0], ids->nb[1]);
+        }
+        st.ids_noted = ids;
+    }
+
     // group consecutive experts and copy them together
     for (int64_t first = 0; first < n_expert; ) {
         if (!st.used[first]) {
