From 66eed1b24aa87596e0a9be93c17a1fcf0310d643 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Mon, 2 Nov 2026 13:25:45 -0600
Subject: [PATCH 004/141] twin backends (LLAMA_TWIN_BACKENDS=1): prefill
 overlap of expert copies and GEMMs

A second backend per GPU device, with its own stream and scheduler buffers, runs the large-batch expert splits of
alternate host-resident layers: the scheduler then copies layer L+1 experts (from the MoE cache banks or the host) on
the twin stream while the primary computes layer L. No scheduler change; the MoE cache treats a twin as its device.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/llama-context.cpp   | 22 ++++++++++++++++++++++
 src/llama-context.h     |  3 +++
 src/llama-graph.cpp     | 24 ++++++++++++++++++++++++
 src/llama-graph.h       |  5 +++++
 src/llama-moe-cache.cpp | 14 +++++++++++---
 5 files changed, 65 insertions(+), 3 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 9601684e0..723698295 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -478,6 +478,27 @@ llama_context::llama_context(
             backends.emplace_back(backend);
         }
 
+        // twin backends (LLAMA_TWIN_BACKENDS=1): a second backend per GPU device with its own stream and scheduler buffers; the
+        // large-batch expert splits of alternate host-resident layers run on it, so the scheduler copies a layer's experts while
+        // the primary backend computes the previous layer (prefill overlap)
+        if (const char * s = getenv("LLAMA_TWIN_BACKENDS"); s != nullptr && atoi(s) > 0) {
+            const size_t n_primary = backends.size();
+            for (size_t i = 0; i < n_primary; ++i) {
+                ggml_backend_t primary = backends[i].get();
+                ggml_backend_dev_t dev = ggml_backend_get_device(primary);
+                if (ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU) {
+                    continue;
+                }
+                ggml_backend_t twin = ggml_backend_dev_init(dev, nullptr);
+                if (twin == nullptr) {
+                    throw std::runtime_error(format("failed to initialize the twin backend of %s", ggml_backend_dev_name(dev)));
+                }
+                backends.emplace_back(twin);
+                twins.emplace_back(primary, twin);
+                LLAMA_LOG_INFO("%s: twin backend for %s\n", __func__, ggml_backend_dev_name(dev));
+            }
+        }
+
         // add ACCEL backends (such as BLAS)
         for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
             ggml_backend_dev_t dev = ggml_backend_dev_get(i);
@@ -2789,6 +2810,7 @@ llm_graph_params llama_context::graph_params(
         /*.mctx        =*/ mctx,
         /*.cross       =*/ &cross,
         /*.moe_cache   =*/ moe_cache.get(),
+        /*.twins       =*/ twins.empty() ? nullptr : &twins,
         /*.prec_policy =*/ &model.prec_policy,
         /*.hdmd        =*/ model.hdmd.rot.empty() ? nullptr : &model.hdmd,
         /*.samplers    =*/ sampling.samplers,
diff --git a/src/llama-context.h b/src/llama-context.h
index 7036ec4f0..3657ef764 100644
--- a/src/llama-context.h
+++ b/src/llama-context.h
@@ -397,6 +397,9 @@ private:
 
     copy_experts_info copy_experts;
 
+    // twin backends for the prefill overlap (LLAMA_TWIN_BACKENDS): primary -> second backend on the same device
+    std::vector<std::pair<ggml_backend_t, ggml_backend_t>> twins;
+
     // graph reallocations during inference where the backend assignments did not change, split by whether the
     // graph size is the same as the previously scheduled one (unexpected) or different
     int32_t n_reallocs_same = 0;
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index f19d0b8f1..6b3b7f3d8 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1563,6 +1563,7 @@ llm_graph_context::llm_graph_context(const llm_graph_params & params) :
     mctx             (params.mctx),
     cross            (params.cross),
     moe_cache        (params.moe_cache),
+    twins            (params.twins),
     prec_policy      (params.prec_policy),
     hdmd             (params.hdmd),
     samplers         (params.samplers),
@@ -2547,6 +2548,20 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         return experts;
     };
 
+    // prefill overlap: the large-batch expert split of alternate host-resident layers runs on the twin backend of the layer's device,
+    // so the scheduler copies this layer's experts while the primary backend computes the previous layer
+    ggml_backend_t twin = nullptr;
+    const int n_nodes_twin = ggml_graph_n_nodes(gf);
+    if (twins != nullptr && slots == nullptr && moe_cache != nullptr && il >= 0 && (il % 2) == 1 && n_tokens > 32 &&
+        moe_cache->get_experts(up_exps != nullptr ? up_exps : gate_up_exps) != nullptr) {
+        ggml_backend_t primary = moe_cache->backend(il);
+        for (const auto & pt : *twins) {
+            if (pt.first == primary) {
+                twin = pt.second;
+            }
+        }
+    }
+
     ggml_tensor * experts = nullptr;
     if (cpu_ids == nullptr) {
         experts = build_experts(cur, selected_experts, slots, true);
@@ -2627,6 +2642,15 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
 
     cb(moe_out, "ffn_moe_out", il);
 
+    if (twin != nullptr) {
+        for (int i = n_nodes_twin; i < ggml_graph_n_nodes(gf); ++i) {
+            ggml_tensor * node = ggml_graph_node(gf, i);
+            if (node->view_src == nullptr) {
+                ggml_backend_sched_set_tensor_backend(sched, node, twin);
+            }
+        }
+    }
+
     return moe_out;
 }
 
diff --git a/src/llama-graph.h b/src/llama-graph.h
index 45ca60daa..bdd01844f 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -790,6 +790,9 @@ struct llm_graph_params {
     const llama_cross            * cross;
     llama_moe_cache              * moe_cache;
 
+    // twin backends (prefill overlap): primary -> a second backend on the same device, for the large-batch expert splits of alternate layers
+    const std::vector<std::pair<ggml_backend_t, ggml_backend_t>> * twins = nullptr;
+
     const llama_prec_policy * prec_policy = nullptr;
 
     const llama_hadamard * hdmd = nullptr;
@@ -1042,6 +1045,8 @@ struct llm_graph_context {
 
     ggml_backend_t backend_cpu; // TODO: needed by build_attn_mha, figure out a way to remove?
 
+    const std::vector<std::pair<ggml_backend_t, ggml_backend_t>> * twins; // see llm_graph_params
+
     const llama_adapter_cvec     * cvec;
     const llama_adapter_loras    * loras;
     const llama_memory_context_i * mctx;
diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index 22bbe327b..67e58f1f4 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -336,6 +336,7 @@ struct llama_moe_cache::impl {
     // prompt-informed admission
     struct pending_ids {
         int32_t il;
+        ggml_backend_t backend; // the stream the read was issued on (a twin, possibly)
         size_t  pos;      // offset in pending_buf, in int32_t
         int64_t ne0, ne1;
         size_t  nb0, nb1; // strides in bytes, as read
@@ -367,6 +368,10 @@ struct llama_moe_cache::impl {
         for (size_t i = 0; i < backends.size(); ++i) {
             const auto dev_type = ggml_backend_dev_type(ggml_backend_get_device(backends[i]));
             if (dev_type == GGML_BACKEND_DEVICE_TYPE_GPU || dev_type == GGML_BACKEND_DEVICE_TYPE_IGPU) {
+                // a twin backend of a device already listed shares its cache
+                if (std::any_of(devices.begin(), devices.end(), [&](const device & d) { return ggml_backend_get_device(d.backend) == ggml_backend_get_device(backends[i]); })) {
+                    continue;
+                }
                 auto & d = devices.emplace_back();
                 d.backend = backends[i];
                 d.buft    = bufts[i];
@@ -674,8 +679,8 @@ struct llama_moe_cache::impl {
         }
         const binding & b = it->second;
         const group & g = groups[layers[b.il].ig];
-        if (backend != devices[g.id].backend) {
-            return 0;
+        if (ggml_backend_get_device(backend) != ggml_backend_get_device(devices[g.id].backend)) {
+            return 0; // a twin backend of the device may copy from the banks
         }
 
         // large batches only read the cache, so the experts used in generation stay in it
@@ -924,6 +929,9 @@ struct llama_moe_cache::impl {
                 ggml_backend_synchronize(d.backend);
             }
         }
+        for (const pending_ids & p : pending) {
+            ggml_backend_synchronize(p.backend);
+        }
         const int32_t * base = (const int32_t *) ggml_backend_buffer_get_base(pending_buf.get());
         for (const pending_ids & p : pending) {
             count_ids(layers[p.il], base + p.pos, p.ne0, p.ne1, p.nb0, p.nb1);
@@ -951,7 +959,7 @@ struct llama_moe_cache::impl {
         }
         int32_t * base = (int32_t *) ggml_backend_buffer_get_base(pending_buf.get());
         ggml_backend_tensor_get_async(backend, ids, base + pending_pos, 0, ggml_nbytes(ids));
-        pending.push_back({ il, pending_pos, ids->ne[0], ids->ne[1], ids->nb[0], ids->nb[1] });
+        pending.push_back({ il, backend, pending_pos, ids->ne[0], ids->ne[1], ids->nb[0], ids->nb[1] });
         pending_pos += GGML_PAD(n, 16);
         prompt_pending = true;
     }
