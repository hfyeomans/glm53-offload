+// the same physical device: the device object, or a twin of it (same PCI bus id)
+static bool llama_moe_cache_same_device(ggml_backend_t a, ggml_backend_t b) {
+    ggml_backend_dev_t da = ggml_backend_get_device(a);
+    ggml_backend_dev_t db = ggml_backend_get_device(b);
+    if (da == db) {
+        return true;
+    }
+    if (da == nullptr || db == nullptr) {
+        return false;
+    }
+    ggml_backend_dev_props pa;
+    ggml_backend_dev_props pb;
+    ggml_backend_dev_get_props(da, &pa);
+    ggml_backend_dev_get_props(db, &pb);
+    return pa.device_id != nullptr && pb.device_id != nullptr && strcmp(pa.device_id, pb.device_id) == 0;
+}
