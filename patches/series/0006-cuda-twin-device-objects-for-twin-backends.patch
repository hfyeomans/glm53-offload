+// twin device objects: one per CUDA device, created on demand, not listed by the registry
+static ggml_backend_dev_t ggml_backend_cuda_twin_device(int device) {
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    static ggml_backend_device twin_devices[GGML_CUDA_MAX_DEVICES];
+    static bool initialized[GGML_CUDA_MAX_DEVICES] = {};
+    if (device < 0 || device >= ggml_backend_cuda_get_device_count()) {
+        return nullptr;
+    }
+    if (!initialized[device]) {
+        ggml_backend_dev_t primary = ggml_backend_reg_dev_get(ggml_backend_cuda_reg(), device);
+        ggml_backend_cuda_device_context * ctx = new ggml_backend_cuda_device_context(*(ggml_backend_cuda_device_context *) primary->context);
+        ctx->name += "_twin";
+        ctx->twin  = true;
+        twin_devices[device] = {
+            /* .iface   = */ ggml_backend_cuda_device_interface,
+            /* .reg     = */ ggml_backend_cuda_reg(),
+            /* .context = */ ctx,
+        };
+        initialized[device] = true;
+    }
+    return &twin_devices[device];
+}
+
+ggml_backend_buffer_type_t ggml_backend_cuda_buffer_type_twin(int device) {
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    static ggml_backend_buffer_type twin_bufts[GGML_CUDA_MAX_DEVICES];
+    static bool initialized[GGML_CUDA_MAX_DEVICES] = {};
+    if (device < 0 || device >= ggml_backend_cuda_get_device_count()) {
+        return nullptr;
+    }
+    if (!initialized[device]) {
+        twin_bufts[device] = {
+            /* .iface    = */ ggml_backend_cuda_buffer_type_interface,
+            /* .device   = */ ggml_backend_cuda_twin_device(device),
+            /* .context  = */ new ggml_backend_cuda_buffer_type_context{device, GGML_CUDA_NAME + std::to_string(device) + "_twin"},
+        };
+        initialized[device] = true;
+    }
+    return &twin_bufts[device];
+}
+
+ggml_backend_t ggml_backend_cuda_init_twin(int device) {
+    if (device < 0 || device >= ggml_backend_cuda_get_device_count()) {
+        GGML_LOG_ERROR("%s: invalid device %d\n", __func__, device);
+        return nullptr;
+    }
+    ggml_backend_cuda_context * ctx = new ggml_backend_cuda_context(device);
+    ctx->name += "_twin";
+    ctx->twin  = true;
+    ggml_backend_t twin = new ggml_backend {
+        /* .guid    = */ ggml_backend_cuda_guid(),
+        /* .iface   = */ ggml_backend_cuda_interface,
+        /* .device  = */ ggml_backend_cuda_twin_device(device),
+        /* .context = */ ctx,
+    };
+    return twin;
+}
+
 ggml_backend_t ggml_backend_cuda_init(int device) {
     if (device < 0 || device >= ggml_backend_cuda_get_device_count()) {
         GGML_LOG_ERROR("%s: invalid device %d\n", __func__, device);
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
