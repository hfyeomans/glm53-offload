+    int twin_idx = -1; // -1 = the primary backend of the device, k = twin k (see ggml_backend_cuda_init_twin)
     cudaEvent_t copy_event = nullptr;
 
     cudaStream_t streams[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS] = {};
