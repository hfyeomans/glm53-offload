 ggml/src/ggml-cuda/common.cuh   |  2 +-
 ggml/src/ggml-cuda/ggml-cuda.cu | 71 +++++++++++++++++++--------------
 src/llama-context.cpp           | 18 +++++----
 src/llama-graph.cpp             |  9 ++++-
 5 files changed, 62 insertions(+), 43 deletions(-)

diff --git a/ggml/include/ggml-cuda.h b/ggml/include/ggml-cuda.h
index 649c4fb86..fa5d4da5d 100644
--- a/ggml/include/ggml-cuda.h
+++ b/ggml/include/ggml-cuda.h
@@ -24,8 +24,9 @@ GGML_BACKEND_API ggml_backend_t ggml_backend_cuda_init(int device);
 
 // a twin backend of a device: a second backend on the same CUDA device with its own stream, device object and buffer type, so a
 // scheduler orders its work against the primary backend with copies and events (also ggml_backend_dev_init(dev, "twin"))
-GGML_BACKEND_API ggml_backend_t ggml_backend_cuda_init_twin(int device);
-GGML_BACKEND_API ggml_backend_buffer_type_t ggml_backend_cuda_buffer_type_twin(int device);
+// k = 0..3 selects one of up to four twins of the device (ggml_backend_dev_init(dev, "twin"), "twin1", ...)
+GGML_BACKEND_API ggml_backend_t ggml_backend_cuda_init_twin(int device, int k);
+GGML_BACKEND_API ggml_backend_buffer_type_t ggml_backend_cuda_buffer_type_twin(int device, int k);
 
 GGML_BACKEND_API bool ggml_backend_is_cuda(ggml_backend_t backend);
 
