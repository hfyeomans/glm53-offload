From a2622162cfb65488add5c323138397d210e5a4fd Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Mon, 2 Nov 2026 14:46:22 -0600
Subject: [PATCH 012/211] context: no graph reuse for large batches under
 pipeline parallelism

A reused graph forces a full scheduler synchronization before set_inputs under pipeline parallelism, which drains the
pipeline between the ubatches of a prompt (the cards alternate 99 % / 0 %). Build a fresh graph for batches above 32
tokens when pipelining; LLAMA_GRAPH_REUSE_LARGE_PP=1 restores the old behaviour.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/llama-context.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 3b87245a2..443263b09 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1619,7 +1619,11 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
     // in order to correctly reuse a graph, it's full topology has to be uniquely determined by these parameters
     const auto gparams = graph_params(res, ubatch, mctx, gtype);
 
-    if (!graph_reuse_disable && gf_res_prev_active == res && res->can_reuse(gparams)) {
+    // under pipeline parallelism a reused graph forces a full synchronization before set_inputs (below), which drains the pipeline
+    // between the ubatches of a prompt: build a fresh graph for large batches, keep the reuse for decode
+    static const bool reuse_large_pp = getenv("LLAMA_GRAPH_REUSE_LARGE_PP") != nullptr && atoi(getenv("LLAMA_GRAPH_REUSE_LARGE_PP")) != 0;
+    const bool no_reuse_pp = cparams.pipeline_parallel && ubatch.n_tokens > 32 && !reuse_large_pp;
+    if (!graph_reuse_disable && !no_reuse_pp && gf_res_prev_active == res && res->can_reuse(gparams)) {
         //LLAMA_LOG_DEBUG("%s: reusing previous graph\n", __func__);
 
         // with pipeline parallelism, the previous graph_compute_async may still be running
