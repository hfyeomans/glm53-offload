diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index e5cc58efc..4657beec5 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -6537,6 +6537,67 @@ ggml_backend_t ggml_backend_cuda_init_twin(int device, int k) {
     return twin;
 }
 
+// gather copy: one kernel moves n experts of `size` bytes from their sources (device banks or mapped pinned host memory) into dst
+#define GGML_CUDA_GATHER_MAX 256
+struct ggml_cuda_gather_table {
+    const void * src[GGML_CUDA_GATHER_MAX];
+};
+
+static __global__ void ggml_cuda_gather_copy_kernel(const ggml_cuda_gather_table table, char * dst, const size_t size, const size_t chunk) {
+    const int e = blockIdx.y;
+    const char * src = (const char *) table.src[e];
+    if (src == nullptr) {
+        return;
+    }
+    const size_t off = (size_t) blockIdx.x*chunk;
+    if (off >= size) {
+        return;
+    }
+    const size_t end = off + chunk < size ? off + chunk : size;
+    char * d = dst + (size_t) e*size;
+    const size_t n16 = (end - off)/16;
+    const int4 * s4 = (const int4 *) (src + off);
+    int4 * d4 = (int4 *) (d + off);
+    for (size_t i = threadIdx.x; i < n16; i += blockDim.x) {
+        d4[i] = s4[i];
+    }
+    if (threadIdx.x == 0) {
+        for (size_t i = off + n16*16; i < end; ++i) {
+            d[i] = src[i];
+        }
+    }
+}
+
+void ggml_backend_cuda_gather_copy_async(ggml_backend_t backend, void * dst, const void * const * srcs, int64_t n, size_t size) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(cuda_ctx->device);
+    const size_t chunk = 1024*1024;
+    const unsigned n_chunks = (unsigned) ((size + chunk - 1)/chunk);
+    for (int64_t first = 0; first < n; first += GGML_CUDA_GATHER_MAX) {
+        const int cnt = (int) std::min<int64_t>(GGML_CUDA_GATHER_MAX, n - first);
+        ggml_cuda_gather_table table;
+        for (int i = 0; i < cnt; ++i) {
+            table.src[i] = srcs[first + i];
+        }
+        for (int i = cnt; i < GGML_CUDA_GATHER_MAX; ++i) {
+            table.src[i] = nullptr;
+        }
+        const dim3 grid(n_chunks, cnt);
+        ggml_cuda_gather_copy_kernel<<<grid, 256, 0, cuda_ctx->stream()>>>(table, (char *) dst + (size_t) first*size, size, chunk);
+        CUDA_CHECK(cudaGetLastError());
+    }
+}
+
+bool ggml_backend_cuda_host_ptr_device_accessible(const void * ptr) {
+    cudaPointerAttributes attr;
+    const cudaError_t err = cudaPointerGetAttributes(&attr, ptr);
+    if (err != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    return attr.type == cudaMemoryTypeHost && attr.devicePointer != nullptr;
+}
