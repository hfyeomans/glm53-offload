                 for (int64_t e = 0; e < n_expert; ) {
diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index 23c7da563..b00a117a7 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -724,6 +724,26 @@ struct llama_moe_cache::impl {
         return n;
     }
 
+    const void * cached_expert(ggml_backend_t backend, const ggml_tensor * w, int64_t e) {
+        const auto it = bindings.find(w);
+        if (it == bindings.end()) {
+            return nullptr;
+        }
+        const binding & b = it->second;
+        const group & g = groups[layers[b.il].ig];
+        if (!llama_moe_cache_same_device(backend, devices[g.id].backend)) {
+            return nullptr;
+        }
+        const int32_t * slots = g.slru.slot_map[b.il];
+        if (slots == nullptr || slots[e] >= g.n_slots) {
+            return nullptr;
+        }
+        const ggml_tensor * bank = g.banks[b.ip];
+        stats_copy.hits  += 1;
+        stats_copy.bytes += bank->nb[2];
+        return (const char *) bank->data + (size_t) slots[e]*bank->nb[2];
+    }
+
     static const ggml_tensor * base_of(const ggml_tensor * t) {
         while (t->view_src != nullptr) {
             t = t->view_src;
@@ -1109,6 +1129,10 @@ int64_t llama_moe_cache::copy_experts(ggml_backend_t backend, const ggml_tensor
     return pimpl->copy_experts(backend, w, dst, e, last);
 }
 
+const void * llama_moe_cache::cached_expert(ggml_backend_t backend, const ggml_tensor * w, int64_t e) {
+    return pimpl->cached_expert(backend, w, e);
+}
