     const int64_t n_expert    = src->ne[2];
     const size_t  expert_size = src->nb[2];
 
+    // all the experts in one gather kernel: the cached ones from the device banks, the rest from the pinned host weights (UVA)
+    auto gather_all = [&]() -> bool {
+#ifdef GGML_USE_CUDA
+        if (!ggml_backend_is_cuda(backend) || n_expert > 256 || !ggml_backend_cuda_host_ptr_device_accessible(src->data)) {
+            return false;
+        }
+        const void * table[256];
+        for (int64_t e = 0; e < n_expert; ++e) {
+            const void * p = lctx->moe_cache ? lctx->moe_cache->cached_expert(backend, src, e) : nullptr;
+            table[e] = p != nullptr ? p : (const void *) ((const uint8_t *) src->data + e*expert_size);
+        }
+        ggml_backend_cuda_gather_copy_async(backend, dst->data, table, n_expert, expert_size);
+        return true;
+#else
+        return false;
+#endif
+    };
+
     // on a twin backend the host weights are copied before the other inputs of the split (host_weights_first), so the ids are
     // not readable here: upload all the experts, the cached ones from the device banks
     bool is_twin = false;
     for (const auto & pt : lctx->twins) {
         is_twin = is_twin || pt.second == backend;
     }
+    if (is_twin && lctx->moe_cache && lctx->moe_cache->layer_of_weight(src) >= 0 && gather_all()) {
+        return true;
+    }
     if (is_twin && lctx->moe_cache && lctx->moe_cache->layer_of_weight(src) >= 0) {
         int64_t next = 0;
         for (int64_t e = 0; e < n_expert; ) {
