From 8a3de57fae3fe0e6e06dfd3b61a6a59c8676842a Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Mon, 2 Nov 2026 15:37:54 -0600
Subject: [PATCH 016/141] context: GGML_SCHED_TIMING=1 logs per large ubatch
 the gap since the previous one, build + alloc, set_inputs and the graph issue

---
 src/llama-context.cpp | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 45bb82888..54b61d0c9 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1623,6 +1623,11 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
     // in order to correctly reuse a graph, it's full topology has to be uniquely determined by these parameters
     const auto gparams = graph_params(res, ubatch, mctx, gtype);
 
+    // GGML_SCHED_TIMING=1: where the host time of a large ubatch goes outside the scheduler
+    static const bool ubatch_timing = getenv("GGML_SCHED_TIMING") != nullptr && atoi(getenv("GGML_SCHED_TIMING")) > 0;
+    static int64_t t_ubatch_prev_end = 0;
+    const int64_t t_ub0 = ubatch_timing ? ggml_time_us() : 0;
+
     // under pipeline parallelism a reused graph forces a full synchronization before set_inputs (below), which drains the pipeline
     // between the ubatches of a prompt: build a fresh graph for large batches, keep the reuse for decode
     static const bool reuse_large_pp = getenv("LLAMA_GRAPH_REUSE_LARGE_PP") != nullptr && atoi(getenv("LLAMA_GRAPH_REUSE_LARGE_PP")) != 0;
@@ -1667,6 +1672,8 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
         gf_res_prev_active = res;
     }
 
+    const int64_t t_ub1 = ubatch_timing ? ggml_time_us() : 0;
+
     // set the input data for the input tensors
     {
         //const auto t_start_us = ggml_time_us();
@@ -1677,7 +1684,17 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
         //LLAMA_LOG_INFO("graph set inputs time: %.3f ms\n", (ggml_time_us() - t_start_us)/1000.0);
     }
 
+    const int64_t t_ub2 = ubatch_timing ? ggml_time_us() : 0;
+
     const auto status = graph_compute(res->get_gf(), ubatch.n_tokens > 1);
+    if (ubatch_timing) {
+        const int64_t t_ub3 = ggml_time_us();
+        if (ubatch.n_tokens > 32) {
+            LLAMA_LOG_INFO("ubatch timing: %d tokens: gap since the previous ubatch %.1f ms, build + alloc %.1f ms, set_inputs %.1f ms, graph issue %.1f ms\n",
+                (int) ubatch.n_tokens, t_ubatch_prev_end ? (t_ub0 - t_ubatch_prev_end)/1000.0 : 0.0, (t_ub1 - t_ub0)/1000.0, (t_ub2 - t_ub1)/1000.0, (t_ub3 - t_ub2)/1000.0);
+        }
+        t_ubatch_prev_end = t_ub3;
+    }
     if (status != GGML_STATUS_SUCCESS) {
         LLAMA_LOG_ERROR("%s: failed to compute graph, compute status: %d\n", __func__, status);
         ret = status;
-- 
