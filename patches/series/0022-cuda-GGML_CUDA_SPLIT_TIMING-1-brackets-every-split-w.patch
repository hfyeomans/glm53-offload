From 8026b0c8393a357e72c29926acf97f16571dd1ed Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Tue, 3 Nov 2026 09:29:13 -0600
Subject: [PATCH 022/211] cuda: GGML_CUDA_SPLIT_TIMING=1 brackets every split
 with timing events and prints busy / gap totals per device

---
 ggml/src/ggml-cuda/ggml-cuda.cu | 74 +++++++++++++++++++++++++++++++++
 1 file changed, 74 insertions(+)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 12c5304e7..9b0e079d4 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5002,11 +5002,83 @@ static bool ggml_cuda_graph_set_enabled(ggml_backend_cuda_context * cuda_ctx, co
 }
 #endif // USE_CUDA_GRAPH
 
+// GGML_CUDA_SPLIT_TIMING=1: device time of every split (one graph compute) and the idle gaps between consecutive splits, per device
+struct ggml_cuda_split_timing {
+    static constexpr int N = 2048;
+    cudaEvent_t start[N] = {};
+    cudaEvent_t end[N]   = {};
+    int    head = 0;      // next slot to record
+    int    tail = 0;      // oldest unprocessed slot
+    int    prev = -1;     // the last processed slot, for the gap to the next
+    int    n    = 0;      // processed splits since the last print
+    double busy_ms = 0.0;
+    double gap_ms  = 0.0;
+};
+
+static ggml_cuda_split_timing g_cuda_split_timing[GGML_CUDA_MAX_DEVICES];
+
+static bool ggml_cuda_split_timing_enabled(void) {
+    static const bool enabled = getenv("GGML_CUDA_SPLIT_TIMING") != nullptr && atoi(getenv("GGML_CUDA_SPLIT_TIMING")) > 0;
+    return enabled;
+}
+
+static int ggml_cuda_split_timing_begin(ggml_backend_cuda_context * cuda_ctx) {
+    if (!ggml_cuda_split_timing_enabled()) {
+        return -1;
+    }
+    ggml_cuda_split_timing & t = g_cuda_split_timing[cuda_ctx->device];
+    // account the completed splits
+    while (t.tail != t.head) {
+        if (cudaEventQuery(t.end[t.tail]) != cudaSuccess) {
+            (void) cudaGetLastError();
+            break;
+        }
+        float ms = 0.0f;
+        CUDA_CHECK(cudaEventElapsedTime(&ms, t.start[t.tail], t.end[t.tail]));
+        t.busy_ms += ms;
+        if (t.prev >= 0) {
+            CUDA_CHECK(cudaEventElapsedTime(&ms, t.end[t.prev], t.start[t.tail]));
+            t.gap_ms += ms;
+        }
+        t.prev = t.tail;
+        t.tail = (t.tail + 1) % ggml_cuda_split_timing::N;
+        t.n   += 1;
+    }
+    if (t.n >= 4096) {
+        GGML_LOG_INFO("cuda split timing: device %d: %d splits: busy %.1f ms, gaps %.1f ms (%.1f us per split busy, %.1f us gap)\n",
+            cuda_ctx->device, t.n, t.busy_ms, t.gap_ms, 1000.0*t.busy_ms/t.n, 1000.0*t.gap_ms/t.n);
+        t.n = 0;
+        t.busy_ms = 0.0;
+        t.gap_ms  = 0.0;
+    }
+    const int slot = t.head;
+    const int next = (slot + 1) % ggml_cuda_split_timing::N;
+    if (next == t.tail) {
+        return -1; // the ring is full: the device is far behind, skip this split
+    }
+    if (t.start[slot] == nullptr) {
+        CUDA_CHECK(cudaEventCreate(&t.start[slot]));
+        CUDA_CHECK(cudaEventCreate(&t.end[slot]));
+    }
+    CUDA_CHECK(cudaEventRecord(t.start[slot], cuda_ctx->stream()));
+    t.head = next;
+    return slot;
+}
+
+static void ggml_cuda_split_timing_end(ggml_backend_cuda_context * cuda_ctx, int slot) {
+    if (slot < 0) {
+        return;
+    }
+    CUDA_CHECK(cudaEventRecord(g_cuda_split_timing[cuda_ctx->device].end[slot], cuda_ctx->stream()));
+}
+
 static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend, ggml_cgraph * cgraph) {
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
 
     ggml_cuda_set_device(cuda_ctx->device);
 
+    const int split_timing_slot = ggml_cuda_split_timing_begin(cuda_ctx);
+
     bool use_cuda_graph             = false;
     bool cuda_graph_update_required = false;
     const void * graph_key = nullptr;
@@ -5062,6 +5134,8 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
 
     ggml_cuda_graph_evaluate_and_capture(cuda_ctx, cgraph, use_cuda_graph, cuda_graph_update_required, graph_key);
 
+    ggml_cuda_split_timing_end(cuda_ctx, split_timing_slot);
+
     return GGML_STATUS_SUCCESS;
 }
 
