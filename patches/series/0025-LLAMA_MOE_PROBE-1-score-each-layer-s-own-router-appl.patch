From 5b43a8363e069117bb57513f953006ffcc75c3b4 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Tue, 3 Nov 2026 10:46:12 -0600
Subject: [PATCH 025/211] LLAMA_MOE_PROBE=1: score each layer's own router
 applied to the pre-attention residual of layers il, il+1, il+2 against the
 experts selected (the measurement behind prefetching predicted misses)

---
 src/llama-context.cpp   | 40 +++++++++++++++++++++++++++++++++++++
 src/llama-graph.cpp     | 11 +++++++++++
 src/llama-graph.h       |  5 +++++
 src/llama-moe-cache.cpp |  6 ++++++
 src/llama-moe-cache.h   |  3 +++
 src/models/glm-dsa.cpp  | 44 +++++++++++++++++++++++++++++++++++++++++
 6 files changed, 109 insertions(+)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 2ed0a3469..a0617bc63 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -2911,6 +2911,46 @@ ggml_status llama_context::graph_compute(
         memset(st.t_path, 0, sizeof(st.t_path));
         memset(st.n_path, 0, sizeof(st.n_path));
     }
+
+    // LLAMA_MOE_PROBE=1: score the expert predictions made from the pre-attention residual against the selections (decode graphs)
+    static const bool moe_probe = getenv("LLAMA_MOE_PROBE") != nullptr && atoi(getenv("LLAMA_MOE_PROBE")) != 0;
+    if (moe_probe && !batched && moe_cache) {
+        static int64_t probe_hit[3] = {};
+        static int64_t probe_n[3]   = {};
+        static int     probe_tokens = 0;
+        std::vector<int32_t> pred;
+        char name[64];
+        for (int k = 0; k < 3; ++k) {
+            for (int jl = 0; jl < (int) model.hparams.n_layer(); ++jl) {
+                const int n_used = (int) model.hparams.n_expert_used(jl);
+                pred.resize(n_used);
+                snprintf(name, sizeof(name), "moe_probe_k%d_l%d", k, jl);
+                ggml_tensor * t = ggml_graph_get_tensor(gf, name);
+                if (t == nullptr || t->data == nullptr) {
+                    continue;
+                }
+                const std::vector<int32_t> * actual = moe_cache->last_ids(jl);
+                if (actual == nullptr || (int) actual->size() != n_used) {
+                    continue;
+                }
+                ggml_backend_tensor_get(t, pred.data(), 0, n_used*sizeof(int32_t));
+                for (int i = 0; i < n_used; ++i) {
+                    for (int j = 0; j < n_used; ++j) {
+                        if (pred[i] == (*actual)[j]) {
+                            probe_hit[k] += 1;
+                            break;
+                        }
+                    }
+                }
+                probe_n[k] += n_used;
+            }
+        }
+        if (++probe_tokens % 64 == 0) {
+            LLAMA_LOG_INFO("moe probe: %d tokens: top-k overlap of the pre-attention prediction: same layer %.1f %%, next %.1f %%, next+1 %.1f %%\n",
+                probe_tokens,
+                probe_n[0] ? 100.0*probe_hit[0]/probe_n[0] : 0.0, probe_n[1] ? 100.0*probe_hit[1]/probe_n[1] : 0.0, probe_n[2] ? 100.0*probe_hit[2]/probe_n[2] : 0.0);
+        }
+    }
     if (status != GGML_STATUS_SUCCESS) {
         LLAMA_LOG_ERROR("%s: ggml_backend_sched_graph_compute_async failed with error %d\n", __func__, status);
     }
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 174d0f850..c28c69977 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -2309,6 +2309,12 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
     }
     cb(selected_experts, "ffn_moe_topk", il);
 
+    if (moe_probe) {
+        // the prediction probe wants the selection only
+        moe_probe_sel = selected_experts;
+        return nullptr;
+    }
+
     if (arch == LLM_ARCH_GROVEMOE && n_expert != hparams.n_expert) {
         // TODO: Use scalar div instead when/if implemented
         ggml_tensor * f_sel = ggml_cast(ctx0, selected_experts, GGML_TYPE_F32);
@@ -2665,6 +2671,11 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
     return moe_out;
 }
 
+bool llm_graph_context::moe_probe_enabled() {
+    static const bool v = getenv("LLAMA_MOE_PROBE") != nullptr && atoi(getenv("LLAMA_MOE_PROBE")) != 0;
+    return v;
+}
+
 ggml_tensor * llm_graph_context::build_moe_cache_slots(
          ggml_tensor * selected_experts,
          ggml_tensor * up_exps,
diff --git a/src/llama-graph.h b/src/llama-graph.h
index bdd01844f..11e263f93 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -1053,6 +1053,11 @@ struct llm_graph_context {
     const llama_cross            * cross;
     llama_moe_cache              * moe_cache;
 
+    // LLAMA_MOE_PROBE=1: build_moe_ffn stops after the expert selection and leaves it in moe_probe_sel (see models/glm-dsa.cpp)
+    mutable bool          moe_probe     = false;
+    mutable ggml_tensor * moe_probe_sel = nullptr;
+    static bool moe_probe_enabled();
+
     const llama_prec_policy * prec_policy;
 
     const llama_hadamard * hdmd;
diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index b34893591..95d502cdf 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -289,6 +289,7 @@ struct llama_moe_cache::impl {
         std::vector<int32_t> cpu_experts;   // experts set in cpu_map
         uint32_t cpu_acc = 0;               // fraction of a miss carried over to the next plan, in 1/65536
         ggml_tensor * cpu_ids = nullptr;    // I32 [n_expert_used, max_batch] in host memory: the token's CPU experts, -1 elsewhere (deferred plan)
+        std::vector<int32_t> last_ids;      // the experts selected at the last small-batch lookup (LLAMA_MOE_PROBE)
         std::vector<ggml_tensor *> experts; // host expert tensors, in the order of the banks
         std::vector<uint32_t> hist;         // prompt-informed admission: selections per expert in large batches
     };
@@ -971,6 +972,7 @@ struct llama_moe_cache::impl {
             return true;
         }
         ggml_backend_synchronize(backend);
+        l.last_ids.assign(ids.begin(), ids.end());
 
         if (trace != nullptr) {
             write_trace(il, it_cpu != cpu_parts.end() ? it_cpu->second.n_used : n_expert_used);
@@ -1235,6 +1237,10 @@ ggml_tensor * llama_moe_cache::get_cpu_ids(int32_t il) const {
     return impl::deferred_plan() && il >= 0 && il < (int32_t) pimpl->layers.size() ? pimpl->layers[il].cpu_ids : nullptr;
 }
 
+const std::vector<int32_t> * llama_moe_cache::last_ids(int32_t il) const {
+    return il >= 0 && il < (int32_t) pimpl->layers.size() && !pimpl->layers[il].last_ids.empty() ? &pimpl->layers[il].last_ids : nullptr;
+}
+
 void llama_moe_cache::set_cpu_part(const ggml_tensor * lookup, int32_t n_used, std::vector<const ggml_tensor *> inputs) {
     pimpl->set_cpu_part(lookup, n_used, std::move(inputs));
 }
diff --git a/src/llama-moe-cache.h b/src/llama-moe-cache.h
index 1a69c949f..40a9a3fe5 100644
--- a/src/llama-moe-cache.h
+++ b/src/llama-moe-cache.h
@@ -36,6 +36,9 @@ public:
     // written by the deferred plan (-1 for the experts the device computes), nullptr when the plan is not deferred
     ggml_tensor * get_cpu_ids(int32_t il) const;
 
+    // the experts selected at the last small-batch lookup of layer il (LLAMA_MOE_PROBE), nullptr if none
+    const std::vector<int32_t> * last_ids(int32_t il) const;
+
     // the CPU part of the layer of the slot lookup, with n_used experts per token, no inputs if the graph has no CPU part
     // its inputs on the device are read together with the selected experts, so the CPU part does not wait for the device
     void set_cpu_part(const ggml_tensor * lookup, int32_t n_used, std::vector<const ggml_tensor *> inputs);
diff --git a/src/models/glm-dsa.cpp b/src/models/glm-dsa.cpp
index 0bf7a7c85..ff05a73d2 100644
--- a/src/models/glm-dsa.cpp
+++ b/src/models/glm-dsa.cpp
@@ -233,8 +233,12 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
     // Difference vs Deepseek 3.2: shared indexer layers reuse the top_k from the previous full indexer layers
     // See https://huggingface.co/zai-org/GLM-5.2/blob/main/config.json#L30
     ggml_tensor * prev_top_k = nullptr;
+    std::vector<ggml_tensor *> moe_probe_inputs; // LLAMA_MOE_PROBE: the pre-attention residual of every layer
     for (int il = 0; il < n_layer; ++il) {
         ggml_tensor * inpSA = inpL;
+        if (moe_probe_enabled() && n_tokens == 1) {
+            moe_probe_inputs.push_back(inpSA);
+        }
 
         // norm
         cur = build_norm(inpL, model.layers[il].attn_norm, NULL, LLM_NORM_RMS, il);
@@ -497,6 +501,46 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
     }
     cur = inpL;
 
+    // LLAMA_MOE_PROBE=1 (decode): the experts of layers il, il+1, il+2 as their own routers predict them from layer il's pre-attention
+    // residual; graph outputs the context scores against the selections (lever F: prefetch the misses early).  Built after the last
+    // layer so the layers' own splits keep their shape
+    if (moe_probe_enabled() && n_tokens == 1) {
+        for (int il = 0; il < (int) moe_probe_inputs.size(); ++il) {
+            for (int k = 0; k < 3; ++k) {
+                const int jl = il + k;
+                if (jl >= n_layer || (uint32_t) jl < hparams.n_layer_dense_lead) {
+                    continue;
+                }
+                ggml_tensor * h = build_norm(moe_probe_inputs[il], model.layers[jl].ffn_norm, NULL, LLM_NORM_RMS, jl);
+                moe_probe = true;
+                build_moe_ffn(h,
+                    model.layers[jl].ffn_gate_inp,
+                    model.layers[jl].ffn_up_exps,
+                    model.layers[jl].ffn_gate_exps,
+                    model.layers[jl].ffn_down_exps,
+                    model.layers[jl].ffn_exp_probs_b,
+                    n_expert, n_expert_used,
+                    LLM_FFN_SILU, hparams.expert_weights_norm,
+                    hparams.expert_weights_scale,
+                    (llama_expert_gating_func_type) hparams.expert_gating_func,
+                    jl,
+                    nullptr,
+                    model.layers[jl].ffn_gate_up_exps,
+                    model.layers[jl].ffn_up_exps_s,
+                    model.layers[jl].ffn_gate_exps_s,
+                    model.layers[jl].ffn_down_exps_s);
+                moe_probe = false;
+                ggml_tensor * sel = moe_probe_sel;
+                moe_probe_sel = nullptr;
+                if (sel != nullptr) {
+                    ggml_format_name(sel, "moe_probe_k%d_l%d", k, jl);
+                    ggml_set_output(sel);
+                    ggml_build_forward_expand(gf, sel);
+                }
+            }
+        }
+    }
+
     cur = build_norm(cur, model.output_norm, NULL, LLM_NORM_RMS, -1);
 
     // post-norm hidden state feeds the NextN/MTP draft head
-- 
