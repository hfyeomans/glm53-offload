index 11e263f93..c27316674 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -1057,6 +1057,7 @@ struct llm_graph_context {
     mutable bool          moe_probe     = false;
     mutable ggml_tensor * moe_probe_sel = nullptr;
     static bool moe_probe_enabled();
