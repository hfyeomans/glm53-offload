From f3fe3dfa9a937200692d7b94e856a6dec69505f0 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Tue, 3 Nov 2026 11:05:06 -0600
Subject: [PATCH 027/211] moe cache: LLAMA_MOE_PREFETCH=1 predicts the next
 layer's experts at the top of each layer (decode), plans them into the cache
 at the lookup callback and uploads the uncached ones on the side stream
 before that layer's hits

---
 ggml/include/ggml-cuda.h        |  5 ++
 ggml/src/ggml-cuda/ggml-cuda.cu | 32 ++++++++++++
 src/llama-graph.cpp             |  5 ++
 src/llama-graph.h               |  1 +
 src/llama-moe-cache.cpp         | 92 ++++++++++++++++++++++++++++++++-
 src/llama-moe-cache.h           |  4 ++
 src/models/glm-dsa.cpp          | 42 +++++++++++++++
 7 files changed, 179 insertions(+), 2 deletions(-)

diff --git a/ggml/include/ggml-cuda.h b/ggml/include/ggml-cuda.h
index 757f38ce1..c6b3826f2 100644
--- a/ggml/include/ggml-cuda.h
+++ b/ggml/include/ggml-cuda.h
@@ -38,6 +38,11 @@ GGML_BACKEND_API bool ggml_backend_cuda_host_ptr_device_accessible(const void *
 // `host_all`, when given, is the contiguous host copy of all n experts: the slot is then filled with one cudaMemcpyAsync (the copy
 // engine) instead of the gather kernel, and `srcs` is ignored
 GGML_BACKEND_API void * ggml_backend_cuda_upload_ring_gather(ggml_backend_t backend, bool first_of_split, const void * const * srcs, int64_t n, size_t size, size_t split_bytes, const void * host_all);
+
+// side uploads: a host -> device copy on the device's upload stream, beside the main stream's work; `wait` makes the main stream wait
+// for every side upload issued since the last wait
+GGML_BACKEND_API void ggml_backend_cuda_side_upload_async(ggml_backend_t backend, void * dst, const void * src, size_t bytes);
+GGML_BACKEND_API void ggml_backend_cuda_side_upload_wait(ggml_backend_t backend);
 GGML_BACKEND_API ggml_backend_buffer_type_t ggml_backend_cuda_buffer_type_twin(int device, int k);
 
 GGML_BACKEND_API bool ggml_backend_is_cuda(ggml_backend_t backend);
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index f2c267b2b..ad3a359dc 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -6793,6 +6793,7 @@ struct ggml_cuda_upload_ring {
     size_t       slot_bytes = 0;
     size_t       used       = 0;  // bump pointer in the current slot
     int64_t      k          = -1; // split counter
+    bool         side_pending = false; // side uploads issued since the last wait
 };
 
 static ggml_cuda_upload_ring g_cuda_upload_ring[GGML_CUDA_MAX_DEVICES];
@@ -6871,6 +6872,37 @@ void * ggml_backend_cuda_upload_ring_gather(ggml_backend_t backend, bool first_o
     return dst;
 }
 
+static void ggml_cuda_upload_ring_init(ggml_cuda_upload_ring & r) {
+    if (r.stream == nullptr) {
+        CUDA_CHECK(cudaStreamCreateWithFlags(&r.stream, cudaStreamNonBlocking));
+        for (int i = 0; i < 2; ++i) {
+            CUDA_CHECK(cudaEventCreateWithFlags(&r.ev_main[i], cudaEventDisableTiming));
+        }
+        CUDA_CHECK(cudaEventCreateWithFlags(&r.ev_upload, cudaEventDisableTiming));
+    }
+}
+
+void ggml_backend_cuda_side_upload_async(ggml_backend_t backend, void * dst, const void * src, size_t bytes) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(cuda_ctx->device);
+    ggml_cuda_upload_ring & r = g_cuda_upload_ring[cuda_ctx->device];
+    ggml_cuda_upload_ring_init(r);
+    CUDA_CHECK(cudaMemcpyAsync(dst, src, bytes, cudaMemcpyHostToDevice, r.stream));
+    r.side_pending = true;
+}
+
+void ggml_backend_cuda_side_upload_wait(ggml_backend_t backend) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_upload_ring & r = g_cuda_upload_ring[cuda_ctx->device];
+    if (!r.side_pending) {
+        return;
+    }
+    ggml_cuda_set_device(cuda_ctx->device);
+    CUDA_CHECK(cudaEventRecord(r.ev_upload, r.stream));
+    CUDA_CHECK(cudaStreamWaitEvent(cuda_ctx->stream(), r.ev_upload, 0));
+    r.side_pending = false;
+}
+
 bool ggml_backend_cuda_host_ptr_device_accessible(const void * ptr) {
     cudaPointerAttributes attr;
     const cudaError_t err = cudaPointerGetAttributes(&attr, ptr);
