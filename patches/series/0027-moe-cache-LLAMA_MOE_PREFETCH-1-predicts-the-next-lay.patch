+    // LLAMA_MOE_PREFETCH: the graph's prediction of the experts of layer il (I32 [n_expert_used, 1]), set per graph build
+    void set_pred(int32_t il, ggml_tensor * sel);
+    void clear_preds();
+
     // the CPU part of the layer of the slot lookup, with n_used experts per token, no inputs if the graph has no CPU part
     // its inputs on the device are read together with the selected experts, so the CPU part does not wait for the device
     void set_cpu_part(const ggml_tensor * lookup, int32_t n_used, std::vector<const ggml_tensor *> inputs);
diff --git a/src/models/glm-dsa.cpp b/src/models/glm-dsa.cpp
index ff05a73d2..5c78c021d 100644
--- a/src/models/glm-dsa.cpp
+++ b/src/models/glm-dsa.cpp
@@ -1,6 +1,7 @@
 #include "models.h"
 
 #include "llama-kv-cache-dsa.h"
+#include "llama-moe-cache.h"
 
 // https://huggingface.co/zai-org/GLM-5.2/blob/main/config.json#L26
 const std::array<uint32_t, LLAMA_MAX_LAYERS> GLM_5_2_DEFAULT_INDEXER_TYPES = {
@@ -234,12 +235,53 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
     // See https://huggingface.co/zai-org/GLM-5.2/blob/main/config.json#L30
     ggml_tensor * prev_top_k = nullptr;
     std::vector<ggml_tensor *> moe_probe_inputs; // LLAMA_MOE_PROBE: the pre-attention residual of every layer
+    if (moe_cache != nullptr) {
+        moe_cache->clear_preds();
+    }
     for (int il = 0; il < n_layer; ++il) {
         ggml_tensor * inpSA = inpL;
         if (moe_probe_enabled() && n_tokens == 1) {
             moe_probe_inputs.push_back(inpSA);
         }
 
+        // LLAMA_MOE_PREFETCH=1 (decode): the next layer's experts as its own router reads this layer's pre-attention residual; the
+        // slot lookup's copy callback of this layer reads them and uploads the uncached ones before the next layer's hits.  Kept on
+        // this layer's device (no pinned norm, no device boundary) so the layer's splits keep their shape
+        if (moe_prefetch_enabled() && n_tokens == 1 && moe_cache != nullptr && il + 1 < n_layer && (uint32_t) (il + 1) >= hparams.n_layer_dense_lead &&
+            model.dev_layer(il + 1) == model.dev_layer(il)) {
+            const int jl = il + 1;
+            ggml_tensor * h = ggml_rms_norm(ctx0, inpL, hparams.f_norm_rms_eps);
+            cb(h, "moe_pred_rms", il);
+            h = ggml_mul(ctx0, h, model.layers[jl].ffn_norm);
+            cb(h, "moe_pred_norm", il);
+            moe_probe = true;
+            build_moe_ffn(h,
+                model.layers[jl].ffn_gate_inp,
+                model.layers[jl].ffn_up_exps,
+                model.layers[jl].ffn_gate_exps,
+                model.layers[jl].ffn_down_exps,
+                model.layers[jl].ffn_exp_probs_b,
+                n_expert, n_expert_used,
+                LLM_FFN_SILU, hparams.expert_weights_norm,
+                hparams.expert_weights_scale,
+                (llama_expert_gating_func_type) hparams.expert_gating_func,
+                jl,
+                nullptr,
+                model.layers[jl].ffn_gate_up_exps,
+                model.layers[jl].ffn_up_exps_s,
+                model.layers[jl].ffn_gate_exps_s,
+                model.layers[jl].ffn_down_exps_s);
+            moe_probe = false;
+            ggml_tensor * sel = moe_probe_sel;
+            moe_probe_sel = nullptr;
+            if (sel != nullptr) {
+                ggml_format_name(sel, "moe_pred-%d", jl);
+                ggml_set_output(sel);
+                ggml_build_forward_expand(gf, sel);
+                moe_cache->set_pred(jl, sel);
+            }
+        }
+
         // norm
         cur = build_norm(inpL, model.layers[il].attn_norm, NULL, LLM_NORM_RMS, il);
         cb(cur, "attn_norm", il);
