diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index 95d502cdf..be647c748 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -1,5 +1,9 @@
 #include "llama-moe-cache.h"
 
+#ifdef GGML_USE_CUDA
+#include "ggml-cuda.h"
+#endif
+
 #include "llama-impl.h"
 #include "llama-memory.h"
 #include "llama-model.h"
@@ -290,6 +294,7 @@ struct llama_moe_cache::impl {
         uint32_t cpu_acc = 0;               // fraction of a miss carried over to the next plan, in 1/65536
         ggml_tensor * cpu_ids = nullptr;    // I32 [n_expert_used, max_batch] in host memory: the token's CPU experts, -1 elsewhere (deferred plan)
         std::vector<int32_t> last_ids;      // the experts selected at the last small-batch lookup (LLAMA_MOE_PROBE)
+        ggml_tensor * pred = nullptr;       // LLAMA_MOE_PREFETCH: the graph's prediction of this layer's experts, per graph build
         std::vector<ggml_tensor *> experts; // host expert tensors, in the order of the banks
         std::vector<uint32_t> hist;         // prompt-informed admission: selections per expert in large batches
     };
@@ -363,6 +368,57 @@ struct llama_moe_cache::impl {
         ggml_backend_event_t ev      = nullptr; // recorded behind the reads of the ids and of the stash
     };
     pending_plan defer_st;
+
+    // LLAMA_MOE_PREFETCH=1: the next layer's predicted experts, read with the ids; the uncached ones are uploaded on the side stream
+    static bool prefetch_enabled() {
+        static const bool v = getenv("LLAMA_MOE_PREFETCH") != nullptr && atoi(getenv("LLAMA_MOE_PREFETCH")) != 0;
+        return v;
+    }
+    std::vector<int32_t> pred_ids;
+    bool   pred_pending  = false;
+    size_t win_pf_n      = 0;
+    size_t win_pf_bytes  = 0;
+
+    void prefetch(int32_t jl, ggml_backend_t backend) {
+        pred_pending = false;
+#ifdef GGML_USE_CUDA
+        if (jl < 0 || jl >= (int32_t) layers.size() || layers[jl].ig < 0 || !ggml_backend_is_cuda(backend)) {
+            return;
+        }
+        layer & lj = layers[jl];
+        group & gj = groups[lj.ig];
+        if (devices[gj.id].backend != backend) {
+            return;
+        }
+        // the predicted experts become hits of the next lookup: the cached ones are promoted, the rest get slots and are uploaded
+        auto n_cpu0 = [](size_t) { return (size_t) 0; };
+        size_t n_hit = 0;
+        if (!gj.slru.plan(jl, pred_ids.data(), pred_ids.size(), n_expert_used, n_zero, n_cpu0, rng, fills, cpu, n_hit)) {
+            return;
+        }
+        size_t bytes = 0;
+        for (size_t ip = 0; ip < lj.experts.size(); ++ip) {
+            const ggml_tensor * w    = lj.experts[ip];
+            ggml_tensor       * bank = gj.banks[ip];
+            const size_t expert_size = w->nb[2];
+            for (size_t i = 0; i < fills.size();) {
+                size_t n = 1;
+                while (i + n < fills.size() && fills[i + n].expert == fills[i].expert + (int32_t) n && fills[i + n].slot == fills[i].slot + (int32_t) n) {
+                    n++;
+                }
+                ggml_backend_cuda_side_upload_async(backend, (uint8_t *) bank->data + fills[i].slot*expert_size,
+                    (const uint8_t *) w->data + fills[i].expert*expert_size, n*expert_size);
+                bytes += n*expert_size;
+                i += n;
+            }
+        }
+        win_pf_n     += fills.size();
+        win_pf_bytes += bytes;
+#else
+        GGML_UNUSED(jl);
+        GGML_UNUSED(backend);
+#endif
+    }
     std::unordered_map<ggml_backend_t, ggml_backend_event_t> ev_ids; // one per backend: an event belongs to its device
     std::vector<uint8_t> fill_mark; // [n_expert] scratch of run_pending
 
@@ -956,6 +1012,14 @@ struct llama_moe_cache::impl {
 
         ids.resize(ggml_nelements(sel));
         ggml_backend_tensor_get_async(backend, sel, ids.data(), 0, ggml_nbytes(sel));
+        pred_pending = false;
+        if (prefetch_enabled() && il + 1 < (int32_t) layers.size() && layers[il + 1].pred != nullptr && layers[il + 1].pred->data != nullptr &&
+            ids.size() == (size_t) n_expert_used) {
+            const ggml_tensor * pred = layers[il + 1].pred;
+            pred_ids.resize(ggml_nelements(pred));
+            ggml_backend_tensor_get_async(backend, pred, pred_ids.data(), 0, ggml_nbytes(pred));
+            pred_pending = true;
+        }
         if (deferred_plan() && has_cpu && l.cpu_ids != nullptr && ids.size() <= (size_t) 8*n_expert_used) {
             // the lookup runs on the map as it is: record the reads, upload the map, plan when the CPU part asks for its inputs
             if (defer_st.il >= 0) {
@@ -1018,6 +1082,9 @@ struct llama_moe_cache::impl {
             }
         }
 
+        if (pred_pending) {
+            prefetch(il + 1, backend);
+        }
         stats & st = ids.size() <= (size_t) 8*n_expert_used ? stats_small : stats_large;
         st.hits   += n_hit;
         st.misses += fills.size() + cpu.size();
@@ -1035,13 +1102,22 @@ struct llama_moe_cache::impl {
             if (il == il_first && ++win_tokens >= (size_t) log_every) {
                 win_total += win_tokens;
                 const size_t n = win.hits + win.misses;
-                LLAMA_LOG_INFO("llama_moe_cache: window: tokens %zu-%zu: hit rate = %.2f%% (%zu hits, %zu misses, %zu on the CPU), uploaded = %.1f MiB\n",
-                    win_total - win_tokens, win_total, n > 0 ? 100.0*win.hits/n : 0.0, win.hits, win.misses, win.cpu, win.bytes/1024.0/1024.0);
+                LLAMA_LOG_INFO("llama_moe_cache: window: tokens %zu-%zu: hit rate = %.2f%% (%zu hits, %zu misses, %zu on the CPU), uploaded = %.1f MiB, prefetched = %zu (%.1f MiB)\n",
+                    win_total - win_tokens, win_total, n > 0 ? 100.0*win.hits/n : 0.0, win.hits, win.misses, win.cpu, win.bytes/1024.0/1024.0,
+                    win_pf_n, win_pf_bytes/1024.0/1024.0);
                 win_tokens = 0;
                 win = stats();
+                win_pf_n = 0;
+                win_pf_bytes = 0;
             }
         }
 
+#ifdef GGML_USE_CUDA
+        // the hits of this layer wait for the side uploads issued for it by the previous layer's callback
+        if (prefetch_enabled() && ggml_backend_is_cuda(backend)) {
+            ggml_backend_cuda_side_upload_wait(backend);
+        }
+#endif
         // the next copy synchronizes the backend before it changes the slot map again
         ggml_backend_tensor_set_async(backend, dst, src->data, 0, ggml_nbytes(src));
 
@@ -1237,6 +1313,18 @@ ggml_tensor * llama_moe_cache::get_cpu_ids(int32_t il) const {
     return impl::deferred_plan() && il >= 0 && il < (int32_t) pimpl->layers.size() ? pimpl->layers[il].cpu_ids : nullptr;
 }
 
+void llama_moe_cache::set_pred(int32_t il, ggml_tensor * sel) {
+    if (il >= 0 && il < (int32_t) pimpl->layers.size()) {
+        pimpl->layers[il].pred = sel;
+    }
+}
+
+void llama_moe_cache::clear_preds() {
+    for (auto & l : pimpl->layers) {
+        l.pred = nullptr;
+    }
+}
+
 const std::vector<int32_t> * llama_moe_cache::last_ids(int32_t il) const {
     return il >= 0 && il < (int32_t) pimpl->layers.size() && !pimpl->layers[il].last_ids.empty() ? &pimpl->layers[il].last_ids : nullptr;
 }
diff --git a/src/llama-moe-cache.h b/src/llama-moe-cache.h
