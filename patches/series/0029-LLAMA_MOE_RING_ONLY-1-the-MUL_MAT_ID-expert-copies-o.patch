@@ -3020,6 +3055,11 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
         // LLAMA_MOE_UPLOAD_RING=1: gather into the device's upload ring on its upload stream, overlapped with the previous split's
