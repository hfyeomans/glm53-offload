--- a/ggml/include/ggml-backend.h
+++ b/ggml/include/ggml-backend.h
@@ -380,6 +380,9 @@ extern "C" {
     // enqueue the copies of a split's weights in host memory before the copies of its other inputs, so they start before the split
     // waits for inputs computed by other backends (the copy callback must then not read those inputs)
     GGML_API void                 ggml_backend_sched_set_host_weights_first(ggml_backend_sched_t sched, ggml_backend_t backend, bool enable);
+    // the copies of host-memory MUL_MAT_ID weights (src0) on this backend get this buffer as a placeholder and no graph memory: the copy
+    // callback must point each one at memory of its own before filling it (NULL = off)
+    GGML_API void                 ggml_backend_sched_set_expert_placeholder(ggml_backend_sched_t sched, ggml_backend_t backend, ggml_backend_buffer_t buffer);
 
     // Set a callback to be called when the compute buffers of a graph are being reallocated
     GGML_API void                 ggml_backend_sched_set_realloc_callback(ggml_backend_sched_t sched, ggml_backend_sched_realloc_callback callback, void * user_data);
diff --git a/ggml/include/ggml-cuda.h b/ggml/include/ggml-cuda.h
index c6b3826f2..5f4e93791 100644
--- a/ggml/include/ggml-cuda.h
+++ b/ggml/include/ggml-cuda.h
@@ -43,6 +43,12 @@ GGML_BACKEND_API void * ggml_backend_cuda_upload_ring_gather(ggml_backend_t back
 // for every side upload issued since the last wait
 GGML_BACKEND_API void ggml_backend_cuda_side_upload_async(ggml_backend_t backend, void * dst, const void * src, size_t bytes);
 GGML_BACKEND_API void ggml_backend_cuda_side_upload_wait(ggml_backend_t backend);
+
+// upload ring without the gather: reserve `bytes` in the current slot (`first_of_split` starts the next slot) and return its device
+// address, the main stream ordered after the ring stream; copy_commit fills it from the host on the ring stream and makes the main
+// stream wait for that copy
+GGML_BACKEND_API void * ggml_backend_cuda_upload_ring_reserve(ggml_backend_t backend, bool first_of_split, size_t bytes, size_t split_bytes);
+GGML_BACKEND_API void   ggml_backend_cuda_upload_ring_copy_commit(ggml_backend_t backend, void * dst, const void * src, size_t bytes);
 GGML_BACKEND_API ggml_backend_buffer_type_t ggml_backend_cuda_buffer_type_twin(int device, int k);
 
 GGML_BACKEND_API bool ggml_backend_is_cuda(ggml_backend_t backend);
