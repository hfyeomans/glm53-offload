     const int64_t n_expert    = src->ne[2];
     const size_t  expert_size = src->nb[2];
 
+#ifdef GGML_USE_CUDA
+    // LLAMA_MOE_RING_ONLY: the copy has no graph memory, give it a ring slot first (every path below fills dst->data)
+    if (!lctx->expert_placeholders.empty() && ggml_backend_is_cuda(backend)) {
+        const int32_t il = lctx->moe_cache ? lctx->moe_cache->layer_of_weight(src) : -1;
+        size_t split_bytes = 0;
+        if (il >= 0 && il < (int32_t) lctx->model.layers.size()) {
+            const auto & layer = lctx->model.layers[il];
+            for (const ggml_tensor * t : { layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps }) {
+                split_bytes += t ? GGML_PAD(ggml_nbytes(t), 256) : 0;
+            }
+        } else {
+            split_bytes = 3*GGML_PAD(ggml_nbytes(dst), 256);
+        }
+        const bool first = il < 0 || il != st.ring_il;
+        st.ring_il = il;
+        dst->data = ggml_backend_cuda_upload_ring_reserve(backend, first, ggml_nbytes(dst), split_bytes);
+        GGML_ASSERT(dst->data != nullptr);
+    }
+#endif
