+void ggml_backend_sched_set_expert_placeholder(ggml_backend_sched_t sched, ggml_backend_t backend, ggml_backend_buffer_t buffer) {
+    GGML_ASSERT(sched);
+    const int backend_id = ggml_backend_sched_backend_id(sched, backend);
+    GGML_ASSERT(backend_id >= 0 && backend_id < sched->n_backends);
+    sched->expert_placeholder[backend_id] = buffer;
+}
