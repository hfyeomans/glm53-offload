From a90d453e9299095f5716317ecb0baed7af2cf4b5 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Tue, 3 Nov 2026 16:07:28 -0600
Subject: [PATCH 039/141] sched: GGML_SCHED_ASYNC_HOST_INPUT=1 uploads split
 inputs computed on the host on the split backend stream instead of a blocking
 copy after waiting for the device

---
 ggml/src/ggml-backend.cpp | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index ad0860285..9aa3ecb52 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -2145,6 +2145,19 @@ static bool ggml_backend_sched_alloc_splits(ggml_backend_sched_t sched) {
     return true;
 }
 
+// GGML_SCHED_ASYNC_HOST_INPUT=1: inputs computed by a host backend are uploaded on the split backend's stream (0038)
+static bool ggml_backend_sched_async_host_input(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char * s = getenv("GGML_SCHED_ASYNC_HOST_INPUT");
+        v = s != NULL && atoi(s) != 0;
+        if (v) {
+            GGML_LOG_INFO("%s: inputs computed on the host are uploaded asynchronously\n", __func__);
+        }
+    }
+    return v != 0;
+}
+
 static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggml_backend_sched_split * split, struct ggml_tensor * input) {
     if (sched->n_copies > 1 && ggml_backend_sched_is_user_input(input)) {
         return; // already uploaded
@@ -2191,6 +2204,15 @@ static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggm
         return;
     }
 
+    // GGML_SCHED_ASYNC_HOST_INPUT: an input that a host backend computed goes up on the split backend's stream, behind the event wait above
+    if (ggml_backend_sched_async_host_input() && input->buffer != NULL && input_cpy->buffer != NULL &&
+            ggml_backend_buffer_is_host(input->buffer) && !ggml_backend_buffer_is_host(input_cpy->buffer) && !ggml_backend_sched_is_host_weight(input) &&
+            split_backend->iface.set_tensor_async != NULL) {
+        ggml_backend_tensor_set_async(split_backend, input_cpy, input->data, 0, ggml_nbytes(input));
+        ggml_sched_copy_account(3, tc0);
+        return;
+    }
+
     // try async copy, but if not possible, we can still use a sync copy without synchronizing the dst backend, since we handle the synchronization here with multiple copies and events
     // TODO: add public function to facilitate this, since applications do not have direct access to the backend interface
     if (split_backend->iface.cpy_tensor_async && split_backend->iface.cpy_tensor_async(input_backend, split_backend, input, input_cpy)) {
-- 
