From d9e54c652a6669b9a9668e8206e63aacc5c231d7 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Wed, 4 Nov 2026 03:17:14 -0600
Subject: [PATCH 056/211] cuda: GGML_CUDA_GRAPH_LARGE=n captures a split with n
 or more token rows as a CUDA graph on every call (direct launches of a prompt
 split fill the launch queue and hold the host)

---
 ggml/src/ggml-cuda/ggml-cuda.cu | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 60800a4d1..1e63d5124 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2938,6 +2938,21 @@ static bool ggml_cuda_graph_debug_enabled() {
     return enabled;
 }
 
+// 0055 GGML_CUDA_GRAPH_LARGE=n: whether a graph has n or more token rows (a prompt ubatch), see ggml_backend_cuda_graph_compute
+static bool ggml_cuda_graph_large(const ggml_cgraph * cgraph) {
+    static const int64_t n = getenv("GGML_CUDA_GRAPH_LARGE") != nullptr ? atoll(getenv("GGML_CUDA_GRAPH_LARGE")) : 0;
+    if (n <= 0) {
+        return false;
+    }
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if ((node->op == GGML_OP_MUL_MAT && node->ne[1] >= n) || (node->op == GGML_OP_MUL_MAT_ID && node->ne[2] >= n)) {
+            return true;
+        }
+    }
+    return false;
+}
+
 static bool ggml_cuda_graph_check_compability(ggml_cgraph * cgraph) {
 
     bool use_cuda_graph = true;
@@ -5404,7 +5419,12 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
         if (graph_compatible) {
             const bool properties_changed = ggml_cuda_graph_update_required(cuda_ctx, cgraph);
 
-            if (!graph->warmup_complete) {
+            if (ggml_cuda_graph_large(cgraph)) {
+                // 0055: a prompt split, captured on every call (its direct launches fill the launch queue and hold the host)
+                graph->warmup_complete     = true;
+                use_cuda_graph             = true;
+                cuda_graph_update_required = true;
+            } else if (!graph->warmup_complete) {
                 // Warmup: need at least 2 calls with no property change on the 2nd call
                 if (!properties_changed) {
                     graph->warmup_complete = true;
-- 
2.43.0

