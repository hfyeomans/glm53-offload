From 5b0e576795aa8df55759ca1b633c599934ae7858 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Wed, 4 Nov 2026 04:03:53 -0600
Subject: [PATCH 058/211] cuda: GGML_CUDA_SPLIT_TIMING splits busy and gap time
 between MoE splits and the rest

---
 ggml/src/ggml-cuda/ggml-cuda.cu | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 44fcc7178..80ec5a26c 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5263,6 +5263,11 @@ struct ggml_cuda_split_timing {
     int    n    = 0;      // processed splits since the last print
     double busy_ms = 0.0;
     double gap_ms  = 0.0;
+    // 0057: per kind of split (0 other, 1 MoE: the first node is MUL_MAT_ID), the gap charged to the split after it
+    int    kind[N] = {};
+    int    n_k[2]       = {};
+    double busy_k_ms[2] = {};
+    double gap_k_ms[2]  = {};
 };
 
 static ggml_cuda_split_timing g_cuda_split_timing[GGML_CUDA_MAX_DEVICES];
@@ -5272,7 +5277,7 @@ static bool ggml_cuda_split_timing_enabled(void) {
     return enabled;
 }
 
-static int ggml_cuda_split_timing_begin(ggml_backend_cuda_context * cuda_ctx) {
+static int ggml_cuda_split_timing_begin(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph) {
     if (!ggml_cuda_split_timing_enabled()) {
         return -1;
     }
@@ -5286,9 +5291,12 @@ static int ggml_cuda_split_timing_begin(ggml_backend_cuda_context * cuda_ctx) {
         float ms = 0.0f;
         CUDA_CHECK(cudaEventElapsedTime(&ms, t.start[t.tail], t.end[t.tail]));
         t.busy_ms += ms;
+        t.busy_k_ms[t.kind[t.tail]] += ms;
+        t.n_k[t.kind[t.tail]] += 1;
         if (t.prev >= 0) {
             CUDA_CHECK(cudaEventElapsedTime(&ms, t.end[t.prev], t.start[t.tail]));
             t.gap_ms += ms;
+            t.gap_k_ms[t.kind[t.tail]] += ms;
         }
         t.prev = t.tail;
         t.tail = (t.tail + 1) % ggml_cuda_split_timing::N;
@@ -5298,9 +5306,16 @@ static int ggml_cuda_split_timing_begin(ggml_backend_cuda_context * cuda_ctx) {
     if (t.n >= every_splits) {
         GGML_LOG_INFO("cuda split timing: device %d: %d splits: busy %.1f ms, gaps %.1f ms (%.1f us per split busy, %.1f us gap)\n",
             cuda_ctx->device, t.n, t.busy_ms, t.gap_ms, 1000.0*t.busy_ms/t.n, 1000.0*t.gap_ms/t.n);
+        GGML_LOG_INFO("cuda split timing: device %d:   MoE splits %d: busy %.1f ms, gaps before them %.1f ms; other %d: busy %.1f ms, gaps %.1f ms\n",
+            cuda_ctx->device, t.n_k[1], t.busy_k_ms[1], t.gap_k_ms[1], t.n_k[0], t.busy_k_ms[0], t.gap_k_ms[0]);
         t.n = 0;
         t.busy_ms = 0.0;
         t.gap_ms  = 0.0;
+        for (int k = 0; k < 2; ++k) {
+            t.n_k[k] = 0;
+            t.busy_k_ms[k] = 0.0;
+            t.gap_k_ms[k]  = 0.0;
+        }
     }
     const int slot = t.head;
     const int next = (slot + 1) % ggml_cuda_split_timing::N;
@@ -5312,6 +5327,7 @@ static int ggml_cuda_split_timing_begin(ggml_backend_cuda_context * cuda_ctx) {
         CUDA_CHECK(cudaEventCreate(&t.end[slot]));
     }
     CUDA_CHECK(cudaEventRecord(t.start[slot], cuda_ctx->stream()));
+    t.kind[slot] = cgraph->n_nodes > 0 && cgraph->nodes[0]->op == GGML_OP_MUL_MAT_ID ? 1 : 0;
     t.head = next;
     return slot;
 }
@@ -5404,7 +5420,7 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
         cuda_ctx->q8_1_arena_used = 0;
     }
 
-    const int split_timing_slot = ggml_cuda_split_timing_begin(cuda_ctx);
+    const int split_timing_slot = ggml_cuda_split_timing_begin(cuda_ctx, cgraph);
 
     bool use_cuda_graph             = false;
     bool cuda_graph_update_required = false;
-- 
2.43.0

