From 814d77719bdce8d259b37e892d5536639f4b5438 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Wed, 4 Nov 2026 04:32:21 -0600
Subject: [PATCH 059/211] ggml: ggml_mul_mat_id_set_id_offset reads ids as id -
 offset and skips the ones outside [0, n_as) (zero rows); CUDA supports it in
 mmq / mmf (expert parallelism)

---
 ggml/include/ggml.h             |  4 +++
 ggml/src/ggml-cpu/ggml-cpu.c    |  8 ++++-
 ggml/src/ggml-cuda/ggml-cuda.cu |  5 ++-
 ggml/src/ggml-cuda/mmf.cu       |  9 ++++-
 ggml/src/ggml-cuda/mmid.cu      | 37 ++++++++++++--------
 ggml/src/ggml-cuda/mmid.cuh     |  3 +-
 ggml/src/ggml-cuda/mmq.cu       | 11 +++++-
 ggml/src/ggml-cuda/quantize.cu  |  3 ++
 ggml/src/ggml.c                 |  6 ++++
 tests/test-backend-ops.cpp      | 60 +++++++++++++++++++++++++++++++++
 10 files changed, 127 insertions(+), 19 deletions(-)

diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index 568251d2c..f85b7b0ed 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -1526,6 +1526,10 @@ extern "C" {
             struct ggml_tensor  * b,
             struct ggml_tensor  * ids);
 
+    // the ids of a MUL_MAT_ID are read as id - offset; an id outside [0, n_as) after it is skipped like -1 (its row of the result is zero),
+    // so a backend handed every expert's id computes only the ones of its own range (expert parallelism); CUDA zeroes the result first
+    GGML_API void ggml_mul_mat_id_set_id_offset(struct ggml_tensor * a, int32_t offset);
+
     // A: m columns, n rows,
     // B: p columns, n rows,
     // result is m columns, p rows
