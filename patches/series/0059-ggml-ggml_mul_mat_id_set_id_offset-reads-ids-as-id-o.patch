 };
 
+// 0058: MUL_MAT_ID over a range of the experts (expert parallelism): ids drawn from 2*n_mats experts, read with an offset, the ids outside
+// [offset, offset + n_mats) skipped (their rows zero)
+struct test_mul_mat_id_range : public test_case {
+    const ggml_type type_a;
+    const int n_mats;
+    const int n_used;
+    const bool bcast;
+    const int64_t m, n, k;
+    const int32_t offset;
+
+    std::string vars() override {
+        return VARS_TO_STR8(type_a, n_mats, n_used, bcast, m, n, k, offset);
+    }
+    double max_nmse_err() override { return 5e-4; }
+
+    test_mul_mat_id_range(ggml_type type_a, int n_mats, int n_used, bool bcast, int64_t m, int64_t n, int64_t k, int32_t offset)
+        : type_a(type_a), n_mats(n_mats), n_used(n_used), bcast(bcast), m(m), n(n), k(k), offset(offset) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * as  = ggml_new_tensor_3d(ctx, type_a, k, m, n_mats);
+        ggml_set_name(as, "as");
+        ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_used, n);
+        ggml_set_name(ids, "ids");
+        ggml_tensor * b   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, bcast ? 1 : n_used, n);
+        ggml_set_name(b, "b");
+        ggml_tensor * out = ggml_mul_mat_id(ctx, as, b, ids);
+        ggml_mul_mat_id_set_id_offset(out, offset);
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        std::default_random_engine rng(4321);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type != GGML_TYPE_I32) {
+                init_tensor_uniform(t);
+                continue;
+            }
+            for (int64_t r = 0; r < ggml_nrows(t); r++) {
+                std::vector<int32_t> all(2*n_mats);
+                for (int i = 0; i < 2*n_mats; i++) {
+                    all[i] = i;
+                }
+                std::shuffle(all.begin(), all.end(), rng);  // distinct experts per token, half of them outside the range
+                ggml_backend_tensor_set(t, all.data(), r * t->nb[1], t->ne[0] * sizeof(int32_t));
+            }
+        }
+    }
+};
