+void ggml_mul_mat_id_set_id_offset(struct ggml_tensor * a, int32_t offset) {
+    GGML_ASSERT(a->op == GGML_OP_MUL_MAT_ID);
+    ggml_set_op_params_i32(a, 6, offset); // slot 0 is the precision (ggml_mul_mat_set_prec)
