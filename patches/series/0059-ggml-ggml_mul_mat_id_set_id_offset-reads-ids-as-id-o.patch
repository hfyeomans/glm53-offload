+// 0058: an id outside [0, n_experts) after the offset (-1 included) is skipped: INT_MAX, as the padding, belongs to no expert
+static __device__ __forceinline__ int mm_ids_remap(const int id, const int id_offset, const int n_experts) {
+    const int e = id - id_offset;
+    return e >= 0 && e < n_experts ? e : INT_MAX;
