index 190e58ca8..a454cad36 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1667,9 +1667,15 @@ static void ggml_compute_forward_mul_mat_id(
         memset(matrix_row_counts, 0, n_as*sizeof(int64_t));
 
         // group rows by src0 matrix
+        // 0058: with an id offset, an id outside [0, n_as) after it is skipped like -1
+        const int32_t id_off   = ggml_get_op_params_i32(dst, 6);
+        const bool    id_range = ggml_get_op_params_i32(dst, 7) != 0;
         for (int64_t iid1 = 0; iid1 < ids->ne[1]; ++iid1) {
             for (int id = 0; id < n_ids; ++id) {
-                const int32_t i02 = *(const int32_t *) ((const char *) ids->data + iid1*ids->nb[1] + id*ids->nb[0]);
+                int32_t i02 = *(const int32_t *) ((const char *) ids->data + iid1*ids->nb[1] + id*ids->nb[0]) - id_off;
+                if (id_range && (i02 < 0 || i02 >= n_as)) {
+                    i02 = -1;
+                }
 
                 assert(i02 == -1 || (i02 >= 0 && i02 < n_as));
 
