From 762d5fdba64bd5a4d87fadb853bf3d5173e882b4 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Wed, 4 Nov 2026 04:45:20 -0600
Subject: [PATCH 060/141] model: LLAMA_TP_PROMPT=1 copies every layer weight
 that lives on one GPU to the other at load (tp_w, tp_home)

---
 src/llama-model.cpp | 94 +++++++++++++++++++++++++++++++++++++++++++++
 src/llama-model.h   | 10 +++++
 2 files changed, 104 insertions(+)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 52893876d..f0694b659 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -2073,10 +2073,104 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
     }
 
     load_tensors_hadamard();
+    load_tensors_tp_shadow();
 
     return true;
 }
 
+// LLAMA_TP_PROMPT=1 (0059): copy every layer weight that lives on one of the two GPUs to the other one
+void llama_model_base::load_tensors_tp_shadow() {
+    const char * env = getenv("LLAMA_TP_PROMPT");
+    if (env == nullptr || atoi(env) == 0) {
+        return;
+    }
+    tp_devs.clear();
+    for (int il = 0; il < (int) hparams.n_layer(); ++il) {
+        ggml_backend_dev_t d = dev_layer(il);
+        if (ggml_backend_dev_type(d) == GGML_BACKEND_DEVICE_TYPE_GPU && std::find(tp_devs.begin(), tp_devs.end(), d) == tp_devs.end()) {
+            tp_devs.push_back(d);
+        }
+    }
+    if (tp_devs.size() != 2) {
+        LLAMA_LOG_WARN("%s: LLAMA_TP_PROMPT needs the layers on exactly two GPUs (found %zu), not used\n", __func__, tp_devs.size());
+        tp_devs.clear();
+        return;
+    }
+    struct target {
+        ggml_context_ptr ctx;
+        std::vector<std::pair<ggml_tensor *, ggml_tensor *>> pairs;
+        size_t bytes = 0;
+    } tg[2];
+    for (auto & t : tg) {
+        ggml_init_params params = {
+            /*.mem_size   =*/ ggml_tensor_overhead()*(tensors_by_name.size() + 1),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        t.ctx.reset(ggml_init(params));
+        if (!t.ctx) {
+            throw std::runtime_error("LLAMA_TP_PROMPT: failed to create the context of the weight copies");
+        }
+    }
+    for (const auto & [name, w] : tensors_by_name) {
+        int il = -1;
+        if (sscanf(name.c_str(), "blk.%d.", &il) != 1 || il < 0 || il >= (int) hparams.n_layer() ||
+                w->buffer == nullptr || ggml_backend_buffer_is_host(w->buffer)) {
+            continue;
+        }
+        ggml_backend_dev_t home = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(w->buffer));
+        const int c_home = home == tp_devs[0] ? 0 : home == tp_devs[1] ? 1 : -1;
+        if (c_home < 0) {
+            continue;
+        }
+        auto & t = tg[1 - c_home];
+        ggml_tensor * s = ggml_dup_tensor(t.ctx.get(), w);
+        ggml_format_name(s, "tp.%s", name.c_str());
+        t.pairs.emplace_back(w, s);
+        t.bytes += ggml_nbytes(w);
+    }
+    for (int c = 0; c < 2; ++c) {
+        auto & t = tg[c];
+        if (t.pairs.empty()) {
+            continue;
+        }
+        ggml_backend_buffer_ptr buf { ggml_backend_alloc_ctx_tensors_from_buft(t.ctx.get(), ggml_backend_dev_buffer_type(tp_devs[c])) };
+        if (!buf) {
+            throw std::runtime_error(format("LLAMA_TP_PROMPT: unable to allocate %.1f MiB of weight copies on %s",
+                t.bytes/1024.0/1024.0, ggml_backend_dev_name(tp_devs[c])));
+        }
+        ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        for (auto & [w, s] : t.pairs) {
+            ggml_backend_tensor_copy(w, s);
+            tp_shadow[w] = s;
+        }
+        LLAMA_LOG_INFO("%s: LLAMA_TP_PROMPT: %zu layer weights (%.1f MiB) copied to %s\n", __func__, t.pairs.size(),
+            t.bytes/1024.0/1024.0, ggml_backend_dev_name(tp_devs[c]));
+        std::vector<ggml_backend_buffer_ptr> buffers;
+        buffers.emplace_back(std::move(buf));
+        pimpl->ctxs_bufs.emplace_back(std::move(t.ctx), std::move(buffers));
+    }
+}
+
+ggml_tensor * llama_model::tp_w(ggml_tensor * w, int c) const {
+    if (w == nullptr || tp_devs.size() != 2 || w->buffer == nullptr || ggml_backend_buffer_is_host(w->buffer)) {
+        return w;
+    }
+    if (ggml_backend_buft_get_device(ggml_backend_buffer_get_type(w->buffer)) == tp_devs[c]) {
+        return w;
+    }
+    auto it = tp_shadow.find(w);
+    GGML_ASSERT(it != tp_shadow.end() && "LLAMA_TP_PROMPT: a GPU weight without a copy on the other card");
+    return it->second;
+}
+
+int llama_model::tp_home(int il) const {
+    if (tp_devs.size() != 2) {
+        return -1;
+    }
+    return dev_layer(il) == tp_devs[0] ? 0 : 1;
+}
+
 // read and check the prism.hadamard metadata, and record the folded weights (load_tensors_hadamard makes the tensors)
 void llama_model_base::load_hparams_hadamard(llama_model_loader & ml) {
     uint32_t hadamard_version = 0;
diff --git a/src/llama-model.h b/src/llama-model.h
index da4964c98..0fee115b4 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -880,6 +880,15 @@ struct llama_model {
     // for quantize-stats only
     std::vector<std::pair<std::string, struct ggml_tensor *>> tensors_by_name;
 
+    // LLAMA_TP_PROMPT (0059): every layer weight that lives on one of the two GPUs, copied to the other (the prompt graph runs each layer
+    // on both cards); tp_devs are the two cards in layer order, empty when the copies were not made
+    std::unordered_map<const ggml_tensor *, ggml_tensor *> tp_shadow;
+    std::vector<ggml_backend_dev_t> tp_devs;
+    // w on card c: w itself on its home card (or in host memory), else its copy
+    ggml_tensor * tp_w(ggml_tensor * w, int c) const;
+    // the card a layer's weights live on (0 or 1), -1 without the copies
+    int tp_home(int il) const;
+
     // for keeping track of associated LoRA adapters
     std::unordered_set<llama_adapter_lora *> loras;
 
@@ -1001,6 +1010,7 @@ struct llama_model_base : public llama_model {
 
     // helper: make the prism.hadamard rotation and sign tensors for the folded weights
     void load_tensors_hadamard();
+    void load_tensors_tp_shadow(); // LLAMA_TP_PROMPT (0059)
 
     // helper: read the SWA pattern as one flag per layer, or as a period expanded by set_swa_pattern
     void load_swa_pattern(llama_model_loader & ml, uint32_t n_pattern, bool dense_first = false);
