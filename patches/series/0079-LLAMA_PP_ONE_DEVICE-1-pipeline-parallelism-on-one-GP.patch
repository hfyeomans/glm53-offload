From 91c497d5187ad32a877a508241e8b3867b0122c8 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Wed, 4 Nov 2026 11:06:07 -0600
Subject: [PATCH 079/141] LLAMA_PP_ONE_DEVICE=1: pipeline parallelism on one
 GPU with every layer offloaded (the host runs ahead, prompts take the
 upload-all path)

---
 src/llama-context.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 7cf1c3deb..df26efe81 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -605,6 +605,15 @@ llama_context::llama_context(
             cparams.offload_kqv &&
             (!model.has_tensor_overrides() || (cparams.op_offload && llama_host_weights_spread(model)));
 
+        // 0080 LLAMA_PP_ONE_DEVICE=1: also on one GPU with every layer offloaded and the experts in host memory, so the host runs ahead on
+        // events and the prompt's expert uploads overlap the kernels (the upload-all path is gated on pipeline parallelism)
+        static const bool pp_one_device = getenv("LLAMA_PP_ONE_DEVICE") != nullptr && atoi(getenv("LLAMA_PP_ONE_DEVICE")) != 0;
+        if (!pipeline_parallel && pp_one_device && model.n_devices() == 1 &&
+                model.n_gpu_layers() > model.hparams.n_layer_all && cparams.offload_kqv && cparams.op_offload) {
+            pipeline_parallel = true;
+            LLAMA_LOG_INFO("%s: LLAMA_PP_ONE_DEVICE: pipeline parallelism on one device\n", __func__);
+        }
+
         // pipeline parallelism requires support for async compute and events in all devices
         if (pipeline_parallel) {
             for (auto & backend : backends) {
-- 
