From 645ef17ff3f3e78c06317f6b64deb78faac33502 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Wed, 4 Nov 2026 11:49:56 -0600
Subject: [PATCH 080/141] cuda FA: GLM-5.3 MLA with all 64 heads of a query in
 one tile (ncols1 1, ncols2 64; sparse from 4K keys; GGML_CUDA_FA_MLA64=0
 restores the 16-head grouping) + test cases

---
 ggml/src/ggml-cuda/fattn-mma-f16.cuh           |  2 ++
 ggml/src/ggml-cuda/fattn.cu                    | 15 +++++++++++----
 ...attn-mma-f16-instance-ncols1_1-ncols2_64.cu |  5 +++++
 tests/test-backend-ops.cpp                     | 18 ++++++++++++++++++
 4 files changed, 36 insertions(+), 4 deletions(-)
 create mode 100644 ggml/src/ggml-cuda/template-instances/fattn-mma-f16-instance-ncols1_1-ncols2_64.cu

diff --git a/ggml/src/ggml-cuda/fattn-mma-f16.cuh b/ggml/src/ggml-cuda/fattn-mma-f16.cuh
index 96b596ea6..84716fa65 100644
--- a/ggml/src/ggml-cuda/fattn-mma-f16.cuh
+++ b/ggml/src/ggml-cuda/fattn-mma-f16.cuh
@@ -1795,6 +1795,7 @@ static constexpr __host__ __device__ bool ggml_cuda_flash_attn_ext_mma_f16_may_u
         const int DKQ, const int DV, const int ncols1, const int ncols2) {
     return (DKQ == 512 && DV == 512 && ncols1 == 1 && ncols2 == 8) ||
            (DKQ == 576 && DV == 512 && ncols1 == 1 && ncols2 == 16) ||
+           (DKQ == 576 && DV == 512 && ncols1 == 1 && ncols2 == 64) || // 0081: GLM-5.3, all 64 heads of a query in one tile
            (DKQ == 256 && DV == 256 && ncols1 == 1 && ncols2 == 8) ||
            (DKQ == 256 && DV == 256 && ncols1 == 8 && ncols2 == 8);
 }
@@ -2182,3 +2183,4 @@ extern DECL_FATTN_MMA_F16_CASE(576, 512,  8,  4);
 extern DECL_FATTN_MMA_F16_CASE(576, 512, 16,  4);
 extern DECL_FATTN_MMA_F16_CASE(576, 512,  1, 32);
 extern DECL_FATTN_MMA_F16_CASE(576, 512,  2, 32);
+extern DECL_FATTN_MMA_F16_CASE(576, 512,  1, 64); // 0081
diff --git a/ggml/src/ggml-cuda/fattn.cu b/ggml/src/ggml-cuda/fattn.cu
index 5d7ebf966..7a036e422 100644
--- a/ggml/src/ggml-cuda/fattn.cu
+++ b/ggml/src/ggml-cuda/fattn.cu
@@ -198,10 +198,12 @@ static void ggml_cuda_flash_attn_ext_mma_f16_switch_ncols1(ggml_backend_cuda_con
         }
     }
 
-    if (Q->ne[1] <= 32/ncols2 || (GGML_CUDA_CC_IS_NVIDIA(cc) && ggml_cuda_highest_compiled_arch(cc) == GGML_CUDA_CC_TURING) ||
-            (GGML_CUDA_CC_IS_AMD(cc) && DKQ > 256)) {
-        ggml_cuda_flash_attn_ext_mma_f16_case<DKQ, DV, 32/ncols2, ncols2>(ctx, dst);
-        return;
+    if constexpr (ncols2 <= 32) { // 0081: ncols2 = 64 has no 32-column variant
+        if (Q->ne[1] <= 32/ncols2 || (GGML_CUDA_CC_IS_NVIDIA(cc) && ggml_cuda_highest_compiled_arch(cc) == GGML_CUDA_CC_TURING) ||
+                (GGML_CUDA_CC_IS_AMD(cc) && DKQ > 256)) {
+            ggml_cuda_flash_attn_ext_mma_f16_case<DKQ, DV, 32/ncols2, ncols2>(ctx, dst);
+            return;
+        }
     }
 
     ggml_cuda_flash_attn_ext_mma_f16_case<DKQ, DV, 64/ncols2, ncols2>(ctx, dst);
@@ -426,6 +428,11 @@ static void ggml_cuda_flash_attn_ext_mma_f16(ggml_backend_cuda_context & ctx, gg
                 }
                 // Volta:
                 ggml_cuda_flash_attn_ext_mma_f16_switch_ncols1<576, 512, 4>(ctx, dst);
+            } else if (gqa_ratio % 64 == 0 && GGML_CUDA_CC_IS_NVIDIA(cc) && turing_mma_available(cc) &&
+                       (getenv("GGML_CUDA_FA_MLA64") == nullptr || atoi(getenv("GGML_CUDA_FA_MLA64")) != 0)) {
+                // 0081: all 64 heads of a query in one tile (GLM-5.3): each key row is read once per query, and the sparse path engages
+                // from 4K keys (GGML_CUDA_FA_MLA64=0: the 16-head grouping)
+                ggml_cuda_flash_attn_ext_mma_f16_switch_ncols1<576, 512, 64>(ctx, dst);
             } else if (gqa_ratio % 16 == 0) {
                 ggml_cuda_flash_attn_ext_mma_f16_switch_ncols1<576, 512, 16>(ctx, dst);
             } else {
diff --git a/ggml/src/ggml-cuda/template-instances/fattn-mma-f16-instance-ncols1_1-ncols2_64.cu b/ggml/src/ggml-cuda/template-instances/fattn-mma-f16-instance-ncols1_1-ncols2_64.cu
new file mode 100644
index 000000000..f1fe27b5e
--- /dev/null
+++ b/ggml/src/ggml-cuda/template-instances/fattn-mma-f16-instance-ncols1_1-ncols2_64.cu
@@ -0,0 +1,5 @@
+// 0081: GLM-5.3's MLA flash attention with all 64 heads of a query in one tile (not generated by generate_cu_files.py).
+
+#include "../fattn-mma-f16.cuh"
+
+DECL_FATTN_MMA_F16_CASE(576, 512, 1, 64);
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 3a51056a2..a91139e80 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -12459,6 +12459,14 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     test_cases.emplace_back(new test_flash_attn_ext(512, 512, 1, { 8, 1}, 4096, 64, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, false, 2048));
     test_cases.emplace_back(new test_flash_attn_ext(576, 512, 1, {16, 1}, 4096, 64, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, true,   512));
     test_cases.emplace_back(new test_flash_attn_ext(576, 512, 1, {16, 1}, 4096, 64, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, true,  2048));
+    // 0081: GLM-5.3's 64 query heads on 1 KV head in one tile -- dense below 4K keys, sparse from 4K, f16 and q8_0 K, odd query counts
+    for (ggml_type t : { GGML_TYPE_F16, GGML_TYPE_Q8_0 }) {
+        test_cases.emplace_back(new test_flash_attn_ext(576, 512, 1, {64, 1}, 2048, 64, true, false, 0, 0, GGML_PREC_F32, t, t, {0, 1, 2, 3}, true, true,    0));
+        test_cases.emplace_back(new test_flash_attn_ext(576, 512, 1, {64, 1}, 4096,  1, true, false, 0, 0, GGML_PREC_F32, t, t, {0, 1, 2, 3}, true, true, 2048));
+        test_cases.emplace_back(new test_flash_attn_ext(576, 512, 1, {64, 1}, 4096,  3, true, false, 0, 0, GGML_PREC_F32, t, t, {0, 1, 2, 3}, true, true, 2048));
+        test_cases.emplace_back(new test_flash_attn_ext(576, 512, 1, {64, 1}, 4096, 64, true, false, 0, 0, GGML_PREC_F32, t, t, {0, 1, 2, 3}, true, true,  512));
+        test_cases.emplace_back(new test_flash_attn_ext(576, 512, 1, {64, 1}, 8192, 67, true, false, 0, 0, GGML_PREC_F32, t, t, {0, 1, 2, 3}, true, true, 2048));
+    }
     test_cases.emplace_back(new test_flash_attn_ext(256, 256, 1, { 8, 1}, 4096, 64, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, false,  512));
     test_cases.emplace_back(new test_flash_attn_ext(128, 128, 1, { 8, 1}, 4096, 64, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, false,  512));
     test_cases.emplace_back(new test_flash_attn_ext(128, 128, 1, { 8, 1}, 4096, 64, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, false, 2048));
@@ -12805,6 +12813,16 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
         return test_cases;
     }
 
+    if (getenv("LLAMA_TEST_FA_MLA_PP") != nullptr) {
+        // 0081: GLM-5.3 prompt attention: 1 KV head x 64 query heads, the indexer's 2,048 keys per query, 1,024 queries a call
+        for (int64_t kv : { 4096, 8192, 16384, 32768 }) {
+            for (ggml_type t : { GGML_TYPE_F16, GGML_TYPE_Q8_0 }) {
+                test_cases.emplace_back(new test_flash_attn_ext(576, 512, 1, {64, 1}, kv, 1024, true, false, 0, 0, GGML_PREC_F32, t, t, {0, 1, 2, 3}, true, true, 2048));
+            }
+        }
+        return test_cases;
+    }
+
     if (getenv("LLAMA_TEST_MMID_BANK") != nullptr) {
         // the offload cache bank at decode: 8 of ~100 experts, GLM-5.3's shapes (gate/up 6144 -> 2048, down 2048 -> 6144), 1 and 8 tokens
         for (ggml_type type_a : { GGML_TYPE_IQ3_XXS, GGML_TYPE_IQ4_XS, GGML_TYPE_IQ3_S, GGML_TYPE_Q4_K, GGML_TYPE_Q5_K, GGML_TYPE_Q4_0, GGML_TYPE_Q8_0 }) {
