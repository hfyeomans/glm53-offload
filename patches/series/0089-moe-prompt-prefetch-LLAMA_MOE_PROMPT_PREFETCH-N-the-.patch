--- a/src/llama-moe-cache.h
+++ b/src/llama-moe-cache.h
@@ -94,6 +94,10 @@ public:
     // 0089 LLAMA_MOE_PROMPT_PRED=1: sel [n_expert_used, n_tokens] on the device, layer il+1's experts guessed in layer il's graph; layer
     // il's plan reads it with the layer's routing
     void set_prompt_pred(int32_t il, ggml_tensor * sel);
+    // 0090 LLAMA_MOE_PROMPT_PREFETCH=N: expert e of w as prefetched into the card's staging area for this graph compute, nullptr if not
+    const void * prompt_staged(const ggml_tensor * w, int64_t e) const;
