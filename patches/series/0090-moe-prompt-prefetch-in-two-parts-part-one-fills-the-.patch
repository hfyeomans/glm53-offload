@@ -98,6 +98,8 @@ public:
     const void * prompt_staged(const ggml_tensor * w, int64_t e) const;
     // after the gather of w's experts: once a planned layer's expert tensors are all up, the next layer's prefetch goes up behind them
     void prompt_after_gather(ggml_backend_t backend, const ggml_tensor * w);
+    // 0091: the CPU part's result of layer il (nullptr: none in this graph); its copy to the card releases the next layer's prefetch
+    void set_prompt_out(int32_t il, ggml_tensor * out);
 
     std::map<ggml_backend_buffer_type_t, size_t> memory_breakdown() const;
 
