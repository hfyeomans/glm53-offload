From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Wed, 4 Nov 2026 19:30:31 -0600
Subject: [PATCH 094/141] test-backend-ops: LLAMA_TEST_PP_GEMM=1, the prompt
 path matmuls at GLM-5.3 shapes (routed experts in ten weight types, dense
 projections in five)

---
 tests/test-backend-ops.cpp | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index d5988e33e..667733109 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -12823,6 +12823,23 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
         return test_cases;
     }
 
+    if (getenv("LLAMA_TEST_PP_GEMM") != nullptr) {
+        // 0095: the prompt path's matmuls at GLM-5.3's shapes: routed experts (256, top-8) and the dense attention projections
+        for (ggml_type type_a : { GGML_TYPE_IQ3_XXS, GGML_TYPE_IQ4_XS, GGML_TYPE_Q3_K, GGML_TYPE_Q4_K, GGML_TYPE_Q4_0, GGML_TYPE_Q8_0,
+                                  GGML_TYPE_MXFP4, GGML_TYPE_NVFP4, GGML_TYPE_F16, GGML_TYPE_BF16 }) {
+            for (int n : { 4096, 8192 }) {
+                test_cases.emplace_back(new test_mul_mat_id(type_a, GGML_TYPE_F32, 256, 8, false, 2048, n, 6144));
+                test_cases.emplace_back(new test_mul_mat_id(type_a, GGML_TYPE_F32, 256, 8, false, 6144, n, 2048));
+            }
+        }
+        for (ggml_type type_a : { GGML_TYPE_Q5_K, GGML_TYPE_Q8_0, GGML_TYPE_Q4_K, GGML_TYPE_F16, GGML_TYPE_BF16 }) {
+            for (auto mk : std::vector<std::array<int64_t, 2>>{ {2048, 6144}, {16384, 2048}, {576, 6144}, {6144, 16384} }) {
+                test_cases.emplace_back(new test_mul_mat(type_a, GGML_TYPE_F32, mk[0], 8192, mk[1], {1, 1}, {1, 1}));
+            }
+        }
+        return test_cases;
+    }
+
     if (getenv("LLAMA_TEST_MMID_PROMPT") != nullptr) {
         // 0084: GLM-5.3's experts at prompt sizes, 256 experts, top-8: n/32 tokens an expert on average
         for (ggml_type type_a : { GGML_TYPE_IQ3_XXS, GGML_TYPE_IQ4_XS }) {
