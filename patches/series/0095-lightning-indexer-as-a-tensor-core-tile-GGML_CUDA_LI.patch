+++ b/tests/test-backend-ops.cpp
@@ -12784,6 +12784,17 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
         }
     }
 
+    // 0096: 32 heads at the tile kernel's edges (GGML_CUDA_LID_MMA=1 takes even key counts): partial key tiles, a second key block
+    // (1,024 keys a block), partial query blocks (8 a block), 4 streams
+    for (int kv : { 2, 8, 62, 64, 66, 1026, 2050 }) {
