From 3323e89d05663d8c4f66cc7c8f595725c886598e Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Wed, 4 Nov 2026 20:10:23 -0600
Subject: [PATCH 097/141] tiled CPU matmul: iq3_xxs unpack in AVX-512
 (GGML_CPU_TILED_IQ3_SIMD, default on): gathers for the grid, vpmultishiftqb +
 vpermi2b for the signs, byte-identical

---
 ggml/src/ggml-cpu/tiled/tiled.cpp | 38 +++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/ggml/src/ggml-cpu/tiled/tiled.cpp b/ggml/src/ggml-cpu/tiled/tiled.cpp
index 77e1a9945..c1c240d39 100644
--- a/ggml/src/ggml-cpu/tiled/tiled.cpp
+++ b/ggml/src/ggml-cpu/tiled/tiled.cpp
@@ -380,6 +380,38 @@ static void tiled_unpack_src0(const block_iq2_s * rows, int64_t row_stride, int
 
 // iq3_xxs: 3-bit grids through the iq3xxs_grid LUT, 4-bit scale per 32, no min
 // codes stored as (value + 128), matching BIAS = 128
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VL__) && defined(__AVX512VBMI__)
+// 0098 GGML_CPU_TILED_IQ3_SIMD (default on): one block's 256 biased codes and 8 scales, byte-identical to the loop below
+static bool tiled_iq3_simd(void) {
+    static bool enabled = true;
+    static std::once_flag flag;
+    std::call_once(flag, []() {
+        const char * env = getenv("GGML_CPU_TILED_IQ3_SIMD");
+        enabled = env == NULL || atoi(env) != 0;
+    });
+    return enabled;
+}
+
+static inline void tiled_unpk_iq3_xxs_avx512(const block_iq3_xxs & x, uint8_t * q, int32_t * scales) {
+    const uint8_t * qs  = x.qs;
+    const __m256i aux  = _mm256_loadu_si256((const __m256i *) (x.qs + QK_K / 4));
+    // the four 7-bit sign indices of each aux32, at bits 0/7/14/21 of either half of a qword
+    const __m256i ctrl = _mm256_set1_epi64x(0x352E2720150E0700LL);
+    const __m256i sidx = _mm256_and_si256(_mm256_multishift_epi64_epi8(ctrl, aux), _mm256_set1_epi8(0x7F));
+    const __m512i ks0  = _mm512_loadu_si512((const void *) (ksigns_iq2xs +  0));
+    const __m512i ks1  = _mm512_loadu_si512((const void *) (ksigns_iq2xs + 64));
+    alignas(64) uint64_t sm[8];
+    _mm512_store_si512((void *) sm, _mm512_permutex2var_epi8(ks0, _mm512_castsi256_si512(sidx), ks1));
+    const __m512i c128 = _mm512_set1_epi8((char) 128);
+    for (int g = 0; g < 4; ++g) {
+        const __m512i idx = _mm512_cvtepu8_epi32(_mm_loadu_si128((const __m128i *) (qs + 16 * g)));
+        const __m512i v   = _mm512_i32gather_epi32(idx, (const void *) iq3xxs_grid, 4);
+        _mm512_storeu_si512((void *) (q + 64 * g), _mm512_mask_blend_epi8((__mmask64) sm[g], _mm512_add_epi8(c128, v), _mm512_sub_epi8(c128, v)));
+    }
+    _mm256_storeu_si256((__m256i *) scales, _mm256_add_epi32(_mm256_slli_epi32(_mm256_srli_epi32(aux, 28), 1), _mm256_set1_epi32(1)));
+}
+#endif
+
 static void tiled_unpack_src0(const block_iq3_xxs * rows, int64_t row_stride, int n_rows, tiled_tile_src0 * tile, int num_k) {
     GGML_ASSERT(n_rows <= TILED_TILE_ROWS);
     constexpr int NB = 8; // 32-wide subblocks
@@ -393,6 +425,12 @@ static void tiled_unpack_src0(const block_iq3_xxs * rows, int64_t row_stride, in
             const int s_off = r * nb_stride + slab * NB;
             const block_iq3_xxs & x = rows[r * row_stride + slab];
             tile->d[d_off] = ggml_fp16_to_fp32(x.d) * 0.25f;
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VL__) && defined(__AVX512VBMI__)
+            if (tiled_iq3_simd()) {
+                tiled_unpk_iq3_xxs_avx512(x, &tile->q[q_off], &tile->scales[s_off]);
+                continue;
+            }
+#endif
 
             const uint8_t * qs = x.qs;
             const uint8_t * scales_and_signs = x.qs + QK_K / 4; // 4 bytes per 32: code bits in the top nibble, signs in 7-bit chunks
