From f2dab2532dc7b4ba71405ba894741616d3980685 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Thu, 5 Nov 2026 00:43:15 -0600
Subject: [PATCH 103/211] MUL_MAT_ID one block a real tile
 (GGML_CUDA_MMQ_MMID_COMPACT=1): the experts column tiles scanned on the card,
 a block finds its expert by binary search

---
 ggml/src/ggml-cuda/mmq.cu  | 39 ++++++++++++++++++++++++-
 ggml/src/ggml-cuda/mmq.cuh | 58 +++++++++++++++++++++++++++++---------
 2 files changed, 82 insertions(+), 15 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmq.cu b/ggml/src/ggml-cuda/mmq.cu
index cb17d93ad..7a0fd8582 100644
--- a/ggml/src/ggml-cuda/mmq.cu
+++ b/ggml/src/ggml-cuda/mmq.cu
@@ -161,6 +161,32 @@ static int ggml_cuda_mmq_get_J_best(
     return J_best;
 }
 
+// 0104 GGML_CUDA_MMQ_MMID_COMPACT=1: each expert's column tiles (J tokens a tile) scanned into tile_off = [n_experts, offset_0 .. offset_n],
+// one block of up to 1,024 threads (one an expert)
+static __global__ void mmq_mmid_tile_offsets(const int32_t * __restrict__ expert_bounds, const int n_experts, const int J,
+        int32_t * __restrict__ tile_off) {
+    __shared__ int s[1024];
+    const int e = threadIdx.x;
+    const int c = e < n_experts ? (expert_bounds[e + 1] - expert_bounds[e] + J - 1) / J : 0;
+    s[e] = c;
+    __syncthreads();
+    for (int d = 1; d < (int) blockDim.x; d <<= 1) {
+        const int v = e >= d ? s[e - d] : 0;
+        __syncthreads();
+        s[e] += v;
+        __syncthreads();
+    }
+    if (e < n_experts) {
+        tile_off[1 + e] = s[e] - c;
+    }
+    if (e == 0) {
+        tile_off[0] = n_experts;
+    }
+    if (e == (int) blockDim.x - 1) {
+        tile_off[1 + n_experts] = s[e];
+    }
+}
+
 void ggml_cuda_mul_mat_q(
         ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst,
         const ggml_cuda_mm_fusion_args_host * fusion) {
@@ -397,7 +423,18 @@ void ggml_cuda_mul_mat_q(
         ne03, ne13, s03, s13, s3,
         ne12, J_best, fusion_device};
 
-    ggml_cuda_mul_mat_q_switch_type(ctx, args, stream, prec_src1);
+    // 0104 GGML_CUDA_MMQ_MMID_COMPACT=1: one block a real tile, from the experts' column tiles scanned on the card
+    static const bool mmid_compact = getenv("GGML_CUDA_MMQ_MMID_COMPACT") != nullptr && atoi(getenv("GGML_CUDA_MMQ_MMID_COMPACT")) != 0;
+    ggml_cuda_pool_alloc<int32_t> tile_off(ctx.pool());
+    mmq_args args_c = args;
+    if (mmid_compact && ne02 <= 1024) {
+        tile_off.alloc(ne02 + 2);
+        mmq_mmid_tile_offsets<<<1, (unsigned) ((ne02 + 31)/32*32), 0, stream>>>(expert_bounds.get(), (int) ne02, J_best, tile_off.get());
+        CUDA_CHECK(cudaGetLastError());
+        args_c.tile_off = tile_off.get();
+    }
+
+    ggml_cuda_mul_mat_q_switch_type(ctx, args_c, stream, prec_src1);
 }
 
 bool ggml_cuda_should_use_mmq(enum ggml_type type, int cc, int64_t ne11, int64_t n_experts) {
diff --git a/ggml/src/ggml-cuda/mmq.cuh b/ggml/src/ggml-cuda/mmq.cuh
index 4d8b110f6..0766ca6f1 100644
--- a/ggml/src/ggml-cuda/mmq.cuh
+++ b/ggml/src/ggml-cuda/mmq.cuh
@@ -998,8 +998,35 @@ static __device__ __forceinline__ void mul_mat_q_process_tile(
 // tiles of an expert's column tile back to back (row tile fastest, expert slowest): the column tile's activations are read from HBM once
 // and stay in L2 for its other row tiles.  tile_order 0 is the upstream order (column tile fastest, row tile slowest).
 static __device__ __forceinline__ void mmq_tile_coords(int tmp, const uint3 ntx, const uint3 nchannels_y, const uint3 nsamples_y,
-        const int nty, const int tile_order, int & jt, int & zt, int & wt, int & it) {
+        const int nty, const int tile_order, int & jt, int & zt, int & wt, int & it, const int32_t * __restrict__ tile_off) {
     uint2 tmp2;
+    if (tile_off != nullptr) {
+        // 0104: ntx is the bound on all experts' column tiles (one channel); tile_off = [n_experts, offset_0 .. offset_n]
+        tmp2 = fast_div_modulo(tmp, ntx);
+        const int ct = tmp2.y;
+        it = tmp2.x;
+        wt = 0;
+        const int n = tile_off[0];
+        const int32_t * offs = tile_off + 1;
+        if (ct >= offs[n]) { // past the real tiles: an empty tile of the last expert
+            zt = n - 1;
+            jt = 1 << 20;
+            return;
+        }
+        int lo = 0;
+        int hi = n - 1;
+        while (lo < hi) {
+            const int mid = (lo + hi + 1) >> 1;
+            if (offs[mid] <= ct) {
+                lo = mid;
+            } else {
+                hi = mid - 1;
+            }
+        }
+        zt = lo;
+        jt = ct - offs[lo];
+        return;
+    }
     if (tile_order == 1) {
         it   = tmp % nty;
         tmp  = tmp / nty;
@@ -1033,7 +1060,7 @@ static __global__ void mul_mat_q(
         const uint3 blocks_per_ne00, const int nrows_x, const int ncols_dst, const int stride_row_x, const int ncols_y, const int stride_col_dst,
         const uint3 channel_ratio, const uint3 nchannels_y, const int stride_channel_x, const int stride_channel_y, const int stride_channel_dst,
         const uint3 sample_ratio, const uint3 nsamples_y, const int stride_sample_x, const int stride_sample_y, const int stride_sample_dst,
-        const uint3 ntx, const int tile_order) {
+        const uint3 ntx, const int tile_order, const int32_t * __restrict__ tile_off) {
 
 #ifdef TURING_MMA_AVAILABLE
     constexpr bool fusion_available = true;
@@ -1159,7 +1186,7 @@ static __global__ void mul_mat_q(
     int kb0_stop  = min(blocks_per_ne00.z, uint32_t(kb0_start + kbc_stop - kbc));
     while (kbc < kbc_stop && kb0_stop == int(blocks_per_ne00.z)) {
         int jt, zt, wt, it;
-        mmq_tile_coords(fastdiv(kbc, blocks_per_ne00), ntx, nchannels_y, nsamples_y, (nrows_x + I - 1)/I, tile_order, jt, zt, wt, it);
+        mmq_tile_coords(fastdiv(kbc, blocks_per_ne00), ntx, nchannels_y, nsamples_y, (nrows_x + I - 1)/I, tile_order, jt, zt, wt, it, tile_off);
 
         // Defaults for regular matrix multiplication:
         int col_low    = 0;
@@ -1240,7 +1267,7 @@ static __global__ void mul_mat_q(
     }
 
     int jt, zt, wt, it;
-    mmq_tile_coords(fastdiv(kbc, blocks_per_ne00), ntx, nchannels_y, nsamples_y, (nrows_x + I - 1)/I, tile_order, jt, zt, wt, it);
+    mmq_tile_coords(fastdiv(kbc, blocks_per_ne00), ntx, nchannels_y, nsamples_y, (nrows_x + I - 1)/I, tile_order, jt, zt, wt, it, tile_off);
 
     // Defaults for regular matrix multiplication:
     int col_low    = 0;
@@ -1311,7 +1338,7 @@ static __global__ void mul_mat_q_stream_k_fixup(
         const int32_t * __restrict__ ids_dst, const int32_t * __restrict__ expert_bounds, float * __restrict__ dst,
         float * __restrict__ tmp_last_tile, const uint3 blocks_per_ne00, const int nrows_x, const int ncols_dst,
         const int stride_col_dst, const uint3 nchannels_y, const int stride_channel_dst, const uint3 nsamples_y,
-        const int stride_sample_dst, const uint3 ntx, const int tile_order) {
+        const int stride_sample_dst, const uint3 ntx, const int tile_order, const int32_t * __restrict__ tile_off) {
     constexpr int warp_size       = ggml_cuda_get_physical_warp_size();
     constexpr int nwarps          = (ggml_cuda_mmq_get_nthreads(type, J, fallback, prec_src1) / 2) / warp_size;
     constexpr int I               = ggml_cuda_mmq_get_I(type, J, fallback, prec_src1);
@@ -1379,7 +1406,7 @@ static __global__ void mul_mat_q_stream_k_fixup(
     }
 
     int jt, zt, wt, it;
-    mmq_tile_coords(fastdiv(kbc0, blocks_per_ne00), ntx, nchannels_y, nsamples_y, nty, tile_order, jt, zt, wt, it);
+    mmq_tile_coords(fastdiv(kbc0, blocks_per_ne00), ntx, nchannels_y, nsamples_y, nty, tile_order, jt, zt, wt, it, tile_off);
 
     if (!ids_dst) {
         const int offset_dst = wt*stride_sample_dst + zt*stride_channel_dst + jt*J*stride_col_dst + it*I;
@@ -1444,6 +1471,7 @@ struct mmq_args {
     int64_t ncols_max;
     int J_best; // Tile width in ne11(dense)/ne12(MoE) direction to use for optimal performance.
     ggml_cuda_mm_fusion_args_device fusion = {}; // gate != nullptr selects the fused gate/up/GLU path
+    const int32_t * tile_off = nullptr; // 0104: MUL_MAT_ID's scanned column tiles (GGML_CUDA_MMQ_MMID_COMPACT=1), [n_experts, offsets..]
 };
 
 static size_t mmq_get_nbytes_shared(const ggml_cuda_mmq_config & config, const int cc) {
@@ -1466,6 +1494,8 @@ static void launch_mul_mat_q(ggml_backend_cuda_context & ctx, const mmq_args & a
     // 0101 GGML_CUDA_MMQ_MMID_ORDER=1: MUL_MAT_ID's stream-k tiles expert-outermost, row tile fastest
     static const int mmid_order = getenv("GGML_CUDA_MMQ_MMID_ORDER") != nullptr ? atoi(getenv("GGML_CUDA_MMQ_MMID_ORDER")) : 0;
     const int tile_order = args.ids_dst != nullptr && mmid_order == 1 ? 1 : 0;
