     const int nwork = ntiles_dst * ((args.ncols_x + config.K_vram - 1) / config.K_vram); // Maximum number of CUDA blocks that can do useful work.
     // 0103 GGML_CUDA_MMQ_MMID_SK=1: MUL_MAT_ID always takes the stream-k loop (its nominal grid is mostly empty tiles)
     static const bool mmid_sk = getenv("GGML_CUDA_MMQ_MMID_SK") != nullptr && atoi(getenv("GGML_CUDA_MMQ_MMID_SK")) != 0;
-    const bool one_block_a_tile = GGML_CUDA_CC_IS_NVIDIA(cc) && tiles_efficiency_percent >= 90 && !(mmid_sk && args.ids_dst != nullptr);
