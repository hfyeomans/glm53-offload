From 048a28b7bc84a6f1f8d1e1cf1d8b3e2369955057 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Thu, 5 Nov 2026 02:44:48 -0600
Subject: [PATCH 106/141] both-cards prompt graph: the expert split follows the
 MoE cache (LLAMA_TP_EP_CACHE=1): the home card takes its cached experts and a
 share of the uncached ones so both cards upload about the same bytes a layer;
 per-card id tables, fixed-size views filled by position; the ring mixed path
 takes host entries anywhere in the host tensor

---
 ggml/include/ggml-cuda.h        |   4 +
 ggml/src/ggml-cuda/ggml-cuda.cu |  29 +++--
 src/llama-context.cpp           |  26 ++++-
 src/llama-graph.cpp             |  25 +++--
 src/llama-moe-cache.cpp         | 188 ++++++++++++++++++++++++++++++++
 src/llama-moe-cache.h           |  11 ++
 src/models/glm-dsa.cpp          |  16 +++
 7 files changed, 281 insertions(+), 18 deletions(-)

diff --git a/ggml/include/ggml-cuda.h b/ggml/include/ggml-cuda.h
index e8d7cd78c..49cb48332 100644
--- a/ggml/include/ggml-cuda.h
+++ b/ggml/include/ggml-cuda.h
@@ -38,6 +38,10 @@ GGML_BACKEND_API bool ggml_backend_cuda_host_ptr_device_accessible(const void *
 // `host_all`, when given, is the contiguous host copy of all n experts: the slot is then filled with one cudaMemcpyAsync (the copy
 // engine) instead of the gather kernel, and `srcs` is ignored
 GGML_BACKEND_API void * ggml_backend_cuda_upload_ring_gather(ggml_backend_t backend, bool first_of_split, const void * const * srcs, int64_t n, size_t size, size_t split_bytes, const void * host_all);
+// 0107: as above with a table, the entries inside [host_lo, host_hi) taken as pinned host memory wherever they sit in srcs (with
+// GGML_CUDA_RING_MIXED=1, runs of them consecutive in memory go up by the copy engine, the other entries by the gather kernel; null
+// entries are skipped)
+GGML_BACKEND_API void * ggml_backend_cuda_upload_ring_gather_span(ggml_backend_t backend, bool first_of_split, const void * const * srcs, int64_t n, size_t size, size_t split_bytes, const void * host_lo, const void * host_hi);
 // 0090: host-to-device copies into the caller's memory on the device's upload ring stream, after the gathers issued so far (the main stream
 // does not wait for them; a later gather on the same stream reads them in order); false when the device has no ring yet
 GGML_BACKEND_API bool ggml_backend_cuda_upload_ring_prefetch(ggml_backend_t backend, void * const * dsts, const void * const * srcs, const size_t * sizes, size_t n);
