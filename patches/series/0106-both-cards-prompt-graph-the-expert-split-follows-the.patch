diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index a7955cf14..4e4aac70a 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -1291,6 +1291,162 @@ struct llama_moe_cache::impl {
         return (const char *) bank->data + (size_t) slots[e]*bank->nb[2];
     }
 
+    // 0107 LLAMA_TP_EP_CACHE=1: the both-cards graph's expert split (see llama_moe_cache::ep_plan)
+    struct ep_layer {
+        ggml_tensor * ids[2] = { nullptr, nullptr }; // I32 [1, n_expert] on card c: expert -> position in card c's view, -1 elsewhere
+        std::vector<int32_t> src[2];                 // card c's view: position -> expert
+        std::vector<int32_t> host[2];                // what ids[c] holds
+        int home = -1;
+    };
+    struct ep_state {
+        bool tried = false;
+        bool on    = false;
+        ggml_backend_t be[2] = { nullptr, nullptr };
+        int64_t n_view_home  = 0; // a card's view on its home layers
+        int64_t n_view_other = 0; // on the other card's
+        ggml_context_ptr ctx[2];
+        ggml_backend_buffer_ptr buf[2];
+        std::vector<ep_layer> layers;
+        uint64_t n_plans = 0;
+    } ep;
+
+    static bool ep_enabled() {
+        static const bool v = getenv("LLAMA_TP_EP_CACHE") != nullptr && atoi(getenv("LLAMA_TP_EP_CACHE")) != 0;
+        return v;
+    }
+
+    bool ep_init(const ggml_backend_t be[2]) {
+        ep.tried = true;
+        int64_t n_expert = 0;
+        size_t  n_t      = 0;
+        for (const layer & l : layers) {
+            if (l.ig >= 0 && !l.experts.empty()) {
+                n_expert = std::max(n_expert, l.experts[0]->ne[2]);
+                n_t++;
+            }
+        }
+        static const bool ring = getenv("LLAMA_MOE_UPLOAD_RING") != nullptr && atoi(getenv("LLAMA_MOE_UPLOAD_RING")) != 0;
+        if (n_t == 0 || n_expert > 256 || n_expert % 2 != 0 || !ring || be[0] == nullptr || be[1] == nullptr) {
+            LLAMA_LOG_WARN("%s: LLAMA_TP_EP_CACHE needs cached MoE layers of up to 256 experts and LLAMA_MOE_UPLOAD_RING=1, not used\n", __func__);
+            return false;
+        }
+        // the views are sized once: the graph's shapes do not change between builds (the reserve holds)
+        const char * hv = getenv("LLAMA_TP_EP_HOME");
+        ep.n_view_home  = std::min(n_expert, std::max(n_expert/2, hv != nullptr ? (int64_t) atoi(hv) : n_expert*13/16));
+        ep.n_view_other = n_expert/2;
+        ep.layers.assign(layers.size(), ep_layer());
+        for (int c = 0; c < 2; ++c) {
+            ep.be[c] = be[c];
+            ggml_init_params params = { n_t*ggml_tensor_overhead(), nullptr, true };
+            ep.ctx[c].reset(ggml_init(params));
+            for (size_t il = 0; il < layers.size(); ++il) {
+                const layer & l = layers[il];
+                if (l.ig < 0 || l.experts.empty()) {
+                    continue;
+                }
+                ep.layers[il].ids[c] = ggml_new_tensor_2d(ep.ctx[c].get(), GGML_TYPE_I32, 1, l.experts[0]->ne[2]);
+                ggml_format_name(ep.layers[il].ids[c], "moe_cache.ep_ids-%d-%zu", c, il);
+            }
+            ep.buf[c] = llama_memory_bufs::alloc_buf(ep.ctx[c].get(), ggml_backend_get_default_buffer_type(be[c]), false, "TP EP tables");
+            GGML_ASSERT(ep.buf[c]);
+            // as weights: the MUL_MAT_IDs' lookups read them on their card, nothing is copied
+            ggml_backend_buffer_set_usage(ep.buf[c].get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        }
+        ep.on = true;
+        LLAMA_LOG_INFO("%s: LLAMA_TP_EP_CACHE: %zu MoE layers, a card's view %lld experts on its home layers, %lld on the other card's\n",
+            __func__, n_t, (long long) ep.n_view_home, (long long) ep.n_view_other);
+        return true;
+    }
+
+    bool ep_plan(const ggml_backend_t be[2], const std::vector<int> & home, const std::vector<size_t> & w_bytes) {
+        if (!ep_enabled() || (ep.tried && !ep.on)) {
+            return false;
+        }
+        if (!ep.tried && !ep_init(be)) {
+            return false;
+        }
+        GGML_ASSERT(llama_moe_cache_same_device(be[0], ep.be[0]) && llama_moe_cache_same_device(be[1], ep.be[1]));
+        static const int shift = getenv("LLAMA_TP_EP_SHIFT") != nullptr ? atoi(getenv("LLAMA_TP_EP_SHIFT")) : 0;
+        ep.n_plans++;
+        double up[2] = { 0.0, 0.0 }, local[2] = { 0.0, 0.0 }, worst = 0.0, worst_fixed = 0.0;
+        int n_layers = 0;
+        std::vector<int32_t> cached, uncached;
+        bool synced[2] = { false, false };
+        for (size_t il = 0; il < layers.size(); ++il) {
+            const layer & l = layers[il];
+            ep_layer & el = ep.layers[il];
+            if (el.ids[0] == nullptr || il >= home.size() || (home[il] != 0 && home[il] != 1)) {
+                continue;
+            }
+            const int H = home[il];
+            const int O = 1 - H;
+            el.home = H;
+            const int64_t n = l.experts[0]->ne[2];
+            size_t S = 0;
+            for (const ggml_tensor * t : l.experts) {
+                S += t->nb[2];
+            }
+            // the experts the home card's cache holds (none if the layer is cached on the other card)
+            const group & g = groups[l.ig];
+            const int32_t * slots = il < g.slru.slot_map.size() ? g.slru.slot_map[il] : nullptr;
+            const bool on_home = llama_moe_cache_same_device(devices[g.id].backend, be[H]);
+            cached.clear();
+            uncached.clear();
+            for (int64_t e = 0; e < n; ++e) {
+                (on_home && slots != nullptr && slots[e] < g.n_slots ? cached : uncached).push_back((int32_t) e);
+            }
+            const int64_t nc = (int64_t) cached.size();
+            const int64_t nu = (int64_t) uncached.size();
+            const double  W  = il < w_bytes.size() ? (double) w_bytes[il] : 0.0; // the other card's weight-ring upload of the layer
+            // the home card's share of the uncached: x*S = (nu - x)*S + W
+            int64_t x = (int64_t) std::llround((nu*(double) S + W)/(2.0*S)) + shift;
+            x = std::min(nu, std::max<int64_t>(0, x));
+            const int64_t nh  = std::min(ep.n_view_home, std::max(n - ep.n_view_other, nc + x));
+            const int64_t nhc = std::min(nc, nh); // the cached ones the home card computes
+            const int64_t nhu = nh - nhc;         // and the uncached ones
+            el.src[H].clear();
+            el.src[O].clear();
