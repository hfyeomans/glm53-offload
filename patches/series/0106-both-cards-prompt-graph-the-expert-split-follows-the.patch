+
+int64_t llama_moe_cache::ep_view_n(int32_t il, int c) const {
+    const auto & ep = pimpl->ep;
+    GGML_ASSERT(ep_ids(il, c) != nullptr);
+    return ep.layers[il].home == c ? ep.n_view_home : ep.n_view_other;
