+        ggml_free(lm_z_ctx);
+        lm_z_ctx = nullptr;
+    }
+
     // when training, ggml_opt allocates extra buffers through the scheduler, so the sizes no longer match the expectation
     if (!model.no_alloc() && !opt_ctx) {
         for (size_t i = 0; i < backend_ptrs.size(); ++i) {
@@ -857,6 +868,75 @@ void llama_context::sched_new(size_t max_nodes, bool parallel) {
     ggml_backend_sched_set_realloc_callback(sched.get(), sched_graph_realloc, this);
 }
 
+// 0108 LLAMA_LAYER_MAJOR=R (rows of an attention block, 0 = off), LLAMA_LM_PIPE (the ubatches a prompt batch is cut into, default 6),
+// LLAMA_LM_FALLBACK_UB (the ubatch of a batch the layer-major graph cannot take, default 512)
+static uint32_t llama_lm_rows() {
+    static const uint32_t v = getenv("LLAMA_LAYER_MAJOR") != nullptr ? (uint32_t) std::max(0, atoi(getenv("LLAMA_LAYER_MAJOR"))) : 0;
+    return v;
+}
+static uint32_t llama_lm_pipe() {
+    static const uint32_t v = getenv("LLAMA_LM_PIPE") != nullptr ? (uint32_t) std::max(1, atoi(getenv("LLAMA_LM_PIPE"))) : 6;
+    return v;
+}
+static uint32_t llama_lm_fallback_ub() {
+    static const uint32_t v = getenv("LLAMA_LM_FALLBACK_UB") != nullptr ? (uint32_t) std::max(1, atoi(getenv("LLAMA_LM_FALLBACK_UB"))) : 512;
+    return v;
+}
+static bool llama_lm_enabled(const llama_model & model, const llama_cparams & cparams) {
+    return llama_lm_rows() >= 512 && model.arch == LLM_ARCH_GLM_DSA && cparams.n_ubatch > llama_lm_rows();
+}
+
+// 0108: the causal staircase of every device that holds layers: Z[j][i] = 0 for column j <= S + i, -inf after (S = n_ctx rounded up to
+// 8).  Rows whose first position is p0 read the view at column c = pad8(S - p0), row d = c - (S - p0): element (j, i) is Z[c + j][d + i],
+// visible iff j <= p0 + i -- the causal mask of a sequence whose cells are its positions.  Uploaded once, row by row.
+void llama_context::lm_z_init() {
+    if (!lm_z.empty() || !llama_lm_enabled(model, cparams)) {
+        return;
+    }
+    const uint32_t R  = llama_lm_rows();
+    const int64_t  Rp = GGML_PAD((int64_t) R, 8);
+    const int64_t  S  = GGML_PAD((int64_t) cparams.n_ctx, 8);
+    const int64_t  W  = S + Rp + 512;
+    const int64_t  H  = Rp + 8;
+    std::vector<ggml_backend_dev_t> devs;
+    for (int il = 0; il < (int) model.hparams.n_layer(); ++il) {
+        ggml_backend_dev_t d = model.dev_layer(il);
+        if (d != nullptr && std::find(devs.begin(), devs.end(), d) == devs.end()) {
+            devs.push_back(d);
+        }
+    }
+    ggml_init_params ip = { ggml_tensor_overhead()*(devs.size() + 1), nullptr, true };
+    lm_z_ctx = ggml_init(ip);
+    std::vector<ggml_fp16_t> row(W);
+    const ggml_fp16_t zero = ggml_fp32_to_fp16(0.0f);
+    const ggml_fp16_t ninf = ggml_fp32_to_fp16(-INFINITY);
+    for (ggml_backend_dev_t d : devs) {
+        ggml_tensor * z = ggml_new_tensor_2d(lm_z_ctx, GGML_TYPE_F16, W, H);
+        ggml_format_name(z, "lm_z.%s", ggml_backend_dev_name(d));
+        ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(ggml_backend_dev_buffer_type(d), ggml_nbytes(z));
+        if (buf == nullptr) {
+            throw std::runtime_error("LLAMA_LAYER_MAJOR: failed to allocate the causal staircase");
+        }
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        if (ggml_backend_tensor_alloc(buf, z, ggml_backend_buffer_get_base(buf)) != GGML_STATUS_SUCCESS) {
+            throw std::runtime_error("LLAMA_LAYER_MAJOR: failed to place the causal staircase");
+        }
+        for (int64_t j = 0; j < W; ++j) {
+            row[j] = j <= S ? zero : ninf;
+        }
+        for (int64_t i = 0; i < H; ++i) {
+            if (i > 0) {
+                row[S + i] = zero;
+            }
+            ggml_backend_tensor_set(z, row.data(), (size_t) i*z->nb[1], (size_t) W*sizeof(ggml_fp16_t));
+        }
+        lm_z_buf.push_back(buf);
+        lm_z.emplace_back(d, z);
+        LLAMA_LOG_INFO("%s: LLAMA_LAYER_MAJOR=%u: causal staircase %lld x %lld f16 on %s (%.1f MiB)\n", __func__, R,
+            (long long) W, (long long) H, ggml_backend_dev_name(d), ggml_nbytes(z)/1024.0/1024.0);
+    }
+}
