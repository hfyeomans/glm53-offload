     // 0071 LLAMA_TP_PROMPT: the both-cards prompt graph only for a batch that is one ubatch
     cparams.tp_batch_single = balloc->get_n_tokens() <= cparams.n_ubatch;
+    cparams.lm_rows    = lm_try ? lm_R : 0; // 0108
+    cparams.lm_reserve = false;
 
     do {
         const auto & ubatch = mctx->get_ubatch();
@@ -2762,6 +2897,14 @@ uint32_t llama_context::graph_max_nodes(uint32_t n_tokens) const {
         res *= 3;
     }
 
+    // 0108 LLAMA_LAYER_MAJOR: the layer-major prompt graph builds each layer's attention once a block of R rows and its FFN once a block
+    // of LLAMA_LM_MOE_ROWS rows (~30-40 nodes each)
+    if (llama_lm_rows() > 0 && n_tokens > llama_lm_rows()) {
