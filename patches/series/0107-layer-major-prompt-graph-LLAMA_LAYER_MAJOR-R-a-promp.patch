+        cparams.lm_rows    = 0;
+        cparams.lm_reserve = false;
     }
 
     for (size_t i = 0; i < backend_ptrs.size(); ++i) {
@@ -2127,8 +2232,24 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
 
     llama_memory_context_ptr mctx;
 
+    // 0108 LLAMA_LAYER_MAJOR=R: a batch of more than 8 tokens is cut into ubatches of ~1/LLAMA_LM_PIPE of it (a multiple of R, R to
+    // n_ubatch) for the layer-major prompt graph when every token lands on the cell of its position (lm_positional); otherwise, and for a
+    // batch of 8 tokens or fewer, the usual graph at LLAMA_LM_FALLBACK_UB rows a ubatch
+    const bool lm_on = llama_lm_enabled(model, cparams);
+    const uint32_t lm_R = llama_lm_rows();
+    uint32_t n_ub = lm_on ? std::min(cparams.n_ubatch, llama_lm_fallback_ub()) : cparams.n_ubatch;
+    bool lm_try = false;
+    if (lm_on && balloc->get_n_tokens() > 8) {
+        const uint32_t n_all = balloc->get_n_tokens();
+        const uint32_t k = llama_lm_pipe();
+        uint32_t u = (n_all + k - 1)/k;
+        u = (u + lm_R - 1)/lm_R*lm_R;
+        n_ub = std::min(cparams.n_ubatch, std::max(lm_R, u));
+        lm_try = true;
+    }
+
     while (true) {
-        mctx = memory->init_batch(*balloc, cparams.n_ubatch, embd_all);
+        mctx = memory->init_batch(*balloc, n_ub, embd_all);
         if (!mctx) {
             return -2;
         }
@@ -2167,6 +2288,18 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
                 }
         }
 
+        // 0108: the layer-major graph's masks need every token at the cell of its position; otherwise the usual graph, small ubatches
+        if (lm_try && !mctx->lm_positional()) {
+            static int n_warn = 0;
+            if (n_warn++ < 4) {
+                LLAMA_LOG_WARN("%s: LLAMA_LAYER_MAJOR: a batch of %d tokens is not positional, the usual graph at %u rows a ubatch\n",
+                    __func__, balloc->get_n_tokens(), llama_lm_fallback_ub());
+            }
+            lm_try = false;
+            n_ub = std::min(cparams.n_ubatch, llama_lm_fallback_ub());
+            continue;
+        }
+
         break;
     }
 
