From ae0cb3e224e8d8e74cebc7d7308f694af6f15121 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Thu, 5 Nov 2026 17:23:33 -0600
Subject: [PATCH 126/141] GGML_GALLOCR_PEAK: the large-request log to stderr,
 from 256 MiB

---
 ggml/src/ggml-alloc.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-alloc.c b/ggml/src/ggml-alloc.c
index 0f877d056..a6c1c7014 100644
--- a/ggml/src/ggml-alloc.c
+++ b/ggml/src/ggml-alloc.c
@@ -688,10 +688,10 @@ static void ggml_gallocr_allocate_node(ggml_gallocr_t galloc, struct ggml_tensor
             fprintf(stderr, "gallocr request: %s (%s) %zu bytes\n", node->name, ggml_op_desc(node), ggml_nbytes(node));
         }
     }
-    if (gallocr_peak_mib() > 0 && ggml_nbytes(node) >= ((size_t) 1 << 30)) {
+    if (gallocr_peak_mib() > 0 && ggml_nbytes(node) >= ((size_t) 256 << 20)) {
         static int n_said = 0;
-        if (n_said++ < 16) {
-            GGML_LOG_INFO("gallocr inplace: %s (%s) %.1f MiB: allocated %d view %d can-inplace %d buffer %d\n", node->name, ggml_op_desc(node),
+        if (n_said++ < 40) {
+            fprintf(stderr, "gallocr inplace: %s (%s) %.1f MiB: allocated %d view %d can-inplace %d buffer %d\n", node->name, ggml_op_desc(node),
                 ggml_nbytes(node)/1024.0/1024.0, (int) ggml_gallocr_is_allocated(galloc, node), (int) ggml_impl_is_view(node),
                 (int) ggml_op_can_inplace(node->op), buffer_id);
             for (int i = 0; i < GGML_MAX_SRC; i++) {
@@ -700,7 +700,7 @@ static void ggml_gallocr_allocate_node(ggml_gallocr_t galloc, struct ggml_tensor
                     continue;
                 }
                 struct hash_node * p_hn = ggml_gallocr_hash_get(galloc, parent);
-                GGML_LOG_INFO("gallocr inplace:   src%d %s (%s) %.1f MiB: own %d output %d same layout %d children %d views %d view %d\n", i,
+                fprintf(stderr, "gallocr inplace:   src%d %s (%s) %.1f MiB: own %d output %d same layout %d children %d views %d view %d\n", i,
                     parent->name, ggml_op_desc(parent), ggml_nbytes(parent)/1024.0/1024.0, (int) ggml_gallocr_is_own(galloc, parent),
                     (int) ((parent->flags & GGML_TENSOR_FLAG_OUTPUT) != 0), (int) ggml_are_same_layout(node, parent), p_hn->n_children,
                     p_hn->n_views, (int) ggml_impl_is_view(parent));
-- 
