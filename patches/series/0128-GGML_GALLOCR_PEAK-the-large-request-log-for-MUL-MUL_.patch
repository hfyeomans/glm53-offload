From 724b40df9743bd209cd5470328857e3f7972086d Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Thu, 5 Nov 2026 17:30:59 -0600
Subject: [PATCH 128/211] GGML_GALLOCR_PEAK: the large-request log for MUL /
 MUL_MAT_ID only

---
 ggml/src/ggml-alloc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-alloc.c b/ggml/src/ggml-alloc.c
index 16b125d88..11a4d04a0 100644
--- a/ggml/src/ggml-alloc.c
+++ b/ggml/src/ggml-alloc.c
@@ -688,8 +688,9 @@ static void ggml_gallocr_allocate_node(ggml_gallocr_t galloc, struct ggml_tensor
             fprintf(stderr, "gallocr request: %s (%s) %zu bytes\n", node->name, ggml_op_desc(node), ggml_nbytes(node));
         }
     }
-    // (compute nodes only: the host experts' weights, 1.2-1.6 GiB a tensor, came first and used up the count)
-    if (gallocr_peak_mib() > 0 && node->op != GGML_OP_NONE && ggml_nbytes(node) >= ((size_t) 1 << 30)) {
+    // (MUL / MUL_MAT_ID nodes only: the host experts' weights, 1.2-1.6 GiB a tensor, then the lightning indexer's 1 GiB scores came
+    // first and used up the count)
+    if (gallocr_peak_mib() > 0 && (node->op == GGML_OP_MUL || node->op == GGML_OP_MUL_MAT_ID) && ggml_nbytes(node) >= ((size_t) 1 << 30)) {
         static int n_said = 0;
         if (n_said++ < 40) {
             fprintf(stderr, "gallocr inplace: %s (%s) %.1f MiB: allocated %d view %d can-inplace %d buffer %d\n", node->name, ggml_op_desc(node),
-- 
2.43.0

