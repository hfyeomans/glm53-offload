     if ((up->op != GGML_OP_MUL_MAT && up->op != GGML_OP_MUL_MAT_ID) || !ggml_cuda_mmq_fusion_supported(x_up->type) || y->type != GGML_TYPE_F32) {
         return false;
     }
+    // 0129: IQ3_XXS fuses only with GGML_CUDA_FUSE_IQ3_XXS=1
+    static const bool fuse_iq3_xxs = getenv("GGML_CUDA_FUSE_IQ3_XXS") != nullptr && atoi(getenv("GGML_CUDA_FUSE_IQ3_XXS")) != 0;
+    if (x_up->type == GGML_TYPE_IQ3_XXS && !fuse_iq3_xxs) {
+        return false;
+    }
 
     // The fused kernel is only compiled for weights whose rows fill whole tiles (no fallback).
     if (ggml_cuda_mmq_needs_fallback(x_up->ne[1])) {
@@ -2242,6 +2258,12 @@ static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor
         ggml_cuda_mul_mat_vec_q(ctx, src0, src1, nullptr, dst);
         return;
     }
+    // 0126 / 0128 GGML_CUDA_DENSE_CUBLAS=N: contiguous quantized weights times N or more columns go to cuBLAS (f16 inputs, f32 compute)
+    if (ggml_is_quantized(src0->type) && ggml_cuda_dense_cublas_min() > 0 && ne11 >= ggml_cuda_dense_cublas_min() &&
+            ggml_is_contiguously_allocated(src0) && ggml_get_to_fp32_cuda(src0->type) != nullptr) {
+        ggml_cuda_mul_mat_cublas(ctx, src0, src1, dst);
+        return;
+    }
     if (ggml_cuda_should_use_mmq(src0->type, cc, ne11, /*n_experts =*/ 0)) {
         ggml_cuda_mul_mat_q(ctx, src0, src1, nullptr, dst);
         return;
