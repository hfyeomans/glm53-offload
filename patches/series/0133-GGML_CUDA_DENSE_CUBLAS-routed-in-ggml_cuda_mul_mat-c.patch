+        if (ggml_cuda_dense_cublas_min() > 0 && src1->ne[1] >= ggml_cuda_dense_cublas_min() && ggml_is_contiguously_allocated(src0)) {
+            static const char * dt = getenv("GGML_CUDA_DENSE_CUBLAS_TYPE");
+            static const int dense_type = dt == nullptr || strcmp(dt, "f16") == 0 ? 0 : strcmp(dt, "bf16") == 0 ? 1 : 2;
+            if (dense_type == 0 && fast_fp16_hardware_available(cc)) {
+                compute_type     = GGML_TYPE_F16;
+                dense_f32_output = true;
+            } else if (dense_type == 1 && fast_bf16_hardware_available(cc) && ggml_get_to_bf16_cuda(src0->type) != nullptr) {
+                compute_type = GGML_TYPE_BF16;
+            } else {
+                compute_type = GGML_TYPE_F32;
+            }
         }
     } else if (compute_type == GGML_TYPE_F16 && !fast_fp16_hardware_available(cc)) {
         compute_type = GGML_TYPE_F32;
