+// 0138 LLAMA_MOE_CACHE_BORROW_MIB: per device, an arena of virtual memory whose pages after a private head are the same physical pages as
+// the MoE cache's borrowed slots (ggml_backend_cuda_alloc_borrowed maps them at both places).  The device's compute buffer and upload
+// ring take their memory from the arena, so the memory only prompt graphs use holds experts between prompts; the cache empties those
+// slots before a graph that reaches past the head and takes them back after (llama_moe_cache::borrow_update).
+struct ggml_cuda_arena {
+    uintptr_t va      = 0; // the reserved range [va, va + va_size)
+    size_t    va_size = 0;
+    size_t    mapped  = 0; // bytes mapped from va: the head, the shared pages, then pages of its own
+    size_t    head    = 0;
+    size_t    shared  = 0;
+    size_t    compute = 0; // the largest compute buffer handed out, from va
+    size_t    ring_lo = 0; // the upload ring's memory [ring_lo, ring_hi), after the compute buffer
+    size_t    ring_hi = 0;
+    int       live    = 0; // compute buffers from the arena not freed yet
+    ggml_backend_buffer_type buft = {};
+};
+static ggml_cuda_arena g_cuda_arena[GGML_CUDA_MAX_DEVICES];
+
+#if defined(GGML_USE_VMM)
+// as the VMM pool: the device, and its peers when peer access is on
+static void ggml_cuda_vmm_access(int device, CUdeviceptr ptr, size_t size) {
+    const int physical_device = ggml_cuda_get_physical_device(device);
+    bool use_peer_access = ggml_cuda_p2p_enabled();
+#if defined(GGML_USE_NCCL)
+    use_peer_access = true;
+#endif // defined(GGML_USE_NCCL)
+    std::vector<CUmemAccessDesc> access_descs;
+    bool physical_seen[GGML_CUDA_MAX_DEVICES] = {};
+    for (int id = 0; id < ggml_cuda_info().device_count; ++id) {
+        const int id_physical = ggml_cuda_get_physical_device(id);
+        if (id_physical != physical_device) {
+            int can_access_peer = 0;
+            if (!use_peer_access || cudaDeviceCanAccessPeer(&can_access_peer, id_physical, physical_device) != cudaSuccess || !can_access_peer) {
+                continue;
+            }
+        }
+        if (physical_seen[id_physical]) {
+            continue;
+        }
+        physical_seen[id_physical] = true;
+        CUmemAccessDesc access = {};
+        access.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+        access.location.id   = id_physical;
+        access.flags         = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+        access_descs.push_back(access);
+    }
+    CU_CHECK(cuMemSetAccess(ptr, size, access_descs.data(), access_descs.size()));
+}
+
+static CUmemGenericAllocationHandle ggml_cuda_vmm_create(int device, size_t size) {
+    CUmemAllocationProp prop = {};
+    prop.type          = CU_MEM_ALLOCATION_TYPE_PINNED;
+    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    prop.location.id   = ggml_cuda_get_physical_device(device);
+    CUmemGenericAllocationHandle handle;
+    CU_CHECK(cuMemCreate(&handle, size, &prop, 0));
+    return handle;
+}
+
+// pages of their own at [ptr, ptr + size) (the handle is released: the pages live while a mapping does)
+static void ggml_cuda_vmm_map_new(int device, CUdeviceptr ptr, size_t size) {
+    if (size == 0) {
+        return;
+    }
+    CUmemGenericAllocationHandle handle = ggml_cuda_vmm_create(device, size);
+    CU_CHECK(cuMemMap(ptr, size, 0, handle, 0));
+    CU_CHECK(cuMemRelease(handle));
+    ggml_cuda_vmm_access(device, ptr, size);
+}
+
+// the arena mapped up to `end` bytes, with pages of its own past what is mapped
+static bool ggml_cuda_arena_grow(int device, size_t end) {
+    ggml_cuda_arena & a = g_cuda_arena[device];
+    end = GGML_PAD(end, ggml_cuda_info().devices[device].vmm_granularity);
+    if (end <= a.mapped) {
+        return true;
+    }
+    if (end > a.va_size) {
+        return false;
+    }
+    ggml_cuda_set_device(device);
+    ggml_cuda_vmm_map_new(device, (CUdeviceptr) (a.va + a.mapped), end - a.mapped);
+    a.mapped = end;
+    return true;
+}
+#endif // defined(GGML_USE_VMM)
+
+static void ggml_cuda_arena_release(void * ud) {
+    g_cuda_arena[(int) (intptr_t) ud].live--;
+}
+
+// the arena's buffer type: one compute buffer at a time from the arena's base; once the ring sits after it, it cannot grow in place
+static ggml_backend_buffer_t ggml_backend_cuda_arena_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    const int device = ((ggml_backend_cuda_buffer_type_context *) buft->context)->device;
+    ggml_cuda_arena & a = g_cuda_arena[device];
+#if defined(GGML_USE_VMM)
+    if (a.live == 0 && (a.ring_hi == 0 || size <= a.ring_lo) && ggml_cuda_arena_grow(device, size)) {
+        a.compute = std::max(a.compute, size);
+        a.live++;
+        ggml_backend_cuda_buffer_context * ctx = new ggml_backend_cuda_buffer_context(device, (void *) a.va);
+        ctx->external   = true;
+        ctx->release    = ggml_cuda_arena_release;
+        ctx->release_ud = (void *) (intptr_t) device;
+        return ggml_backend_buffer_init(buft, ggml_backend_cuda_buffer_interface, ctx, size);
+    }
+#endif // defined(GGML_USE_VMM)
+    GGML_LOG_WARN("%s: device %d: a compute buffer of %.1f MiB outside the arena (live %d, ring at %.1f MiB)\n", __func__, device,
+        size/1024.0/1024.0, a.live, a.ring_lo/1024.0/1024.0);
+    return ggml_backend_cuda_buffer_type_alloc_buffer(ggml_backend_cuda_buffer_type(device), size);
+}
+
+// LLAMA_MOE_CACHE_BORROW_RING=1: the upload ring's slots also come from the arena (after the compute buffer).  Every graph of more than
+// the cache's max_batch tokens uses the ring, so the borrowed slots are given up for every prompt then; off, only a prompt graph that
+// reaches past the head gives them up
+static bool ggml_cuda_borrow_ring(void) {
+    static const bool v = getenv("LLAMA_MOE_CACHE_BORROW_RING") != nullptr && atoi(getenv("LLAMA_MOE_CACHE_BORROW_RING")) != 0;
+    return v;
+}
+
+// the upload ring's slots: from the device's arena after its compute buffer, when it has one and LLAMA_MOE_CACHE_BORROW_RING=1
+static void ggml_cuda_ring_malloc(void ** ptr, size_t size, int device, bool arena_ok) {
+#if defined(GGML_USE_VMM)
+    ggml_cuda_arena & a = g_cuda_arena[device];
+    if (arena_ok && a.va != 0 && ggml_cuda_borrow_ring()) {
+        const size_t lo = a.ring_hi > 0 ? a.ring_hi : GGML_PAD(a.compute, 4096);
+        if (ggml_cuda_arena_grow(device, lo + size)) {
+            if (a.ring_hi == 0) {
+                a.ring_lo = lo;
+            }
+            a.ring_hi = GGML_PAD(lo + size, 4096);
+            *ptr = (void *) (a.va + lo);
+            return;
+        }
+    }
+#else
+    GGML_UNUSED(arena_ok);
+#endif // defined(GGML_USE_VMM)
+    ggml_cuda_set_device(device);
+    CUDA_CHECK(cudaMalloc(ptr, size));
+}
+
+static void ggml_cuda_ring_free(void * ptr, int device) {
+    ggml_cuda_arena & a = g_cuda_arena[device];
+    if (a.va != 0 && (uintptr_t) ptr >= a.va && (uintptr_t) ptr < a.va + a.va_size) {
+        a.ring_lo = a.ring_hi = 0; // the ring frees every slot before it takes bigger ones
+        return;
+    }
+    CUDA_CHECK(cudaFree(ptr));
+}
+
+size_t ggml_backend_cuda_vmm_granularity(ggml_backend_t backend) {
+#if defined(GGML_USE_VMM)
+    const int device = ((ggml_backend_cuda_context *) backend->context)->device;
+    const auto & info = ggml_cuda_info().devices[device];
+    return info.vmm ? info.vmm_granularity : 0;
+#else
+    GGML_UNUSED(backend);
+    return 0;
+#endif // defined(GGML_USE_VMM)
+}
+
+ggml_backend_buffer_t ggml_backend_cuda_alloc_borrowed(ggml_backend_t backend, size_t size, const size_t * off, const size_t * len, int n, size_t head) {
+#if defined(GGML_USE_VMM)
+    const int device = ((ggml_backend_cuda_context *) backend->context)->device;
+    const auto & info = ggml_cuda_info().devices[device];
+    ggml_cuda_arena & a = g_cuda_arena[device];
+    if (!info.vmm || a.va != 0) {
+        return nullptr;
+    }
+    const size_t gran = info.vmm_granularity;
+    size = GGML_PAD(size, gran);
+    head = GGML_PAD(head, gran);
+    size_t shared = 0;
+    for (int i = 0; i < n; ++i) {
+        GGML_ASSERT(off[i] % gran == 0 && len[i] % gran == 0 && off[i] + len[i] <= size);
+        GGML_ASSERT(i == 0 || off[i] >= off[i - 1] + len[i - 1]);
+        shared += len[i];
+    }
+    ggml_cuda_set_device(device);
+    CUdeviceptr bank = 0;
+    CU_CHECK(cuMemAddressReserve(&bank, size, 0, 0, 0));
+    CUdeviceptr va = 0;
+    a.va_size = head + shared + ((size_t) 512 << 30); // room for the compute buffer and the ring past the shared pages
+    CU_CHECK(cuMemAddressReserve(&va, a.va_size, 0, 0, 0));
+    a.va = (uintptr_t) va;
+    ggml_cuda_vmm_map_new(device, va, head);
+    size_t pos  = 0;    // in the bank buffer
+    size_t apos = head; // in the arena
+    for (int i = 0; i < n; ++i) {
+        ggml_cuda_vmm_map_new(device, bank + pos, off[i] - pos);
+        if (len[i] > 0) {
+            CUmemGenericAllocationHandle handle = ggml_cuda_vmm_create(device, len[i]);
+            CU_CHECK(cuMemMap(bank + off[i], len[i], 0, handle, 0));
+            CU_CHECK(cuMemMap(va + apos, len[i], 0, handle, 0));
+            CU_CHECK(cuMemRelease(handle));
+            ggml_cuda_vmm_access(device, bank + off[i], len[i]);
+            ggml_cuda_vmm_access(device, va + apos, len[i]);
+        }
+        pos   = off[i] + len[i];
+        apos += len[i];
+    }
+    ggml_cuda_vmm_map_new(device, bank + pos, size - pos);
+    a.mapped = apos;
+    a.head   = head;
+    a.shared = shared;
+    a.buft   = {
+        /* .iface   = */ ggml_backend_cuda_buffer_type_interface,
+        /* .device  = */ ggml_backend_reg_dev_get(ggml_backend_cuda_reg(), device),
+        /* .context = */ new ggml_backend_cuda_buffer_type_context{device, GGML_CUDA_NAME + std::to_string(device)},
+    };
+    a.buft.iface.alloc_buffer = ggml_backend_cuda_arena_alloc_buffer;
+    GGML_LOG_INFO("%s: device %d: %.1f MiB of a %.1f MiB buffer share their pages with the arena (head %.1f MiB)\n", __func__, device,
+        shared/1024.0/1024.0, size/1024.0/1024.0, head/1024.0/1024.0);
+    ggml_backend_cuda_buffer_context * ctx = new ggml_backend_cuda_buffer_context(device, (void *) bank);
+    ctx->external = true; // mapped for the life of the process
+    return ggml_backend_buffer_init(ggml_backend_cuda_buffer_type(device), ggml_backend_cuda_buffer_interface, ctx, size);
+#else
+    GGML_UNUSED(backend); GGML_UNUSED(size); GGML_UNUSED(off); GGML_UNUSED(len); GGML_UNUSED(n); GGML_UNUSED(head);
+    return nullptr;
+#endif // defined(GGML_USE_VMM)
+}
+
+ggml_backend_buffer_type_t ggml_backend_cuda_arena_buffer_type(ggml_backend_t backend) {
+    ggml_cuda_arena & a = g_cuda_arena[((ggml_backend_cuda_context *) backend->context)->device];
+    return a.va != 0 ? &a.buft : nullptr;
+}
+
+void ggml_backend_cuda_arena_info(ggml_backend_t backend, size_t * head, size_t * compute, size_t * ring_lo, size_t * ring_hi, size_t * mapped) {
+    const ggml_cuda_arena & a = g_cuda_arena[((ggml_backend_cuda_context *) backend->context)->device];
+    *head    = a.head;
+    *compute = a.compute;
+    *ring_lo = a.ring_lo;
+    *ring_hi = a.ring_hi;
+    *mapped  = a.mapped;
+}
+
+void ggml_backend_cuda_synchronize_device(ggml_backend_t backend) {
+    ggml_cuda_set_device(((ggml_backend_cuda_context *) backend->context)->device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+}
+
