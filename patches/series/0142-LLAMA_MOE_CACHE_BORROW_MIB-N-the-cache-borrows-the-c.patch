+// device's arena after its private head of `head` bytes, in that order; the rest of the buffer has pages of its own.  Creates the arena
+// (once per device); nullptr without VMM or when the device has one already
+GGML_BACKEND_API ggml_backend_buffer_t ggml_backend_cuda_alloc_borrowed(ggml_backend_t backend, size_t size, const size_t * off, const size_t * len, int n, size_t head);
+// the arena's buffer type, for the device's compute buffer (nullptr without an arena); the upload ring's slots come from the arena too
+GGML_BACKEND_API ggml_backend_buffer_type_t ggml_backend_cuda_arena_buffer_type(ggml_backend_t backend);
+// the arena's layout, as offsets from its base: the head, the largest compute buffer, the ring's range and the bytes mapped
+GGML_BACKEND_API void ggml_backend_cuda_arena_info(ggml_backend_t backend, size_t * head, size_t * compute, size_t * ring_lo, size_t * ring_hi, size_t * mapped);
