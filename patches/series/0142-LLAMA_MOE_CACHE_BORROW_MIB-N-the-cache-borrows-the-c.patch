+void llama_moe_cache::borrow_update(ggml_backend_sched_t sched, int64_t n_tokens) {
+#ifdef GGML_USE_CUDA
+    impl & p = *pimpl;
+    for (size_t id = 0; id < p.devices.size(); ++id) {
+        auto & d = p.devices[id];
+        if (d.borrow_bytes == 0) {
+            continue;
+        }
+        // LLAMA_MOE_CACHE_BORROW_RING=1: the ring (any graph of more than max_batch tokens) uses the arena too
+        static const bool ring = getenv("LLAMA_MOE_CACHE_BORROW_RING") != nullptr && atoi(getenv("LLAMA_MOE_CACHE_BORROW_RING")) != 0;
+        const size_t peak = ggml_backend_sched_get_peak(sched, d.backend);
+        const bool   want = (!ring || n_tokens <= impl::max_batch) && peak <= d.borrow_head;
+        if (want == d.borrow_on) {
+            continue;
+        }
+        // nothing may still read or write the borrowed slots (the hits, the side fills) or the memory the graph puts there (the ring)
+        ggml_backend_cuda_synchronize_device(d.backend);
+        int32_t n_given = 0;
+        for (auto & g : p.groups) {
+            if (g.id != (int32_t) id || g.n_base == g.n_slots) {
+                continue;
+            }
+            if (want) {
+                g.slru.n_active = g.n_slots;
+            } else {
+                n_given += g.slru.give_up(g.n_base);
+            }
+        }
+        d.borrow_on = want;
+        if (d.borrow_n++ < 4 || d.borrow_n % 64 == 0) {
+            size_t head, compute, ring_lo, ring_hi, mapped;
+            ggml_backend_cuda_arena_info(d.backend, &head, &compute, &ring_lo, &ring_hi, &mapped);
+            LLAMA_LOG_INFO("llama_moe_cache: 0138 %s: borrowed slots %s (transition %u): %lld tokens, graph peak %.1f MiB, head %.0f, compute %.1f, "
+                "ring %.1f-%.1f, mapped %.1f MiB, %d experts emptied\n", ggml_backend_name(d.backend), want ? "back in use" : "given up", d.borrow_n,
+                (long long) n_tokens, peak == SIZE_MAX ? -1.0 : peak/1024.0/1024.0, head/1024.0/1024.0, compute/1024.0/1024.0,
+                ring_lo/1024.0/1024.0, ring_hi/1024.0/1024.0, mapped/1024.0/1024.0, n_given);
+        }
+    }
+#else
+    GGML_UNUSED(sched);
+    GGML_UNUSED(n_tokens);
+#endif
+}
