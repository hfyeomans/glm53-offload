     return true;
 }
 
+// 0138: the end of the bytes of buffer_id that the graph of the last reservation uses (SIZE_MAX when it spans several chunks)
+size_t ggml_gallocr_get_peak(ggml_gallocr_t galloc, int buffer_id) {
+    GGML_ASSERT(buffer_id >= 0 && buffer_id < galloc->n_buffers);
+    const struct ggml_dyn_tallocr * alloc = galloc->buf_tallocs[buffer_id];
+    if (alloc == NULL || alloc->n_chunks == 0) {
+        return 0;
+    }
+    if (alloc->n_chunks > 1) {
+        return SIZE_MAX;
+    }
+    return alloc->chunks[0]->max_size;
+}
+
 size_t ggml_gallocr_get_buffer_size(ggml_gallocr_t galloc, int buffer_id) {
     GGML_ASSERT(buffer_id >= 0 && buffer_id < galloc->n_buffers);
 
