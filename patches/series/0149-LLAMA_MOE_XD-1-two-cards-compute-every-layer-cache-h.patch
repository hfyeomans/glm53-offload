+            std::min(n_tokens*n_expert_used, l.slot_map_xd->ne[1]) > groups[l.ig_xd].n_slots ||
+            std::min(n_tokens*n_expert_used, l.slot_map->ne[1]) > groups[l.ig].n_slots) {
+            return nullptr;
+        }
+        return l.slot_map_xd;
+    }
