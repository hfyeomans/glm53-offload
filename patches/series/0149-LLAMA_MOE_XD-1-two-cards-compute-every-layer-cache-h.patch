From 7be420601432ec7c3191961b4f6edf2351c01483 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Fri, 6 Nov 2026 22:55:56 -0600
Subject: [PATCH 149/211] LLAMA_MOE_XD=1: two cards compute every layer cache
 hits, each card caching the experts of its parity; the other card hits run
 there beside the CPU part

---
 src/llama-graph.cpp     |  44 ++++++++-
 src/llama-graph.h       |   3 +
 src/llama-moe-cache.cpp | 203 ++++++++++++++++++++++++++++++++++++++--
 src/llama-moe-cache.h   |   6 ++
 4 files changed, 245 insertions(+), 11 deletions(-)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index f5f0f0871..14aea21c5 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1713,7 +1713,7 @@ ggml_tensor * llm_graph_context::build_lora_mm_id(
     // the experts in the MoE cache are selected by their slots
     ggml_tensor * res = slots == nullptr ?
         ggml_mul_mat_id(ctx0, w, cur_mm, ids) :
-        ggml_mul_mat_id(ctx0, cached ? moe_cache->get_experts(w) : w, cur_mm, slots);
+        ggml_mul_mat_id(ctx0, cached ? (moe_xd_views ? moe_cache->get_experts_xd(w) : moe_cache->get_experts(w)) : w, cur_mm, slots);
 
     if (prec_policy) {
         prec_policy->apply(res);
@@ -2737,6 +2737,23 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
             moe_overlap_hook = nullptr;
         }
 
+        // 0145 LLAMA_MOE_XD=1: the hits of the other device's parity, computed on that device from its banks (before the CPU part, so
+        // both devices and the CPU work at once)
+        ggml_tensor * experts_xd = nullptr;
+        if (ggml_tensor * slots_xd = build_moe_cache_slots_xd(selected_experts, il)) {
+            const int n_nodes_xd = ggml_graph_n_nodes(gf);
+            moe_xd_views = true;
+            experts_xd = build_experts(cur, selected_experts, slots_xd, true);
+            moe_xd_views = false;
+            ggml_build_forward_expand(gf, experts_xd);
+            for (int i = n_nodes_xd; i < ggml_graph_n_nodes(gf); ++i) {
+                ggml_tensor * node = ggml_graph_node(gf, i);
+                if (node->view_src == nullptr) {
+                    ggml_backend_sched_set_tensor_backend(sched, node, moe_cache->backend_xd(il));
+                }
+            }
+        }
+
         // the CPU part comes after the slot lookup, whose copy callback fills the CPU map and reads the inputs of the CPU part
         const int n_nodes_dev = ggml_graph_n_nodes(gf);
         ggml_tensor * experts_cpu = build_experts(cur, sel2d, cpu_ids, false);
@@ -2752,6 +2769,10 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
 
         experts = ggml_add(ctx0, experts_dev, experts_cpu);
         ggml_backend_sched_set_tensor_backend(sched, experts, moe_cache->backend(il));
+        if (experts_xd != nullptr) {
+            experts = ggml_add(ctx0, experts, experts_xd); // 0145
+            ggml_backend_sched_set_tensor_backend(sched, experts, moe_cache->backend(il));
+        }
         cb(experts, "ffn_moe_down_merged", il);
     }
 
@@ -2890,6 +2911,27 @@ bool llm_graph_context::moe_probe_enabled() {
     return v;
 }
 
+ggml_tensor * llm_graph_context::build_moe_cache_slots_xd(ggml_tensor * selected_experts, int il) const {
+    if (moe_cache == nullptr) {
+        return nullptr;
+    }
+    ggml_tensor * slot_map = moe_cache->get_slot_map_xd(il, selected_experts->ne[1], selected_experts->ne[0]);
+    ggml_backend_t be = moe_cache->backend_xd(il);
+    if (slot_map == nullptr || be == nullptr) {
+        return nullptr;
+    }
+    ggml_tensor * ids = selected_experts;
+    if (!ggml_is_contiguous(ids)) {
+        ids = ggml_cont(ctx0, ids);
+    }
+    ids = ggml_reshape_1d(ctx0, ids, ggml_nelements(ids));
+    ggml_tensor * slots = ggml_get_rows(ctx0, slot_map, ids); // [1, n_expert_used*n_tokens], on the other device
+    ggml_backend_sched_set_tensor_backend(sched, slots, be);
+    cb(slots, "ffn_moe_slots_xd", il);
+    ggml_build_forward_expand(gf, slots);
+    return ggml_reshape_2d(ctx0, slots, selected_experts->ne[0], selected_experts->ne[1]);
+}
+
