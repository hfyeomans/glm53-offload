     }
 
+    // 0151: 2-4 tokens over a K one warp covers in one trip (the absorbed MLA heads), one warp a block
+    if constexpr (mmvq_smallk_mt_type(type)) {
+        const int mt = ggml_cuda_mmvq_smallk_mt();
+        if (mt != 0 && ncols_dst >= 2 && ncols_dst <= 4 && blocks_per_row_x <= blocks_per_iter_1warp &&
+                (table_id == MMVQ_PARAMETERS_GENERIC || table_id == MMVQ_PARAMETERS_GB10)) {
+            const auto launch_mt = [&](auto ncols_tag, auto wide_tag) {
+                constexpr int  c_ncols_dst = decltype(ncols_tag)::value;
+                constexpr bool c_wide      = decltype(wide_tag)::value;
+                const std::pair<dim3, dim3> dims = calc_launch_params<type>(c_ncols_dst, nrows_x, nchannels_dst, nsamples_dst, warp_size, table_id, true, c_wide);
+                mul_mat_vec_q_switch_fusion<type, c_ncols_dst, true, c_wide>(vx, vy, ids, fusion, dst, ncols_x, nchannels_y_fd, stride_row_x, stride_col_y, stride_col_dst,
+                     channel_ratio_fd, stride_channel_x, stride_channel_y, stride_channel_dst,
+                     sample_ratio_fd, stride_sample_x, stride_sample_y, stride_sample_dst,
+                     dims.first, dims.second, 0, ids_stride, stream);
+            };
+            const auto launch_n = [&](auto wide_tag) {
+                switch (ncols_dst) {
+                    case 2:  launch_mt(std::integral_constant<int, 2>{}, wide_tag); break;
+                    case 3:  launch_mt(std::integral_constant<int, 3>{}, wide_tag); break;
+                    default: launch_mt(std::integral_constant<int, 4>{}, wide_tag); break;
+                }
+            };
+            if (mt == 2) {
+                launch_n(std::true_type{});
+            } else {
+                launch_n(std::false_type{});
+            }
+            return;
+        }
+    }
+
     switch (ncols_dst) {
         case 1: {
