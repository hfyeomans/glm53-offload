+// GGML_CUDA_MMVQ_SMALLK_MT=1|2 (0151): the dense matvec at 2-4 tokens over a K one warp covers in a single trip runs one warp a block,
+// 2 (1) or 4 (2) rows of it; 0 / unset = upstream's four warps
+static int ggml_cuda_mmvq_smallk_mt() {
+    static const int v = [] {
+        const char * s = getenv("GGML_CUDA_MMVQ_SMALLK_MT");
+        const int r = s ? atoi(s) : 0;
+        const int m = (r == 1 || r == 2) ? r : 0;
+        if (s) {
+            GGML_LOG_INFO("%s: multi-token small-K matvec %s\n", __func__, m == 0 ? "off" : m == 1 ? "one warp, 2 rows a block" : "one warp, 4 rows a block");
+        }
+        return m;
+    }();
+    return v;
+}
+
+static constexpr bool mmvq_smallk_mt_type(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+            return true;
+        default:
+            return false;
+    }
+}
+
 // LLAMA_MMVQ_MOE_RPB=2|4|8: rows per block of the multi-token MoE kernel (0037; default 2 = upstream)
 static int ggml_cuda_mmvq_moe_rpb() {
