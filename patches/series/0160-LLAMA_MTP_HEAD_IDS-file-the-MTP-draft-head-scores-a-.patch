--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -2074,6 +2074,7 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
 
     load_tensors_hadamard();
     load_tensors_tp_shadow();
+    load_tensors_mtp_head();
 
     return true;
 }
@@ -2172,6 +2173,59 @@ void llama_model_base::load_tensors_tp_shadow() {
     }
 }
 
+// LLAMA_MTP_HEAD_IDS=<file> (0155): copy the head rows of the listed token ids (one a line) into a buffer of the head's own type
+void llama_model_base::load_tensors_mtp_head() {
+    const char * path = getenv("LLAMA_MTP_HEAD_IDS");
+    if (path == nullptr || *path == '\0' || output == nullptr || output->buffer == nullptr || !ggml_is_contiguous(output)) {
+        return;
+    }
+    std::vector<int64_t> ids;
+    if (FILE * f = fopen(path, "r")) {
+        long long v = 0;
+        while (fscanf(f, "%lld", &v) == 1) {
+            if (v >= 0 && v < output->ne[1]) {
+                ids.push_back((int64_t) v);
+            }
+        }
+        fclose(f);
+    }
+    std::sort(ids.begin(), ids.end());
+    ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+    if (ids.empty() || (int64_t) ids.size() >= output->ne[1]) {
+        LLAMA_LOG_WARN("%s: LLAMA_MTP_HEAD_IDS=%s: %zu usable ids, not used\n", __func__, path, ids.size());
+        return;
+    }
+    const int64_t K = (int64_t) ids.size();
+    ggml_init_params params = { ggml_tensor_overhead()*3, NULL, true };
+    ggml_context_ptr ctx { ggml_init(params) };
+    ggml_tensor * sub = ggml_new_tensor_2d(ctx.get(), output->type, output->ne[0], K);
+    ggml_set_name(sub, "mtp_head_sub");
+    ggml_tensor * idt = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I64, K);
+    ggml_set_name(idt, "mtp_head_ids");
+    ggml_backend_buffer_ptr buf { ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), ggml_backend_buffer_get_type(output->buffer)) };
+    if (!buf) {
+        LLAMA_LOG_WARN("%s: LLAMA_MTP_HEAD_IDS: could not allocate %lld rows beside the head, not used\n", __func__, (long long) K);
+        return;
+    }
+    ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    const size_t rs = output->nb[1];
+    std::vector<uint8_t> all(ggml_nbytes(output));
+    ggml_backend_tensor_get(output, all.data(), 0, all.size());
+    std::vector<uint8_t> rows((size_t) K * rs);
+    for (int64_t k = 0; k < K; ++k) {
+        memcpy(rows.data() + (size_t) k * rs, all.data() + (size_t) ids[k] * rs, rs);
+    }
+    ggml_backend_tensor_set(sub, rows.data(), 0, rows.size());
+    ggml_backend_tensor_set(idt, ids.data(), 0, (size_t) K * sizeof(int64_t));
+    mtp_head_sub = sub;
+    mtp_head_ids = idt;
+    LLAMA_LOG_INFO("%s: LLAMA_MTP_HEAD_IDS: the draft head scores %lld of %lld tokens (%.1f MiB beside the head, %s)\n", __func__,
+        (long long) K, (long long) output->ne[1], ggml_nbytes(sub)/1024.0/1024.0, ggml_backend_buffer_name(buf.get()));
+    std::vector<ggml_backend_buffer_ptr> buffers;
+    buffers.emplace_back(std::move(buf));
+    pimpl->ctxs_bufs.emplace_back(std::move(ctx), std::move(buffers));
+}
