     }();
-    if (head_k > 0 && head_k < head_w->ne[1] && head_s == nullptr && loras->empty()) {
+    if (model.mtp_head_sub != nullptr && head_w == model.output && head_s == nullptr && loras->empty()) {
+        // 0155 LLAMA_MTP_HEAD_IDS: score the subset's rows, scatter them into a -inf row of the full vocabulary
+        ggml_tensor * ls   = ggml_mul_mat(ctx0, model.mtp_head_sub, cur);                    // [K, n_outputs]
+        ls = ggml_cont(ctx0, ggml_transpose(ctx0, ls));                                      // [n_outputs, K]
+        ggml_tensor * full = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, ls->ne[0], head_w->ne[1]); // [n_outputs, n_vocab]
+        full = ggml_fill(ctx0, full, -INFINITY);
+        full = ggml_set_rows(ctx0, full, ls, model.mtp_head_ids);                           // full[ids[k], :] = ls[k, :]
+        cur  = ggml_cont(ctx0, ggml_transpose(ctx0, full));                                  // [n_vocab, n_outputs]
+    } else if (head_k > 0 && head_k < head_w->ne[1] && head_s == nullptr && loras->empty()) {
         ggml_tensor * head_k_w = ggml_view_2d(ctx0, head_w, head_w->ne[0], head_k, head_w->nb[1], 0);
         ggml_tensor * logits_k = ggml_mul_mat(ctx0, head_k_w, cur);                     // [K, n_outputs]
         ggml_tensor * rest     = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, head_w->ne[1] - head_k, logits_k->ne[1]);
