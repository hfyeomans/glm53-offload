From 28d23e1896adf820d64391fa168665a86d93fb99 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Sat, 7 Nov 2026 06:43:06 -0600
Subject: [PATCH 161/211] LLAMA_DSA_SHORT_DENSE=1: while the indexer cache
 holds no more cells than its top-k keeps, skip the indexer scores and sort
 (keys still written) and attend with the causal mask

---
 src/llama-graph.cpp    |  4 +++-
 src/models/glm-dsa.cpp | 11 ++++++++++-
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index f4b6e2866..7576ec2c7 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -3866,7 +3866,9 @@ ggml_tensor * llm_graph_context::build_attn(
     }
 
     ggml_tensor * kq_mask_top_k = nullptr;
-    if (cparams.fused_top_k_mask) {
+    if (top_k == nullptr) {
+        kq_mask_top_k = kq_mask; // 0156: the top-k is every cell
+    } else if (cparams.fused_top_k_mask) {
         kq_mask_top_k = build_fused_top_k_mask(kq_mask, top_k, il);
     } else {
         // prepare new kq mask - starts filled with -INFINITY
diff --git a/src/models/glm-dsa.cpp b/src/models/glm-dsa.cpp
index a47c9737e..eb02f7cb4 100644
--- a/src/models/glm-dsa.cpp
+++ b/src/models/glm-dsa.cpp
@@ -837,6 +837,9 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
     // Difference vs Deepseek 3.2: shared indexer layers reuse the top_k from the previous full indexer layers
     // See https://huggingface.co/zai-org/GLM-5.2/blob/main/config.json#L30
     ggml_tensor * prev_top_k = nullptr;
+    // 0156 LLAMA_DSA_SHORT_DENSE=1: no indexer while its top-k keeps every cell
+    static const bool dsa_short_dense = getenv("LLAMA_DSA_SHORT_DENSE") != nullptr && atoi(getenv("LLAMA_DSA_SHORT_DENSE")) != 0;
+    bool top_k_dense = false;
     std::vector<ggml_tensor *> moe_probe_inputs; // LLAMA_MOE_PROBE: the pre-attention residual of every layer
     if (moe_cache != nullptr) {
         moe_cache->clear_preds();
@@ -937,6 +940,11 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
                 const auto & k_idxs_lid = inp_attn_dsa->get_k_idxs_lid();
                 ggml_build_forward_expand(gf, mctx_lid->cpy_k(ctx0, indexer_k, k_idxs_lid, il));
 
+                // 0156: the key is written above; with no more cells than the top-k keeps, nothing else of the indexer is needed
+                top_k_dense = dsa_short_dense && mctx_lid->get_k(ctx0, il)->ne[1] <= (int64_t) n_indexer_top_k;
+                if (top_k_dense) {
+                    prev_top_k = nullptr;
+                } else {
                 // prepare indexer weights
                 ggml_tensor * indexer_weights = ggml_mul_mat(ctx0, model.layers[il].indexer_proj, cur);
                 cb(indexer_weights, "indexer_weights", il);
@@ -999,9 +1007,10 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
                 top_k = ggml_cont(ctx0, ggml_top_k(ctx0, indexer_score, n_top_k));
                 prev_top_k = top_k;
                 cb(top_k, "top_k", il);
+                } // 0156
             } else {
                 // "shared" indexer layer - reuse top-k from a previous full layer
-                GGML_ASSERT(prev_top_k != nullptr && "shared indexer layer must follow a previous full indexer layer");
+                GGML_ASSERT((prev_top_k != nullptr || top_k_dense) && "shared indexer layer must follow a previous full indexer layer");
                 top_k = prev_top_k;
                 cb(top_k, "top_k", il);
             }
-- 
