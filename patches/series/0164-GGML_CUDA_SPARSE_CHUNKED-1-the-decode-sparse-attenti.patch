From d91259990df24cc289492735d91e65b65e10c5c4 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Sat, 7 Nov 2026 07:01:33 -0600
Subject: [PATCH 164/211] GGML_CUDA_SPARSE_CHUNKED=1: the decode sparse
 attention top-k mask and index-list scan spread over chunk blocks (they ran
 one block a row, linear in the context)

---
 ggml/src/ggml-cuda/fattn-common.cuh |  15 +++-
 ggml/src/ggml-cuda/fattn.cu         | 134 ++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/top-k-mask.cu    |  54 +++++++++++
 3 files changed, 201 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/fattn-common.cuh b/ggml/src/ggml-cuda/fattn-common.cuh
index e1e8a0dac..ca187cc62 100644
--- a/ggml/src/ggml-cuda/fattn-common.cuh
+++ b/ggml/src/ggml-cuda/fattn-common.cuh
@@ -726,6 +726,10 @@ static __global__ void flash_attn_mask_to_KV_max(
 
 void ggml_cuda_flash_attn_ext_compact_mask(
         const ggml_tensor * mask, int32_t * indices, int32_t * counts, int32_t n_queries, int32_t ncols1, int32_t n_kv_max, cudaStream_t stream);
+// 0158: the same lists from a count pass and a write pass over 2,048-column chunks; false if not applicable (then use the above)
+bool ggml_cuda_flash_attn_ext_compact_mask_chunked(
+        const ggml_tensor * mask, int32_t * indices, int32_t * counts, int32_t * chunk_counts, int32_t n_queries, int32_t ncols1, int32_t n_kv_max,
+        cudaStream_t stream);
 
 template<int D, int ncols1, int ncols2> // D == head size
 __launch_bounds__(D, 1)
@@ -1145,8 +1149,15 @@ void launch_fattn(
 
         const size_t n_lists = size_t(ntiles_x) * mask->ne[3];
 
-        KV_max.alloc(size_t(n_kv_max)*n_lists + n_lists);
-        ggml_cuda_flash_attn_ext_compact_mask(mask, KV_max.ptr, KV_max.ptr + size_t(n_kv_max)*n_lists, Q->ne[1], ncols1, n_kv_max, main_stream);
+        // 0158 GGML_CUDA_SPARSE_CHUNKED=1: wide rows (> 8,192 columns), one query a list: chunked count + write
+        static const bool sparse_chunked = getenv("GGML_CUDA_SPARSE_CHUNKED") != nullptr && atoi(getenv("GGML_CUDA_SPARSE_CHUNKED")) != 0;
+        const bool chunked = sparse_chunked && ncols1 == 1 && mask->ne[0] > 8192;
+        const size_t n_chunk_counts = chunked ? n_lists*size_t((mask->ne[0] + 2047)/2048) : 0;
+        KV_max.alloc(size_t(n_kv_max)*n_lists + n_lists + n_chunk_counts);
+        if (!chunked || !ggml_cuda_flash_attn_ext_compact_mask_chunked(mask, KV_max.ptr, KV_max.ptr + size_t(n_kv_max)*n_lists,
+                KV_max.ptr + size_t(n_kv_max)*n_lists + n_lists, Q->ne[1], ncols1, n_kv_max, main_stream)) {
+            ggml_cuda_flash_attn_ext_compact_mask(mask, KV_max.ptr, KV_max.ptr + size_t(n_kv_max)*n_lists, Q->ne[1], ncols1, n_kv_max, main_stream);
+        }
         if (gather_k) {
             // 0157: the rows the lists name, and row 0
             const int64_t n_entries = int64_t(n_kv_max)*int64_t(n_lists);
diff --git a/ggml/src/ggml-cuda/fattn.cu b/ggml/src/ggml-cuda/fattn.cu
index 4bef121d4..8acd2b50c 100644
--- a/ggml/src/ggml-cuda/fattn.cu
+++ b/ggml/src/ggml-cuda/fattn.cu
@@ -115,6 +115,140 @@ static __global__ void flash_attn_mask_to_sparse_indices(
 }
 #endif // !defined(GGML_USE_MUSA)
 
+#if !defined(GGML_USE_MUSA)
+// 0158 GGML_CUDA_SPARSE_CHUNKED=1: one query a list, the row in 2,048-column chunks (256 threads x 8): the finite columns a chunk ...
+static __global__ void flash_attn_mask_chunk_count(
+        const half * mask_ptr, int32_t * chunk_counts, const int ne30, const int64_t s31, const int64_t s33) {
+    ggml_cuda_pdl_sync();
+    const int q = blockIdx.x, sequence = blockIdx.y, chunk = blockIdx.z;
+    const half * mask = mask_ptr + sequence*s33 + q*s31;
+    const int i0 = chunk*2048;
+    int n = 0;
+    for (int i = i0 + threadIdx.x; i < min(i0 + 2048, ne30); i += blockDim.x) {
+        n += isfinite(__half2float(mask[i])) ? 1 : 0;
+    }
+    __shared__ int part[256];
+    part[threadIdx.x] = n;
+    __syncthreads();
+    for (int s = 128; s > 0; s >>= 1) {
+        if (threadIdx.x < s) {
+            part[threadIdx.x] += part[threadIdx.x + s];
+        }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        chunk_counts[(int64_t(sequence)*gridDim.x + q)*gridDim.z + chunk] = part[0];
+    }
+}
+
+// ... then each chunk's columns at the sum of the counts before it, in the order of flash_attn_mask_to_sparse_indices
+static __global__ void flash_attn_mask_chunk_write(
+        const half * mask_ptr, int32_t * indices_ptr, int32_t * counts_ptr, const int32_t * chunk_counts,
+        const int ne30, const int n_kv_max, const int64_t s31, const int64_t s33) {
+    ggml_cuda_pdl_sync();
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int values_per_lane = 8;
+    using lane_mask_t = std::conditional_t<warp_size == 64, uint64_t, uint32_t>;
+    constexpr uint64_t ballot_mask = ~(lane_mask_t)0;
+    const auto popc = [](const lane_mask_t m) {
+        if constexpr (warp_size == 64) { return __popcll(m); } else { return __popc(m); }
+    };
+    const int tid = threadIdx.x, warp = tid / warp_size, lane = tid % warp_size;
+    const int q = blockIdx.x, sequence = blockIdx.y, chunk = blockIdx.z, n_chunks = gridDim.z;
+    const half * mask = mask_ptr + sequence*s33 + q*s31;
+    const int32_t * cc = chunk_counts + (int64_t(sequence)*gridDim.x + q)*n_chunks;
+    int32_t * indices = indices_ptr + (int64_t(sequence)*gridDim.x + q)*n_kv_max;
+
+    __shared__ int part[256];
+    int b = 0, t = 0;
+    for (int c = tid; c < n_chunks; c += blockDim.x) {
+        b += c < chunk ? cc[c] : 0;
+        t += cc[c];
+    }
+    part[tid] = b;
+    __syncthreads();
+    for (int s = 128; s > 0; s >>= 1) { if (tid < s) { part[tid] += part[tid + s]; } __syncthreads(); }
+    const int base = part[0];
+    __syncthreads();
+    part[tid] = t;
+    __syncthreads();
+    for (int s = 128; s > 0; s >>= 1) { if (tid < s) { part[tid] += part[tid + s]; } __syncthreads(); }
+    const int total = part[0];
+    __syncthreads();
+
+    __shared__ int warp_offsets[256/warp_size];
+    const int i0 = chunk*2048;
+    lane_mask_t selected_warp[values_per_lane];
+    int warp_count = 0;
+#pragma unroll
+    for (int item = 0; item < values_per_lane; ++item) {
+        const int i = i0 + (warp*values_per_lane + item)*warp_size + lane;
+        const bool selected = i < ne30 && isfinite(__half2float(mask[i]));
+        selected_warp[item] = (lane_mask_t)__ballot_sync(ballot_mask, (int) selected);
+        warp_count += popc(selected_warp[item]);
+    }
+    if (lane == 0) {
+        warp_offsets[warp] = warp_count;
+    }
+    __syncthreads();
+    if (tid == 0) {
+        int offset = 0;
+        for (int iw = 0; iw < 256/warp_size; ++iw) {
+            const int c = warp_offsets[iw];
+            warp_offsets[iw] = offset;
+            offset += c;
+        }
+    }
+    __syncthreads();
+    const lane_mask_t lane_mask = lane == 0 ? 0 : ((lane_mask_t)1 << lane) - 1;
+    int warp_item_offset = 0;
+#pragma unroll
+    for (int item = 0; item < values_per_lane; ++item) {
+        const int i = i0 + (warp*values_per_lane + item)*warp_size + lane;
+        const int dst = base + warp_offsets[warp] + warp_item_offset + popc(selected_warp[item] & lane_mask);
+        if ((selected_warp[item] & ((lane_mask_t)1 << lane)) && dst < n_kv_max) {
+            indices[dst] = i;
+        }
+        warp_item_offset += popc(selected_warp[item]);
+    }
+    if (chunk == n_chunks - 1) {
+        const int count = min(total, n_kv_max);
+        for (int i = count + tid; i < n_kv_max; i += blockDim.x) {
+            indices[i] = -1;
+        }
+        if (tid == 0) {
+            counts_ptr[int64_t(sequence)*gridDim.x + q] = count;
+        }
+    }
+    __syncthreads();
+    ggml_cuda_pdl_lc();
+}
+#endif // !defined(GGML_USE_MUSA)
+
+bool ggml_cuda_flash_attn_ext_compact_mask_chunked(
+        const ggml_tensor * mask, int32_t * indices, int32_t * counts, int32_t * chunk_counts, int32_t n_queries, int32_t ncols1, int32_t n_kv_max,
+        cudaStream_t stream) {
+#ifdef GGML_USE_MUSA
+    GGML_UNUSED_VARS(mask, indices, counts, chunk_counts, n_queries, ncols1, n_kv_max, stream);
+    return false;
+#else
+    if (ncols1 != 1 || chunk_counts == nullptr) {
+        return false;
+    }
+    const int64_t s31 = mask->nb[1] / sizeof(half);
+    const int64_t s33 = mask->nb[3] / sizeof(half);
+    const int n_chunks = int((mask->ne[0] + 2047)/2048);
+    const dim3 grid(n_queries, mask->ne[3], n_chunks);
+    const dim3 block(256, 1, 1);
+    ggml_cuda_kernel_launch(flash_attn_mask_chunk_count, ggml_cuda_kernel_launch_params(grid, block, 0, stream),
+        (const half *) mask->data, chunk_counts, int(mask->ne[0]), s31, s33);
+    ggml_cuda_kernel_launch(flash_attn_mask_chunk_write, ggml_cuda_kernel_launch_params(grid, block, 0, stream),
+        (const half *) mask->data, indices, counts, (const int32_t *) chunk_counts, int(mask->ne[0]), n_kv_max, s31, s33);
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+#endif
+}
+
 void ggml_cuda_flash_attn_ext_compact_mask(
         const ggml_tensor * mask, int32_t * indices, int32_t * counts, int32_t n_queries, int32_t ncols1, int32_t n_kv_max, cudaStream_t stream) {
 #ifdef GGML_USE_MUSA
diff --git a/ggml/src/ggml-cuda/top-k-mask.cu b/ggml/src/ggml-cuda/top-k-mask.cu
index 9ff995240..7823ea773 100644
--- a/ggml/src/ggml-cuda/top-k-mask.cu
+++ b/ggml/src/ggml-cuda/top-k-mask.cu
@@ -82,6 +82,44 @@ static __global__ void top_k_mask_kernel(
     }
 }
 
+// 0158 GGML_CUDA_SPARSE_CHUNKED=1: the top-k-only mask with a block a chunk of a row (fill, then the picks inside the chunk)
+#define CUDA_TOP_K_MASK_CHUNK 4096
+template <typename T>
+static __global__ void top_k_mask_chunked_kernel(
+        const T * mask, const int32_t * top_k, T * dst,
+        const int64_t n_kv, const int64_t ne1, const int64_t ne2,
+        const int64_t m1, const int64_t m2, const int64_t m3, const int64_t n_top,
+        const int64_t sm1, const int64_t sm2, const int64_t sm3,
+        const int64_t sd1, const int64_t sd2, const int64_t sd3,
+        const int64_t sk0, const int64_t sk1, const int64_t sk2, const int64_t sk3) {
+    ggml_cuda_pdl_lc();
+
+    const int64_t ir = blockIdx.x;
+    const int64_t i1 = ir % ne1;
+    const int64_t i2 = (ir / ne1) % ne2;
+    const int64_t i3 = ir / (ne1*ne2);
+    const int64_t c0 = int64_t(blockIdx.y)*CUDA_TOP_K_MASK_CHUNK;
+    const int64_t c1 = min(n_kv, c0 + CUDA_TOP_K_MASK_CHUNK);
+
+    const T       * mask_row  = mask  + (i1 % m1)*sm1 + (i2 % m2)*sm2 + (i3 % m3)*sm3;
+    T             * dst_row   = dst   + i1*sd1 + i2*sd2 + i3*sd3;
+    const int32_t * top_k_row = top_k + i1*sk1 + i2*sk2 + i3*sk3;
+
+    ggml_cuda_pdl_sync();
+
+    const T ninf = ggml_cuda_cast<T>(-INFINITY);
+    for (int64_t i = c0 + threadIdx.x; i < c1; i += blockDim.x) {
+        dst_row[i] = ninf;
+    }
+    __syncthreads();
+    for (int64_t i = threadIdx.x; i < n_top; i += blockDim.x) {
+        const int32_t p = top_k_row[i*sk0];
+        if (p >= c0 && p < c1) {
+            dst_row[p] = mask_row[p];
+        }
+    }
+}
+
 template <typename T>
 static void top_k_mask_cuda(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     const ggml_tensor * mask   = dst->src[0];
@@ -102,6 +140,22 @@ static void top_k_mask_cuda(ggml_backend_cuda_context & ctx, ggml_tensor * dst)
 
     const int64_t n_pick = blocks ? blocks->ne[1] : score ? score->ne[0] : n_kv;
 
+    // 0158: top-k only, a wide row: a block a chunk
+    static const bool chunked = getenv("GGML_CUDA_SPARSE_CHUNKED") != nullptr && atoi(getenv("GGML_CUDA_SPARSE_CHUNKED")) != 0;
+    if (chunked && !score && !blocks && !extra && n_kv > 8192) {
+        const size_t si0 = sizeof(int32_t);
+        const dim3 cb(CUDA_TOP_K_MASK_BLOCK_SIZE, 1, 1);
+        const dim3 cg(ggml_nrows(dst), (n_kv + CUDA_TOP_K_MASK_CHUNK - 1)/CUDA_TOP_K_MASK_CHUNK, 1);
+        const ggml_cuda_kernel_launch_params lp = ggml_cuda_kernel_launch_params(cg, cb, 0, ctx.stream());
+        ggml_cuda_kernel_launch(top_k_mask_chunked_kernel<T>, lp,
+            (const T *) mask->data, (const int32_t *) top_k->data, (T *) dst->data,
+            n_kv, dst->ne[1], dst->ne[2], mask->ne[1], mask->ne[2], mask->ne[3], top_k->ne[0],
+            mask->nb[1]/sizeof(T), mask->nb[2]/sizeof(T), mask->nb[3]/sizeof(T),
+            dst->nb[1]/sizeof(T),  dst->nb[2]/sizeof(T),  dst->nb[3]/sizeof(T),
+            top_k->nb[0]/si0, top_k->nb[1]/si0, top_k->nb[2]/si0, top_k->nb[3]/si0);
+        return;
+    }
+
     const size_t si = sizeof(int32_t);
     const size_t sf = sizeof(float);
 
