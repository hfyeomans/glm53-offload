diff --git a/tests/test-pair-allreduce.cpp b/tests/test-pair-allreduce.cpp
new file mode 100644
index 000000000..ec66b4063
--- /dev/null
+++ b/tests/test-pair-allreduce.cpp
@@ -0,0 +1,106 @@
+// test-pair-allreduce (0164): GGML_OP_PAIR_ALLREDUCE on the first two CUDA devices -- the same bits on both devices, the exact sum of the
+// two partials, many calls in a row (the device call counters, the slot ring, CUDA graph replay of a reused graph), and the time of a call
+// (both devices' graphs issued, then both synchronized).
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+int main() {
+    std::vector<ggml_backend_dev_t> gpus;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t d = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(d) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+            gpus.push_back(d);
+        }
+    }
+    if (gpus.size() < 2) {
+        printf("need two GPUs, found %zu\n", gpus.size());
+        return 1;
+    }
+    ggml_backend_t be[2] = { ggml_backend_dev_init(gpus[0], nullptr), ggml_backend_dev_init(gpus[1], nullptr) };
+    using init_t = bool (*)(ggml_backend_dev_t, ggml_backend_dev_t, size_t);
+    init_t init = (init_t) ggml_backend_reg_get_proc_address(ggml_backend_dev_backend_reg(gpus[0]), "ggml_backend_cuda_pair_ar_init");
+    if (init == nullptr || !init(gpus[0], gpus[1], 1u << 20)) {
+        printf("ggml_backend_cuda_pair_ar_init failed\n");
+        return 1;
+    }
+
+    int n_fail = 0;
+    for (const int64_t n : { (int64_t) 1, (int64_t) 7, (int64_t) 6144, (int64_t) 6144*3, (int64_t) 6144*8, (int64_t) 65536, (int64_t) 262144 }) {
+        ggml_context * ctx[2];
+        ggml_tensor  * a[2];
+        ggml_tensor  * r[2];
+        ggml_cgraph  * g[2];
+        ggml_backend_buffer_t buf[2];
+        for (int c = 0; c < 2; ++c) {
+            ggml_init_params ip = { ggml_tensor_overhead()*8 + ggml_graph_overhead(), nullptr, true };
+            ctx[c] = ggml_init(ip);
+            a[c] = ggml_new_tensor_1d(ctx[c], GGML_TYPE_F32, n);
+            r[c] = ggml_pair_allreduce(ctx[c], a[c], c);
+            g[c] = ggml_new_graph(ctx[c]);
+            ggml_build_forward_expand(g[c], r[c]);
+            buf[c] = ggml_backend_alloc_ctx_tensors(ctx[c], be[c]);
+        }
+        std::mt19937 rng((unsigned) n);
+        std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
+        std::vector<float> h[2] = { std::vector<float>(n), std::vector<float>(n) };
+        std::vector<float> o[2] = { std::vector<float>(n), std::vector<float>(n) };
+        const int iters = 2000;
+        int checked = 0, bad = 0;
+        double t_sum = 0.0;
+        int    t_n   = 0;
+        for (int it = 0; it < iters; ++it) {
+            const bool check = it < 3 || it % 97 == 0;
+            if (check) {
+                for (int c = 0; c < 2; ++c) {
+                    for (int64_t i = 0; i < n; ++i) {
+                        h[c][i] = dist(rng);
+                    }
+                    ggml_backend_tensor_set(a[c], h[c].data(), 0, n*sizeof(float));
+                }
+            }
+            const auto t0 = std::chrono::high_resolution_clock::now();
+            ggml_backend_graph_compute_async(be[0], g[0]);
+            ggml_backend_graph_compute_async(be[1], g[1]);
+            ggml_backend_synchronize(be[0]);
+            ggml_backend_synchronize(be[1]);
+            const auto t1 = std::chrono::high_resolution_clock::now();
+            if (it >= 10 && !check) {
+                t_sum += std::chrono::duration<double, std::micro>(t1 - t0).count();
+                t_n++;
+            }
+            if (check) {
+                checked++;
+                for (int c = 0; c < 2; ++c) {
+                    ggml_backend_tensor_get(r[c], o[c].data(), 0, n*sizeof(float));
+                }
+                for (int64_t i = 0; i < n; ++i) {
+                    const float want = h[0][i] + h[1][i];
+                    if (memcmp(&o[0][i], &o[1][i], sizeof(float)) != 0 || o[0][i] != want) {
+                        if (bad < 4) {
+                            printf("  n=%lld it=%d i=%lld: %.9g %.9g want %.9g\n", (long long) n, it, (long long) i, o[0][i], o[1][i], want);
+                        }
+                        bad++;
+                    }
+                }
+            }
+        }
+        printf("n=%7lld: %d checks, %d wrong values, %.1f us a call (both devices issued and synchronized, %d calls)\n",
+            (long long) n, checked, bad, t_n ? t_sum/t_n : 0.0, t_n);
+        n_fail += bad > 0;
+        for (int c = 0; c < 2; ++c) {
+            ggml_backend_buffer_free(buf[c]);
+            ggml_free(ctx[c]);
+        }
+    }
+    ggml_backend_free(be[0]);
+    ggml_backend_free(be[1]);
+    printf("%s\n", n_fail == 0 ? "PAIR ALLREDUCE OK" : "PAIR ALLREDUCE FAILED");
+    return n_fail == 0 ? 0 : 1;
+}
