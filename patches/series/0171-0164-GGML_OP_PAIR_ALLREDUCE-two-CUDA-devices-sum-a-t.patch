diff --git a/ggml/src/ggml-cuda/pair-allreduce.cu b/ggml/src/ggml-cuda/pair-allreduce.cu
new file mode 100644
index 000000000..cd92f7950
--- /dev/null
+++ b/ggml/src/ggml-cuda/pair-allreduce.cu
@@ -0,0 +1,148 @@
+#include "pair-allreduce.cuh"
+
+#include <cstring>
+#include <mutex>
+
+// 0164 GGML_OP_PAIR_ALLREDUCE, adapted from allreduce.cu's chunked kernel (upstream's two-GPU tensor-parallel reduction over PCIe): each
+// device writes its partial into its own pinned host buffer, raises a token per block, waits for the peer's token and adds the peer's
+// partial: dst = mine + peer's, the same bits on both devices (one add, which commutes).  The call number lives in device memory (each
+// device counts its own calls, a call is one kernel whose last block advances the count), so the op is an ordinary graph node and its CUDA
+// graph replays.  The two devices run their calls in the same order, one kernel at a time on a stream, and a call is a barrier: when a
+// device starts call N, its peer has finished call N-2, so PAIR_AR_POOL >= 2 slots are never overwritten while read.
+
+#define PAIR_AR_BLOCKS  8
+#define PAIR_AR_THREADS 256
+#define PAIR_AR_POOL    4
+#define PAIR_AR_STRIDE  16 // ints between two blocks' tokens (64 bytes, one line each)
+
+struct ggml_cuda_pair_ar {
+    bool    ready = false;
+    int     dev[2] = { -1, -1 };
+    size_t  slot_elems = 0;                          // floats a slot
+    float * host[2] = { nullptr, nullptr };          // rank r's staging: PAIR_AR_POOL slots (mapped pinned host memory)
+    int   * arr[2]  = { nullptr, nullptr };          // rank r's tokens: [PAIR_AR_POOL][PAIR_AR_BLOCKS][PAIR_AR_STRIDE]
+    int   * ctr[2]  = { nullptr, nullptr };          // on device r: { calls, blocks done in the current call }
+};
+
+static ggml_cuda_pair_ar g_pair_ar;
+static std::mutex        g_pair_ar_mutex;
+
+bool ggml_cuda_pair_ar_init(int dev0, int dev1, size_t max_bytes) {
+    std::lock_guard<std::mutex> lock(g_pair_ar_mutex);
+    ggml_cuda_pair_ar & p = g_pair_ar;
+    if (p.ready) {
+        return p.dev[0] == dev0 && p.dev[1] == dev1 && p.slot_elems*sizeof(float) >= max_bytes;
+    }
+    if (dev0 == dev1) {
+        return false;
+    }
+    p.dev[0] = dev0;
+    p.dev[1] = dev1;
+    p.slot_elems = (max_bytes + 15)/16*4;
+    const size_t host_bytes = (size_t) PAIR_AR_POOL*p.slot_elems*sizeof(float);
+    const size_t arr_bytes  = (size_t) PAIR_AR_POOL*PAIR_AR_BLOCKS*PAIR_AR_STRIDE*sizeof(int);
+    for (int r = 0; r < 2; ++r) {
+        ggml_cuda_set_device(p.dev[r]);
+        void * h = nullptr;
+        void * a = nullptr;
+        CUDA_CHECK(cudaHostAlloc(&h, host_bytes, cudaHostAllocPortable | cudaHostAllocMapped));
+        CUDA_CHECK(cudaHostAlloc(&a, arr_bytes,  cudaHostAllocPortable | cudaHostAllocMapped));
+        memset(h, 0, host_bytes);
+        memset(a, 0, arr_bytes);
+        CUDA_CHECK(cudaHostGetDevicePointer((void **) &p.host[r], h, 0));
+        CUDA_CHECK(cudaHostGetDevicePointer((void **) &p.arr[r],  a, 0));
+        CUDA_CHECK(cudaMalloc((void **) &p.ctr[r], 2*sizeof(int)));
+        CUDA_CHECK(cudaMemset(p.ctr[r], 0, 2*sizeof(int)));
+        CUDA_CHECK(cudaDeviceSynchronize());
+    }
+    p.ready = true;
+    GGML_LOG_INFO("%s: 0164: pair all-reduce between CUDA%d and CUDA%d, up to %zu KiB a call\n", __func__, dev0, dev1,
+        p.slot_elems*sizeof(float)/1024);
+    return true;
+}
+
+static __global__ void pair_ar_kernel(
+        const float * __restrict__ src, float * __restrict__ dst, float * __restrict__ host_mine, const float * __restrict__ host_other,
+        const int n, int * arr_mine, const int * arr_other, int * ctr, const size_t slot_elems, const bool vec) {
+    __shared__ int s_call;
+    if (threadIdx.x == 0) {
+        s_call = *(volatile int *) ctr;
+    }
+    __syncthreads();
+    const int call  = s_call;
+    const int slot  = call % PAIR_AR_POOL;
+    const int token = call + 1;
+
+    float       * hm = host_mine  + (size_t) slot*slot_elems;
+    const float * ho = host_other + (size_t) slot*slot_elems;
+
+    const int gt = blockIdx.x*blockDim.x + threadIdx.x;
+    const int gn = gridDim.x*blockDim.x;
+    const int n4 = vec ? n/4 : 0;
+
+    // this block's stripe of my partial to host memory (the peer's same block reads it)
+    for (int i = gt; i < n4; i += gn) {
+        ((float4 *) hm)[i] = ((const float4 *) src)[i];
+    }
+    for (int i = 4*n4 + gt; i < n; i += gn) {
+        hm[i] = src[i];
+    }
+    __threadfence_system();
+    __syncthreads();
+
+    if (threadIdx.x == 0) {
+        volatile int       * am = arr_mine  + (slot*PAIR_AR_BLOCKS + blockIdx.x)*PAIR_AR_STRIDE;
+        const volatile int * ao = arr_other + (slot*PAIR_AR_BLOCKS + blockIdx.x)*PAIR_AR_STRIDE;
+        *am = token;
+        __threadfence_system();
+        while (*ao != token) {
+#if __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
+            __nanosleep(32);
+#endif // __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
+        }
+    }
+    __syncthreads();
+    __threadfence_system();
+
+    // mine + the peer's, the peer's read past the caches
+    for (int i = gt; i < n4; i += gn) {
+        const float4 a = ((const float4 *) src)[i];
+        const float4 b = __ldcv((const float4 *) ho + i);
+        ((float4 *) dst)[i] = make_float4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
+    }
+    for (int i = 4*n4 + gt; i < n; i += gn) {
+        dst[i] = src[i] + __ldcv(ho + i);
+    }
+
+    // the last block of the call advances the count (the next call on this stream starts after this kernel)
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        __threadfence();
+        if (atomicAdd(ctr + 1, 1) == (int) gridDim.x - 1) {
+            ctr[1] = 0;
+            *(volatile int *) ctr = call + 1;
+            __threadfence();
+        }
+    }
+}
+
+void ggml_cuda_op_pair_allreduce(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src = dst->src[0];
+    const int rank = ggml_get_op_params_i32(dst, 0);
+    ggml_cuda_pair_ar & p = g_pair_ar;
+
+    GGML_ASSERT(p.ready && "ggml_pair_allreduce: the pair was not set up (ggml_backend_cuda_pair_ar_init)");
+    GGML_ASSERT(rank == 0 || rank == 1);
+    GGML_ASSERT(p.dev[rank] == ctx.device);
+    GGML_ASSERT(src->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(src) && ggml_is_contiguous(dst));
+
+    const int64_t n = ggml_nelements(src);
+    GGML_ASSERT(n > 0 && (size_t) n <= p.slot_elems);
+
+    const bool vec = ((uintptr_t) src->data % 16) == 0 && ((uintptr_t) dst->data % 16) == 0;
+    pair_ar_kernel<<<PAIR_AR_BLOCKS, PAIR_AR_THREADS, 0, ctx.stream()>>>(
+        (const float *) src->data, (float *) dst->data, p.host[rank], p.host[1 - rank], (int) n,
+        p.arr[rank], p.arr[1 - rank], p.ctr[rank], p.slot_elems, vec);
+    CUDA_CHECK(cudaGetLastError());
+}
