+ggml_tensor * llama_model::td_w(ggml_tensor * w, int c) const {
+    if (w == nullptr || ggml_backend_buft_get_device(ggml_backend_buffer_get_type(w->buffer)) == tp_devs[c]) {
+        return w;
+    }
+    auto it = td_rep.find(w);
+    GGML_ASSERT(it != td_rep.end() && "LLAMA_TP_DECODE: a replicated weight without a copy on the other card");
+    return it->second;
+}
+
+ggml_tensor * llama_model::td_h(ggml_context * ctx, ggml_tensor * w, int c, int kind) const {
+    if (w == nullptr) {
+        return nullptr;
+    }
+    if (ggml_backend_buft_get_device(ggml_backend_buffer_get_type(w->buffer)) != tp_devs[c]) {
+        auto it = td_half.find(w);
+        GGML_ASSERT(it != td_half.end() && "LLAMA_TP_DECODE: a split weight without its half on the other card");
+        return it->second;
+    }
+    switch (kind) {
+        case 0:  return ggml_view_2d(ctx, w, w->ne[0], w->ne[1]/2, w->nb[1], (size_t) c*(w->ne[1]/2)*w->nb[1]);
+        case 1:  return ggml_view_3d(ctx, w, w->ne[0], w->ne[1], w->ne[2]/2, w->nb[1], w->nb[2], (size_t) c*(w->ne[2]/2)*w->nb[2]);
+        default: return ggml_view_2d(ctx, w, w->ne[0]/2, w->ne[1], w->nb[1], (size_t) c*ggml_row_size(w->type, w->ne[0]/2));
+    }
+}
