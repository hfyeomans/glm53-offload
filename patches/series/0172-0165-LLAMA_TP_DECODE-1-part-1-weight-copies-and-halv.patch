+
+ggml_tensor * llama_kv_cache_context::cpy_k_rep(ggml_context * ctx, ggml_tensor * k_cur, ggml_tensor * k_idxs, int32_t il) const {
+    return kv->cpy_k_rep(ctx, k_cur, k_idxs, il, sinfos[i_cur]);
+}
