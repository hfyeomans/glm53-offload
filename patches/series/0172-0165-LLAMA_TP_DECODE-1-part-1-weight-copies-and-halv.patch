+// 0165 LLAMA_TP_DECODE=1: the K replica of each trunk layer on the layer's other card
+void llama_kv_cache::td_rep_alloc() {
+    if (!model.td_ready || model.tp_devs.size() != 2 || n_stream != 1) {
+        return;
+    }
+    std::map<ggml_backend_buffer_type_t, ggml_context_ptr> ctxs;
+    for (auto & l : layers) {
+        if (l.il >= hparams.n_layer() || l.k == nullptr || l.k->buffer == nullptr || ggml_backend_buffer_is_host(l.k->buffer)) {
+            continue;
+        }
+        const int home = model.tp_home((int) l.il);
+        if (home < 0) {
+            continue;
+        }
+        ggml_backend_buffer_type_t buft = ggml_backend_dev_buffer_type(model.tp_devs[1 - home]);
+        auto & ctx = ctxs[buft];
+        if (!ctx) {
+            ggml_init_params params = { ggml_tensor_overhead()*(layers.size() + 1), nullptr, true };
+            ctx.reset(ggml_init(params));
+        }
+        l.k_rep = ggml_dup_tensor(ctx.get(), l.k);
+        ggml_format_name(l.k_rep, "cache_k_rep_l%d", (int) l.il);
+    }
+    for (auto & [buft, ctx] : ctxs) {
+        ggml_backend_buffer_t buf = td_rep_bufs.emplace(std::move(ctx), buft, "K replica");
+        if (buf == nullptr) {
+            throw std::runtime_error("LLAMA_TP_DECODE: failed to allocate the K replica");
+        }
+        LLAMA_LOG_INFO("%s: LLAMA_TP_DECODE: K replica on %s, %.1f MiB\n", __func__, ggml_backend_buft_name(buft),
+            ggml_backend_buffer_get_size(buf)/1024.0/1024.0);
+    }
+}
+
+bool llama_kv_cache::has_k_rep(int32_t il) const {
+    const auto it = map_layer_ids.find(il);
+    return it != map_layer_ids.end() && layers[it->second].k_rep != nullptr;
+}
+
+ggml_tensor * llama_kv_cache::get_k_rep(ggml_context * ctx, int32_t il, uint32_t n_kv, const slot_info & sinfo) const {
+    const int32_t ikv = map_layer_ids.at(il);
+
+    auto * k = layers[ikv].k_rep;
+    GGML_ASSERT(k != nullptr);
+
+    const uint64_t kv_size      = get_size();
+    const uint64_t n_embd_k_gqa = k->ne[0];
+
+    const uint32_t ns = sinfo.s1 - sinfo.s0 + 1;
+
+    return ggml_view_4d(ctx, k,
+            hparams.n_embd_head_k(il), hparams.n_head_kv(il), n_kv, ns,
+            ggml_row_size(k->type, hparams.n_embd_head_k(il)),
+            ggml_row_size(k->type, n_embd_k_gqa),
+            ggml_row_size(k->type, n_embd_k_gqa*kv_size),
+            ggml_row_size(k->type, n_embd_k_gqa*kv_size)*sinfo.s0);
+}
+
+ggml_tensor * llama_kv_cache::cpy_k_rep(ggml_context * ctx, ggml_tensor * k_cur, ggml_tensor * k_idxs, int32_t il, const slot_info & sinfo) const {
+    GGML_UNUSED(sinfo);
+
+    const int32_t ikv = map_layer_ids.at(il);
+
+    ggml_tensor * k = layers[ikv].k_rep;
+    GGML_ASSERT(k != nullptr && k->ne[2] == 1);
+
+    const int64_t n_embd_gqa = k_cur->ne[0]*k_cur->ne[1];
+    GGML_ASSERT(ggml_row_size(k_cur->type, k_cur->ne[0]) == k_cur->nb[1]);
+
+    k_cur = ggml_view_2d(ctx, k_cur, n_embd_gqa, k_cur->ne[2], k_cur->nb[2], 0);
+
+    return ggml_set_rows(ctx, k, k_cur, k_idxs);
+}
+
+void llama_kv_cache::td_rep_sync(ggml_backend_sched_t sched, const slot_info & sinfo) const {
+    if (td_rep_bufs.empty() || sinfo.empty() || sinfo.idxs.size() != 1 || sinfo.idxs[0].empty()) {
+        return;
+    }
+    std::vector<uint32_t> idx = sinfo.idxs[0];
+    std::sort(idx.begin(), idx.end());
+    idx.erase(std::unique(idx.begin(), idx.end()), idx.end());
+    std::vector<std::pair<uint32_t, uint32_t>> runs; // [first, end)
+    for (uint32_t c : idx) {
+        if (!runs.empty() && runs.back().second == c) {
+            runs.back().second = c + 1;
+        } else {
+            runs.emplace_back(c, c + 1);
+        }
+    }
+    auto backend_of = [&](const ggml_backend_buffer_t buf) -> ggml_backend_t {
+        ggml_backend_dev_t dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(buf));
+        for (int i = 0; i < ggml_backend_sched_get_n_backends(sched); ++i) {
+            ggml_backend_t b = ggml_backend_sched_get_backend(sched, i);
+            if (ggml_backend_get_device(b) == dev) {
+                return b;
+            }
+        }
+        return nullptr;
+    };
+    size_t n_views = 0;
+    for (const auto & l : layers) {
+        n_views += l.k_rep != nullptr ? 2*runs.size() : 0;
+    }
+    ggml_init_params params = { ggml_tensor_overhead()*(n_views + 1), nullptr, true };
+    ggml_context_ptr tctx { ggml_init(params) };
+    for (const auto & l : layers) {
+        if (l.k_rep == nullptr) {
+            continue;
+        }
+        ggml_backend_t bs = backend_of(l.k->buffer);
+        ggml_backend_t bd = backend_of(l.k_rep->buffer);
+        GGML_ASSERT(bs != nullptr && bd != nullptr);
+        for (const auto & r : runs) {
+            const int64_t ne = (int64_t) (r.second - r.first)*l.k->ne[0];
+            ggml_tensor * vs = ggml_view_1d(tctx.get(), l.k,     ne, (size_t) r.first*l.k->nb[1]);
+            ggml_tensor * vd = ggml_view_1d(tctx.get(), l.k_rep, ne, (size_t) r.first*l.k_rep->nb[1]);
+            GGML_ASSERT(ggml_backend_view_init(vs) == GGML_STATUS_SUCCESS && ggml_backend_view_init(vd) == GGML_STATUS_SUCCESS);
+            ggml_backend_tensor_copy_async(bs, bd, vs, vd);
+        }
+    }
+}
+
 ggml_tensor * llama_kv_cache::cpy_k(ggml_context * ctx, ggml_tensor * k_cur, ggml_tensor * k_idxs, int32_t il, const slot_info & sinfo) const {
     GGML_UNUSED(sinfo);
 
@@ -3143,6 +3264,24 @@ ggml_tensor * llama_kv_cache_context::cpy_k(ggml_context * ctx, ggml_tensor * k_
     return kv->cpy_k(ctx, k_cur, k_idxs, il, sinfos[i_cur]);
 }
 
+bool llama_kv_cache_context::has_k_rep(int32_t il) const {
