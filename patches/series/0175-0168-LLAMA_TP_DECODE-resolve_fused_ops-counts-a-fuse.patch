From fc8a63e5628a3c8cb6a7daef13d63e4608b61a9f Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Sat, 7 Nov 2026 13:31:21 -0600
Subject: [PATCH 175/211] 0168: LLAMA_TP_DECODE -- resolve_fused_ops counts a
 fused node on either TD card as on its layer device

---
 src/llama-context.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 8fd675b08..83cdbc3dc 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -746,7 +746,10 @@ void llama_context::resolve_fused_ops(const llama_memory_context_i * mctx, uint3
             // but is still wrong for cases like --no-kv-offload.
             ggml_backend_dev_t device_layer = model.dev_layer(node.il);
 
-            if (device_fused != device_layer) {
+            // 0168 LLAMA_TP_DECODE: the two-card decode graph runs every layer's ops on both cards
+            const bool td_card = cparams.td && model.tp_devs.size() == 2 && (device_fused == model.tp_devs[0] || device_fused == model.tp_devs[1]);
+
+            if (device_fused != device_layer && !td_card) {
                 LLAMA_LOG_WARN("%s: layer %d is assigned to device %s but %s "
                         "is assigned to device %s (usually due to missing support)\n",
                         func, node.il,
-- 
