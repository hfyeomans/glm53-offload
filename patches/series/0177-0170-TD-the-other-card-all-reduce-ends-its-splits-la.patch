     int   * ctr[2]  = { nullptr, nullptr };          // on device r: { calls, blocks done in the current call }
+    int   * err_host = nullptr;                      // 0170: set by a kernel that gave up waiting (mapped host memory)
+    int   * err_dev  = nullptr;
+    uint64_t timeout_ns = 0;
 };
 
 static ggml_cuda_pair_ar g_pair_ar;
@@ -55,15 +58,26 @@ bool ggml_cuda_pair_ar_init(int dev0, int dev1, size_t max_bytes) {
         CUDA_CHECK(cudaMemset(p.ctr[r], 0, 2*sizeof(int)));
         CUDA_CHECK(cudaDeviceSynchronize());
     }
+    {
+        void * e = nullptr;
+        ggml_cuda_set_device(p.dev[0]);
+        CUDA_CHECK(cudaHostAlloc(&e, 64, cudaHostAllocPortable | cudaHostAllocMapped));
+        memset(e, 0, 64);
+        p.err_host = (int *) e;
+        CUDA_CHECK(cudaHostGetDevicePointer((void **) &p.err_dev, e, 0));
+        const char * t = getenv("GGML_CUDA_PAIR_AR_TIMEOUT_MS");
+        p.timeout_ns = (uint64_t) (t != nullptr ? atoll(t) : 10000)*1000000ull;
+    }
     p.ready = true;
-    GGML_LOG_INFO("%s: 0164: pair all-reduce between CUDA%d and CUDA%d, up to %zu KiB a call\n", __func__, dev0, dev1,
-        p.slot_elems*sizeof(float)/1024);
+    GGML_LOG_INFO("%s: 0164: pair all-reduce between CUDA%d and CUDA%d, up to %zu KiB a call, gives up after %llu ms\n", __func__, dev0, dev1,
+        p.slot_elems*sizeof(float)/1024, (unsigned long long) (p.timeout_ns/1000000ull));
     return true;
 }
 
 static __global__ void pair_ar_kernel(
         const float * __restrict__ src, float * __restrict__ dst, float * __restrict__ host_mine, const float * __restrict__ host_other,
-        const int n, int * arr_mine, const int * arr_other, int * ctr, const size_t slot_elems, const bool vec) {
+        const int n, int * arr_mine, const int * arr_other, int * ctr, const size_t slot_elems, const bool vec,
+        int * err, const uint64_t timeout_ns) {
     __shared__ int s_call;
     if (threadIdx.x == 0) {
         s_call = *(volatile int *) ctr;
@@ -95,10 +109,19 @@ static __global__ void pair_ar_kernel(
         const volatile int * ao = arr_other + (slot*PAIR_AR_BLOCKS + blockIdx.x)*PAIR_AR_STRIDE;
         *am = token;
         __threadfence_system();
+        uint64_t t0;
+        asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t0));
         while (*ao != token) {
 #if __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
             __nanosleep(32);
 #endif // __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
+            uint64_t t1;
+            asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t1));
+            if (timeout_ns > 0 && t1 - t0 > timeout_ns) {
+                *(volatile int *) err = 1; // 0170: give up; the host aborts at the next pair all-reduce
+                __threadfence_system();
+                break;
+            }
         }
     }
     __syncthreads();
@@ -139,10 +162,13 @@ void ggml_cuda_op_pair_allreduce(ggml_backend_cuda_context & ctx, ggml_tensor *
 
     const int64_t n = ggml_nelements(src);
     GGML_ASSERT(n > 0 && (size_t) n <= p.slot_elems);
+    if (*(volatile int *) p.err_host != 0) {
+        GGML_ABORT("pair all-reduce: a call waited longer than GGML_CUDA_PAIR_AR_TIMEOUT_MS for its peer (the two devices' graphs disagree or the host blocked on one)");
+    }
 
     const bool vec = ((uintptr_t) src->data % 16) == 0 && ((uintptr_t) dst->data % 16) == 0;
     pair_ar_kernel<<<PAIR_AR_BLOCKS, PAIR_AR_THREADS, 0, ctx.stream()>>>(
         (const float *) src->data, (float *) dst->data, p.host[rank], p.host[1 - rank], (int) n,
-        p.arr[rank], p.arr[1 - rank], p.ctr[rank], p.slot_elems, vec);
+        p.arr[rank], p.arr[1 - rank], p.ctr[rank], p.slot_elems, vec, p.err_dev, p.timeout_ns);
     CUDA_CHECK(cudaGetLastError());
 }
