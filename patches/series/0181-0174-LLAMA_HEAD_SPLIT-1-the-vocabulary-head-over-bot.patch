+    load_tensors_head_split();
 
     return true;
 }
@@ -2227,6 +2228,49 @@ void llama_model_base::load_tensors_mtp_head() {
     pimpl->ctxs_bufs.emplace_back(std::move(ctx), std::move(buffers));
 }
 
+// LLAMA_HEAD_SPLIT=1 (0174): the first half of the vocabulary head's rows on the other card of a two-card layer split
+void llama_model_base::load_tensors_head_split() {
+    const char * env = getenv("LLAMA_HEAD_SPLIT");
+    if (env == nullptr || atoi(env) == 0 || output == nullptr || output->buffer == nullptr || ggml_backend_buffer_is_host(output->buffer) ||
+            !ggml_is_contiguous(output) || output->ne[1] % 2 != 0 || output_s != nullptr) {
+        return;
+    }
+    std::vector<ggml_backend_dev_t> devs;
+    for (int il = 0; il < (int) hparams.n_layer(); ++il) {
+        ggml_backend_dev_t d = dev_layer(il);
+        if (ggml_backend_dev_type(d) == GGML_BACKEND_DEVICE_TYPE_GPU && std::find(devs.begin(), devs.end(), d) == devs.end()) {
+            devs.push_back(d);
+        }
+    }
+    ggml_backend_dev_t d_out = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(output->buffer));
+    if (devs.size() != 2 || (devs[0] != d_out && devs[1] != d_out)) {
+        LLAMA_LOG_WARN("%s: LLAMA_HEAD_SPLIT needs the layers on two GPUs, one of them the head's, not used\n", __func__);
+        return;
+    }
+    ggml_backend_dev_t d_x = devs[0] == d_out ? devs[1] : devs[0];
+    ggml_init_params params = { ggml_tensor_overhead()*2, NULL, true };
+    ggml_context_ptr ctx { ggml_init(params) };
+    ggml_tensor * t = ggml_new_tensor_2d(ctx.get(), output->type, output->ne[0], output->ne[1]/2);
+    ggml_set_name(t, "output.head_half");
+    ggml_backend_buffer_ptr buf { ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), ggml_backend_dev_buffer_type(d_x)) };
+    if (!buf) {
+        LLAMA_LOG_WARN("%s: LLAMA_HEAD_SPLIT: could not allocate %.1f MiB on %s, not used\n", __func__, ggml_nbytes(t)/1024.0/1024.0,
+            ggml_backend_dev_name(d_x));
+        return;
+    }
+    ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    std::vector<uint8_t> rows(ggml_nbytes(t));
+    ggml_backend_tensor_get(output, rows.data(), 0, rows.size());
+    ggml_backend_tensor_set(t, rows.data(), 0, rows.size());
+    head_half = t;
+    head_half_dev = d_x;
+    LLAMA_LOG_INFO("%s: LLAMA_HEAD_SPLIT: the head's first %lld of %lld rows on %s (%.1f MiB)\n", __func__, (long long) t->ne[1],
+        (long long) output->ne[1], ggml_backend_dev_name(d_x), ggml_nbytes(t)/1024.0/1024.0);
+    std::vector<ggml_backend_buffer_ptr> buffers;
+    buffers.emplace_back(std::move(buf));
+    pimpl->ctxs_bufs.emplace_back(std::move(ctx), std::move(buffers));
+}
+
 // LLAMA_TP_DECODE=1 (0165): the two-card head-split decode's weights on each layer's non-home card (docs/20261107-two-card-tp-decode-design.md)
 void llama_model_base::load_tensors_td() {
     const char * env = getenv("LLAMA_TP_DECODE");
diff --git a/src/llama-model.h b/src/llama-model.h
index 251533a0e..8ada03bdf 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -903,6 +903,9 @@ struct llama_model {
     ggml_tensor * td_w(ggml_tensor * w, int c) const;
     // card c's half of w (kind 0: rows, ne1; 1: heads, ne2; 2: input columns, ne0): a view on w's home card, else the copy
     ggml_tensor * td_h(ggml_context * ctx, ggml_tensor * w, int c, int kind) const;
+    // LLAMA_HEAD_SPLIT (0174): the first half of the vocabulary head's rows on the card that does not hold the head, and that card
+    ggml_tensor * head_half = nullptr;
+    ggml_backend_dev_t head_half_dev = nullptr;
 
     // for keeping track of associated LoRA adapters
     std::unordered_set<llama_adapter_lora *> loras;
@@ -1028,6 +1031,7 @@ struct llama_model_base : public llama_model {
     void load_tensors_tp_shadow(); // LLAMA_TP_PROMPT (0059)
     void load_tensors_mtp_head();  // LLAMA_MTP_HEAD_IDS (0155)
     void load_tensors_td();        // LLAMA_TP_DECODE (0165)
+    void load_tensors_head_split(); // LLAMA_HEAD_SPLIT (0174)
 
     // helper: read the SWA pattern as one flag per layer, or as a period expanded by set_swa_pattern
     void load_swa_pattern(llama_model_loader & ml, uint32_t n_pattern, bool dense_first = false);
diff --git a/src/models/glm-dsa.cpp b/src/models/glm-dsa.cpp
index bfe87e085..20ce1dc0a 100644
--- a/src/models/glm-dsa.cpp
+++ b/src/models/glm-dsa.cpp
@@ -183,6 +183,40 @@ void llama_model_glm_dsa::load_arch_tensors(llama_model_loader & ml) {
     }
 }
 
+// 0174 LLAMA_HEAD_SPLIT=1: logits = the head (w) times cur, the first half of the rows on the other card (model.head_half), the second on
+// the head's card, concatenated there.  cur_x: the hidden state as the other card already holds it (the TD graph), else cur is copied over
+static ggml_tensor * glm_dsa_head(ggml_context * ctx0, ggml_cgraph * gf, ggml_backend_sched_t sched, const llama_model & model,
+        ggml_tensor * w, ggml_tensor * cur, ggml_tensor * cur_x) {
+    if (model.head_half == nullptr || w != model.output) {
+        return ggml_mul_mat(ctx0, w, cur);
+    }
+    ggml_backend_t be_o = nullptr;
+    ggml_backend_t be_x = nullptr;
+    ggml_backend_dev_t d_o = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(w->buffer));
+    for (int i = 0; i < ggml_backend_sched_get_n_backends(sched); ++i) {
+        ggml_backend_t b = ggml_backend_sched_get_backend(sched, i);
+        if (be_o == nullptr && ggml_backend_get_device(b) == d_o) {
+            be_o = b;
+        }
+        if (be_x == nullptr && ggml_backend_get_device(b) == model.head_half_dev) {
+            be_x = b;
+        }
+    }
+    if (be_o == nullptr || be_x == nullptr) {
+        return ggml_mul_mat(ctx0, w, cur);
+    }
+    const int64_t nh = model.head_half->ne[1];
+    ggml_tensor * lx = ggml_mul_mat(ctx0, model.head_half, cur_x != nullptr ? cur_x : cur); // the other card first
+    ggml_backend_sched_set_tensor_backend(sched, lx, be_x);
+    ggml_build_forward_expand(gf, lx);
+    ggml_tensor * wo = ggml_view_2d(ctx0, w, w->ne[0], w->ne[1] - nh, w->nb[1], (size_t) nh*w->nb[1]);
+    ggml_tensor * lo = ggml_mul_mat(ctx0, wo, cur);
+    ggml_backend_sched_set_tensor_backend(sched, lo, be_o);
+    ggml_tensor * l = ggml_concat(ctx0, lx, lo, 0);
+    ggml_backend_sched_set_tensor_backend(sched, l, be_o);
+    return l;
+}
+
 std::unique_ptr<llm_graph_context> llama_model_glm_dsa::build_arch_graph(const llm_graph_params & params) const {
     if (params.gtype == LLM_GRAPH_TYPE_DECODER_MTP) {
         return std::make_unique<graph_mtp>(*this, params);
@@ -902,6 +936,20 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
 
         // the final norm, the MTP hidden state and the logits on the output's card
         const int co = model.dev_output() == model.tp_devs[0] ? 0 : 1;
+        // 0174: the other card's half of the head first (its last all-reduce's partner is queued), from its own copy of the stream
+        ggml_tensor * cur_x = nullptr;
+        if (model.head_half != nullptr && model.head_half_dev == model.tp_devs[1 - co]) {
+            const int nx = ggml_graph_n_nodes(gf);
+            cur_x = build_norm(x_of(1 - co), model.output_norm, NULL, LLM_NORM_RMS, -1);
+            if (crop_before_nextn(inp_out_ids)) {
+                cur_x = ggml_get_rows(ctx0, cur_x, inp_out_ids);
+            }
+            if (crop_after_nextn(inp_out_ids)) {
+                cur_x = ggml_get_rows(ctx0, cur_x, inp_out_ids);
+            }
+            ggml_build_forward_expand(gf, cur_x);
+            pin_from(nx, 1 - co);
+        }
         const int n0 = ggml_graph_n_nodes(gf);
         ggml_tensor * cur = build_norm(x_of(co), model.output_norm, NULL, LLM_NORM_RMS, -1);
         if (crop_before_nextn(inp_out_ids)) {
@@ -914,11 +962,11 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
         }
         cb(cur, "result_norm", -1);
         res->t_embd = cur;
-        cur = ggml_mul_mat(ctx0, model.output, cur);
+        pin_from(n0, co);
+        cur = glm_dsa_head(ctx0, gf, sched, model, model.output, cur, cur_x); // 0174
         cb(cur, "result_output", -1);
         res->t_logits = cur;
         ggml_build_forward_expand(gf, cur);
-        pin_from(n0, co);
         return;
     }
 
@@ -1635,8 +1683,8 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
     cb(cur, "result_norm", -1);
     res->t_embd = cur;
 
-    // lm_head
-    cur = ggml_mul_mat(ctx0, model.output, cur);
+    // lm_head (0174: over both cards with LLAMA_HEAD_SPLIT=1, for the small batches only)
+    cur = n_tokens <= 32 ? glm_dsa_head(ctx0, gf, sched, model, model.output, cur, nullptr) : ggml_mul_mat(ctx0, model.output, cur);
 
     cb(cur, "result_output", -1);
     res->t_logits = cur;
@@ -1963,6 +2011,8 @@ llama_model_glm_dsa::graph_mtp::graph_mtp(const llama_model & model, const llm_g
         ggml_tensor * rest     = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, head_w->ne[1] - head_k, logits_k->ne[1]);
         rest = ggml_fill(ctx0, rest, -INFINITY);
         cur  = ggml_concat(ctx0, logits_k, rest, 0);                                    // [n_vocab, n_outputs]
+    } else if (head_s == nullptr && loras->empty()) {
+        cur = glm_dsa_head(ctx0, gf, sched, model, head_w, cur, nullptr); // 0174
     } else {
         cur = build_lora_mm(head_w, cur, head_s);
     }
