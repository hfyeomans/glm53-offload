Subject: [PATCH 181/211] 0174: LLAMA_HEAD_SPLIT=1 -- the vocabulary head over
 both cards (first half of the rows on the other card) for decode, TD and the
 MTP draft

---
 src/llama-model.cpp    | 44 ++++++++++++++++++++++++++++++++
 src/llama-model.h      |  4 +++
 src/models/glm-dsa.cpp | 58 +++++++++++++++++++++++++++++++++++++++---
 3 files changed, 102 insertions(+), 4 deletions(-)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index f46ab3897..3ac16c739 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -2076,6 +2076,7 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
     load_tensors_tp_shadow();
     load_tensors_mtp_head();
