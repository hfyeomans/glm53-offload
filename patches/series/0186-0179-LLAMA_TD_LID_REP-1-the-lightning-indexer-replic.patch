From 49e473e9f482aadbd70200353a39a81d1b3284c6 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Sat, 7 Nov 2026 21:24:02 -0600
Subject: [PATCH 186/211] 0179: LLAMA_TD_LID_REP=1 -- the lightning indexer
 replicated on both TD cards (weights, key cache replica, rotation), no top-k
 copy

---
 src/llama-kv-cache-dsa.cpp |  7 ++++++
 src/llama-kv-cache.cpp     | 41 ++++++++++++++++++++++++++++++++++-
 src/llama-kv-cache.h       |  5 ++++-
 src/llama-model.cpp        |  7 ++++++
 src/models/glm-dsa.cpp     | 44 ++++++++++++++++++++++++--------------
 5 files changed, 86 insertions(+), 18 deletions(-)

diff --git a/src/llama-kv-cache-dsa.cpp b/src/llama-kv-cache-dsa.cpp
index ece9d69c1..3be43143d 100644
--- a/src/llama-kv-cache-dsa.cpp
+++ b/src/llama-kv-cache-dsa.cpp
@@ -60,6 +60,11 @@ llama_kv_cache_dsa::llama_kv_cache_dsa(
             model, no_alloc, hparams_lid, type_k, type_v,
             v_trans, offload, unified, kv_size, n_seq_max,
             n_swa, swa_type, nullptr, filter_lid, nullptr, nullptr);
+
+    // 0179 LLAMA_TD_LID_REP=1: the indexer keys of each full-indexer layer on its other card too
+    if (!no_alloc && model.td_ready && getenv("LLAMA_TD_LID_REP") != nullptr && atoi(getenv("LLAMA_TD_LID_REP")) != 0) {
+        kv_lid->td_rep_alloc(true);
+    }
 }
 
 void llama_kv_cache_dsa::clear(bool data) {
@@ -282,12 +287,14 @@ const llama_kv_cache_context * llama_kv_cache_dsa_context::get_lid()  const {
 void llama_kv_cache_dsa_context::td_rep_sync(ggml_backend_sched_t sched) const {
     if (status == LLAMA_MEMORY_STATUS_SUCCESS) {
         get_mla()->td_rep_sync(sched);
+        get_lid()->td_rep_sync(sched); // 0179
     }
 }
 
 void llama_kv_cache_dsa_context::td_rep_flush(ggml_backend_sched_t sched) const {
     if (status == LLAMA_MEMORY_STATUS_SUCCESS) {
         get_mla()->td_rep_flush(sched);
+        get_lid()->td_rep_flush(sched); // 0179
     }
 }
 
diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index b9b9eb5d9..972c07e3c 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -1560,7 +1560,7 @@ ggml_tensor * llama_kv_cache::get_v(ggml_context * ctx, int32_t il, uint32_t n_k
 }
 
 // 0165 LLAMA_TP_DECODE=1: the K replica of each trunk layer on the layer's other card
-void llama_kv_cache::td_rep_alloc() {
+void llama_kv_cache::td_rep_alloc(bool rot) {
     if (!model.td_ready || model.tp_devs.size() != 2 || n_stream != 1) {
         return;
     }
@@ -1629,6 +1629,33 @@ void llama_kv_cache::td_rep_alloc() {
         LLAMA_LOG_INFO("%s: LLAMA_TP_DECODE: K replica on %s, %.1f MiB\n", __func__, ggml_backend_buft_name(buft),
             ggml_backend_buffer_get_size(buf)/1024.0/1024.0);
     }
+    // 0179: the rotation matrices of the replicated layers on the other card too (their own buffer: the replica's pages may be unmapped)
+    std::map<ggml_backend_buffer_type_t, ggml_context_ptr> rctxs;
+    for (auto & l : layers) {
+        if (!rot || l.k_rep == nullptr || l.k_rot == nullptr) {
+            continue;
+        }
+        ggml_backend_buffer_type_t buft = ggml_backend_dev_buffer_type(model.tp_devs[1 - model.tp_home((int) l.il)]);
+        auto & ctx = rctxs[buft];
+        if (!ctx) {
+            ggml_init_params params = { ggml_tensor_overhead()*(layers.size() + 1), nullptr, true };
+            ctx.reset(ggml_init(params));
+        }
+        l.k_rot_rep = ggml_dup_tensor(ctx.get(), l.k_rot);
+        ggml_format_name(l.k_rot_rep, "cache_k_rot_rep_l%d", (int) l.il);
+    }
+    for (auto & [buft, ctx] : rctxs) {
+        ggml_backend_buffer_t buf = td_rep_bufs.emplace(std::move(ctx), buft, "rotation replica");
+        if (buf == nullptr) {
+            throw std::runtime_error("LLAMA_TP_DECODE: failed to allocate the rotation replica");
+        }
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    }
+    for (auto & l : layers) {
+        if (l.k_rot_rep != nullptr) {
+            ggml_backend_tensor_set(l.k_rot_rep, attn_rot_hadamard.at(l.k_rot->ne[0]).data(), 0, ggml_nbytes(l.k_rot_rep));
+        }
+    }
 }
 
 bool llama_kv_cache::has_k_rep(int32_t il) const {
@@ -1856,6 +1883,14 @@ std::vector<ggml_tensor *> llama_kv_cache::get_k_rot() const {
     return res;
 }
 
+std::vector<ggml_tensor *> llama_kv_cache::get_k_rot_rep() const {
+    std::vector<ggml_tensor *> res(hparams.n_layer_all, nullptr);
+    for (const auto & [il, idx] : map_layer_ids) {
+        res[il] = layers[idx].k_rot_rep;
+    }
+    return res;
+}
+
 std::vector<ggml_tensor *> llama_kv_cache::get_v_rot() const {
     std::vector<ggml_tensor *> res(hparams.n_layer_all, nullptr);
     for (const auto & [il, idx] : map_layer_ids) {
@@ -3351,6 +3386,10 @@ std::vector<ggml_tensor *> llama_kv_cache_context::get_k_rot() const {
     return kv->get_k_rot();
 }
 
+std::vector<ggml_tensor *> llama_kv_cache_context::get_k_rot_rep() const {
+    return kv->get_k_rot_rep();
+}
+
 std::vector<ggml_tensor *> llama_kv_cache_context::get_v_rot() const {
     return kv->get_v_rot();
 }
