@@ -295,6 +296,7 @@ private:
         ggml_tensor * v_rot = nullptr;
 
         ggml_tensor * k_rep = nullptr; // 0165 LLAMA_TP_DECODE: the copy of k on the layer's other card
+        ggml_tensor * k_rot_rep = nullptr; // 0179: the copy of k_rot there
     };
 
     bool v_trans = true;  // the value tensor is transposed
@@ -471,6 +473,7 @@ public:
     ggml_tensor * build_input_v_idxs(ggml_context * ctx, const llama_ubatch & ubatch) const;
 
     std::vector<ggml_tensor *> get_k_rot() const;
+    std::vector<ggml_tensor *> get_k_rot_rep() const; // 0179: k_rot of the replicated layers on their other card
     std::vector<ggml_tensor *> get_v_rot() const;
 
     void set_input_k_idxs(ggml_tensor * dst, const llama_ubatch * ubatch) const;
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 3ac16c739..15111ad5c 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -2321,6 +2321,13 @@ void llama_model_base::load_tensors_td() {
         for (ggml_tensor * w : { L.attn_norm, L.wq_a, L.attn_q_a_norm, L.wkv_a_mqa, L.attn_kv_a_norm, L.ffn_norm, L.ffn_gate_inp, L.ffn_exp_probs_b }) {
             add(w, -1);
         }
+        // 0179 LLAMA_TD_LID_REP=1: a full-indexer layer's indexer weights on the other card too
+        static const bool td_lid_rep = getenv("LLAMA_TD_LID_REP") != nullptr && atoi(getenv("LLAMA_TD_LID_REP")) != 0;
+        if (td_lid_rep && hparams.is_indexer_full(il)) {
+            for (ggml_tensor * w : { L.indexer_attn_q_b, L.indexer_attn_k, L.indexer_k_norm, L.indexer_k_norm_b, L.indexer_proj }) {
+                add(w, -1);
+            }
+        }
         add(L.wq_b, 0);
         add(L.wk_b, 1);
         add(L.wv_b, 1);
