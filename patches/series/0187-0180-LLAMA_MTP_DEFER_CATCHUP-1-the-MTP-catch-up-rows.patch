From 54fcf080b64f0600739821e14d6b0fc8f67bdbd5 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Sat, 7 Nov 2026 21:24:02 -0600
Subject: [PATCH 187/211] 0180: LLAMA_MTP_DEFER_CATCHUP=1 -- the MTP catch-up
 rows decoded with the first draft row (one MTP decode a step fewer)

---
 common/speculative.cpp | 79 +++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 78 insertions(+), 1 deletion(-)

diff --git a/common/speculative.cpp b/common/speculative.cpp
index d65e26bec..e1eba9fed 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -1524,6 +1524,15 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
     std::vector<int>                i_last;
     std::vector<std::vector<float>> chain_h;
 
+    // 0180 LLAMA_MTP_DEFER_CATCHUP=1: a verify batch's catch-up rows, decoded with the first draft row (see process / draft)
+    struct stash_row {
+        llama_token        id;
+        llama_pos          pos;
+        std::vector<float> h;
+    };
+    bool defer = false;
+    std::vector<std::vector<stash_row>> stash; // [n_seq]
+
     common_speculative_impl_draft_mtp(const common_params_speculative & params, uint32_t n_seq)
         : common_speculative_impl(COMMON_SPECULATIVE_TYPE_DRAFT_MTP, n_seq, params.draft.n_max)
         , params(params.draft)
@@ -1598,6 +1607,39 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
 
         verify_h.assign(n_seq, {});
         verify_h_rows.assign(n_seq, 0);
+
+        // 0180
+        defer = getenv("LLAMA_MTP_DEFER_CATCHUP") != nullptr && atoi(getenv("LLAMA_MTP_DEFER_CATCHUP")) != 0 &&
+                n_seq == 1 && !is_mem_shared && !chain_heads;
+        stash.assign(n_seq, {});
+        if (defer) {
+            SPC_TRC("%s", "- 0180: the catch-up rows are decoded with the first draft row\n");
+        }
+    }
+
+    // 0180: decode the stashed catch-up rows as process() would have (all of them, no outputs)
+    bool flush_stash() {
+        if (!defer) {
+            return true;
+        }
+        bool ok = true;
+        for (llama_seq_id s = 0; s < (llama_seq_id) n_seq; ++s) {
+            if (stash[s].empty()) {
+                continue;
+            }
+            batch.clear();
+            for (const auto & r : stash[s]) {
+                const int32_t idx = batch.add(r.id, r.pos, s, false);
+                batch.set_embd_state(idx, { r.h.data(), 1, (size_t) n_embd });
+            }
+            if (llama_process(this->params.ctx_dft, LLAMA_PROCESS_TYPE_DECODE, batch.get()) != 0) {
+                SPC_ERR("%s", "0180: the stashed catch-up decode failed\n");
+                ok = false;
+            }
+            stash[s].clear();
+        }
+        batch.clear();
+        return ok;
     }
 
     ~common_speculative_impl_draft_mtp() override {
@@ -1626,6 +1668,7 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
         auto * ctx_dft = this->params.ctx_dft;
         const llama_pos pos_max = llama_memory_seq_pos_max(llama_get_memory(ctx_dft), seq_id);
 
+        flush_stash(); // 0180: a stash from the last request, before its rows are needed
         if (pos_max < N - 1 && !is_mem_shared) {
             SPC_WRN("ctx_dft pos_max=%d < N-1=%d - "
                     "process() hook may not have run on every prefill ubatch "
@@ -1666,8 +1709,28 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
 
         const size_t row_bytes = (size_t) n_embd * sizeof(float);
 
+        // 0180 LLAMA_MTP_DEFER_CATCHUP=1: a verify-sized batch is stashed and decoded with the first draft row (its accepted rows only)
+        bool deferred = false;
+        if (defer) {
+            if (!flush_stash()) {
+                return false;
+            }
+            deferred = n_tokens <= this->params.n_max + 1;
+            for (int k = 0; k < n_tokens && deferred; ++k) {
+                deferred = batch_in.tokens[k].id != LLAMA_TOKEN_NULL && batch_in.tokens[k].seq_id == 0;
+            }
+            if (deferred) {
+                const float * h_tgt = llama_get_embeddings_nextn(ctx_tgt);
+                for (int k = 0; k < n_tokens; ++k) {
+                    const auto & t = batch_in.tokens[k];
+                    const float * h_row = k == i_batch_beg[0] ? pending_h[0].data() : h_tgt + (size_t) (k - 1) * n_embd;
+                    stash[0].push_back({ t.id, t.pos[0], std::vector<float>(h_row, h_row + n_embd) });
+                }
+            }
+        }
+
         // if kv is shared with target (e.g Gemma4), then we can skip this catch-up decode
-        if (!is_mem_shared) {
+        if (!is_mem_shared && !deferred) {
             batch.clear();
 
             // pair each token with the tgt embedding shifted right by one position, and
@@ -1781,6 +1844,15 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
                 common_sampler_reset(smpls[seq_id].get());
             }
 
+            // 0180: the stashed catch-up rows of the accepted positions, ahead of the first draft row
+            if (defer) {
+                for (const auto & r : stash[seq_id]) {
+                    if (r.pos < dp.pos0) {
+                        const int32_t ir = batch.add(r.id, r.pos, seq_id, false);
+                        batch.set_embd_state(ir, { r.h.data(), 1, (size_t) n_embd });
+                    }
+                }
+            }
             const int32_t idx = batch.add(dp.id_last, dp.pos0, seq_id, true);
             batch.set_embd_state(idx, { pending_h[seq_id].data(), 1, (size_t) n_embd });
 
@@ -1815,6 +1887,11 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
                 SPC_ERR("llama_process[%d] returned %d\n", i, ret);
                 break;
             }
+            if (defer && i == 0) {
+                for (auto & s : stash) {
+                    s.clear(); // 0180: decoded with the first draft row (the rejected rows dropped)
+                }
+            }
 
             // rebuild the batch for the next step: the growing-KV paths re-add only the
             // new token (the KV already holds the prefix), while chained heads re-add the
