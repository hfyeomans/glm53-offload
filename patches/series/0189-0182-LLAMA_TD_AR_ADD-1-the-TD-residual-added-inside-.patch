--- a/src/models/glm-dsa.cpp
+++ b/src/models/glm-dsa.cpp
@@ -638,6 +638,7 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
         auto Wh = [&](ggml_tensor * w, int c, int kind) { return model.td_h(ctx0, w, c, kind); };
         static const bool td_short_dense = getenv("LLAMA_DSA_SHORT_DENSE") != nullptr && atoi(getenv("LLAMA_DSA_SHORT_DENSE")) != 0;
         static const bool td_lid_rep = getenv("LLAMA_TD_LID_REP") != nullptr && atoi(getenv("LLAMA_TD_LID_REP")) != 0; // 0179
+        static const bool td_ar_add  = getenv("LLAMA_TD_AR_ADD")  != nullptr && atoi(getenv("LLAMA_TD_AR_ADD"))  != 0; // 0182
 
         ggml_tensor * inp_embd = build_inp_embd(model.tok_embd);
         ggml_tensor * inp_pos  = build_inp_pos();
@@ -792,13 +793,14 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
                                                  top_k != nullptr ? top_k->ne[0] : 0, kq_scale, il);
                 o = ggml_mul_mat(ctx0, Wh(L.wo, c, 2), o);
                 cb(o, "attn_out_part", il);
-                ggml_tensor * a = ggml_pair_allreduce(ctx0, o, c);
+                // 0182 LLAMA_TD_AR_ADD=1: the residual added inside the all-reduce
+                ggml_tensor * a = td_ar_add ? ggml_pair_allreduce_add(ctx0, o, x[c], c) : ggml_pair_allreduce(ctx0, o, c);
                 if (first) {
                     ggml_build_forward_expand(gf, a); // 0170: the end of the card's split
                     pin_from(n0, c);
                     return a;
                 }
-                ggml_tensor * f = ggml_add(ctx0, a, x[c]);
+                ggml_tensor * f = td_ar_add ? a : ggml_add(ctx0, a, x[c]);
                 cb(f, "ffn_inp", il);
                 ggml_build_forward_expand(gf, f);
                 pin_from(n0, c);
@@ -830,7 +832,7 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
                 const int n0 = ggml_graph_n_nodes(gf);
                 const bool attn_first = home_first ? c == H : c == O; // its attention all-reduce came first: the residual add is here
                 const bool first2     = c == O;                        // its FFN all-reduce is the first of the pair (both orders)
-                if (attn_first) {
+                if (attn_first && !td_ar_add) {
                     ffn_inp = ggml_add(ctx0, ffn_inp, x[c]); // 0170: the attention residual, at the top of the card's FFN split
                     cb(ffn_inp, "ffn_inp", il);
                 }
@@ -908,16 +910,20 @@ llama_model_glm_dsa::graph::graph(const llama_model & model, const llm_graph_par
                     moe_td_w     = nullptr;
                 }
                 cb(p, "ffn_out_part", il);
-                ggml_tensor * p_ar = ggml_pair_allreduce(ctx0, p, c);
+                ggml_tensor * p_ar = td_ar_add ? ggml_pair_allreduce_add(ctx0, p, ffn_inp, c) : ggml_pair_allreduce(ctx0, p, c); // 0182
                 if (first2) {
                     ggml_build_forward_expand(gf, p_ar); // 0170: the end of the other card's split, the residual add in its next one
                     pin_from(n0, c);
+                    if (td_ar_add) {
+                        x[c] = p_ar; // 0182: the residual came with the all-reduce
+                        return;
+                    }
                     x_ar[c]  = p_ar;
                     x_res[c] = ffn_inp;
                     x[c]     = nullptr;
                     return;
                 }
-                ggml_tensor * y = ggml_add(ctx0, p_ar, ffn_inp);
+                ggml_tensor * y = td_ar_add ? p_ar : ggml_add(ctx0, p_ar, ffn_inp); // 0182
                 cb(y, "l_out", il);
