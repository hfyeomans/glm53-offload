From 8ce96e1fcc30deb3e436103b188287c317057502 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Sat, 7 Nov 2026 22:32:40 -0600
Subject: [PATCH 189/211] 0182: LLAMA_TD_AR_ADD=1 -- the TD residual added
 inside the pair all-reduce (ggml_pair_allreduce_add), 156 add launches a step
 fewer

---
 ggml/include/ggml.h                  |  7 ++++++
 ggml/src/ggml-cuda/ggml-cuda.cu      |  3 ++-
 ggml/src/ggml-cuda/pair-allreduce.cu | 34 ++++++++++++++++++++--------
 ggml/src/ggml.c                      | 15 ++++++++++++
 src/models/glm-dsa.cpp               | 16 +++++++++----
 5 files changed, 60 insertions(+), 15 deletions(-)

diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index 8278756b4..9713acd97 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -2806,6 +2806,13 @@ extern "C" {
             struct ggml_tensor  * a,
             int                   rank);
 
+    // 0182: (a + the peer's a) + res, res on this device (same shape, F32, contiguous): the residual add folded into the all-reduce
+    GGML_API struct ggml_tensor * ggml_pair_allreduce_add(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,
+            struct ggml_tensor  * res,
+            int                   rank);
+
     // custom operators
 
     typedef void (*ggml_custom1_op_t)(struct ggml_tensor * dst , const struct ggml_tensor * a, int ith, int nth, void * userdata);
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index e0e03e165..8f981ba67 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -6793,7 +6793,8 @@ static bool ggml_backend_cuda_device_supports_op(ggml_backend_dev_t dev, const g
         case GGML_OP_TOP_K_MASK:
             return op->type == GGML_TYPE_F16 || op->type == GGML_TYPE_F32;
         case GGML_OP_PAIR_ALLREDUCE:
-            return op->type == GGML_TYPE_F32 && ggml_is_contiguous(op->src[0]); // 0164
+            return op->type == GGML_TYPE_F32 && ggml_is_contiguous(op->src[0]) && // 0164
+                (op->src[1] == nullptr || (op->src[1]->type == GGML_TYPE_F32 && ggml_is_contiguous(op->src[1]))); // 0182
 
         default:
             return false;
diff --git a/ggml/src/ggml-cuda/pair-allreduce.cu b/ggml/src/ggml-cuda/pair-allreduce.cu
index 4d74bbc67..e1a3847eb 100644
--- a/ggml/src/ggml-cuda/pair-allreduce.cu
+++ b/ggml/src/ggml-cuda/pair-allreduce.cu
@@ -106,7 +106,7 @@ bool ggml_cuda_pair_ar_init(int dev0, int dev1, size_t max_bytes) {
 static __global__ void pair_ar_kernel(
         const float * __restrict__ src, float * __restrict__ dst, float * __restrict__ host_mine, const float * __restrict__ host_other,
         const int n, int * arr_mine, const int * arr_other, int * ctr, const size_t slot_elems, const bool vec,
-        int * err, const uint64_t timeout_ns) {
+        int * err, const uint64_t timeout_ns, const float * __restrict__ res) {
     __shared__ int s_call;
     if (threadIdx.x == 0) {
         s_call = *(volatile int *) ctr;
@@ -160,10 +160,16 @@ static __global__ void pair_ar_kernel(
     for (int i = gt; i < n4; i += gn) {
         const float4 a = ((const float4 *) src)[i];
         const float4 b = __ldcv((const float4 *) ho + i);
-        ((float4 *) dst)[i] = make_float4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
+        float4 s = make_float4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
+        if (res != nullptr) { // 0182: + the residual, after the pair's sum (the same order on both devices)
+            const float4 r = ((const float4 *) res)[i];
+            s = make_float4(s.x + r.x, s.y + r.y, s.z + r.z, s.w + r.w);
+        }
+        ((float4 *) dst)[i] = s;
     }
     for (int i = 4*n4 + gt; i < n; i += gn) {
-        dst[i] = src[i] + __ldcv(ho + i);
+        const float s = src[i] + __ldcv(ho + i);
+        dst[i] = res != nullptr ? s + res[i] : s;
     }
 
     // the last block of the call advances the count (the next call on this stream starts after this kernel)
@@ -182,7 +188,7 @@ static __global__ void pair_ar_kernel(
 static __global__ void pair_ar_kernel_p2p(
         const float * __restrict__ src, float * __restrict__ dst, float * __restrict__ peer_recv, const float * __restrict__ my_recv,
         const int n, int * peer_tok, const int * my_tok, int * ctr, const size_t slot_elems, const bool vec,
-        int * err, const uint64_t timeout_ns) {
+        int * err, const uint64_t timeout_ns, const float * __restrict__ res) {
     __shared__ int s_call;
     if (threadIdx.x == 0) {
         s_call = *(volatile int *) ctr;
@@ -231,10 +237,16 @@ static __global__ void pair_ar_kernel_p2p(
     for (int i = gt; i < n4; i += gn) {
         const float4 a = ((const float4 *) src)[i];
         const float4 b = __ldcv((const float4 *) mr + i);
-        ((float4 *) dst)[i] = make_float4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
+        float4 s = make_float4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
+        if (res != nullptr) { // 0182
+            const float4 r = ((const float4 *) res)[i];
+            s = make_float4(s.x + r.x, s.y + r.y, s.z + r.z, s.w + r.w);
+        }
+        ((float4 *) dst)[i] = s;
     }
     for (int i = 4*n4 + gt; i < n; i += gn) {
-        dst[i] = src[i] + __ldcv(mr + i);
+        const float s = src[i] + __ldcv(mr + i);
+        dst[i] = res != nullptr ? s + res[i] : s;
     }
 
     __syncthreads();
@@ -265,16 +277,20 @@ void ggml_cuda_op_pair_allreduce(ggml_backend_cuda_context & ctx, ggml_tensor *
         GGML_ABORT("pair all-reduce: a call waited longer than GGML_CUDA_PAIR_AR_TIMEOUT_MS for its peer (the two devices' graphs disagree or the host blocked on one)");
     }
 
-    const bool vec = ((uintptr_t) src->data % 16) == 0 && ((uintptr_t) dst->data % 16) == 0;
+    // 0182: the residual (src[1]), when the add is folded in
+    const ggml_tensor * res_t = dst->src[1];
+    GGML_ASSERT(res_t == nullptr || (res_t->type == GGML_TYPE_F32 && ggml_is_contiguous(res_t) && ggml_nelements(res_t) == n));
+    const float * res = res_t != nullptr ? (const float *) res_t->data : nullptr;
+    const bool vec = ((uintptr_t) src->data % 16) == 0 && ((uintptr_t) dst->data % 16) == 0 && ((uintptr_t) res % 16) == 0;
     if (p.p2p) {
         pair_ar_kernel_p2p<<<PAIR_AR_BLOCKS, PAIR_AR_THREADS, 0, ctx.stream()>>>(
             (const float *) src->data, (float *) dst->data, p.recv[1 - rank], p.recv[rank], (int) n,
-            p.tok[1 - rank], p.tok[rank], p.ctr[rank], p.slot_elems, vec, p.err_dev, p.timeout_ns);
+            p.tok[1 - rank], p.tok[rank], p.ctr[rank], p.slot_elems, vec, p.err_dev, p.timeout_ns, res);
         CUDA_CHECK(cudaGetLastError());
         return;
     }
     pair_ar_kernel<<<PAIR_AR_BLOCKS, PAIR_AR_THREADS, 0, ctx.stream()>>>(
         (const float *) src->data, (float *) dst->data, p.host[rank], p.host[1 - rank], (int) n,
-        p.arr[rank], p.arr[1 - rank], p.ctr[rank], p.slot_elems, vec, p.err_dev, p.timeout_ns);
+        p.arr[rank], p.arr[1 - rank], p.ctr[rank], p.slot_elems, vec, p.err_dev, p.timeout_ns, res);
     CUDA_CHECK(cudaGetLastError());
 }
diff --git a/ggml/src/ggml.c b/ggml/src/ggml.c
index 7ea6915d1..a74e08721 100644
--- a/ggml/src/ggml.c
+++ b/ggml/src/ggml.c
@@ -6789,6 +6789,21 @@ struct ggml_tensor * ggml_pair_allreduce(
     return result;
 }
 
+// ggml_pair_allreduce_add (0182)
+
+struct ggml_tensor * ggml_pair_allreduce_add(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * res,
+        int                   rank) {
+    GGML_ASSERT(res->type == GGML_TYPE_F32 && ggml_is_contiguous(res) && ggml_are_same_shape(a, res));
+
+    struct ggml_tensor * result = ggml_pair_allreduce(ctx, a, rank);
+    result->src[1] = res;
+
+    return result;
+}
+
 ////////////////////////////////////////////////////////////////////////////////
 
 struct ggml_hash_set ggml_hash_set_new(size_t size) {
diff --git a/src/models/glm-dsa.cpp b/src/models/glm-dsa.cpp
