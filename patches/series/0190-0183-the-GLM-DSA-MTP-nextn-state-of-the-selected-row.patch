Subject: [PATCH 190/211] 0183: the GLM-DSA MTP nextn state of the selected
 rows when the context extracts it masked (0180 chained draft 2 from a
 catch-up row)

---
 src/models/glm-dsa.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/models/glm-dsa.cpp b/src/models/glm-dsa.cpp
index dd4f7b986..1634a6775 100644
--- a/src/models/glm-dsa.cpp
+++ b/src/models/glm-dsa.cpp
@@ -2006,6 +2006,9 @@ llama_model_glm_dsa::graph_mtp::graph_mtp(const llama_model & model, const llm_g
 
     cur = ggml_get_rows(ctx0, cur, inp_out_ids);
     cb(cur, "mtp_shared_head_norm", -1);
+    if (cparams.embeddings_nextn_masked) {
+        res->t_h_nextn = cur; // 0183: masked extraction copies n_outputs rows -- the selected ones
+    }
 
     ggml_tensor * head_w = layer.nextn.shared_head_head ? layer.nextn.shared_head_head : model.output;
     ggml_tensor * head_s = layer.nextn.shared_head_head ? layer.nextn.shared_head_head_s : model.output_s;
