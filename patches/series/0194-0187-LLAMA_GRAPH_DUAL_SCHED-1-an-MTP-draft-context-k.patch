From 052eb3db05261f0396fb209cd84c77f3ef05d5d8 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Sun, 8 Nov 2026 03:17:30 -0600
Subject: [PATCH 194/211] 0187: LLAMA_GRAPH_DUAL_SCHED=1 -- an MTP draft
 context keeps a second scheduler for its batches with outputs (catch-up and
 draft graphs both stay allocated)

---
 src/llama-context.cpp | 23 +++++++++++++++++++++++
 src/llama-context.h   |  6 ++++++
 2 files changed, 29 insertions(+)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index b49de3b0b..a3b602f5d 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -992,6 +992,8 @@ void llama_context::sched_reserve() {
     }
     gf_res_reserve.reset(new llm_graph_result(max_nodes));
     gf_res_prev_active = nullptr;
+    sched_alt.reset(); // 0187: made again on first use, from the new buffer types
+    gf_res_prev_active_alt = nullptr;
 
     sched_new(max_nodes, cparams.pipeline_parallel);
 
@@ -1353,6 +1355,7 @@ bool llama_context::memory_update(bool optimize) {
             }
         }
         gf_res_prev_active = nullptr;
+        gf_res_prev_active_alt = nullptr; // 0187
 
         if (!mctx->apply()) {
             LLAMA_LOG_ERROR("%s: failed to apply memory update\n", __func__);
@@ -1890,6 +1893,24 @@ bool llama_context::set_adapter_cvec(
 }
 
 llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, llm_graph_type gtype, llama_memory_context_i * mctx, ggml_status & ret) {
+    // 0187 LLAMA_GRAPH_DUAL_SCHED=1: an MTP draft context alternates its catch-up (no outputs) with one-row drafts; each kind keeps its
+    // own scheduler, and so its allocated graph, so neither is rebuilt because the other ran in between
+    static const bool dual_sched = getenv("LLAMA_GRAPH_DUAL_SCHED") != nullptr && atoi(getenv("LLAMA_GRAPH_DUAL_SCHED")) != 0;
+    if (dual_sched && cparams.ctx_type == LLAMA_CONTEXT_TYPE_MTP && !moe_cache && gf_res_reserve) {
+        const int slot = n_outputs > 0 ? 1 : 0;
+        if (slot != sched_slot) {
+            if (!sched_alt) {
+                sched_alt.reset(ggml_backend_sched_new(backend_ptrs.data(), backend_buft.data(), backend_ptrs.size(),
+                    gf_res_reserve->get_max_nodes(), cparams.pipeline_parallel, cparams.op_offload));
+                ggml_backend_sched_set_copy_callback(sched_alt.get(), sched_copy_experts, this);
+                LLAMA_LOG_INFO("%s: LLAMA_GRAPH_DUAL_SCHED: a second scheduler for the batches %s outputs\n", __func__, slot ? "with" : "without");
+            }
+            std::swap(sched, sched_alt);
+            std::swap(gf_res_prev_active, gf_res_prev_active_alt);
+            sched_slot = slot;
+        }
+    }
+
     // [TAG_PIPELINE_RESERVE] with pipeline parallelism, reserve the worst-case graph of sched_reserve again after a different graph
     // (e.g. a small batch with host weights), otherwise every ubatch of the prompt reallocates the compute buffers
     if (cparams.pipeline_parallel && gtype == ctx_type_to_graph_type(cparams.ctx_type)) {
@@ -3177,6 +3198,7 @@ ggml_cgraph * llama_context::graph_reserve(
         }
     }
     gf_res_prev_active = nullptr;
+    gf_res_prev_active_alt = nullptr; // 0187
 
     // store the n_outputs as it is, and restore it afterwards
     // TODO: not sure if needed, might simplify in the future by removing this
@@ -4976,6 +4998,7 @@ void llama_context::opt_epoch_iter(
 
             // the optimizer graph is allocated outside sched, so the next decode must rebuild
             gf_res_prev_active = nullptr;
+            gf_res_prev_active_alt = nullptr; // 0187
             res->reset();
 
             auto * gf = model.build_graph(gparams);
diff --git a/src/llama-context.h b/src/llama-context.h
index 735e8b70d..097dd6da9 100644
--- a/src/llama-context.h
+++ b/src/llama-context.h
@@ -369,6 +369,12 @@ private:
 
     ggml_backend_sched_ptr sched;
 
+    // 0187 LLAMA_GRAPH_DUAL_SCHED=1 (an MTP draft context): the other slot's scheduler and its last allocated graph, swapped with
+    // sched / gf_res_prev_active when a batch's slot (with or without outputs) differs from sched_slot
+    ggml_backend_sched_ptr sched_alt;
+    llm_graph_result * gf_res_prev_active_alt = nullptr;
+    int sched_slot = 0;
+
     bool sched_need_reserve = true;
 
     // whether the reserve graph has a logits tensor, set in sched_reserve()
-- 
2.43.0

