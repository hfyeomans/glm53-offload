From 18788b4dd97149f4dc2e399529352cd9a2732b04 Mon Sep 17 00:00:00 2001
From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Sun, 8 Nov 2026 03:43:38 -0600
Subject: [PATCH 197/211] 0190: with LLAMA_HEAD_OVERLAP=1 the MTP graph sets
 gpu_switch_nosync (0189 blocked the host at the input-less split)

---
 src/models/glm-dsa.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/models/glm-dsa.cpp b/src/models/glm-dsa.cpp
index e3dfc87f4..ba69e1089 100644
--- a/src/models/glm-dsa.cpp
+++ b/src/models/glm-dsa.cpp
@@ -1733,6 +1733,12 @@ llama_model_glm_dsa::graph_mtp::graph_mtp(const llama_model & model, const llm_g
     GGML_ASSERT(hparams.is_mla() && "GLM_DSA MTP requires MLA");
 
     const int il = hparams.n_layer() + cparams.nextn_layer_offset;
+
+    // 0190: with 0189's split head the head card's half is a split without inputs; no host wait when the scheduler switches into it
+    static const bool head_overlap_mtp = getenv("LLAMA_HEAD_OVERLAP") != nullptr && atoi(getenv("LLAMA_HEAD_OVERLAP")) != 0;
+    if (head_overlap_mtp && model.head_half != nullptr) {
+        ggml_backend_sched_set_gpu_switch_nosync(sched, true);
+    }
     GGML_ASSERT(cparams.nextn_layer_offset >= 0 &&
                 cparams.nextn_layer_offset < (int) hparams.n_layer_nextn &&
                 "nextn_layer_offset out of range [0, n_layer_nextn)");
-- 
