From: Killy <308386066+killy-netsphere@users.noreply.github.com>
Date: Sun, 8 Nov 2026 05:07:27 -0600
Subject: [PATCH 198/211] 0191: LLAMA_MTP_HEAD_TYPE=<type> -- the MTP draft
 graph scores its drafts with a requantized copy of the vocabulary head (split
 like the head with 0174)

---
 src/llama-model.cpp    | 88 ++++++++++++++++++++++++++++++++++++++++++
 src/llama-model.h      |  5 +++
 src/models/glm-dsa.cpp | 11 ++++--
 3 files changed, 101 insertions(+), 3 deletions(-)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 15111ad5c..1d6c8a2be 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -32,6 +32,7 @@
 #include <cstring>
 #include <cmath>
 #include <functional>
+#include <thread> // 0191
 #include <map>
 #include <numeric>
 #include <regex>
@@ -2077,6 +2078,7 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
     load_tensors_mtp_head();
     load_tensors_td();
     load_tensors_head_split();
+    load_tensors_mtp_head_q(); // 0191
 
     return true;
 }
@@ -2271,6 +2273,92 @@ void llama_model_base::load_tensors_head_split() {
     pimpl->ctxs_bufs.emplace_back(std::move(ctx), std::move(buffers));
 }
 
+// LLAMA_MTP_HEAD_TYPE=<type> (0191): a requantized copy of the vocabulary head for the MTP draft graph only (fewer bytes a draft; the verify
+// keeps the model's head), on the head's card, and with 0174's split head its first half also on the other card
+void llama_model_base::load_tensors_mtp_head_q() {
+    const char * env = getenv("LLAMA_MTP_HEAD_TYPE");
+    if (env == nullptr || *env == 0 || hparams.n_layer_nextn == 0 || output == nullptr || output->buffer == nullptr ||
+            ggml_backend_buffer_is_host(output->buffer) || !ggml_is_contiguous(output) || output_s != nullptr) {
+        return;
+    }
+    ggml_type qt = GGML_TYPE_COUNT;
+    for (int t = 0; t < GGML_TYPE_COUNT; ++t) {
+        const char * name = ggml_type_name((ggml_type) t);
+        if (name != nullptr && strcmp(name, env) == 0 && ggml_blck_size((ggml_type) t) > 0) {
+            qt = (ggml_type) t;
+            break;
+        }
+    }
+    const auto * tr_src = ggml_get_type_traits(output->type);
+    const int64_t n_per_row = output->ne[0];
+    const int64_t nrows = output->ne[1];
+    if (qt == GGML_TYPE_COUNT || qt == output->type || ggml_quantize_requires_imatrix(qt) || tr_src->to_float == nullptr ||
+            n_per_row % ggml_blck_size(qt) != 0) {
+        LLAMA_LOG_WARN("%s: LLAMA_MTP_HEAD_TYPE=%s: not a type the head (%s) can be requantized to without an imatrix, not used\n", __func__,
+            env, ggml_type_name(output->type));
+        return;
+    }
+    const int64_t t0 = ggml_time_us();
+    std::vector<uint8_t> src(ggml_nbytes(output));
+    ggml_backend_tensor_get(output, src.data(), 0, src.size());
+    const size_t row_q = ggml_row_size(qt, n_per_row);
+    std::vector<uint8_t> dst(row_q * nrows);
+    const int n_thr = std::max(1, std::min(64, (int) std::thread::hardware_concurrency() / 2));
+    std::vector<std::thread> workers;
+    for (int w = 0; w < n_thr; ++w) {
+        workers.emplace_back([&, w]() {
+            const int64_t r0 = nrows * w / n_thr;
+            const int64_t r1 = nrows * (w + 1) / n_thr;
+            std::vector<float> f(n_per_row * 64);
+            for (int64_t r = r0; r < r1; r += 64) {
+                const int64_t nr = std::min<int64_t>(64, r1 - r);
+                for (int64_t k = 0; k < nr; ++k) {
+                    tr_src->to_float(src.data() + (r + k) * output->nb[1], f.data() + k * n_per_row, n_per_row);
+                }
+                ggml_quantize_chunk(qt, f.data(), dst.data() + r * row_q, 0, nr, n_per_row, nullptr);
+            }
+        });
+    }
+    for (auto & w : workers) {
+        w.join();
+    }
+    ggml_backend_dev_t d_out = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(output->buffer));
+    auto place = [&](ggml_backend_dev_t dev, int64_t n, const char * name) -> ggml_tensor * {
+        ggml_init_params params = { ggml_tensor_overhead()*2, NULL, true };
+        ggml_context_ptr ctx { ggml_init(params) };
+        ggml_tensor * t = ggml_new_tensor_2d(ctx.get(), qt, n_per_row, n);
+        ggml_set_name(t, name);
+        ggml_backend_buffer_ptr buf { ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), ggml_backend_dev_buffer_type(dev)) };
+        if (!buf) {
+            LLAMA_LOG_WARN("%s: LLAMA_MTP_HEAD_TYPE: could not allocate %.1f MiB on %s\n", __func__, ggml_nbytes(t)/1024.0/1024.0,
+                ggml_backend_dev_name(dev));
+            return nullptr;
+        }
+        ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        ggml_backend_tensor_set(t, dst.data(), 0, ggml_nbytes(t)); // the first n rows
+        std::vector<ggml_backend_buffer_ptr> buffers;
+        buffers.emplace_back(std::move(buf));
+        pimpl->ctxs_bufs.emplace_back(std::move(ctx), std::move(buffers));
+        return t;
+    };
+    ggml_tensor * full = place(d_out, nrows, "output.mtp_head_q");
+    if (full == nullptr) {
+        return;
+    }
+    ggml_tensor * half = nullptr;
+    if (head_half != nullptr) {
+        half = place(head_half_dev, head_half->ne[1], "output.mtp_head_q_half");
+        if (half == nullptr) {
+            return;
+        }
+    }
+    mtp_head_q = full;
+    mtp_head_q_half = half;
+    LLAMA_LOG_INFO("%s: LLAMA_MTP_HEAD_TYPE: the draft head as %s, %.1f MiB on %s%s%s (requantized from %s in %.1f s on %d threads)\n",
+        __func__, ggml_type_name(qt), ggml_nbytes(full)/1024.0/1024.0, ggml_backend_dev_name(d_out), half ? ", its first half on " : "",
+        half ? ggml_backend_dev_name(head_half_dev) : "", ggml_type_name(output->type), (ggml_time_us() - t0)/1e6, n_thr);
+}
+
 // LLAMA_TP_DECODE=1 (0165): the two-card head-split decode's weights on each layer's non-home card (docs/20261107-two-card-tp-decode-design.md)
 void llama_model_base::load_tensors_td() {
     const char * env = getenv("LLAMA_TP_DECODE");
diff --git a/src/llama-model.h b/src/llama-model.h
index 8ada03bdf..ce6658c30 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -906,6 +906,10 @@ struct llama_model {
     // LLAMA_HEAD_SPLIT (0174): the first half of the vocabulary head's rows on the card that does not hold the head, and that card
     ggml_tensor * head_half = nullptr;
     ggml_backend_dev_t head_half_dev = nullptr;
+    // LLAMA_MTP_HEAD_TYPE (0191): a requantized copy of the vocabulary head for the MTP draft graph, and with 0174 its first half on
+    // head_half_dev
+    ggml_tensor * mtp_head_q = nullptr;
+    ggml_tensor * mtp_head_q_half = nullptr;
 
     // for keeping track of associated LoRA adapters
     std::unordered_set<llama_adapter_lora *> loras;
@@ -1032,6 +1036,7 @@ struct llama_model_base : public llama_model {
     void load_tensors_mtp_head();  // LLAMA_MTP_HEAD_IDS (0155)
     void load_tensors_td();        // LLAMA_TP_DECODE (0165)
     void load_tensors_head_split(); // LLAMA_HEAD_SPLIT (0174)
+    void load_tensors_mtp_head_q(); // LLAMA_MTP_HEAD_TYPE (0191)
 
     // helper: read the SWA pattern as one flag per layer, or as a period expanded by set_swa_pattern
     void load_swa_pattern(llama_model_loader & ml, uint32_t n_pattern, bool dense_first = false);
diff --git a/src/models/glm-dsa.cpp b/src/models/glm-dsa.cpp
index ba69e1089..b79e44130 100644
--- a/src/models/glm-dsa.cpp
+++ b/src/models/glm-dsa.cpp
@@ -187,7 +187,9 @@ void llama_model_glm_dsa::load_arch_tensors(llama_model_loader & ml) {
 // the head's card, concatenated there.  cur_x: the hidden state as the other card already holds it (the TD graph), else cur is copied over
 static ggml_tensor * glm_dsa_head(ggml_context * ctx0, ggml_cgraph * gf, ggml_backend_sched_t sched, const llama_model & model,
         ggml_tensor * w, ggml_tensor * cur, ggml_tensor * cur_x) {
-    if (model.head_half == nullptr || w != model.output) {
+    // 0191: the draft head's requantized copy splits like the head
+    ggml_tensor * w_half = w == model.output ? model.head_half : (w == model.mtp_head_q ? model.mtp_head_q_half : nullptr);
+    if (w_half == nullptr) {
         return ggml_mul_mat(ctx0, w, cur);
     }
     ggml_backend_t be_o = nullptr;
@@ -205,8 +207,8 @@ static ggml_tensor * glm_dsa_head(ggml_context * ctx0, ggml_cgraph * gf, ggml_ba
     if (be_o == nullptr || be_x == nullptr) {
         return ggml_mul_mat(ctx0, w, cur);
     }
-    const int64_t nh = model.head_half->ne[1];
-    ggml_tensor * lx = ggml_mul_mat(ctx0, model.head_half, cur_x != nullptr ? cur_x : cur); // the other card first
+    const int64_t nh = w_half->ne[1];
+    ggml_tensor * lx = ggml_mul_mat(ctx0, w_half, cur_x != nullptr ? cur_x : cur); // the other card first
     ggml_backend_sched_set_tensor_backend(sched, lx, be_x);
     ggml_build_forward_expand(gf, lx);
     ggml_tensor * wo = ggml_view_2d(ctx0, w, w->ne[0], w->ne[1] - nh, w->nb[1], (size_t) nh*w->nb[1]);
@@ -2028,6 +2030,9 @@ llama_model_glm_dsa::graph_mtp::graph_mtp(const llama_model & model, const llm_g
     }
 
     ggml_tensor * head_w = layer.nextn.shared_head_head ? layer.nextn.shared_head_head : model.output;
+    if (model.mtp_head_q != nullptr && head_w == model.output) {
+        head_w = model.mtp_head_q; // 0191 LLAMA_MTP_HEAD_TYPE: the drafts score with the requantized copy
+    }
     ggml_tensor * head_s = layer.nextn.shared_head_head ? layer.nextn.shared_head_head_s : model.output_s;
     GGML_ASSERT(head_w && "GLM_DSA MTP: missing LM head (nextn.shared_head_head or model.output)");
     // LLAMA_MTP_HEAD_VOCAB=K (0041): score the first K token ids only, -inf for the rest (the draft just cannot propose them)
