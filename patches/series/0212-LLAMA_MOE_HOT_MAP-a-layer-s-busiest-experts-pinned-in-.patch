index 1d6c8a2..5ef6ee4 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -25,9 +25,15 @@
 #include "ggml.h"
 #include "ggml-cpp.h"
 
+#ifndef _WIN32
+#include <unistd.h>
+#endif
+
 #include <algorithm>
+#include <atomic>
 #include <cassert>
 #include <cfloat>
