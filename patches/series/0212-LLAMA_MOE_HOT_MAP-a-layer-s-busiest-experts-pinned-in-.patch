 #include <cstring>
 #include <cmath>
@@ -1371,6 +1377,211 @@ llama_model::~llama_model() {
     for (auto * lora : loras) {
         delete lora;
     }
+#ifndef _WIN32
+    for (int fd : moe_hot_fds) {
+        if (fd >= 0) {
+            close(fd);
+        }
+    }
+#endif
+}
+
+static std::vector<ggml_tensor *> llama_moe_hot_experts(const llama_layer & layer) {
+    std::vector<ggml_tensor *> res;
+    for (ggml_tensor * t : { layer.ffn_gate_up_exps, layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps }) {
+        if (t != nullptr) {
+            res.push_back(t);
+        }
+    }
+    return res;
+}
+
+// before the buffers are allocated: the layers of the map get their order, and their expert tensors the size of their host part
+static void llama_moe_hot_plan(llama_model & model, llama_model_loader & ml) {
+    const char * path = getenv("LLAMA_MOE_HOT_MAP");
+    if (path == nullptr || *path == '\0' || ml.no_alloc) {
+        return;
+    }
+#ifdef _WIN32
+    throw std::runtime_error("LLAMA_MOE_HOT_MAP is not supported on Windows");
+#else
+    if (ml.use_mmap) {
+        throw std::runtime_error("LLAMA_MOE_HOT_MAP needs a load mode that reads the file (--load-mode none)");
+    }
+    std::ifstream in(path);
+    if (!in) {
+        throw std::runtime_error(std::string("LLAMA_MOE_HOT_MAP: cannot open ") + path);
+    }
+    if (model.hparams.n_expert_groups > 1) {
+        throw std::runtime_error("LLAMA_MOE_HOT_MAP: the router picks groups of experts by their number, the experts cannot take a new order");
+    }
+    const int32_t n_expert = (int32_t) model.hparams.n_expert;
+    model.moe_hot_fds.assign(ml.files.size(), -1);
+    size_t n_hot = 0;
+    std::string line;
+    while (std::getline(in, line)) {
+        if (const size_t c = line.find('#'); c != std::string::npos) {
+            line.resize(c);
+        }
+        std::istringstream ss(line);
+        int32_t il;
+        if (!(ss >> il)) {
+            continue;
+        }
+        if (il < 0 || il >= (int32_t) model.layers.size() || model.moe_hot.count(il) > 0) {
+            throw std::runtime_error(format("LLAMA_MOE_HOT_MAP: layer %d is out of range or named twice", il));
+        }
+        const llama_layer & layer = model.layers[il];
+        const auto experts = llama_moe_hot_experts(layer);
+        if (experts.empty() || layer.ffn_gate_inp == nullptr || layer.ffn_gate_inp->ne[1] != n_expert) {
+            throw std::runtime_error(format("LLAMA_MOE_HOT_MAP: layer %d has no routed experts", il));
+        }
+        for (const ggml_tensor * t : { layer.ffn_gate_inp_b, layer.ffn_gate_inp_s, layer.ffn_exp_probs_b_vl,
+                layer.ffn_gate_exps_s, layer.ffn_up_exps_s, layer.ffn_down_exps_s, layer.ffn_gate_exps_in_s, layer.ffn_up_exps_in_s, layer.ffn_down_exps_in_s }) {
+            if (t != nullptr) {
+                throw std::runtime_error(format("LLAMA_MOE_HOT_MAP: layer %d has a per-expert tensor that is not reordered (%s)", il, t->name));
+            }
+        }
+        std::vector<bool> hot(n_expert, false);
+        std::vector<int32_t> tail;
+        int32_t e;
+        while (ss >> e) {
+            if (e < 0 || e >= n_expert || hot[e]) {
+                throw std::runtime_error(format("LLAMA_MOE_HOT_MAP: layer %d: expert %d is out of range or named twice", il, e));
+            }
+            hot[e] = true;
+            tail.push_back(e);
+        }
+        if (tail.empty()) {
+            continue;
+        }
+        if ((int32_t) tail.size() + (int32_t) model.hparams.n_expert_used_max() > n_expert) {
+            throw std::runtime_error(format("LLAMA_MOE_HOT_MAP: layer %d names too many experts", il));
+        }
+        auto & h = model.moe_hot[il];
+        h.n_host = n_expert - (int32_t) tail.size();
+        for (int32_t x = 0; x < n_expert; ++x) {
+            if (!hot[x]) {
+                h.order.push_back(x);
+            }
+        }
+        h.order.insert(h.order.end(), tail.begin(), tail.end());
+        for (ggml_tensor * t : experts) {
+            const auto * w = ml.get_weight(ggml_get_name(t));
+            if (w == nullptr || t->ne[2] != n_expert) {
+                throw std::runtime_error(format("LLAMA_MOE_HOT_MAP: layer %d: %s is not an expert tensor of the file", il, t->name));
+            }
+            int & fd = model.moe_hot_fds[w->idx];
+            if (fd < 0) {
+                fd = dup(ml.files.at(w->idx)->file_id());
+                if (fd < 0) {
+                    throw std::runtime_error("LLAMA_MOE_HOT_MAP: cannot keep the model file open");
+                }
+            }
+            h.src.push_back({ t, fd, w->offs });
+            model.moe_hot_n_host[t] = h.n_host;
+            ml.expert_order[t]      = &h.order;
+            t->ne[2] = h.n_host; // allocated and loaded with this size, see llama_moe_hot_done
+        }
+        for (const ggml_tensor * t : { layer.ffn_gate_inp, layer.ffn_exp_probs_b }) {
+            const auto * w = t != nullptr ? ml.get_weight(ggml_get_name(t)) : nullptr;
+            if (w != nullptr && model.moe_hot_fds[w->idx] >= 0) {
+                h.router.push_back({ t, model.moe_hot_fds[w->idx], w->offs });
+            }
+        }
+        n_hot += tail.size();
+    }
+    LLAMA_LOG_INFO("%s: LLAMA_MOE_HOT_MAP: %zu experts of %zu layers stay out of host memory\n", __func__, n_hot, model.moe_hot.size());
+#endif
+}
+
+// after the load: the tensors get their shape back, and the router of each layer the order of its experts
+static void llama_moe_hot_done(llama_model & model) {
+    const int32_t n_expert = (int32_t) model.hparams.n_expert;
+    std::vector<uint8_t> a;
+    std::vector<uint8_t> b;
+    for (auto & [il, h] : model.moe_hot) {
+        for (const auto & s : h.src) {
+            ggml_tensor * t = const_cast<ggml_tensor *>(s.t);
+            if (!llama_tensor_is_host_weight(t)) {
+                throw std::runtime_error(format("LLAMA_MOE_HOT_MAP: layer %d: %s is not in host memory", il, t->name));
+            }
+            t->ne[2] = n_expert;
+        }
+        const llama_layer & layer = model.layers[il];
+        for (ggml_tensor * t : { layer.ffn_gate_inp, layer.ffn_exp_probs_b }) {
+            if (t == nullptr) {
+                continue;
+            }
+            // one row per expert: ffn_gate_inp [n_embd, n_expert], ffn_exp_probs_b [n_expert]
+            const size_t row = ggml_nbytes(t)/n_expert;
+            GGML_ASSERT(ggml_nelements(t) % n_expert == 0 && row*n_expert == ggml_nbytes(t) && (ggml_n_dims(t) == 1 || t->nb[1] == row));
+            a.resize(ggml_nbytes(t));
+            b.resize(ggml_nbytes(t));
+            ggml_backend_tensor_get(t, a.data(), 0, a.size());
+            for (int32_t p = 0; p < n_expert; ++p) {
+                memcpy(b.data() + p*row, a.data() + h.order[p]*row, row);
+            }
+            ggml_backend_tensor_set(t, b.data(), 0, b.size());
+        }
+    }
+#ifndef _WIN32
+    // LLAMA_MOE_HOT_VERIFY=1: the host experts and the router rows against the model file, byte for byte
+    if (const char * s = getenv("LLAMA_MOE_HOT_VERIFY"); s != nullptr && atoi(s) != 0 && !model.moe_hot.empty()) {
+        const int64_t t0 = ggml_time_us();
+        auto same = [](int fd, size_t offs, const uint8_t * data, size_t size) {
+            std::vector<uint8_t> buf(std::min<size_t>(size, 8u*1024*1024));
+            for (size_t done = 0; done < size; ) {
+                const ssize_t r = pread(fd, buf.data(), std::min(buf.size(), size - done), (off_t) (offs + done));
+                if (r <= 0 || memcmp(buf.data(), data + done, (size_t) r) != 0) {
+                    return false;
+                }
+                done += (size_t) r;
+            }
+            return true;
+        };
+        std::vector<const llama_model::moe_hot_layer *> hs;
+        for (const auto & [il, h] : model.moe_hot) {
+            hs.push_back(&h);
+        }
+        std::atomic<size_t> next { 0 };
+        std::atomic<size_t> n_bad { 0 };
+        std::atomic<size_t> n_ok { 0 };
+        std::vector<std::thread> thr;
+        for (int i = 0; i < 8; ++i) {
+            thr.emplace_back([&]() {
+                for (size_t k = next++; k < hs.size(); k = next++) {
+                    const auto & h = *hs[k];
+                    for (const auto & s : h.src) {
+                        const size_t es = s.t->nb[2];
+                        for (int32_t p = 0; p < h.n_host; ++p) {
+                            (same(s.fd, s.offs + (size_t) h.order[p]*es, (const uint8_t *) s.t->data + (size_t) p*es, es) ? n_ok : n_bad)++;
+                        }
+                    }
+                }
+            });
+        }
+        for (auto & t : thr) {
+            t.join();
+        }
+        std::atomic<size_t> n_rows { 0 };
+        for (const auto & [il, h] : model.moe_hot) {
+            for (const auto & s : h.router) {
+                const size_t row = ggml_nbytes(s.t)/n_expert;
+                a.resize(ggml_nbytes(s.t));
+                ggml_backend_tensor_get(s.t, a.data(), 0, a.size());
+                for (int32_t p = 0; p < n_expert; ++p) {
+                    (same(s.fd, s.offs + (size_t) h.order[p]*row, a.data() + p*row, row) ? n_rows : n_bad)++;
+                }
+            }
+        }
+        LLAMA_LOG_INFO("%s: LLAMA_MOE_HOT_VERIFY: %zu host experts and %zu router rows match the model file, %zu differ (%.1f s)\n", __func__,
+            n_ok.load(), n_rows.load(), n_bad.load(), (ggml_time_us() - t0)/1e6);
+        if (n_bad > 0) {
+            throw std::runtime_error("LLAMA_MOE_HOT_VERIFY: the loaded experts differ from the model file");
+        }
+    }
+#endif
 }
 
