     if (use_mmap_buffer) {
         for (auto & mapping : ml.mappings) {
diff --git a/src/llama-model.h b/src/llama-model.h
index ce6658c..fafff92 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -923,6 +923,29 @@ struct llama_model {
     int64_t t_load_us  = 0;
     int64_t t_start_us = 0;
 
+    // LLAMA_MOE_HOT_MAP=file: a line per layer, "layer expert expert ...".  The layer's experts are loaded in a new order, the ones
+    // named last: host memory holds the first n_host only, the others live in the MoE cache alone (it reads them from the file).
+    // The router's rows take the same order, so the model computes the same thing; every expert index of the layer is a position
+    struct moe_hot_layer {
+        int32_t n_host = 0;
+        std::vector<int32_t> order; // position -> expert of the file
+        struct source {
+            const ggml_tensor * t;
+            int    fd;
+            size_t offs;
+        };
+        std::vector<source> src;    // the layer's expert tensors in the files
+        std::vector<source> router; // ffn_gate_inp and ffn_exp_probs_b there
+    };
+    std::map<int32_t, moe_hot_layer> moe_hot;
+    std::unordered_map<const ggml_tensor *, int32_t> moe_hot_n_host;
+    std::vector<int> moe_hot_fds;
+    // the experts of w that host memory holds, the first ones
+    int64_t moe_host_experts(const ggml_tensor * w) const {
+        const auto it = moe_hot_n_host.find(w);
+        return it != moe_hot_n_host.end() ? it->second : w->ne[2];
+    }
+
     explicit llama_model(const llama_model_params & params);
     virtual ~llama_model();
 
